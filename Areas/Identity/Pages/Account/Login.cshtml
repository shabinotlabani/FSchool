@page
@model _2Korriku.Areas.Identity.Pages.Account.LoginModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="sq">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a2341" />
    <meta name="color-scheme" content="light" />
    <title>Hyr në llogari · UPNEXT</title>
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
    <link rel="icon" href="~/images/upnext/favicon.ico" asp-append-version="true" />
    <link rel="manifest" href="~/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="~/images/upnext/app_icon_180.png" />
    <link rel="stylesheet" href="~/css/pwa.css" asp-append-version="true" />
</head>
<body>
    <main class="login-shell">
        <section class="form-panel" aria-label="Identifikimi">
            <div class="login-identity"><a href="~/" class="login-brand" aria-label="UPNEXT SPORTS MANAGEMENT SOFTWARE"><img src="~/images/upnext/logo_512.webp" srcset="@Url.Content("~/images/upnext/logo_256.webp") 256w, @Url.Content("~/images/upnext/logo_512.webp") 512w" sizes="(max-width: 700px) 104px, 260px" asp-append-version="true" alt="UPNEXT SPORTS MANAGEMENT SOFTWARE" width="260" height="260" /></a><p>Klubi yt. Një hap përpara.</p><span class="identity-line" aria-hidden="true"></span></div>
            <header class="login-heading"><span>PLATFORMA UPNEXT</span><h1>Hyr në llogari</h1><p>Vazhdo me llogarinë tënde.</p></header>
            <div class="form-content">
                <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
                    <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
                    <div class="field">
                        <label asp-for="Input.Email">Adresa e emailit</label>
                        <input asp-for="Input.Email" type="email" autocomplete="username" placeholder="emri@shembull.com" spellcheck="false" aria-describedby="email-error" />
                        <span asp-validation-for="Input.Email" id="email-error" class="field-error"></span>
                    </div>
                    <div class="field">
                        <label asp-for="Input.Password">Fjalëkalimi</label>
                        <div class="password-field">
                            <input asp-for="Input.Password" autocomplete="current-password" placeholder="Shkruani fjalëkalimin" aria-describedby="password-error" />
                            <button type="button" class="password-toggle" aria-label="Shfaq fjalëkalimin" aria-pressed="false" aria-controls="Input_Password">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z" /><circle cx="12" cy="12" r="3" /><path class="eye-slash" d="m3 3 18 18" /></svg>
                            </button>
                        </div>
                        <span asp-validation-for="Input.Password" id="password-error" class="field-error"></span>
                    </div>
                    <label class="remember"><input asp-for="Input.RememberMe" /> Më mbaj të kyçur</label>
                    <button type="submit" class="submit-button">Hyr në llogari <span aria-hidden="true">→</span></button>
                </form>
            </div>
            <footer class="form-footer"><span>© @DateTime.UtcNow.Year UPNEXT</span><span>Programuar nga <a href="https://www.volcanopixels.com" target="_blank" rel="noopener noreferrer">Volcano Pixels <span aria-hidden="true">↗</span></a></span></footer>
        </section>
    </main>
    <script>
        const toggle = document.querySelector('.password-toggle');
        const password = document.getElementById('Input_Password');
        toggle.addEventListener('click', () => {
            const visible = password.type === 'password';
            password.type = visible ? 'text' : 'password';
            toggle.setAttribute('aria-pressed', String(visible));
            toggle.setAttribute('aria-label', visible ? 'Fshih fjalëkalimin' : 'Shfaq fjalëkalimin');
        });
    </script>
    <partial name="_PwaInstall" />
</body>
</html>
