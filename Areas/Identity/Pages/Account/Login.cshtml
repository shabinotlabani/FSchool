@page
@model _2Korriku.Areas.Identity.Pages.Account.LoginModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="@Model.Language">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a2341" />
    <meta name="color-scheme" content="light" />
    <title>@Model.T("Title") · UPNEXT</title>
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
    <link rel="icon" href="~/images/upnext/favicon.ico" asp-append-version="true" />
    <link rel="manifest" href="~/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="~/images/upnext/app_icon_180.png" />
    <link rel="stylesheet" href="~/css/pwa.css" asp-append-version="true" />
</head>
<body>
    <svg class="login-icons" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><defs>
        <symbol id="login-players" viewBox="0 0 24 24"><circle cx="9" cy="8" r="3"/><path d="M3 21v-3a6 6 0 0 1 12 0v3M16 5a3 3 0 0 1 0 6m2 3a5 5 0 0 1 3 4v3"/></symbol>
        <symbol id="login-training" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="3"/><path d="M7 3v4m10-4v4M3 11h18m-13 5 3 3 5-5"/></symbol>
        <symbol id="login-finance" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="15" rx="3"/><path d="M3 9h18m-6 4h6v4h-6a2 2 0 0 1 0-4Z"/></symbol>
        <symbol id="login-stats" viewBox="0 0 24 24"><path d="M4 3v17h17M8 16v-4m5 4V8m5 8V4"/></symbol>
        <symbol id="login-mail" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="m4 7 8 6 8-6"/></symbol>
        <symbol id="login-lock" viewBox="0 0 24 24"><rect x="5" y="10" width="14" height="11" rx="3"/><path d="M8 10V7a4 4 0 0 1 8 0v3m-4 5v2"/></symbol>
    </defs></svg>
    <main class="login-shell">
        <section class="login-identity" aria-label="UPNEXT Sports Management Software">
            <a href="~/" class="login-brand" aria-label="UPNEXT SPORTS MANAGEMENT SOFTWARE"><img src="~/images/upnext/logo_256.webp" srcset="@Url.Content("~/images/upnext/logo_256.webp") 256w, @Url.Content("~/images/upnext/logo_512.webp") 512w" sizes="(max-width: 700px) 68px, 112px" asp-append-version="true" alt="UPNEXT SPORTS MANAGEMENT SOFTWARE" width="112" height="112" fetchpriority="high" /></a>
            <div class="identity-copy"><span class="identity-rule" aria-hidden="true"></span><h2>@Model.T("HeroLead")<br/><span>@Model.T("HeroAccent")</span></h2><p>@Model.T("HeroDescription")</p></div>
            <div class="login-showcase" aria-label="UPNEXT">
                <article class="showcase-player">
                    <header><span class="showcase-team">@Model.T("YourTeam")</span><span class="showcase-active"><i></i>@Model.T("Active")</span></header>
                    <div class="showcase-photo"><img src="~/images/upnext/login-player.jpg" asp-append-version="true" alt="" width="480" height="640" loading="eager" decoding="async"/><span>@Model.T("YourLogo")</span><b>10</b></div>
                    <div class="showcase-player-main"><span class="showcase-player-name"><strong>@Model.T("PlayerSample")</strong><small>@Model.T("PlayerRoleSample")</small></span></div>
                    <div class="showcase-metrics"><span><small>@Model.T("Attendance")</small><strong>92%</strong></span><span><small>@Model.T("Progress")</small><strong>84</strong></span><span><small>@Model.T("Matches")</small><strong>12</strong></span></div>
                </article>
                <article class="showcase-notice"><span class="showcase-notice-icon" aria-hidden="true">!</span><div><small>@Model.T("Notice")</small><strong>@Model.T("TrainingMissed")</strong><span>@Model.T("Today") · 18:30</span></div></article>
                <div class="showcase-quick"><span class="showcase-payment"><i aria-hidden="true">89</i><small>@Model.T("MonthlyCollection")</small><strong>89% @Model.T("Collected")</strong><em><b></b></em></span><span class="showcase-development"><i aria-hidden="true">↗</i><small>@Model.T("PlayerDevelopment")</small><strong>+12% · 30 ditë</strong><em><b></b></em></span></div>
            </div>
            <div class="identity-bottom"><ul class="login-benefits"><li><svg aria-hidden="true"><use href="#login-players"/></svg>@Model.T("Players")</li><li><svg aria-hidden="true"><use href="#login-training"/></svg>@Model.T("Training")</li><li><svg aria-hidden="true"><use href="#login-finance"/></svg>@Model.T("Finances")</li><li><svg aria-hidden="true"><use href="#login-stats"/></svg>@Model.T("Statistics")</li></ul><p class="identity-sports">@Model.T("Sports")</p></div>
        </section>
        <section class="form-panel" aria-label="@Model.T("Identity")">
            <div class="form-topbar">
                @{var languages=new[]{("sq","Shqip"),("en","English")};}
                <details class="login-language-combo">
                <summary aria-label="@Model.T("Language")"><partial name="_LanguageFlag" model="Model.Language"/><span>@languages.Single(x=>x.Item1==Model.Language).Item2</span><svg class="language-chevron" viewBox="0 0 16 16" aria-hidden="true"><path d="m4 6 4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5"/></svg></summary>
                <nav class="login-language-options" aria-label="@Model.T("Language")">
                @foreach(var item in languages){
                    <a asp-page="./Login" asp-route-language="@item.Item1" asp-route-returnUrl="@Model.ReturnUrl" lang="@item.Item1" hreflang="@item.Item1" aria-current="@(Model.Language==item.Item1?"true":null)" class="@(Model.Language==item.Item1?"is-selected":null)"><partial name="_LanguageFlag" model="item.Item1"/><span>@item.Item2</span>@if(Model.Language==item.Item1){<span class="language-check" aria-hidden="true">✓</span>}</a>
                }
                </nav>
                </details>
            </div>
            <div class="form-content">
                <header class="login-heading"><span>@Model.T("Workspace")</span><h1>@Model.T("Title")</h1><p>@Model.T("Continue")</p></header>
                <form id="login-form" method="post" asp-route-returnUrl="@Model.ReturnUrl" novalidate>

                    <input type="hidden" name="language" value="@Model.Language"/>
                    <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
                    <div class="field">
                        <label asp-for="Input.Email">@Model.T("Email")</label>
                        <div class="input-wrap"><svg class="input-icon" aria-hidden="true"><use href="#login-mail"/></svg><input asp-for="Input.Email" type="email" autocomplete="username" placeholder="@Model.T("EmailPlaceholder")" spellcheck="false" autocapitalize="none" inputmode="email" required data-required="@Model.T("EmailRequired")" data-invalid="@Model.T("EmailInvalid")" aria-describedby="email-error" /></div>
                        <span asp-validation-for="Input.Email" id="email-error" class="field-error"></span>
                    </div>
                    <div class="field">
                        <label asp-for="Input.Password">@Model.T("Password")</label>
                        <div class="password-field input-wrap"><svg class="input-icon" aria-hidden="true"><use href="#login-lock"/></svg>
                            <input asp-for="Input.Password" autocomplete="current-password" placeholder="@Model.T("PasswordPlaceholder")" required data-required="@Model.T("PasswordRequired")" aria-describedby="password-error" />
                            <button type="button" class="password-toggle" aria-label="@Model.T("Show")" data-show="@Model.T("Show")" data-hide="@Model.T("Hide")" aria-pressed="false" aria-controls="Input_Password">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z" /><circle cx="12" cy="12" r="3" /><path class="eye-slash" d="m3 3 18 18" /></svg>
                            </button>
                        </div>
                        <span asp-validation-for="Input.Password" id="password-error" class="field-error"></span>
                    </div>
                    <label class="remember"><input asp-for="Input.RememberMe" /> @Model.T("Remember")</label>
                    <button type="submit" class="submit-button" data-loading="@Model.T("Loading")"><span class="submit-label">@Model.T("Title")</span><span class="submit-arrow" aria-hidden="true">→</span><span class="submit-spinner" aria-hidden="true"></span></button><span id="login-status" class="visually-hidden" role="status" aria-live="polite"></span>
                </form>
            </div>
            <footer class="form-footer"><span>© @DateTime.UtcNow.Year UPNEXT</span><span>@Model.T("Credit") <a href="https://www.volcanopixels.com" target="_blank" rel="noopener noreferrer">Volcano Pixels <span aria-hidden="true">↗</span></a></span></footer>
        </section>
    </main>
    <script>
        const languages = document.querySelector('.login-language-combo');
        document.addEventListener('click', event => { if (!languages.contains(event.target)) languages.open = false; });
        document.addEventListener('keydown', event => { if (event.key === 'Escape' && languages.open) { languages.open = false; languages.querySelector('summary').focus(); } });
        const toggle = document.querySelector('.password-toggle');
        const password = document.getElementById('Input_Password');
        toggle.addEventListener('click', () => {
            const visible = password.type === 'password';
            password.type = visible ? 'text' : 'password';
            toggle.setAttribute('aria-pressed', String(visible));
            toggle.setAttribute('aria-label', visible ? toggle.dataset.hide : toggle.dataset.show);
        });
        const form = document.getElementById('login-form');
        const submit = form.querySelector('.submit-button');
        const submitLabel = submit.querySelector('.submit-label');
        const idleLabel = submitLabel.textContent;
        const fields = [document.getElementById('Input_Email'), password];
        function validate(field) {
            const error = field.validity.valueMissing ? field.dataset.required : field.validity.typeMismatch ? field.dataset.invalid : '';
            document.getElementById(field.getAttribute('aria-describedby')).textContent = error;
            field.classList.toggle('input-validation-error', Boolean(error));
            field.setAttribute('aria-invalid', String(Boolean(error)));
            return !error;
        }
        fields.forEach(field => {
            if (field.classList.contains('input-validation-error')) field.setAttribute('aria-invalid', 'true');
            field.addEventListener('input', () => { if (field.getAttribute('aria-invalid') === 'true') validate(field); });
            field.addEventListener('blur', () => { if (field.value) validate(field); });
        });
        form.addEventListener('submit', event => {
            if (submit.disabled) { event.preventDefault(); return; }
            const valid = fields.map(validate).every(Boolean);
            if (!valid) { event.preventDefault(); fields.find(field => field.getAttribute('aria-invalid') === 'true').focus(); return; }
            submit.disabled = true;
            form.setAttribute('aria-busy', 'true');
            submitLabel.textContent = submit.dataset.loading;
            document.getElementById('login-status').textContent = submit.dataset.loading;
        });
        window.addEventListener('pageshow', () => {
            submit.disabled = false; form.removeAttribute('aria-busy'); submitLabel.textContent = idleLabel;
            document.getElementById('login-status').textContent = '';
        });
    </script>
    <div class="pwa-install" hidden>
        <button type="button" class="pwa-install-button" hidden>@Model.T("Install")</button>
        <p class="pwa-ios-help" hidden>@Model.T("InstallHelp")</p>
        <button type="button" class="pwa-dismiss" aria-label="@Model.T("Dismiss")">×</button>
    </div>
    <script src="~/js/pwa.js" asp-append-version="true" data-service-worker="@Url.Content("~/sw.js")" defer></script>
</body>
</html>
