@model List<SizeGroup>
@{ViewData["Title"]="Grupet e madhësive";}

<div class="page-heading mt-3"><div><p class="eyebrow">KONFIGURIMI I REKUIZITAVE</p><h1>Grupet e madhësive</h1></div><a asp-action="Edit" class="btn btn-primary">+ Grup i ri</a></div>
@if(TempData["Success"] is string message){<div class="alert alert-success">@message</div>}
<div class="row g-3">@foreach(var group in Model){<div class="col-md-6"><section class="panel p-4 h-100"><div class="d-flex justify-content-between"><h2 class="h5">@group.Name</h2><span class="badge text-bg-light">@(group.IsActive?"Aktiv":"Joaktiv")</span></div><div class="d-flex flex-wrap gap-2 my-3">@foreach(var size in SizeGroup.Parse(group.Sizes)){<span class="badge text-bg-light p-2">@size</span>}</div><a asp-action="Edit" asp-route-id="@group.Id" class="btn btn-outline-primary">Menaxho grupin</a></section></div>}</div>

@section PageNavigation {
    <a class="btn btn-outline-secondary app-back-button" asp-controller="Products" asp-action="Index"><span aria-hidden="true">←</span><span>Mbrapa</span></a>
}
