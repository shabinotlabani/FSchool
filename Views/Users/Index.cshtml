@model List<UserListModel>
@{ViewData["Title"]="Shfrytëzuesit";}
<div class="page-heading"><div><p class="eyebrow">ADMINISTRIMI</p><h1>Shfrytëzuesit</h1></div><a asp-action="Create" class="btn btn-primary">+ Shfrytëzues i ri</a></div>
@if(TempData["Success"] is string message){<div class="alert alert-success">@message</div>}

<form method="get" class="search-panel d-flex flex-wrap gap-3"><input type="search" name="search" value="@ViewData["Search"]" class="form-control" style="max-width:400px" placeholder="Kërko emrin ose emailin…" aria-label="Kërko shfrytëzues"/><select name="role" class="form-select" style="max-width:200px" aria-label="Filtro rolin"><option value="">Të gjitha rolet</option>@foreach(var role in Roles.All){<option value="@role" selected="@(ViewData["Role"]?.ToString()==role)">@role</option>}</select><button class="btn btn-dark">Kërko</button><a asp-action="Index" class="btn btn-outline-secondary">Pastro</a></form>
<section class="panel"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Shfrytëzuesi</th><th>Emaili</th><th>Roli</th><th>Statusi</th><th></th></tr></thead><tbody>@foreach(var item in Model){<tr><td><strong>@item.User.FirstName @item.User.LastName</strong></td><td>@item.User.Email</td><td>@item.Role</td><td><span class="status-pill @(item.IsActive ? "status-active" : "billing-unpaid")">@(item.IsActive ? "Aktiv" : "Joaktiv")</span></td><td><a asp-action="Edit" asp-route-id="@item.User.Id" class="text-link">Menaxho</a></td></tr>}@if(Model.Count==0){<tr><td colspan="5" class="p-4 text-secondary">Nuk u gjet asnjë shfrytëzues.</td></tr>}</tbody></table></div></section>
