@model PersonalTrainingDetailsModel
@using _2Korriku.Services
@{var t=Model.Training;ViewData["Title"]=t.Name;}

<div class="page-heading mt-3"><div><p class="eyebrow">@t.ModeLabel</p><h1>@t.Student!.FullName</h1><p>@t.Name · @t.Rate.ToString("N2") € · Nga @t.StartsOn.ToString("dd.MM.yyyy") @(t.EndsOn.HasValue?"deri më "+t.EndsOn.Value.ToString("dd.MM.yyyy"):"") @(t.IsCancelled?"· ANULUAR":"")</p></div><a asp-controller="Payments" asp-action="Account" asp-route-id="@t.StudentId" class="btn btn-outline-primary">Kartela e lojtarit</a></div>
<partial name="~/Views/Payments/_BillingNotice.cshtml"/>
<section class="panel p-4 mb-4"><h2 class="h5">Orari personal</h2><p class="fs-5">@t.Schedule</p><p>Trajneri: @(t.Coach??"—") · Vendi: @(t.Location??"—")</p><p>@t.Notes</p><hr/><h3 class="h6">Ekipi bazë: @(t.Student.TrainingTeam?.Name??"Pa ekip")</h3>@if(t.Student.TrainingTeam!=null){foreach(var s in t.Student.TrainingTeam.Sessions){<span class="me-3">@TeamService.DayName(s.Day) @s.StartsAt.ToString("HH:mm")–@s.EndsAt.ToString("HH:mm")</span>}}
@if(User.IsInRole(Roles.Admin)&&!t.IsCancelled){<div class="d-flex gap-3 mt-4">@if(t.Mode=="Monthly"&&!t.EndsOn.HasValue){<a asp-action="Action" asp-route-id="@t.Id" asp-route-operation="Stop" class="btn btn-outline-primary">Ndërprit pas muajit</a>}<a asp-action="Action" asp-route-id="@t.Id" asp-route-operation="Cancel" class="btn btn-outline-danger">Anulo me arsye</a></div>}</section>
<section class="panel p-4 mb-4"><h2 class="h5">Detyrimet dhe pagesat</h2><partial name="_Charges" model="t.Charges.OrderByDescending(x=>x.Period)"/>
@foreach(var p in t.Charges.SelectMany(x=>x.Payments).OrderByDescending(x=>x.Id)){<p>Arkëtimi #@p.Id · @p.Amount.ToString("N2") € @(p.IsCancelled?"· Anuluar":"") <a asp-controller="Payments" asp-action="Receipt" asp-route-id="@p.Id">Printo arkëtimin</a> @if(User.IsInRole(Roles.Admin)&&!p.IsCancelled){<a asp-controller="Payments" asp-action="CancelPayment" asp-route-id="@p.Id" class="ms-3">Anulo pagesën</a>}</p>}</section>
<section class="panel p-4"><h2 class="h5">Historiku</h2>@foreach(var h in Model.History){using var detail=System.Text.Json.JsonDocument.Parse(h.Snapshot);var record=detail.RootElement;var action=record.TryGetProperty("Action",out var actionValue)?actionValue.GetString():"Create";var actionLabel=action switch{"Waive"=>"Lirim","Restore"=>"Kthim lirimi","Stop"=>"Ndërprerje pakete","Cancel"=>"Anulim",_=>"Regjistrim"};<div class="border-bottom py-3"><small class="d-block">@actionLabel @if(record.TryGetProperty("ChargeId",out var chargeValue)){var period=t.Charges.FirstOrDefault(x=>x.Id==chargeValue.GetInt32());<span>· @period?.Description</span>}</small><strong>@h.Reason</strong>@if(record.TryGetProperty("Notes",out var noteValue)&&noteValue.ValueKind==System.Text.Json.JsonValueKind.String){<p class="mb-1">@noteValue.GetString()</p>}@if(record.TryGetProperty("EndsOn",out var endValue)&&endValue.ValueKind==System.Text.Json.JsonValueKind.String){<p class="mb-1">Përfundimi: @endValue.GetString()</p>}<small class="d-block">@h.Actor?.UserName · @TimeZoneInfo.ConvertTimeFromUtc(h.CreatedAt,BillingClock.Zone).ToString("dd.MM.yyyy HH:mm")</small></div>}</section>
@section PageNavigation {
    <a class="btn btn-outline-secondary app-back-button" asp-action="Index"><span aria-hidden="true">←</span><span>Mbrapa</span></a>
}
