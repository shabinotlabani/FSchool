@model IEnumerable<PersonalCharge>
<div class="table-responsive"><table class="table align-middle"><thead><tr><th>Lojtari / trajnimi</th><th>Periudha</th><th>Tarifa</th><th>Lirim</th><th>Arkëtuar</th><th>Borxh</th><th>Statusi / veprimet</th></tr></thead><tbody>
@foreach(var c in Model){<tr><td><a asp-controller="PersonalTraining" asp-action="Details" asp-route-id="@c.PersonalTrainingId">@c.PersonalTraining?.Name</a><small class="d-block">@c.PersonalTraining?.Student?.FullName</small></td><td>@c.Period.ToString(c.PersonalTraining?.Mode=="Monthly"?"MM.yyyy":"dd.MM.yyyy")<small class="d-block">@c.Number</small></td><td>@c.Amount.ToString("N2") €<small class="d-block">@c.Calculation</small></td><td>@c.Waived.ToString("N2") €<small class="d-block">@c.WaiverReason</small></td><td>@c.Paid.ToString("N2") €</td><td><strong>@c.Due.ToString("N2") €</strong></td><td><span class="d-block mb-2">@c.Status</span><a asp-controller="PersonalTraining" asp-action="Print" asp-route-id="@c.Id" class="me-3">Printo</a>
@if(c.Due>0&&(User.IsInRole(Roles.Admin)||User.IsInRole(Roles.Operator))){<a asp-controller="PersonalTraining" asp-action="Pay" asp-route-id="@c.Id" class="btn btn-sm btn-primary">Arkëto</a>}
@if(User.IsInRole(Roles.Admin)&&!c.IsCancelled){if(c.Paid==0&&c.Due>0){<a asp-controller="PersonalTraining" asp-action="Action" asp-route-operation="Waive" asp-route-id="@c.Id" class="d-block mt-2">Liro me arsye</a>}if(c.Waived>0){<a asp-controller="PersonalTraining" asp-action="Action" asp-route-operation="Restore" asp-route-id="@c.Id" class="d-block mt-2">Kthe lirimin</a>}}</td></tr>}
@if(!Model.Any()){<tr><td colspan="7" class="p-4 text-secondary">Nuk ka detyrime për këtë përzgjedhje.</td></tr>}
</tbody></table></div>