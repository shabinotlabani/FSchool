@model IEnumerable<PersonalCharge>
@{ var charges = Model.ToList(); var number = 0; }
<link rel="stylesheet" href="~/css/personal-training-grid.css" asp-append-version="true" />
<div class="table-responsive"><table class="table personal-grid align-middle mb-0"><thead><tr><th scope="col">Nr.</th><th scope="col">Lojtari / trajnimi</th><th scope="col">Periudha</th><th scope="col" class="personal-money">Tarifa (€)</th><th scope="col" class="personal-money">Lirim (€)</th><th scope="col" class="personal-money">Arkëtuar (€)</th><th scope="col" class="personal-money">Borxh (€)</th><th scope="col">Statusi</th><th scope="col">Veprimet</th></tr></thead><tbody>
@foreach(var c in charges){
    number++;
    <tr><td class="personal-number">@number</td><td><a asp-controller="PersonalTraining" asp-action="Details" asp-route-id="@c.PersonalTrainingId" class="personal-name">@c.PersonalTraining?.Student?.FullName</a><small>@c.PersonalTraining?.Name</small></td><td class="text-nowrap">@c.Period.ToString(c.PersonalTraining?.Mode=="Monthly"?"MM.yyyy":"dd.MM.yyyy")<small>@c.Number</small></td><td class="personal-money">@c.Amount.ToString("N2")</td><td class="personal-money">@c.Waived.ToString("N2")</td><td class="personal-money">@c.Paid.ToString("N2")</td><td class="personal-money fw-bold @(c.Due>0?"personal-debt":"")">@c.Due.ToString("N2")</td><td><span class="personal-status @(c.IsCancelled?"cancelled":c.Due<=0?"paid":c.Paid>0?"pending":"unpaid")">@c.Status</span></td><td><div class="personal-actions">
    @if(c.Due>0&&(User.IsInRole(Roles.Admin)||User.IsInRole(Roles.Operator))){<a asp-controller="PersonalTraining" asp-action="Pay" asp-route-id="@c.Id" class="btn btn-sm btn-primary">Arkëto</a>}
    <a asp-controller="PersonalTraining" asp-action="Print" asp-route-id="@c.Id" class="btn btn-sm btn-outline-secondary">Printo</a>
    @if(!string.IsNullOrWhiteSpace(c.Calculation)||!string.IsNullOrWhiteSpace(c.WaiverReason)||(User.IsInRole(Roles.Admin)&&!c.IsCancelled&&(c.Waived>0||(c.Paid==0&&c.Due>0)))){
        <details class="personal-more"><summary>Detaje</summary><div class="personal-more-content">@if(!string.IsNullOrWhiteSpace(c.Calculation)){<p>@c.Calculation</p>}@if(!string.IsNullOrWhiteSpace(c.WaiverReason)){<p>@c.WaiverReason</p>}@if(User.IsInRole(Roles.Admin)&&!c.IsCancelled){if(c.Paid==0&&c.Due>0){<a asp-controller="PersonalTraining" asp-action="Action" asp-route-operation="Waive" asp-route-id="@c.Id">Liro me arsye</a>}if(c.Waived>0){<a asp-controller="PersonalTraining" asp-action="Action" asp-route-operation="Restore" asp-route-id="@c.Id">Kthe lirimin</a>}}</div></details>
    }
    </div></td></tr>
}
@if(charges.Count==0){<tr><td colspan="9" class="personal-empty">Nuk ka detyrime për këtë përzgjedhje.</td></tr>}
</tbody>@if(charges.Count>0){<tfoot><tr><th colspan="3">GJITHSEJ</th><td class="personal-money">@charges.Sum(x=>x.Amount).ToString("N2")</td><td class="personal-money">@charges.Sum(x=>x.Waived).ToString("N2")</td><td class="personal-money">@charges.Sum(x=>x.Paid).ToString("N2")</td><td class="personal-money personal-debt">@charges.Sum(x=>x.Due).ToString("N2")</td><td colspan="2"></td></tr></tfoot>}</table></div>
