@model PersonalTrainingIndexModel
@using _2Korriku.Services
@{ ViewData["Title"] = "Trajnimet personale"; var number = 0; }
<link rel="stylesheet" href="~/css/personal-training-grid.css" asp-append-version="true" />
<div class="page-heading"><h1>Trajnimet personale</h1><div class="d-flex gap-2 flex-wrap">@if(User.IsInRole(Roles.Admin)){<a asp-action="Tariffs" class="btn btn-outline-primary">Tarifat</a>}@if(User.IsInRole(Roles.Admin)||User.IsInRole(Roles.Operator)){<a asp-action="Create" asp-route-studentId="@ViewBag.StudentId" class="btn btn-primary">+ Regjistro trajnim</a>}</div></div>
<partial name="~/Views/Payments/_BillingNotice.cshtml" />
<form method="get" class="panel personal-filters"><input name="studentId" value="@ViewBag.StudentId" type="hidden" /><div><label asp-for="Month" class="form-label">Muaji</label><input asp-for="Month" type="month" class="form-control" /></div><div class="personal-search"><label asp-for="Search" class="form-label">Kërko</label><input asp-for="Search" class="form-control" type="search" placeholder="Lojtari, telefoni ose trajnimi" /></div><label class="personal-unpaid"><input asp-for="UnpaidOnly" class="form-check-input" /> Vetëm me borxh</label><div class="d-flex gap-2"><button class="btn btn-primary">Filtro</button><a asp-action="Index" asp-route-studentId="@ViewBag.StudentId" class="btn btn-outline-secondary">Pastro</a></div></form>
<section class="panel personal-section"><div class="personal-section-heading"><div><h2>Pagesat e muajit</h2><span>@Model.Charges.Count regjistrime · @Model.Month</span></div><div class="personal-totals"><span>Arkëtuar <strong>@Model.Charges.Sum(x=>x.Paid).ToString("N2") €</strong></span><span>Borxh <strong class="personal-debt">@Model.Charges.Sum(x=>x.Due).ToString("N2") €</strong></span></div></div><partial name="_Charges" model="Model.Charges" /></section>
<section class="panel personal-section"><div class="personal-section-heading"><h2>Regjistrimet dhe oraret</h2><span>@Model.Trainings.Count trajnime</span></div><div class="table-responsive"><table class="table personal-grid align-middle mb-0"><thead><tr><th scope="col">Nr.</th><th scope="col">Lojtari / trajnimi</th><th scope="col">Lloji</th><th scope="col">Orari</th><th scope="col">Trajneri / vendi</th><th scope="col" class="personal-money">Tarifa (€)</th><th scope="col">Statusi</th><th scope="col">Veprimi</th></tr></thead><tbody>
@foreach(var t in Model.Trainings){
    number++;
    var ended = t.EndsOn.HasValue && t.EndsOn.Value < BillingClock.Today;
    var upcoming = t.StartsOn > BillingClock.Today;
    var state = t.IsCancelled ? "Anuluar" : ended ? "Përfunduar" : upcoming ? "Në pritje" : "Aktiv";
    <tr><td class="personal-number">@number</td><td><a asp-action="Details" asp-route-id="@t.Id" class="personal-name">@t.Student?.FullName</a><small>@t.Name</small></td><td>@t.ModeLabel</td><td class="personal-schedule">@foreach(var slot in t.Sessions.OrderBy(x=>x.Day).ThenBy(x=>x.StartsAt)){<div><span>@(t.Mode=="Monthly"?TeamService.DayName(slot.Day):t.StartsOn.ToString("dd.MM.yyyy"))</span> <strong>@slot.StartsAt.ToString("HH:mm")–@slot.EndsAt.ToString("HH:mm")</strong></div>}@if(t.Sessions.Count==0){<span>—</span>}</td><td>@(string.IsNullOrWhiteSpace(t.Coach)?"—":t.Coach)<small>@(string.IsNullOrWhiteSpace(t.Location)?"—":t.Location)</small></td><td class="personal-money fw-semibold">@t.Rate.ToString("N2")</td><td><span class="personal-status @(t.IsCancelled?"cancelled":ended?"neutral":upcoming?"pending":"paid")">@state</span>@if(t.EndsOn.HasValue){<small>Deri më @t.EndsOn.Value.ToString("dd.MM.yyyy")</small>}</td><td><a asp-action="Details" asp-route-id="@t.Id" class="btn btn-sm btn-outline-primary">Detajet</a></td></tr>
}
@if(Model.Trainings.Count==0){<tr><td colspan="8" class="personal-empty">Nuk ka trajnime për këtë përzgjedhje.</td></tr>}
</tbody></table></div></section>
