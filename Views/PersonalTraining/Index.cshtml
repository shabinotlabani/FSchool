@model PersonalTrainingIndexModel
@{ViewData["Title"]="Trajnimet personale";}
<div class="page-heading"><div><p class="eyebrow">ZHVILLIM INDIVIDUAL</p><h1>Trajnimet personale</h1></div><div class="d-flex gap-2">@if(User.IsInRole(Roles.Admin)){<a asp-action="Tariffs" class="btn btn-outline-primary">Menaxho tarifat</a>}@if(User.IsInRole(Roles.Admin)||User.IsInRole(Roles.Operator)){<a asp-action="Create" asp-route-studentId="@ViewBag.StudentId" class="btn btn-primary">+ Regjistro trajnim</a>}</div></div>
<partial name="~/Views/Payments/_BillingNotice.cshtml"/>
<form method="get" class="panel p-3 mb-4 d-flex gap-3 align-items-end flex-wrap"><input name="studentId" value="@ViewBag.StudentId" type="hidden"/><div><label asp-for="Month">Muaji</label><input asp-for="Month" type="month" class="form-control"/></div><div class="flex-grow-1"><label asp-for="Search">Lojtari, telefoni ose trajnimi</label><input asp-for="Search" class="form-control" type="search"/></div><label class="pb-2"><input asp-for="UnpaidOnly"/> Vetëm pa paguar / pjesërisht</label><button class="btn btn-primary">Filtro</button></form>
<section class="panel p-4 mb-4"><div class="d-flex justify-content-between"><h2 class="h5">Pagesat e muajit</h2><strong>Borxh: @Model.Charges.Sum(x=>x.Due).ToString("N2") €</strong></div><partial name="_Charges" model="Model.Charges"/></section>
<section class="panel p-4"><h2 class="h5">Regjistrimet dhe oraret</h2><div class="row g-3">
@foreach(var t in Model.Trainings){<div class="col-lg-6"><article class="border rounded p-3 h-100"><small class="text-secondary">@t.ModeLabel · @(t.IsCancelled?"Anuluar":t.EndsOn.HasValue?"Deri më "+t.EndsOn.Value.ToString("dd.MM.yyyy"):"Regjistruar")</small><h3 class="h5 mt-2"><a asp-action="Details" asp-route-id="@t.Id">@t.Student!.FullName · @t.Name</a></h3><p>@t.Schedule</p><div class="d-flex justify-content-between"><span>@t.Coach · @t.Location</span><strong>@t.Rate.ToString("N2") €</strong></div></article></div>}
@if(Model.Trainings.Count==0){<p>Ende nuk ka trajnime personale. Shtoni tarifat dhe regjistroni lojtarin.</p>}
</div></section>