@model LeagueReportModel
@using _2Korriku.Services
@{ViewData["Title"]="Raporti i garës";var done=Model.Matches.Where(x=>x.Status=="Completed").ToList();var upcoming=Model.Matches.Where(x=>x.Status is "Draft" or "Live"&&x.Date>=BillingClock.Today).OrderBy(x=>x.Date).Take(8).ToList();var goals=done.Sum(x=>x.ScoreFor??0);var conceded=done.Sum(x=>x.ScoreAgainst??0);var cards=done.Sum(x=>x.Events.Count(e=>FootballLabels.Card(e)));}
<link rel="stylesheet" href="~/css/league-report.css" asp-append-version="true"/>
<div class="league-report">
<header class="league-report-head"><div><span>@Model.League.Organizer · @Model.League.Season</span><h1>@Model.League.Name</h1><p>@Model.League.AgeCategory · @(Model.League.Gender=="Female"?"Femra":Model.League.Gender=="Mixed"?"Përzier":"Meshkuj") · @Model.League.StartsOn.ToString("dd/MM/yyyy") – @Model.League.EndsOn.ToString("dd/MM/yyyy")</p></div><button type="button" class="btn btn-outline-primary no-print" onclick="window.print()">Printo raportin</button></header>
<section class="league-kpis" aria-label="Përmbledhja"><article><span>Ekipe të klubit</span><strong>@Model.Teams.Count</strong></article><article><span>Ndeshje</span><strong>@done.Count <small>/ @Model.Matches.Count</small></strong></article><article><span>Gola</span><strong>@goals <small>– @conceded</small></strong></article><article><span>Kartonë</span><strong>@cards</strong></article></section>
<section class="league-panel"><header><div><span>BILANCI</span><h2>Ekipet në këtë garë</h2></div></header><div class="table-responsive"><table class="table league-table"><thead><tr><th>Ekipi</th><th>N</th><th>F</th><th>B</th><th>H</th><th>GF</th><th>GK</th><th>Minuta</th></tr></thead><tbody>@foreach(var row in Model.Teams){<tr><th><a asp-controller="Teams" asp-action="Details" asp-route-id="@row.TeamId">@row.Team</a><small>@row.Played / @row.Scheduled të luajtura</small></th><td>@row.Played</td><td class="stat-win">@row.Wins</td><td>@row.Draws</td><td>@row.Losses</td><td>@row.GoalsFor</td><td>@row.GoalsAgainst</td><td>@row.Minutes</td></tr>}@if(Model.Teams.Count==0){<tr><td colspan="8">Nuk ka ekip të regjistruar.</td></tr>}</tbody></table></div></section>
<div class="league-report-grid"><section class="league-panel"><header><div><span>ORARI</span><h2>Ndeshjet e ardhshme</h2></div></header><div class="league-fixtures">@foreach(var game in upcoming){<a asp-controller="AdminMatches" asp-action="Edit" asp-route-id="@game.Id"><time>@game.Date.ToString("dd/MM")<small>@(game.Kickoff?.ToString("HH:mm")??"—")</small></time><span><strong>@(game.Home?game.TrainingTeam.Name:game.Opponent) — @(game.Home?game.Opponent:game.TrainingTeam.Name)</strong><small>@game.TrainingTeam.Name · @MatchLabels.Status(game.Status)</small></span></a>}@if(upcoming.Count==0){<p class="league-empty">Nuk ka ndeshje të ardhshme.</p>}</div></section>
<section class="league-panel"><header><div><span>FORMA</span><h2>Rezultatet e fundit</h2></div></header><div class="league-fixtures">@foreach(var game in done.OrderByDescending(x=>x.Date).Take(8)){<a asp-controller="AdminMatches" asp-action="Edit" asp-route-id="@game.Id"><time>@game.Date.ToString("dd/MM")<small>@game.TrainingTeam.Name</small></time><span><strong>@(game.Home?game.TrainingTeam.Name:game.Opponent) <b>@(game.Home?game.ScoreFor:game.ScoreAgainst)–@(game.Home?game.ScoreAgainst:game.ScoreFor)</b> @(game.Home?game.Opponent:game.TrainingTeam.Name)</strong><small>@(game.ScoreFor>game.ScoreAgainst?"Fitore":game.ScoreFor==game.ScoreAgainst?"Barazim":"Humbje")</small></span></a>}@if(done.Count==0){<p class="league-empty">Nuk ka rezultate të regjistruara.</p>}</div></section></div>
<section class="league-panel"><header><div><span>LOJTARËT</span><h2>Statistikat në garë</h2></div><small>Vetëm ndeshjet e përfunduara</small></header><div class="table-responsive"><table class="table league-table player-league-table"><thead><tr><th>Lojtari</th><th>Ndeshje</th><th>Titullar</th><th>Minuta</th><th>Gola</th><th>Asiste</th><th>V</th><th>K</th></tr></thead><tbody>@foreach(var row in Model.Players){<tr><th>@row.Name<small>@row.Team</small></th><td>@row.Appearances</td><td>@row.Starts</td><td><strong>@row.Minutes</strong></td><td>@row.Goals</td><td>@row.Assists</td><td>@row.YellowCards</td><td>@row.RedCards</td></tr>}@if(Model.Players.Count==0){<tr><td colspan="8">Nuk ka statistika të regjistruara.</td></tr>}</tbody></table></div></section>
</div>
@section PageNavigation {<a class="btn btn-outline-secondary" asp-action="Index">← Garat dhe ligat</a>}
