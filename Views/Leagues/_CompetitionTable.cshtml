@model List<League>
<div class="panel table-responsive" tabindex="0" role="region" aria-label="Garat"><table class="table competition-table"><thead><tr><th>Gara</th><th>Sezoni</th><th>Kategoria</th><th>Faza</th><th>Pjesëmarrjet</th><th>Statusi</th><th></th></tr></thead><tbody>
@foreach(var league in Model){<tr><td><strong>@league.Name</strong><small class="d-block text-secondary">@league.Organizer · @(league.CompetitionScope=="International"?"Ndërkombëtare":league.CompetitionScope=="Regional"?"Rajonale":"Vendore") · @league.CompetitionType</small></td><td><strong>@league.Season</strong><small class="d-block text-secondary">@league.StartsOn.ToString("dd/MM/yyyy") – @league.EndsOn.ToString("dd/MM/yyyy")</small></td><td>@league.AgeCategory · @(league.Gender=="Female"?"Femra":league.Gender=="Mixed"?"Përzier":"Meshkuj")@if(!string.IsNullOrWhiteSpace(league.Division)){<small class="d-block">@league.Division</small>}</td><td>@league.Stage@if(!string.IsNullOrWhiteSpace(league.Group)){<small class="d-block">@league.Group</small>}</td><td>@foreach(var team in league.Teams){<span class="competition-team-row"><a asp-controller="Teams" asp-action="Details" asp-route-id="@team.TrainingTeamId">@team.TrainingTeam.Name <small>· @team.Status</small></a><a class="competition-squad-link" asp-action="Squad" asp-route-id="@league.Id" asp-route-teamId="@team.TrainingTeamId">Lista</a></span>}@if(league.Teams.Count==0){<span class="text-secondary">Pa ekip të regjistruar</span>}</td><td><span class="competition-status @(league.IsActive?"active":"")">@(league.IsActive?"Aktive":"Arkivuar")</span></td><td><a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@league.Id">Ndrysho</a></td></tr>}
@if(Model.Count==0){<tr><td colspan="7" class="p-4 text-secondary">Nuk u gjet asnjë garë.</td></tr>}
</tbody></table></div>
