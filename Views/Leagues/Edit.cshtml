@model LeagueInput
@{ViewData["Title"]=Model.Id==0?"Ligë e re":Model.Name;}
<link rel="stylesheet" href="~/css/teams.css" asp-append-version="true"/>
<div class="team-workspace league-editor"><div class="page-heading"><h1>@ViewData["Title"]</h1></div>
<form method="post"><input asp-for="Id" type="hidden"/><input asp-for="Revision" type="hidden"/>
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<div class="league-fields">
<label>Emri i ligës<input asp-for="Name" class="form-control" required maxlength="150"/></label>
<input asp-for="Kind" type="hidden"/>
<label>Fillimi i sezonit<input asp-for="StartsOn" type="date" class="form-control" required/></label><label>Fundi i sezonit<input asp-for="EndsOn" type="date" class="form-control" required/></label>
</div>
<h2 class="h5 mt-4">Ekipet pjesëmarrëse</h2>
<div class="table-responsive league-teams"><table class="table"><thead><tr><th>Zgjidh</th><th>Ekipi</th><th>Grupmosha</th></tr></thead><tbody>
@foreach(var team in Model.Teams){<tr><td><input id="team-@team.Id" type="checkbox" name="TeamIds" value="@team.Id" checked="@Model.TeamIds.Contains(team.Id)"/></td><td><label for="team-@team.Id">@team.Name</label></td><td>@team.MinAge–@team.MaxAge</td></tr>}
</tbody></table></div>
<h2 class="h5 mt-4">Rregullat e kartonëve</h2>
<p class="text-secondary small">Sipas rregullores së ligës. Vendimi disiplinor mund të shënohet te ndeshja.</p>
<div class="league-fields">
<label>Pragu i të verdhëve<input asp-for="YellowThreshold" type="number" min="1" max="20" class="form-control"/></label>
<label>Pezullim nga të verdhët (ndeshje)<input asp-for="YellowBan" type="number" min="1" max="20" class="form-control"/></label>
<label>I kuq direkt (ndeshje)<input asp-for="RedBan" type="number" min="0" max="20" class="form-control"/></label>
<label>Dy të verdhë (ndeshje)<input asp-for="SecondYellowBan" type="number" min="0" max="20" class="form-control"/></label>
</div>
<label class="league-check"><input asp-for="CountDismissalYellows"/> Numëro në total edhe të verdhët që sollën përjashtimin</label>
<label class="league-check"><input asp-for="RulesConfirmed"/> Rregullat janë konfirmuar sipas ligës</label>
<label class="league-check"><input asp-for="IsActive"/> Liga aktive</label>
<div class="mt-4"><button class="btn btn-primary">Ruaj ligën</button></div>
</form></div>
@section PageNavigation {<a class="btn btn-outline-secondary" asp-action="Index">← Ligat</a>}
