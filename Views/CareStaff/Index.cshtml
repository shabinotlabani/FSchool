@model List<CareStaffRow>
@{ViewData["Title"]="Stafi shëndetësor";}
@if(ViewData["PendingRouting"] is List<CareRoutingRow> pending&&pending.Count>0){<details open><summary>Në pritje të caktimit · @pending.Count</summary><table class="table"><thead><tr><th>Lojtari</th><th>Nevojitet</th></tr></thead><tbody>@foreach(var r in pending){<tr><td>@r.Name</td><td>@r.Kind</td></tr>}</tbody></table></details>}
<div class="page-heading"><h1>Stafi shëndetësor</h1><div class="d-flex gap-2"><a asp-controller="Users" asp-action="Create" asp-route-role="@Roles.Doctor" class="btn btn-outline-primary">+ Mjek</a><a asp-controller="Users" asp-action="Create" asp-route-role="@Roles.Nutritionist" class="btn btn-outline-primary">+ Nutricist</a></div></div>
@if(TempData["Success"] is string message){<p class="alert alert-success">@message</p>}
<div class="table-responsive"><table class="table"><thead><tr><th>Emri</th><th>Roli</th><th>Lojtarë</th><th>Email</th><th></th></tr></thead><tbody>@foreach(var row in Model){var p=row.User;<tr><td>@p.FirstName @p.LastName</td><td>@row.Kind</td><td>@row.Players</td><td>@p.Email</td><td>@if(!_2Korriku.Services.UserAdministrationService.IsDisabled(p)){<a asp-action="Assign" asp-route-id="@p.Id">Cakto lojtarët</a>} <a asp-controller="Users" asp-action="Edit" asp-route-id="@p.Id">Llogaria</a></td></tr>}@if(Model.Count==0){<tr><td colspan="5">Ende pa mjek ose nutricist.</td></tr>}</tbody></table></div>
