@model SponsorshipSpend
@{ViewData["Title"]="Fatura "+Model.DocumentReference;}
<partial name="_Intro"/>
<div class="page-heading mt-3"><div><p class="eyebrow">SPONSORIZIMET · SP-@Model.Id</p><h1>Fatura @Model.DocumentReference</h1></div><div class="sp-actions sp-no-print"><button type="button" class="btn btn-outline-primary" id="print-sponsorship">Printo</button>@if(Model.CancelledAt==null){<a asp-action="Cancel" asp-route-id="@Model.Id" asp-route-kind="Spend" class="btn btn-outline-danger">Anulo me arsye</a>}</div></div>
<section class="panel sp-invoice-receipt"><div class="sp-receipt-heading"><div><span>@Model.Date.ToString("dd/MM/yyyy")</span><h2>@Model.Beneficiary.Name</h2><span>@Model.Beneficiary.Identifier</span></div><strong>@Model.Amount.ToString("N2")</strong></div><p class="mt-4">@Model.Description</p><dl class="sp-meta mt-4"><dt>Kategoria</dt><dd>@Model.Allocation.PlanLine.Category</dd><dt>Sponsori</dt><dd><a asp-action="Details" asp-route-id="@Model.Allocation.ContractId">@Model.Allocation.Contract.Sponsor</a></dd><dt>Kontrata</dt><dd>@Model.Allocation.Contract.Reference</dd><dt>Referenca bankare</dt><dd>@Model.BankReference</dd>@if(Model.SalaryMonth.HasValue){<dt>Lloji i pagës</dt><dd>@(Model.SalaryRole=="Player"?"Lojtar":Model.SalaryRole=="Staff"?"Staf":"Pa klasifikim")</dd><dt>Muaji i pagës</dt><dd>@Model.SalaryMonth.Value.ToString("MM.yyyy")</dd>}<dt>Statusi</dt><dd>@(Model.CancelledAt==null?"E paguar":"E anuluar")</dd></dl>@if(Model.CancelledAt.HasValue){<p class="text-danger">@_2Korriku.Services.BillingClock.LocalDate(Model.CancelledAt.Value).ToString("dd/MM/yyyy") · @Model.CancellationReason</p>}</section>
@section PageNavigation {<a asp-action="Invoices" asp-route-year="@Model.Date.Year" class="btn btn-outline-secondary">Mbrapa te faturat</a>}
@section Scripts {<script src="~/js/sponsorships.js" asp-append-version="true"></script>}
