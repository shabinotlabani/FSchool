@model SponsorshipSpendInput
@{ViewData["Title"]="Pagesë nga sponsorizimi";}
<partial name="_Intro"/>
<div class="page-heading mt-3"><div><p class="eyebrow">@Model.Contract!.Sponsor · @Model.Contract.Reference</p><h1>Regjistro pagesën</h1><p>@Model.Contract.From.ToString("dd.MM.yyyy") – @Model.Contract.To.ToString("dd.MM.yyyy") · Pagesë përmes bankës</p></div></div>
<form asp-action="Spend" method="post" class="panel p-4 sp-form" data-financial-confirm><input asp-for="RequestId" type="hidden"/><input asp-for="ContractId" type="hidden"/><div asp-validation-summary="All" class="text-danger" role="alert"></div>
<div class="row g-3"><div class="col-12"><label asp-for="AllocationId">Kategoria e lejuar</label><select asp-for="AllocationId" class="form-select" required id="sponsor-allocation"><option value="">Zgjidhni kategorinë</option>@foreach(var a in Model.Contract.Allocations.OrderBy(x=>x.PlanLine.Category)){<option value="@a.Id" data-salary="@(a.PlanLine.IsSalary?"true":"false")">@a.PlanLine.Category · buxheti @a.Amount.ToString("N2")</option>}</select></div>
<div class="col-12"><label asp-for="BeneficiaryId">Përfituesi</label><select asp-for="BeneficiaryId" class="form-select" required><option value="">Zgjidhni personin ose biznesin</option>@foreach(var b in Model.Beneficiaries){<option value="@b.Id">@b.Name · @b.Identifier</option>}</select><a asp-action="Beneficiaries" asp-route-contractId="@Model.ContractId" class="d-inline-block mt-2">+ Regjistro përfitues të ri</a></div>
<div class="col-md-6" id="salary-month-field"><label asp-for="SalaryMonth">Muaji i pagës (vetëm për paga)</label><input asp-for="SalaryMonth" type="month" class="form-control"/><label asp-for="SalaryRole" class="mt-2">Lloji i pagës</label><select asp-for="SalaryRole" class="form-select"><option value="">Zgjidhni</option><option value="Player">Lojtar</option><option value="Staff">Staf</option></select></div><div class="col-md-6"><label asp-for="InvoiceDate">Data e faturës</label><input asp-for="InvoiceDate" type="date" class="form-control mb-3"/><label asp-for="Date">Data e pagesës</label><input asp-for="Date" type="date" class="form-control" required/></div><div class="col-md-6"><label asp-for="Amount">Shuma</label><input asp-for="Amount" type="number" step="0.01" min="0.01" class="form-control" required/></div><div class="col-12"><label asp-for="Description">Përshkrimi / qëllimi i shpenzimit</label><textarea asp-for="Description" class="form-control" rows="2" maxlength="500" required></textarea></div><div class="col-md-6"><label asp-for="DocumentReference">Numri i faturës / listës së pagës</label><input asp-for="DocumentReference" class="form-control" required maxlength="100"/></div><div class="col-md-6"><label asp-for="BankReference">Referenca e pagesës bankare</label><input asp-for="BankReference" class="form-control" required maxlength="100"/></div></div>
<button class="btn btn-primary mt-3">Regjistro pagesën</button></form>
@section PageNavigation {<a asp-action="Details" asp-route-id="@Model.ContractId" class="btn btn-outline-secondary">Mbrapa te kontrata</a>}
@section Scripts {<script src="~/js/sponsorships.js" asp-append-version="true"></script>}
