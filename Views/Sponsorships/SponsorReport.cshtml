@model SponsorshipSponsorReport
@{ViewData["Title"]="Raporti i sponsorit";}
<partial name="_Intro"/>
<section class="sp-report">
<header class="sp-report-heading"><h1>Raporti i sponsorit</h1>@if(Model.Report!=null){<button type="button" class="btn btn-sm btn-outline-secondary sp-no-print" id="print-sponsorship">Printo / PDF</button>}</header>
<form method="get" class="sp-sponsor-filter sp-no-print"><label for="sponsor-report-id">Sponsori / kontrata</label><select id="sponsor-report-id" name="id" class="form-select form-select-sm" required><option value="">Zgjidhni</option>@foreach(var contract in Model.Contracts){<option value="@contract.Id" selected="@(contract.Id==Model.Id)">@contract.Sponsor · @contract.Reference · @contract.Plan.Year</option>}</select><button class="btn btn-sm btn-outline-primary">Shfaq</button></form>
@if(Model.Report is {} report){
var c=report.Contract;
<div class="sp-sponsor-report-heading"><h2>@c.Sponsor</h2><p>@c.SponsorNumber · @c.Reference</p><p>@c.From.ToString("dd.MM.yyyy") – @c.To.ToString("dd.MM.yyyy")</p></div>
<div class="sp-table-wrap" tabindex="0" role="region" aria-label="Përmbledhja"><table class="table sp-table sp-report-table"><thead><tr><th scope="col" class="sp-number">Kontraktuar</th><th scope="col" class="sp-number">Pranuar</th><th scope="col" class="sp-number">Pa pranuar</th><th scope="col" class="sp-number">Shpenzuar</th><th scope="col" class="sp-number">Gjendja bankare</th></tr></thead><tbody><tr><td class="sp-number">@c.Amount.ToString("N2")</td><td class="sp-number">@report.Received.ToString("N2")</td><td class="sp-number">@((c.Amount-report.Received).ToString("N2"))</td><td class="sp-number">@report.Used.ToString("N2")</td><td class="sp-number"><strong>@((report.Received-report.Used).ToString("N2"))</strong></td></tr></tbody></table></div>
<h2 class="sp-report-group">Buxheti sipas kategorive</h2>
<div class="sp-table-wrap" tabindex="0" role="region" aria-label="Buxhetet"><table class="table sp-table sp-report-table"><thead><tr><th scope="col">Kategoria</th><th scope="col" class="sp-number">Kontraktuar</th><th scope="col" class="sp-number">Shpenzuar</th><th scope="col" class="sp-number">Buxheti i mbetur</th></tr></thead><tbody>
@foreach(var a in c.Allocations.OrderBy(x=>x.PlanLineId)){var spent=report.Spending.Where(x=>x.AllocationId==a.Id).Sum(x=>x.Amount);<tr><th scope="row">@a.PlanLine.Category</th><td class="sp-number">@a.Amount.ToString("N2")</td><td class="sp-number">@spent.ToString("N2")</td><td class="sp-number">@((a.Amount-spent).ToString("N2"))</td></tr>}
</tbody><tfoot><tr><th scope="row">Gjithsej</th><td class="sp-number">@c.Amount.ToString("N2")</td><td class="sp-number">@report.Used.ToString("N2")</td><td class="sp-number">@((c.Amount-report.Used).ToString("N2"))</td></tr></tfoot></table></div>
@foreach(var group in new[]{"Expenses","Player","Staff","Unclassified"}){
var rows=report.Spending.Where(x=>group=="Expenses"?!x.SalaryMonth.HasValue:x.SalaryMonth.HasValue&&(group=="Unclassified"?x.SalaryRole==null:x.SalaryRole==group)).ToList();
if(rows.Count==0){continue;}
var title=group=="Expenses"?"Faturat":group=="Player"?"Pagat · Lojtarë":group=="Staff"?"Pagat · Staf":"Pagat · Pa klasifikim";
<h2 class="sp-report-group">@title</h2>
<div class="sp-table-wrap" tabindex="0" role="region" aria-label="@title"><table class="table sp-table sp-report-table"><thead><tr><th scope="col">Data</th><th scope="col">Përfituesi</th><th scope="col">Fatura</th><th scope="col">Kategoria / përshkrimi</th><th scope="col">Referenca bankare</th><th scope="col" class="sp-number">Shuma</th></tr></thead><tbody>
@foreach(var row in rows){<tr><td class="sp-nowrap">@row.Date.ToString("dd.MM.yyyy")</td><td>@row.Beneficiary.Name@if(row.SalaryMonth.HasValue){<small class="d-block">@row.SalaryMonth.Value.ToString("MM.yyyy")</small>}</td><td><a asp-action="InvoiceDetails" asp-route-id="@row.Id">@row.DocumentReference</a></td><td>@row.Allocation.PlanLine.Category<small class="d-block">@row.Description</small></td><td>@row.BankReference</td><td class="sp-number">@row.Amount.ToString("N2")</td></tr>}
</tbody><tfoot><tr><th colspan="5" scope="row">Gjithsej</th><td class="sp-number">@rows.Sum(x=>x.Amount).ToString("N2")</td></tr></tfoot></table></div>
}
@if(report.Spending.Count==0){<p class="sp-sponsor-empty">Nuk ka shpenzime të regjistruara.</p>}
<h2 class="sp-report-group">Pranimet në bankë</h2>
<div class="sp-table-wrap" tabindex="0" role="region" aria-label="Pranimet"><table class="table sp-table sp-report-table"><thead><tr><th scope="col">Data</th><th scope="col">Referenca bankare</th><th scope="col" class="sp-number">Shuma</th></tr></thead><tbody>
@foreach(var receipt in report.Receipts){<tr><td>@receipt.Date.ToString("dd.MM.yyyy")</td><td>@receipt.BankReference</td><td class="sp-number">@receipt.Amount.ToString("N2")</td></tr>}
@if(report.Receipts.Count==0){<tr><td colspan="3">Nuk ka pranime.</td></tr>}
</tbody><tfoot><tr><th colspan="2" scope="row">Gjithsej</th><td class="sp-number">@report.Received.ToString("N2")</td></tr></tfoot></table></div>
<p class="sp-sponsor-stamp">Gjendja më @_2Korriku.Services.BillingClock.Today.ToString("dd.MM.yyyy")</p>
}else{<p class="sp-sponsor-empty">@(Model.Contracts.Count==0?"Nuk ka kontrata të regjistruara.":"Zgjidhni sponsorin dhe kontratën.")</p>}
</section>
@section Scripts {<script src="~/js/sponsorships.js" asp-append-version="true"></script>}
