@{ var club = await Club.Get(); }
@model SponsorshipSponsorReport
@{ViewData["Title"]="Raporti i sponsorit";}
<partial name="_Intro"/>
<link rel="stylesheet" href="~/css/sponsor-official-report.css" asp-append-version="true"/>
<section class="sp-report official-report-page">
<header class="sp-report-heading sp-no-print"><h1>Raporti i sponsorit</h1>@if(Model.Report!=null){<button type="button" class="btn btn-sm btn-outline-secondary" id="print-sponsorship">Printo / PDF</button>}</header>
<form method="get" class="sp-sponsor-filter sp-no-print"><label for="sponsor-report-id">Sponsori / kontrata</label><select id="sponsor-report-id" name="id" class="form-select form-select-sm" required><option value="">Zgjidhni</option>@foreach(var contract in Model.Contracts){<option value="@contract.Id" selected="@(contract.Id==Model.Id)">@contract.Sponsor · @contract.Reference · @contract.Plan.Year</option>}</select><button class="btn btn-sm btn-outline-primary">Shfaq</button></form>
@if(Model.Report is {} report){
var c=report.Contract;var number=0;
@if(string.IsNullOrWhiteSpace(c.CertificateNumber)||c.CertificateDate==null){<p class="sp-no-print official-missing">Vërtetimi është i paplotësuar. <a asp-action="Contract" asp-route-id="@c.Id">Plotëso vërtetimin</a></p>}
<article class="official-report">
<h2>RAPORT FINANCIAR I SHPENZIMEVE</h2>
<div class="official-meta">
<p><strong>Vërtetimi nr.</strong> @(c.CertificateNumber??"________________"); <strong>Data:</strong> @(c.CertificateDate?.ToString("dd.MM.yyyy")??"________________")</p>
<p><strong>Sponsorizuesi:</strong> @c.Sponsor, NUI @c.SponsorNumber</p>
<p><strong>Shuma e sponsorizuar:</strong> @c.Amount.ToString("N2")</p>
<p><strong>Përfituesi i Sponsorizimit:</strong> @club.LegalName@(string.IsNullOrWhiteSpace(club.RegistrationNumber) ? "" : ", " + club.RegistrationNumber)</p>
</div>
<div class="official-scroll" tabindex="0" role="region" aria-label="Raporti financiar i shpenzimeve">
<table class="official-table">
<colgroup><col style="width:5%"/><col style="width:31%"/><col style="width:20%"/><col style="width:18%"/><col style="width:12%"/><col style="width:14%"/></colgroup>
<thead><tr><th scope="col">NR.</th><th scope="col">Përshkrimi i shpenzimit<br/><span>(Faturat, kontratat, transaksionet bankare të specifikuara për secilin vërtetim)</span></th><th scope="col">Furnitori</th><th scope="col">Nr. i faturës/kontratës</th><th scope="col">Data e faturës</th><th scope="col">Shuma e shpenzuar</th></tr></thead>
<tbody>
@foreach(var row in report.Spending){
number++;
<tr><td class="official-center">@number</td><td>@row.Allocation.PlanLine.Category
@if(row.SalaryMonth.HasValue){<span class="official-detail">@(row.SalaryRole=="Player"?"Paga të lojtarëve":row.SalaryRole=="Staff"?"Paga të stafit":"Paga") · @row.SalaryMonth.Value.ToString("MM.yyyy")</span>}
@if(!string.IsNullOrWhiteSpace(row.Description)&&row.Description!=row.Allocation.PlanLine.Category){<span class="official-detail">@row.Description</span>}
@if(!string.IsNullOrWhiteSpace(row.BankReference)){<span class="official-detail">Transaksioni bankar: @row.BankReference</span>}</td>
<td>@row.Beneficiary.Name</td><td><a asp-action="InvoiceDetails" asp-route-id="@row.Id">@row.DocumentReference</a></td><td class="official-center">@(row.InvoiceDate?.ToString("dd.MM.yyyy")??"")</td><td class="official-amount">@row.Amount.ToString("N2")</td></tr>
}
@if(report.Spending.Count==0){<tr><td colspan="6">Nuk ka shpenzime të regjistruara.</td></tr>}
<tr class="official-total"><td></td><th scope="row">TOTALI</th><td></td><td></td><td></td><td class="official-amount">@report.Used.ToString("N2")</td></tr>
</tbody></table></div>
<p class="official-note">Raporti financiar duhet të përmbajë informatat e detajuara: faturat, kontratat, transaksionet bankare, të specifikuara për secilin vërtetim.</p>
<div class="official-signature"><p>Përfituesi i sponsorizimit:</p><div class="official-signature-line"></div><p>(Nënshkrimi dhe vula)</p></div>
</article>
}else{<p class="sp-sponsor-empty">@(Model.Contracts.Count==0?"Nuk ka kontrata të regjistruara.":"Zgjidhni sponsorin dhe kontratën.")</p>}
</section>
@section Scripts {<script src="~/js/sponsorships.js" asp-append-version="true"></script>}
