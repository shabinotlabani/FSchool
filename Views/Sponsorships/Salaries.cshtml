@model SponsorshipInvoiceList
@{ViewData["Title"]="Raporti i pagave";}
<partial name="_Intro"/>
<section class="sp-report sp-salary-report">
<header class="sp-report-heading"><h1>Pagat <span>@Model.Year</span></h1><button type="button" id="print-sponsorship" class="btn btn-sm btn-outline-secondary sp-no-print">Printo</button></header>
<form method="get" class="sp-year sp-report-filter sp-no-print"><label for="year">Viti</label><select id="year" name="year" class="form-select form-select-sm">@foreach(var y in Model.Years.Append(Model.Year).Distinct().OrderDescending()){<option value="@y" selected="@(y==Model.Year)">@y</option>}</select><button class="btn btn-sm btn-outline-primary">Shfaq</button></form>
@{
    var months=new[]{"Janar","Shkurt","Mars","Prill","Maj","Qershor","Korrik","Gusht","Shtator","Tetor","Nëntor","Dhjetor"};
    var people=Model.Invoices.GroupBy(x=>x.BeneficiaryId).Select(g=>new{
        Person=g.First().Beneficiary,
        Role=g.OrderByDescending(x=>x.SalaryMonth).ThenByDescending(x=>x.Id).First().SalaryRole??"",
        Payments=g.ToList()
    }).OrderBy(x=>x.Person.Name).ToList();
}
<div class="sp-table-wrap sp-salary-scroll" tabindex="0" role="region" aria-label="Pagat mujore"><table class="table sp-table sp-report-table sp-salary-grid">
<colgroup><col class="sp-salary-name-col"/>@for(var month=1;month<=12;month++){<col class="sp-salary-month-col"/>}<col class="sp-salary-total-col"/></colgroup>
<thead><tr><th scope="col" class="sp-salary-person">Emri</th>@foreach(var month in months){<th scope="col" class="sp-salary-month">@month</th>}<th scope="col" class="sp-salary-month">Vjetore</th></tr></thead>
@foreach(var role in new[]{"Player","Staff",""}){
var rows=people.Where(x=>x.Role==role).ToList();
if(rows.Count==0){continue;}
var title=role=="Player"?"Lojtarë":role=="Staff"?"Staf":"Pa klasifikim";
<tbody>
<tr class="sp-salary-group"><th scope="rowgroup" colspan="14">@title</th></tr>
@foreach(var row in rows){
<tr><th scope="row" class="sp-salary-person">@row.Person.Name</th>
@for(var month=1;month<=12;month++){
var payment=row.Payments.SingleOrDefault(x=>x.SalaryMonth!.Value.Month==month);
<td class="sp-salary-month @(payment==null?"sp-salary-unpaid":"sp-salary-paid")">
@if(payment!=null){<a asp-action="InvoiceDetails" asp-route-id="@payment.Id" title="@payment.DocumentReference"><strong>@payment.Amount.ToString("N2")</strong><span>@payment.Allocation.Contract.Sponsor</span></a>}
else{<span aria-label="Pa pagesë" title="Pa pagesë">—</span>}
</td>
}
<td class="sp-salary-month sp-salary-annual">@row.Payments.Sum(x=>x.Amount).ToString("N2")</td></tr>
}
<tr class="sp-salary-subtotal"><th scope="row" class="sp-salary-person">Totali @title.ToLower()</th>@for(var month=1;month<=12;month++){<td class="sp-salary-month">@rows.SelectMany(x=>x.Payments).Where(x=>x.SalaryMonth!.Value.Month==month).Sum(x=>x.Amount).ToString("N2")</td>}<td class="sp-salary-month">@rows.SelectMany(x=>x.Payments).Sum(x=>x.Amount).ToString("N2")</td></tr>
</tbody>
}
@if(people.Count==0){<tbody><tr><td colspan="14">Nuk ka paga të regjistruara.</td></tr></tbody>}
<tfoot><tr><th scope="row" class="sp-salary-person">Gjithsej</th>@for(var month=1;month<=12;month++){<td class="sp-salary-month">@Model.Invoices.Where(x=>x.SalaryMonth!.Value.Month==month).Sum(x=>x.Amount).ToString("N2")</td>}<td class="sp-salary-month">@Model.Invoices.Sum(x=>x.Amount).ToString("N2")</td></tr></tfoot>
</table></div>
</section>
@section Scripts {<script src="~/js/sponsorships.js" asp-append-version="true"></script>}
