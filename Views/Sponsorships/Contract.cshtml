@model SponsorshipContractInput
@{ViewData["Title"]="Kontratë sponsorizimi";}
<partial name="_Intro"/>
<div class="page-heading mt-3"><div><p class="eyebrow">PLANI @Model.Plan!.Year</p><h1>Kontratë sponsorizimi</h1></div></div>
<form asp-action="Contract" method="post" class="panel p-4 sp-form" data-financial-confirm><input asp-for="Id" type="hidden"/><input asp-for="Revision" type="hidden"/><input asp-for="PlanId" type="hidden"/><div asp-validation-summary="All" class="text-danger" role="alert"></div>
<div class="row g-3"><div class="col-md-8"><label asp-for="Sponsor">Emri i sponsorit</label><input asp-for="Sponsor" class="form-control" required maxlength="150"/></div><div class="col-md-4"><label asp-for="SponsorNumber">Numri i biznesit</label><input asp-for="SponsorNumber" class="form-control" required maxlength="60"/></div><div class="col-md-8"><label asp-for="Reference">Numri / referenca e kontratës</label><input asp-for="Reference" class="form-control" required maxlength="100"/></div><div class="col-md-4"><label asp-for="Amount">Shuma e kontratës</label><input asp-for="Amount" type="number" step="0.01" min="0.01" class="form-control" required data-contract-total/></div><div class="col-md-6"><label asp-for="From">Fillon më</label><input asp-for="From" type="date" class="form-control" required/></div><div class="col-md-6"><label asp-for="To">Përfundon më</label><input asp-for="To" type="date" class="form-control" required/></div></div>
<div class="row g-3 mt-1"><div class="col-md-6"><label asp-for="CertificateNumber">Numri i vërtetimit</label><input asp-for="CertificateNumber" class="form-control" maxlength="100"/></div><div class="col-md-6"><label asp-for="CertificateDate">Data e vërtetimit</label><input asp-for="CertificateDate" type="date" class="form-control"/></div></div>
<h2 class="mt-4">Ndarja sipas kategorive</h2>
<div class="sp-table-wrap" tabindex="0" role="region" aria-label="Ndarja sipas kategorive"><table class="table sp-table"><thead><tr><th scope="col">Kategoria</th><th scope="col" class="sp-number">Plani vjetor</th><th scope="col">Shuma nga sponsori</th></tr></thead><tbody>
@for(var i=0;i<Model.Allocations.Count;i++){var line=Model.Plan.Lines.FirstOrDefault(x=>x.Id==Model.Allocations[i].PlanLineId);<tr><th scope="row"><input asp-for="Allocations[i].PlanLineId" type="hidden"/><label asp-for="Allocations[i].Amount">@(line?.Category??"Kategori e pavlefshme")</label></th><td class="sp-number">@line?.Budget.ToString("N2")</td><td><input asp-for="Allocations[i].Amount" type="number" min="0" step="0.01" class="form-control" required data-allocation-amount/></td></tr>}
</tbody><tfoot><tr><th>Totali</th><td class="sp-number">@Model.Plan.Lines.Sum(x=>x.Budget).ToString("N2")</td><td class="sp-number"><strong data-allocation-total>0.00</strong><small data-allocation-difference></small></td></tr></tfoot></table></div>
@if(Model.Id!=0){<label asp-for="Reason" class="mt-3">Arsyeja dhe referenca e ndryshimit</label><textarea asp-for="Reason" class="form-control" required maxlength="300" rows="2"></textarea>}<button class="btn btn-primary mt-4">Ruaj kontratën</button></form>
@section Scripts {<script src="~/js/sponsorships.js" asp-append-version="true"></script>}
