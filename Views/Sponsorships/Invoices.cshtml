@model SponsorshipInvoiceList
@{ViewData["Title"]="Faturat e sponsorizimeve";var active=Model.Invoices.Where(x=>x.CancelledAt==null).ToList();}
<partial name="_Intro"/>
<div class="page-heading mt-3"><div><p class="eyebrow">SPONSORIZIMET · @Model.Year</p><h1>Faturat</h1></div><a asp-action="Invoice" class="btn btn-primary">+ Faturë e re</a></div>
<form method="get" class="sp-invoice-filter"><select name="year" class="form-select" aria-label="Viti">@foreach(var y in Model.Years.Append(Model.Year).Distinct().OrderDescending()){<option value="@y" selected="@(y==Model.Year)">@y</option>}</select><input name="search" value="@Model.Search" class="form-control" placeholder="Kërko faturën, përfituesin ose sponsorin" aria-label="Kërko faturat"/><button class="btn btn-outline-primary">Kërko</button></form>
<div class="sp-table-wrap" tabindex="0" role="region" aria-label="Faturat e sponsorizimeve"><table class="table sp-table"><thead><tr><th scope="col">Data</th><th scope="col">Fatura</th><th scope="col">Përfituesi</th><th scope="col">Përshkrimi</th><th scope="col">Kategoria</th><th scope="col">Sponsori</th><th scope="col" class="sp-number">Shuma</th><th scope="col">Statusi</th></tr></thead><tbody>
@foreach(var s in Model.Invoices){<tr class="@(s.CancelledAt!=null?"sp-cancelled":"")"><td class="sp-nowrap">@s.Date.ToString("dd.MM.yyyy")</td><td><a asp-action="InvoiceDetails" asp-route-id="@s.Id">@s.DocumentReference</a></td><td>@s.Beneficiary.Name@if(s.SalaryMonth.HasValue){<small class="d-block">@(s.SalaryRole=="Player"?"Lojtar":s.SalaryRole=="Staff"?"Staf":"Pa klasifikim")</small>}</td><td class="sp-description">@s.Description</td><td>@s.Allocation.PlanLine.Category</td><td>@s.Allocation.Contract.Sponsor</td><td class="sp-number">@s.Amount.ToString("N2")</td><td class="sp-nowrap"><span class="badge @(s.CancelledAt==null?"text-bg-success":"text-bg-secondary")">@(s.CancelledAt==null?"E paguar":"E anuluar")</span></td></tr>}
@if(Model.Invoices.Count==0){<tr><td colspan="8" class="text-center py-4">Nuk ka fatura.</td></tr>}
</tbody><tfoot><tr><th colspan="6" scope="row">Gjithsej · @active.Count fatura</th><td class="sp-number">@active.Sum(x=>x.Amount).ToString("N2")</td><td></td></tr></tfoot></table></div>
