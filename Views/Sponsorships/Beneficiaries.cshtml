@model SponsorshipBeneficiaryInput
@{ViewData["Title"]="Përfituesit e sponsorizimeve";var list=(List<SponsorshipBeneficiary>)ViewData["Beneficiaries"]!;}
<partial name="_Intro"/>
<div class="page-heading mt-3"><div><p class="eyebrow">REGJISTËR I PËRBASHKËT PËR TË GJITHË SPONSORËT</p><h1>Përfituesit</h1></div></div>
<form asp-action="Beneficiaries" method="post" class="panel p-4 sp-form"><input type="hidden" name="invoice" value="@(ViewData["Invoice"] is true ? "true" : "false")"/><input type="hidden" name="contractId" value="@ViewData["ContractId"]"/><div asp-validation-summary="All" class="text-danger" role="alert"></div><h2>Përfitues i ri</h2><div class="row g-3"><div class="col-md-6"><label asp-for="Name">Emri i plotë / biznesi</label><input asp-for="Name" class="form-control" maxlength="150" required/></div><div class="col-md-6"><label asp-for="Identifier">Kodi unik i personit / numri i biznesit</label><input asp-for="Identifier" class="form-control" maxlength="60" required/></div><div class="col-12"><label><input asp-for="IsPerson"/> Person (për pagat)</label></div></div><button class="btn btn-primary mt-3">Ruaj përfituesin</button></form>
<div class="sp-table-wrap mt-4" tabindex="0" role="region" aria-label="Përfituesit"><table class="table sp-table"><thead><tr><th scope="col">Emri / biznesi</th><th scope="col">Kodi / numri i biznesit</th><th scope="col">Lloji</th><th scope="col">Veprimi</th></tr></thead><tbody>@foreach(var b in list){<tr><th scope="row">@b.Name</th><td>@b.Identifier</td><td>@(b.IsPerson?"Person":"Biznes")</td><td>@if(ViewData["ContractId"] is int c){<a asp-action="Spend" asp-route-id="@c" asp-route-beneficiaryId="@b.Id">Përdor këtë përfitues</a>}else{<a asp-action="Invoice" asp-route-beneficiaryId="@b.Id">Faturë e re</a>}</td></tr>}@if(list.Count==0){<tr><td colspan="4" class="text-center py-4">Nuk ka përfitues.</td></tr>}</tbody></table></div>
