@model SponsorshipReceiptInput
@{ViewData["Title"]="Pranim nga sponsori";}
<partial name="_Intro"/>
<div class="page-heading mt-3"><div><p class="eyebrow">@Model.Contract!.Sponsor</p><h1>Pranim në bankë</h1></div></div>
<form asp-action="Receive" method="post" class="panel p-4 sp-form" data-financial-confirm><input asp-for="RequestId" type="hidden"/><input asp-for="ContractId" type="hidden"/><div asp-validation-summary="All" class="text-danger" role="alert"></div><div class="row g-3"><div class="col-md-6"><label asp-for="Date">Data e pranimit</label><input asp-for="Date" type="date" class="form-control" required/></div><div class="col-md-6"><label asp-for="Amount">Shuma e pranuar</label><input asp-for="Amount" type="number" step="0.01" min="0.01" class="form-control" required/></div><div class="col-12"><label asp-for="BankReference">Referenca e transaksionit bankar</label><input asp-for="BankReference" class="form-control" required maxlength="100"/></div></div><button class="btn btn-primary mt-4">Regjistro pranimin</button></form>
@section PageNavigation {<a asp-action="Details" asp-route-id="@Model.ContractId" class="btn btn-outline-secondary">Mbrapa te kontrata</a>}
