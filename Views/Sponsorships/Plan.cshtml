@model SponsorshipPlanInput
@{ViewData["Title"]="Plani vjetor i sponsorizimeve";ViewContext.CheckBoxHiddenInputRenderMode=Microsoft.AspNetCore.Mvc.Rendering.CheckBoxHiddenInputRenderMode.Inline;}
<partial name="_Intro"/>
<section class="sp-plan-editor">
<header class="sp-plan-heading"><h1>@(Model.Id!=0?"Ndrysho planin":"Plan i ri")</h1><a asp-action="Index" asp-route-year="@Model.Year">Mbrapa</a></header>
<form method="post" asp-action="Plan" class="sp-form sp-plan-form" data-financial-confirm>
<input asp-for="Id" type="hidden"/><input asp-for="Revision" type="hidden"/>
<div asp-validation-summary="All" class="text-danger sp-plan-validation" role="alert"></div>
<div class="row g-3"><div class="col-md-3"><label asp-for="Year">Viti</label><input asp-for="Year" class="form-control" min="2020" max="2100"/></div><div class="col-md-9"><label asp-for="Title">Emërtimi</label><input asp-for="Title" class="form-control" required maxlength="200"/></div><div class="col-12"><label asp-for="Reference">Referenca</label><input asp-for="Reference" class="form-control" required maxlength="200"/></div></div>
<div class="sp-section-heading mt-4"><h2>Kategoritë</h2><button type="button" class="btn btn-sm sp-plan-add" id="add-plan-line">+ Kategori</button></div>

<div class="sp-table-wrap" tabindex="0" role="region" aria-label="Kategoritë e planit"><table class="table sp-table sp-edit-table"><thead><tr><th scope="col">Nr.</th><th scope="col">Kategoria</th><th scope="col">Aktivitetet</th><th scope="col">Buxheti</th><th scope="col">Pagë</th><th scope="col"><span class="visually-hidden">Veprime</span></th></tr></thead><tbody id="plan-lines">
@for(var i=0;i<Model.Lines.Count;i++){<tr data-plan-line><td data-line-number>@(i+1)</td><td><input asp-for="Lines[i].Id" type="hidden"/><input asp-for="Lines[i].Category" aria-label="Kategoria" class="form-control" maxlength="150" required/></td><td><textarea asp-for="Lines[i].Activities" aria-label="Aktivitetet" class="form-control" maxlength="1000" rows="1"></textarea></td><td><input asp-for="Lines[i].Budget" aria-label="Shuma vjetore" type="number" step="0.01" min="0.01" class="form-control" required/></td><td><input asp-for="Lines[i].IsSalary" aria-label="Pagë mujore" class="sp-plan-switch" role="switch"/></td><td><button class="btn sp-plan-remove" type="button" data-remove-line aria-label="Hiq kategorinë">&#215;</button></td></tr>}
</tbody></table></div>
@if(Model.Id!=0){<div class="sp-plan-reason"><label asp-for="Reason">Arsyeja e ndryshimit</label><textarea asp-for="Reason" class="form-control" required maxlength="300" rows="2"></textarea></div>}
<div class="sp-plan-footer"><a asp-action="Index" asp-route-year="@Model.Year" class="btn sp-plan-back">Anulo</a><button class="btn btn-primary">@(Model.Id!=0?"Ruaj ndryshimet":"Ruaj planin")</button></div></form>
<template id="plan-line-template"><tr data-plan-line><td data-line-number></td><td><input name="Lines[0].Category" aria-label="Kategoria" class="form-control" maxlength="150" required/></td><td><textarea name="Lines[0].Activities" aria-label="Aktivitetet" class="form-control" maxlength="1000" rows="1"></textarea></td><td><input name="Lines[0].Budget" aria-label="Shuma vjetore" type="number" step="0.01" min="0.01" class="form-control" required/></td><td><input name="Lines[0].IsSalary" aria-label="Pagë mujore" class="sp-plan-switch" role="switch" type="checkbox" value="true"/><input name="Lines[0].IsSalary" type="hidden" value="false"/></td><td><button class="btn sp-plan-remove" type="button" data-remove-line aria-label="Hiq kategorinë">&#215;</button></td></tr></template>
@section Scripts {<script src="~/js/sponsorships.js" asp-append-version="true"></script>}
@if(Model.History.Count>0){<details class="sp-plan-history"><summary>Historiku (@Model.History.Count)</summary><div class="sp-table-wrap mt-3" tabindex="0" role="region" aria-label="Historiku i planit"><table class="table sp-table"><thead><tr><th scope="col">Data</th><th scope="col">Arsyeja</th><th scope="col">Llogaria</th></tr></thead><tbody>@foreach(var h in Model.History){<tr><td class="sp-nowrap">@_2Korriku.Services.BillingClock.LocalDate(h.At).ToString("dd/MM/yyyy")</td><td>@h.Reason</td><td>@h.ActorId</td></tr>}</tbody></table></div></details>}
</section>
