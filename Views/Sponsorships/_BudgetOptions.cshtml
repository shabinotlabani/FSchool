@model SponsorshipInvoiceInput
@if(Model.Suggestions.Count==0){<p class="sp-budget-empty">@(Model.PlanLineId>0&&Model.Amount>0?"Nuk ka buxhet të vlefshëm për këtë kategori dhe datë.":"Zgjidhni kategorinë dhe shumën.")</p>}
else{<div class="sp-table-wrap" tabindex="0" role="region" aria-label="Buxhetet e propozuara"><table class="table sp-table sp-budget-table"><thead><tr><th scope="col">Zgjidh</th><th scope="col">Sponsori / kontrata</th><th scope="col">Kategoria</th><th scope="col" class="sp-number">Në dispozicion</th><th scope="col" class="sp-number">Nga ky buxhet</th><th scope="col">Deri më</th><th scope="col">Statusi</th></tr></thead><tbody>
@for(var i=0;i<Model.Suggestions.Count;i++){var s=Model.Suggestions[i];<tr class="@(s.CanCover?"":"sp-budget-unavailable")"><td><input type="radio" name="AllocationId" id="budget-@s.AllocationId" value="@s.AllocationId" checked="@(s.AllocationId==Model.AllocationId)" disabled="@(!s.CanCover)" required/></td><th scope="row"><label for="budget-@s.AllocationId">@s.Sponsor</label><small class="d-block">@s.Reference</small></th><td>@s.Category</td><td class="sp-number">@s.Available.ToString("N2")</td><td class="sp-number">@s.Proposed.ToString("N2")</td><td class="sp-nowrap">@s.Expires.ToString("dd.MM.yyyy")</td><td>@(s.CanCover?(i==0?"I propozuar":"I disponueshëm"):"Nuk mjafton")</td></tr>}
</tbody></table></div>}
