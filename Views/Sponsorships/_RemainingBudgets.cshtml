@model SponsorshipDashboard
@{
    var today=_2Korriku.Services.BillingClock.Today;
    var spent=Model.Spending.Where(x=>x.CancelledAt==null).GroupBy(x=>x.AllocationId).ToDictionary(x=>x.Key,x=>x.Sum(s=>s.Amount));
}
@if(Model.Contracts.Any(c=>c.Allocations.Any(a=>a.Amount>0))){
<div class="sp-section-heading"><h2>Buxhetet e mbetura</h2></div>
<div class="sp-table-wrap" tabindex="0" role="region" aria-label="Buxhetet e mbetura sipas sponsorit"><table class="table sp-table sp-report-table"><thead><tr><th>Sponsori / Kategoria</th><th class="sp-number">Buxheti</th><th class="sp-number">Shpenzuar</th><th class="sp-number">Mbetur</th><th>Afati</th><th>Statusi</th></tr></thead><tbody>
@foreach(var contract in Model.Contracts){
    var cash=Model.Receipts.Where(x=>x.ContractId==contract.Id&&x.CancelledAt==null).Sum(x=>x.Amount)-Model.Spending.Where(x=>x.Allocation.ContractId==contract.Id&&x.CancelledAt==null).Sum(x=>x.Amount);
    @foreach(var allocation in contract.Allocations.Where(x=>x.Amount>0).OrderBy(x=>x.PlanLineId)){
        var used=spent.GetValueOrDefault(allocation.Id);
        var remaining=Math.Max(0,allocation.Amount-used);
        var category=Model.Plan!.Lines.First(x=>x.Id==allocation.PlanLineId).Category;
        var expired=contract.To<today;
        var upcoming=contract.From>today;
        <tr><td><a asp-action="Details" asp-route-id="@contract.Id">@contract.Sponsor</a><span class="d-block">@category</span><small>@contract.Reference</small></td>
        <td class="sp-number">@allocation.Amount.ToString("N2")</td><td class="sp-number">@used.ToString("N2")</td><td class="sp-number"><strong>@remaining.ToString("N2")</strong>
        @if(!expired&&!upcoming&&remaining>cash){<small class="d-block">Në bankë: @cash.ToString("N2")</small>}</td>
        <td class="sp-nowrap">@contract.To.ToString("dd.MM.yyyy")</td><td>@(expired?"E përfunduar":upcoming?"Së shpejti":remaining==0?"I shfrytëzuar":"Aktiv")</td></tr>
    }
}
</tbody></table></div>
}
