@model SponsorshipContractDetails
@{var c=Model.Contract;var allocated=c.Allocations.Sum(x=>x.Amount);var unallocated=Math.Max(0,c.Amount-allocated);ViewData["Title"]="Sponsorizimi · "+c.Sponsor;}
<partial name="_Intro"/>
<a asp-action="Contract" asp-route-id="@c.Id" class="sp-no-print d-inline-block mt-3">Ndrysho kontratën me arsye</a>
<div class="page-heading mt-3"><div><p class="eyebrow">KONTRATA @c.Reference · PLANI @c.Plan.Year</p><h1>@c.Sponsor</h1><p>@c.SponsorNumber · @c.From.ToString("dd/MM/yyyy") – @c.To.ToString("dd/MM/yyyy")</p></div><div class="sp-actions sp-no-print">@if(!c.FundingClosedAt.HasValue){<a asp-action="Receive" asp-route-id="@c.Id" class="btn btn-outline-primary">Pranim në bankë</a>}<a asp-action="Invoice" class="btn btn-primary">Faturë e re</a><a asp-action="SponsorReport" asp-route-id="@c.Id" class="btn btn-outline-secondary">Raporti i sponsorit</a></div></div>
@if(c.FundingClosedAt.HasValue){<div class="sp-funding-closed"><strong>Financimi i përfunduar</strong><span>@_2Korriku.Services.BillingClock.LocalDate(c.FundingClosedAt.Value).ToString("dd/MM/yyyy") · Pranuar @Model.Received.ToString("N2")</span><small>@c.FundingClosureReason</small></div>}else if(!string.IsNullOrWhiteSpace(c.FundingClosureReason)){<div class="sp-funding-note"><strong>Marrëveshja mbetet aktive</strong><span>@c.FundingClosureReason</span></div>}
<div class="sp-table-wrap" tabindex="0" role="region" aria-label="Përmbledhja e kontratës"><table class="table sp-table sp-summary-table"><thead><tr><th scope="col">Kontrata</th><th scope="col">Ndarë në kategori</th><th scope="col">Pa u ndarë</th><th scope="col">Pranuar në bankë</th><th scope="col">Për t’u pranuar</th><th scope="col">Shpenzuar</th><th scope="col">Mjete të mbetura</th></tr></thead><tbody><tr><td>@c.Amount.ToString("N2")</td><td>@allocated.ToString("N2")</td><td class="@(unallocated>0?"sp-unallocated":"")">@(unallocated>0?"⚠ ":"")@unallocated.ToString("N2")</td><td>@Model.Received.ToString("N2")</td><td>@(c.FundingClosedAt.HasValue?"0.00":(c.Amount-Model.Received).ToString("N2"))</td><td>@Model.Used.ToString("N2")</td><td>@((Model.Received-Model.Used).ToString("N2"))</td></tr></tbody></table></div>
@if(!c.FundingClosedAt.HasValue&&Model.Received>0&&Model.Received<c.Amount){<form asp-action="CloseFunding" method="post" class="sp-close-funding sp-no-print" data-financial-confirm><input type="hidden" name="ContractId" value="@c.Id"/><fieldset><legend>Sqarimi i diferencës</legend><label><input type="radio" name="Outcome" value="ContinuingExpenses" required/> Ka shpenzime të tjera në vazhdim</label><label><input type="radio" name="Outcome" value="SponsorShortfall" required/> Sponsori nuk ka mundur t’i transferojë të gjitha mjetet</label></fieldset><input name="Note" class="form-control form-control-sm" maxlength="180" placeholder="Sqarim shtesë (opsional)"/><button class="btn btn-sm btn-outline-secondary">Ruaj sqarimin</button></form>}
<h2 class="mt-4">Buxheti sipas kategorive</h2><div class="sp-table-wrap" tabindex="0" role="region" aria-label="Buxheti sipas kategorive"><table class="table sp-table"><thead><tr><th scope="col">Kategoria</th><th scope="col">Lloji</th><th scope="col" class="sp-number">Lejuar</th><th scope="col" class="sp-number">Shpenzuar</th><th scope="col" class="sp-number">Mbetur</th></tr></thead><tbody>
@foreach(var a in c.Allocations.OrderBy(x=>x.PlanLineId)){var used=Model.Spending.Where(x=>x.AllocationId==a.Id&&x.CancelledAt==null).Sum(x=>x.Amount);<tr><th scope="row">@a.PlanLine.Category</th><td>@(a.PlanLine.IsSalary?"Pagë mujore":"Shpenzim")</td><td class="sp-number">@a.Amount.ToString("N2")</td><td class="sp-number">@used.ToString("N2")</td><td class="sp-number">@((a.Amount-used).ToString("N2"))</td></tr>}
</tbody><tfoot><tr><th colspan="2">Totali</th><td class="sp-number">@c.Allocations.Sum(x=>x.Amount).ToString("N2")</td><td class="sp-number">@Model.Used.ToString("N2")</td><td class="sp-number">@((c.Allocations.Sum(x=>x.Amount)-Model.Used).ToString("N2"))</td></tr></tfoot></table></div>
<h2 class="mt-4">Pagesat dhe dëshmitë</h2><div class="sp-table-wrap" tabindex="0" role="region" aria-label="Pagesat dhe dëshmitë"><table class="table sp-table"><thead><tr><th scope="col">Data</th><th scope="col">Fatura</th><th scope="col">Përfituesi</th><th scope="col">Kategoria</th><th scope="col">Përshkrimi</th><th scope="col">Muaji i pagës</th><th scope="col">Referenca bankare</th><th scope="col" class="sp-number">Shuma</th><th scope="col">Statusi</th><th scope="col" class="sp-no-print">Veprimi</th></tr></thead><tbody>
@foreach(var s in Model.Spending){<tr class="@(s.CancelledAt!=null?"sp-cancelled":"")"><td class="sp-nowrap">@s.Date.ToString("dd/MM/yyyy")</td><td><a asp-action="InvoiceDetails" asp-route-id="@s.Id">@s.DocumentReference</a><small class="d-block">SP-@s.Id</small></td><td>@s.Beneficiary.Name@if(s.SalaryMonth.HasValue){<small class="d-block">@(s.SalaryRole=="Player"?"Lojtar":s.SalaryRole=="Staff"?"Staf":"Pa klasifikim")</small>}</td><td>@s.Allocation.PlanLine.Category</td><td class="sp-description">@s.Description</td><td>@s.SalaryMonth?.ToString("MM.yyyy")</td><td>@s.BankReference</td><td class="sp-number">@s.Amount.ToString("N2")</td><td>@if(s.CancelledAt.HasValue){<span class="text-danger">Anuluar më @_2Korriku.Services.BillingClock.LocalDate(s.CancelledAt.Value).ToString("dd/MM/yyyy")</span><small class="d-block">@s.CancellationReason</small>}else{<span>E paguar</span>}</td><td class="sp-no-print">@if(s.CancelledAt==null){<a asp-action="Cancel" asp-route-kind="Spend" asp-route-id="@s.Id">Anulo me arsye</a>}</td></tr>}
@if(Model.Spending.Count==0){<tr><td colspan="10" class="text-center py-4">Nuk ka pagesa.</td></tr>}
</tbody>@if(Model.Spending.Count>0){<tfoot><tr><th colspan="7">Totali i shpenzuar</th><td class="sp-number">@Model.Used.ToString("N2")</td><td colspan="2"></td></tr></tfoot>}</table></div>
<h2 class="mt-4">Pranimet nga sponsori</h2><div class="sp-table-wrap" tabindex="0" role="region" aria-label="Pranimet nga sponsori"><table class="table sp-table"><thead><tr><th scope="col">Data</th><th scope="col">Regjistrimi</th><th scope="col">Referenca bankare</th><th scope="col" class="sp-number">Shuma</th><th scope="col">Statusi</th><th scope="col" class="sp-no-print">Veprimi</th></tr></thead><tbody>
@foreach(var r in Model.Receipts){<tr class="@(r.CancelledAt!=null?"sp-cancelled":"")"><td class="sp-nowrap">@r.Date.ToString("dd/MM/yyyy")</td><td>PR-@r.Id</td><td>@r.BankReference</td><td class="sp-number">@r.Amount.ToString("N2")</td><td>@if(r.CancelledAt.HasValue){<span class="text-danger">Anuluar më @_2Korriku.Services.BillingClock.LocalDate(r.CancelledAt.Value).ToString("dd/MM/yyyy")</span><small class="d-block">@r.CancellationReason</small>}else{<span>I pranuar</span>}</td><td class="sp-no-print">@if(r.CancelledAt==null){<a asp-action="Cancel" asp-route-kind="Receipt" asp-route-id="@r.Id">Anulo me arsye</a>}</td></tr>}
@if(Model.Receipts.Count==0){<tr><td colspan="6" class="text-center py-4">Nuk ka pranime.</td></tr>}
</tbody>@if(Model.Receipts.Count>0){<tfoot><tr><th colspan="3">Totali i pranuar</th><td class="sp-number">@Model.Received.ToString("N2")</td><td colspan="2"></td></tr></tfoot>}</table></div>
<details class="mt-4 sp-no-print"><summary>Historiku i veprimeve (@Model.History.Count)</summary><div class="sp-table-wrap mt-3" tabindex="0" role="region" aria-label="Historiku"><table class="table sp-table"><thead><tr><th scope="col">Data</th><th scope="col">Veprimi / arsyeja</th><th scope="col">Regjistrimi</th><th scope="col">Llogaria</th></tr></thead><tbody>@foreach(var h in Model.History){<tr><td class="sp-nowrap">@h.At.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td>@h.Reason</td><td>@h.Entity #@h.EntityId</td><td>@h.ActorId</td></tr>}</tbody></table></div></details>
@section PageNavigation {<a asp-action="Index" asp-route-year="@c.Plan.Year" class="btn btn-outline-secondary">Mbrapa te sponsorizimet</a>}
@section Scripts {<script src="~/js/sponsorships.js" asp-append-version="true"></script>}
