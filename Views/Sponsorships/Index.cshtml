@model SponsorshipDashboard
@{ViewData["Title"]="Sponsorizimet";var declared=Model.Plan?.Lines.Sum(x=>x.Budget)??0;var contracted=Model.Contracts.Sum(x=>x.Amount);var allocated=Model.Contracts.SelectMany(x=>x.Allocations).Sum(x=>x.Amount);var unallocated=Math.Max(0,contracted-allocated);var received=Model.Receipts.Where(x=>x.CancelledAt==null).Sum(x=>x.Amount);var used=Model.Spending.Where(x=>x.CancelledAt==null).Sum(x=>x.Amount);var bankBalance=received-used;var fundingNeeded=Math.Max(0,declared-allocated);}
<partial name="_Intro"/>
<section class="sp-report sp-overview">
<header class="sp-report-heading"><h1>Përmbledhja <span>@Model.Year</span></h1><div class="sp-actions"><a asp-action="Plan" class="btn btn-sm btn-outline-secondary">Plan i ri</a><a asp-action="Invoice" class="btn btn-sm btn-primary">+ Faturë</a></div></header>
@if(Model.Years.Count>0){<form method="get" class="sp-year sp-report-filter"><label for="year">Viti</label><select name="year" id="year" class="form-select form-select-sm">@foreach(var y in Model.Years.Append(Model.Year).Distinct().OrderDescending()){<option selected="@(y==Model.Year)" value="@y">@y</option>}</select><button class="btn btn-sm btn-outline-secondary">Shfaq</button></form>}
@if(Model.Plan==null){<div class="sp-table-wrap"><table class="table sp-table sp-report-table"><thead><tr><th scope="col">Plani vjetor</th><th scope="col">Veprimi</th></tr></thead><tbody><tr><td>@Model.Year</td><td><a asp-action="Plan" class="btn btn-sm btn-outline-secondary">Regjistro planin vjetor</a></td></tr></tbody></table></div>}
else {
<div class="sp-total-strip" aria-label="Totalet e sponsorizimeve"><div><span>Plani</span><strong>@declared.ToString("N2")</strong></div><div><span>Kontraktuar</span><strong>@contracted.ToString("N2")</strong></div><div class="@(unallocated>0?"sp-total-warning":"")"><span>Pa u ndarë</span><strong>@unallocated.ToString("N2")</strong></div><div><span>Për t’u mbuluar</span><strong>@fundingNeeded.ToString("N2")</strong></div><div><span>Pranuar</span><strong>@received.ToString("N2")</strong></div><div><span>Shpenzuar</span><strong>@used.ToString("N2")</strong></div><div class="sp-total-primary"><span>Në dispozicion</span><strong>@bankBalance.ToString("N2")</strong></div></div>
<partial name="_RemainingBudgets" model="Model"/>
<div class="sp-section-heading"><h2>Sponsorët</h2><a asp-action="Contract" asp-route-planId="@Model.Plan.Id" class="btn btn-sm btn-outline-secondary">+ Kontratë</a></div>
<div class="sp-table-wrap" tabindex="0" role="region" aria-label="Sponsorët dhe kontratat"><table class="table sp-table sp-report-table"><thead><tr><th scope="col">Sponsori</th><th scope="col">Periudha</th><th scope="col" class="sp-number">Kontraktuar</th><th scope="col" class="sp-number">Pranuar</th><th scope="col" class="sp-number">Shpenzuar</th><th scope="col" class="sp-number">Gjendja</th><th scope="col">Statusi</th></tr></thead><tbody>
@foreach(var c in Model.Contracts){var r=Model.Receipts.Where(x=>x.ContractId==c.Id&&x.CancelledAt==null).Sum(x=>x.Amount);var s=Model.Spending.Where(x=>x.Allocation.ContractId==c.Id&&x.CancelledAt==null).Sum(x=>x.Amount);var open=Math.Max(0,c.Amount-c.Allocations.Sum(x=>x.Amount));<tr><td><a asp-action="Details" asp-route-id="@c.Id">@c.Sponsor</a><small class="d-block">@c.Reference</small></td><td class="sp-nowrap">@c.From.ToString("dd/MM/yyyy")<br/>@c.To.ToString("dd/MM/yyyy")</td><td class="sp-number">@c.Amount.ToString("N2")</td><td class="sp-number">@r.ToString("N2")</td><td class="sp-number">@s.ToString("N2")</td><td class="sp-number">@((r-s).ToString("N2"))</td><td>@(c.FundingClosedAt.HasValue?"Financimi i përfunduar":c.To<_2Korriku.Services.BillingClock.Today?"E përfunduar":c.From>_2Korriku.Services.BillingClock.Today?"Fillon së shpejti":"Aktive")@if(open>0){<small class="d-block sp-unallocated">⚠ Pa u ndarë @open.ToString("N2")</small>}</td></tr>}
@if(Model.Contracts.Count==0){<tr><td colspan="7" class="text-center py-4">Nuk ka kontrata të regjistruara.</td></tr>}
</tbody>@if(Model.Contracts.Count>0){<tfoot><tr><th colspan="2">Totali</th><td class="sp-number">@contracted.ToString("N2")</td><td class="sp-number">@received.ToString("N2")</td><td class="sp-number">@used.ToString("N2")</td><td class="sp-number">@bankBalance.ToString("N2")</td><td></td></tr></tfoot>}</table></div>
<div class="sp-section-heading"><h2>Kategoritë</h2><div class="sp-actions"><a asp-action="Coverage" asp-route-year="@Model.Year">Mbulimi i planit</a><a asp-action="Plan" asp-route-id="@Model.Plan.Id" class="btn btn-sm btn-outline-secondary">Ndrysho planin</a></div></div>
<div class="sp-table-wrap" tabindex="0" role="region" aria-label="Kategoritë e planit"><table class="table sp-table sp-report-table"><thead><tr><th scope="col">Kategoria</th><th scope="col" class="sp-number">Deklaruar</th><th scope="col" class="sp-number">Kontraktuar</th><th scope="col" class="sp-number">Shpenzuar</th><th scope="col" class="sp-number">Nevojiten ende</th></tr></thead><tbody>
@foreach(var l in Model.Plan.Lines.OrderBy(x=>x.Id)){var lineAllocated=Model.Contracts.SelectMany(x=>x.Allocations).Where(x=>x.PlanLineId==l.Id).Sum(x=>x.Amount);var spent=Model.Spending.Where(x=>x.Allocation.PlanLineId==l.Id&&x.CancelledAt==null).Sum(x=>x.Amount);<tr><th scope="row">@l.Category</th><td class="sp-number">@l.Budget.ToString("N2")</td><td class="sp-number">@lineAllocated.ToString("N2")</td><td class="sp-number">@spent.ToString("N2")</td><td class="sp-number">@Math.Max(0,l.Budget-lineAllocated).ToString("N2")</td></tr>}
</tbody><tfoot><tr><th>Totali</th><td class="sp-number">@declared.ToString("N2")</td><td class="sp-number">@allocated.ToString("N2")</td><td class="sp-number">@used.ToString("N2")</td><td class="sp-number">@fundingNeeded.ToString("N2")</td></tr></tfoot></table></div>
}
</section>
