@{ var club = await Club.Get(); }
@model FieldPayment
@using _2Korriku.Services
@{Layout="_PrintLayout";ViewData["Title"]="Dëftesë " + Model.Number; var receipts=ViewData["BatchPayments"] as List<FieldPayment> ?? new List<FieldPayment>{Model};}
<div class="print-toolbar"><partial name="_DocumentBack"/><button type="button" onclick="window.print()">Printo A4 / Ruaj PDF</button></div>
<main class="stock-sheet"><header class="document-header"><div class="document-brand"><img src="@Club.LogoUrl" alt="@club.DisplayName" /><div><strong>@club.DisplayName</strong><span>TERMINET PRIVATE</span></div></div><div class="document-heading"><span class="copy-label">DËFTESË ARKËTIMI</span><h1>@Model.Number</h1><strong>@TimeZoneInfo.ConvertTimeFromUtc(Model.CreatedAt,BillingClock.Zone).ToString("dd/MM/yyyy HH:mm")</strong></div></header><div class="document-rule"></div>
@if(receipts.All(p=>p.CancelledAt.HasValue)){<p class="cancelled-notice">E ANULUAR më @TimeZoneInfo.ConvertTimeFromUtc(Model.CancelledAt.GetValueOrDefault(),BillingClock.Zone).ToString("dd/MM/yyyy HH:mm") · @Model.CancellationReason</p>}
<table class="document-table"><thead><tr><th>Përshkrimi</th><th>Shuma</th></tr></thead><tbody>@foreach(var receipt in receipts){<tr><td>@receipt.Description @if(receipt.CancelledAt.HasValue){<strong> · E anuluar</strong>}</td><td>@receipt.Amount.ToString("N2")</td></tr>}</tbody><tfoot><tr><th>Gjithsej arkëtuar</th><td>@receipts.Where(p=>!p.CancelledAt.HasValue).Sum(p=>p.Amount).ToString("N2")</td></tr></tfoot></table>
<p class="document-notes">Mënyra e pagesës: @BillingService.MethodLabel(Model.Method)</p><p class="document-notes">Regjistruar nga: @Model.Actor?.UserName</p><footer class="document-footer"><span>@club.DisplayName · Arkëtim për termin privat #@Model.FieldBookingId</span></footer></main>
