@{ var club = await Club.Get(); }
@model BankReceiptView
@using _2Korriku.Services
@{ViewData["Title"]="Pagesa bankare #"+Model.Request.Id;Layout="_PrintLayout";}
<div class="print-toolbar"><a asp-action="Index">Mbrapa</a><button type="button" onclick="window.print()">Printo / PDF</button></div>
<main class="stock-sheet"><header class="document-header"><div class="document-brand"><img src="@Club.LogoUrl" alt="@club.DisplayName"/><div><strong>@club.DisplayName</strong><span>Pagesë bankare</span></div></div><div class="document-heading"><h1>BK-@Model.Request.Id</h1><span>@BillingClock.LocalDate(Model.Allocations.First().Payment.PaymentDate).ToString("dd.MM.yyyy")</span></div></header>
<table class="document-table"><thead><tr><th>Përfituesi</th><th>Ndarja</th><th>Dokumenti</th><th>Shuma</th><th>Statusi</th></tr></thead><tbody>
@foreach(var row in Model.Allocations){<tr><td>@row.Payment.Student?.FullName</td><td>@row.Label</td><td><a asp-controller="Payments" asp-action="Receipt" asp-route-id="@row.PaymentId">#@row.PaymentId</a></td><td>@row.Amount.ToString("N2")</td><td>@(row.Payment.IsCancelled?"Anuluar":"Konfirmuar")</td></tr>}
</tbody><tfoot><tr><th colspan="3">Pranuar në bankë</th><td>@Model.Request.ConfirmedAmount?.ToString("N2")</td><td></td></tr><tr><th colspan="3">Gjendja pas anulimeve</th><td>@Model.Allocations.Where(x=>!x.Payment.IsCancelled).Sum(x=>x.Amount).ToString("N2")</td><td></td></tr></tfoot></table></main>
