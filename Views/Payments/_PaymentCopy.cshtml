@model PaymentDocumentModel
@{ var compact = Model.SeasonalDescription != null || Model.IsCancelled || (Model.Notes?.Length ?? 0) > 150 || Model.Student.FullName.Length + (Model.Student.ParentName?.Length ?? 0) > 120; }
<section class="payment-copy @(Model.IsCancelled ? "cancelled-copy" : "") @(compact ? "compact-copy" : "")" aria-label="@Model.CopyLabel">
    <header class="document-header"><div class="document-brand"><img src="~/images/fc-2-korriku.svg" alt="Logo e FC 2 Korriku" width="44" height="63"/><div><strong>FC 2 KORRIKU</strong><span>SHKOLLA E FUTBOLLIT</span><small>Prishtinë · 1957</small></div></div><div class="document-heading"><span class="copy-label">@Model.CopyLabel</span><h1>@Model.Title</h1><strong>@Model.Number</strong></div></header>
    <div class="document-rule"></div>
    @if(Model.IsCancelled){<div class="cancelled-notice">ANULUAR · @Model.CancellationReason</div>}
    <div class="document-metadata"><div><label>Lojtari</label><strong>@Model.Student.FullName</strong></div><div><label>Data</label><strong>@Model.Date.ToString("dd.MM.yyyy")</strong></div><div><label>Prindi / kujdestari</label><span>@(Model.Student.ParentName ?? "—")</span></div><div><label>@(Model.IsReceipt ? "Mënyra e pagesës" : "Periudha")</label><span>@(Model.IsReceipt ? Model.Method : Model.Description)</span></div></div>
    <table class="document-table"><thead><tr><th>Përshkrimi</th><th>Shuma (€)</th></tr></thead><tbody>
    @if(Model.SeasonalDescription != null){<tr><td>@Model.SeasonalDescription</td><td>@Model.SeasonalGross.ToString("N2")</td></tr><tr><td>Zbritje sezonale</td><td>− @Model.SeasonalDiscount.ToString("N2")</td></tr>}else{
    <tr><td>@(Model.ServiceDescription ?? (Model.IsReceipt ? (Model.SaleNumber == null ? "Pagesë e pranuar për shkollën e futbollit" : "Pagesë për rekuizita · " + Model.SaleNumber) : "Tarifa mujore e shkollës së futbollit"))</td><td>@Model.Amount.ToString("N2")</td></tr>}
    @if(!Model.IsReceipt){<tr><td>Lirim / zbritje</td><td>− @Model.Exempted.ToString("N2")</td></tr><tr><td>Mbuluar nga pagesat / parapagimi</td><td>− @Model.Paid.ToString("N2")</td></tr>}
    </tbody><tfoot><tr><th>@(Model.IsReceipt ? "GJITHSEJ ARKËTUAR" : "MBETET PËR PAGESË")</th><td>@(Model.IsReceipt ? Model.Amount.ToString("N2") : Model.Due.ToString("N2")) €</td></tr></tfoot></table>
    @if(!string.IsNullOrWhiteSpace(Model.Notes)){<p class="document-notes"><strong>Shënim:</strong> @Model.Notes</p>}
    <p class="document-explanation">@(Model.ServiceDescription != null ? "Ky dokument lidhet vetëm me trajnimin personal të shënuar. Pagesa mujore bazë evidentohet veçmas." : Model.SeasonalDescription != null ? "Ky arkëtim mbulon vetëm periudhën sezonale të shënuar. Muajt e zbritjes ruhen në historik. Borxhet jashtë periudhës paguhen veçmas." : Model.IsReceipt ? (Model.SaleNumber == null ? "Ky dokument vërteton pagesën e regjistruar. Pagesa mbulon tarifat mujore më të vjetra; teprica mbetet parapagim." : "Ky dokument vërteton arkëtimin vetëm për daljen " + Model.SaleNumber + ".") : "Kjo fletëpagesë tregon detyrimin mujor dhe gjendjen aktuale. Dëftesa e arkëtimit lëshohet pas regjistrimit të pagesës.")</p>
    <div class="document-signatures"><div><span>@(Model.IsReceipt ? "Arkëtari" : "Përgatiti")</span><strong>@Model.PreparedBy</strong><i></i><small>Nënshkrimi / vula</small></div><div><span>Prindi / paguesi</span><strong>@(Model.Student.ParentName ?? " ")</strong><i></i><small>Nënshkrimi</small></div></div>
    <footer class="document-footer"><span>FC 2 Korriku · Evidenca e pagesave</span><span>@Model.Number · @Model.CopyLabel</span></footer>
</section>
