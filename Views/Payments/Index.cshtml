@model BillingIndexModel
<link rel="stylesheet" href="~/css/billing-attendance.css" asp-append-version="true"/>
@{ ViewData["Title"] = "Pagesat dhe arkëtimet"; var selectedMonth = new DateTime(Model.Year, Model.Month, 1); }
<a asp-controller="PersonalTraining" asp-action="Index" class="btn btn-outline-primary mb-3">Pagesat e trajnimeve personale →</a>
<div class="page-heading"><div><p class="eyebrow">FINANCAT E SHKOLLËS</p><h1>Pagesat dhe arkëtimet</h1></div>
@if(User.IsInRole(Roles.Admin)){<form asp-action="Generate" method="post"><button class="btn btn-primary" type="submit">Përditëso faturat</button></form>}</div>
<partial name="_BillingNotice" />
@if(TempData["PaymentReceiptId"] is int receiptId){<a asp-action="Receipt" asp-route-id="@receiptId" asp-route-returnUrl="@(Context.Request.PathBase + Context.Request.Path + Context.Request.QueryString)" class="btn btn-outline-primary mb-3">Printo dëftesën e pagesës</a>}
@if(TempData["FamilyReceiptId"] is int familyReceiptId){<a asp-action="FamilyReceipt" asp-route-id="@familyReceiptId" asp-route-returnUrl="@(Context.Request.PathBase + Context.Request.Path + Context.Request.QueryString)" class="btn btn-outline-primary mb-3">Printo dëftesën familjare</a>}
@if(TempData["FieldReceiptId"] is int fieldReceiptId){<a asp-controller="Fields" asp-action="Receipt" asp-route-id="@fieldReceiptId" asp-route-returnUrl="@(Context.Request.PathBase + Context.Request.Path + Context.Request.QueryString)" class="btn btn-outline-primary mb-3">Printo dëftesën e terminit</a>}
@if(User.IsInRole(Roles.Admin)||User.IsInRole(Roles.Operator)){<a asp-controller="BankPayments" asp-action="Index" class="btn btn-outline-primary mb-3">Verifiko pagesat bankare</a>}

<form method="get" class="search-panel billing-filter" role="search">
    <div><label for="bill-month" class="form-label">Muaji</label><select id="bill-month" name="month" class="form-select">@for(var m = 1; m <= 12; m++){<option value="@m" selected="@(m == Model.Month)">@(new DateTime(2000, m, 1).ToString("MMMM", System.Globalization.CultureInfo.GetCultureInfo("sq-AL")))</option>}</select></div>
    <div><label for="bill-year" class="form-label">Viti</label><input id="bill-year" name="year" type="number" min="2000" max="9998" value="@Model.Year" class="form-control" /></div>
    <div class="billing-search"><label for="bill-search" class="form-label">Lojtari</label><input id="bill-search" type="search" name="search" value="@Model.Search" class="form-control" placeholder="Emri, mbiemri ose telefoni" /></div>
    <div class="form-check form-switch mb-2"><input id="bill-unpaid" class="form-check-input" type="checkbox" role="switch" name="unpaidOnly" value="true" checked="@Model.UnpaidOnly" onchange="this.form.requestSubmit()" /><label class="form-check-label fw-semibold" for="bill-unpaid">Vetëm të papaguarit</label></div>
    <button type="submit" class="btn btn-dark">Shfaq faturat</button><a asp-action="Index" asp-route-unpaidOnly="@Model.UnpaidOnly" class="btn btn-outline-secondary">Muaji aktual</a>
</form>

<section class="panel"><div class="panel-heading"><h2>@selectedMonth.ToString("MMMM yyyy", System.Globalization.CultureInfo.GetCultureInfo("sq-AL"))</h2><span class="results-caption">@(Model.UnpaidOnly ? "Vetëm faturat me borxh të mbetur" : "Gjendja sipas pagesave dhe lirimeve aktuale")</span></div>
<div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Lojtari / fatura</th><th>Tarifa</th><th>Lirim / zbritje</th><th>Mbuluar</th><th title="Borxhi i muajit të zgjedhur dhe borxhet shtesë aktuale">Borxhi gjithsej</th><th>Statusi</th><th>Veprime</th><th>Prezenca</th></tr></thead><tbody>
<partial name="_UnifiedRows" model="Model.Rows"/>@if(Model.Rows.Count==0){<tr><td colspan="8" class="text-center text-secondary py-5">Nuk ka të dhëna për filtrat e zgjedhur.</td></tr>}</tbody></table></div></section>
