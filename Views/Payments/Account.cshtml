@model PlayerBillingModel
@using _2Korriku.Services
@{ ViewData["Title"] = "Kartela financiare"; }
<link rel="stylesheet" href="~/css/player-account.css" asp-append-version="true"/>
<div class="account-compact">
<div class="page-heading"><div><h1>@Model.Student.FullName</h1><span class="text-secondary">Kartela financiare · #@Model.Student.Id · @(Model.Student.IsActive?"Aktiv":"Joaktiv")</span></div></div>
<div class="account-toolbar">
<a asp-action="PrintAccount" asp-route-id="@Model.Student.Id" class="btn btn-outline-primary">Printo / PDF</a>
<button type="button" class="btn btn-outline-primary" data-bs-toggle="collapse" data-bs-target="#player-attendance" aria-expanded="false" aria-controls="player-attendance">Prezenca</button>
@if(User.IsInRole(Roles.Admin)||User.IsInRole(Roles.Operator)){
<partial name="_AccountPaymentActions" model="Model"/>
<a asp-controller="Students" asp-action="Edit" asp-route-id="@Model.Student.Id" class="btn btn-outline-secondary">Edito lojtarin</a>
<a asp-controller="ParentLinks" asp-action="Index" asp-route-id="@Model.Student.Id" class="btn btn-outline-secondary">Linku i prindit</a>
<a asp-controller="Teams" asp-action="Assign" asp-route-id="@Model.Student.Id" class="btn btn-outline-secondary">Ndrysho ekipin</a>
<a asp-controller="Sales" asp-action="Create" asp-route-studentId="@Model.Student.Id" class="btn btn-outline-secondary">+ Rekuzita</a>
<a asp-controller="PersonalTraining" asp-action="Create" asp-route-studentId="@Model.Student.Id" class="btn btn-outline-secondary">+ Trajnim personal</a>
}
@if(User.IsInRole(Roles.Admin)){<a asp-controller="Tariffs" asp-action="Assign" asp-route-id="@Model.Student.Id" class="btn btn-outline-secondary">Ndrysho kategorinë</a>}
</div>
<partial name="_BillingNotice"/>
<div class="collapse" id="player-attendance">
    <section class="panel p-3 mb-3" aria-label="Historiku i prezencës sipas muajve">
        <div class="d-flex justify-content-between align-items-center gap-2 mb-2"><h2>Prezenca sipas muajve</h2><small class="text-secondary">Prezent / ditë të regjistruara</small></div>
        @if(Model.AttendanceHistory.Count == 0){<p class="text-secondary small mb-0">Nuk ka prezencë të regjistruar.</p>}
        <div class="attendance-months">
        @foreach(var month in Model.AttendanceHistory){
            <div class="attendance-month">
                <span>@month.Label</span>
                <div class="progress" role="progressbar" aria-label="@month.Label" aria-valuenow="@month.Percent" aria-valuemin="0" aria-valuemax="100"><div class="progress-bar @(month.Percent >= 80 ? "bg-success" : month.Percent >= 50 ? "bg-warning" : "bg-danger")" style="width:@(month.Percent)%"></div></div>
                <strong>@month.Percent%</strong><small>@month.Present/@month.Total</small>
            </div>
        }
        </div>
    </section>
</div>
@if(Model.PendingBankAmount>0){<div class="alert alert-warning py-2">Bankë në pritje: <strong>@Model.PendingBankAmount.ToString("N2")</strong> · Borxhi mbetet deri në verifikim. @if(User.IsInRole(Roles.Admin)||User.IsInRole(Roles.Operator)){<a asp-controller="BankPayments" asp-action="Index">Shiko kërkesat</a>}</div>}
<div class="account-metadata">
<div><small>Datëlindja</small><strong>@Model.Student.DateOfBirth.ToString("dd.MM.yyyy")</strong></div>
<div><small>Prindi / kontakti</small><strong>@Model.Student.ParentName · @Model.Student.ParentPhone</strong></div>
<div><small>Ekipi</small><strong>@(Model.Student.TrainingTeam?.Name??"Pa ekip")</strong></div>
<div><small>Tarifa mujore</small><strong>@Model.CurrentFeeName · @Model.Student.MonthlyFee.ToString("N2")</strong></div>
</div>
@if(Model.Student.TrainingTeam is TrainingTeam team){<p class="account-schedule">@team.Location · @string.Join(" · ",team.Sessions.OrderBy(s=>s.Day).ThenBy(s=>s.StartsAt).Select(s=>$"{TeamService.DayName(s.Day)} {s.StartsAt:HH:mm}–{s.EndsAt:HH:mm}"))</p>}
<div class="account-summary">
<div><small>@(Model.AvailableBalance>0?"Borxh gjithsej":Model.AvailableBalance<0?"Parapagim":"Bilanci")</small><strong class="@(Model.AvailableBalance>0?"text-danger":"text-success")">@Math.Abs(Model.AvailableBalance).ToString("N2")</strong></div>
<div><small>Borxh mujor</small><strong>@Model.MonthlyDue.ToString("N2")</strong></div>
<div><small>Rekuzita</small><strong>@Model.Sales.Where(s=>s.RequestId!=null).Sum(s=>s.Due).ToString("N2")</strong></div>
<div><small>Trajnime personale</small><strong>@Model.PersonalDue.ToString("N2")</strong></div>
@if(Model.SeasonalReserve>0){<div><small>Fonde sezonale</small><strong>@Model.SeasonalReserve.ToString("N2")</strong></div>}
</div>
<section class="panel mb-4"><div class="panel-heading"><h2>Faturat mujore</h2></div><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Muaji / fatura</th><th>Tarifa</th><th>Lirim / zbritje</th><th>Mbuluar</th><th>Borxh</th><th>Statusi</th><th></th></tr></thead><tbody>
@foreach(var invoice in Model.Invoices.OrderByDescending(i => i.Period.Year).ThenByDescending(i => i.Period.Month)){<tr><td><a asp-action="Invoice" asp-route-returnUrl="@(Context.Request.PathBase + Context.Request.Path + Context.Request.QueryString)" asp-route-id="@invoice.Period.Id">@invoice.MonthLabel</a><small class="balance-caption">@invoice.Number · @invoice.Period.FeePlanName</small>@if(invoice.Period.ProrationDescription != null){<small class="balance-caption">@invoice.Period.ProrationDescription</small>}</td><td>@invoice.Amount.ToString("N2")</td><td>@invoice.Exempted.ToString("N2")</td><td>@invoice.Paid.ToString("N2")</td><td>@invoice.Due.ToString("N2")</td><td><span class="status-pill @invoice.StatusClass">@invoice.Status</span></td><td>@if(User.IsInRole(Roles.Admin) && invoice.CanExempt){<a asp-action="Exempt" asp-route-id="@invoice.Period.Id" class="text-link">Liro nga tarifa</a>}</td></tr>}
@if(Model.Invoices.Count == 0){<tr><td colspan="7" class="text-secondary p-4">Nuk ka fatura të gjeneruara.</td></tr>}
</tbody></table></div></section>
@if(Model.Sales.Count>0){<section class="panel p-4 mb-4"><div class="d-flex justify-content-between mb-3"><h2>Rekuizitat e dorëzuara</h2></div><div class="table-responsive"><table class="table"><thead><tr><th>Dalja</th><th>Vlera neto</th><th>Arkëtuar</th><th>Borxh</th><th></th></tr></thead><tbody>@foreach(var sale in Model.Sales){<tr><td><a asp-controller="Sales" asp-action="Details" asp-route-id="@sale.Id">@sale.InvoiceNumber</a>@if(sale.WaiverReason != null){<small class="balance-caption">Lirim: @sale.WaiverReason</small>}</td><td>@sale.GrandTotal.ToString("N2")</td><td>@sale.AmountPaid.ToString("N2")</td><td>@sale.Due.ToString("N2")</td><td>@if(sale.Due > 0 && sale.RequestId != null){@if(User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Operator)){<a asp-controller="Sales" asp-action="Pay" asp-route-id="@sale.Id">Arkëto</a>}} <a asp-controller="Sales" asp-action="Print" asp-route-id="@sale.Id" class="ms-3">Printo</a></td></tr>}@if(Model.Sales.Count==0){<tr><td colspan="5">Nuk ka rekuizita të dorëzuara.</td></tr>}</tbody></table></div></section>}<section class="panel mb-4"><div class="panel-heading"><h2>Pagesat e regjistruara</h2></div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Nr. / data</th><th>Shuma</th><th>Mënyra</th><th>Shënimi</th><th>Regjistruar nga</th><th></th></tr></thead><tbody>
@foreach(var payment in Model.Payments){<tr><td>#@payment.Id · @BillingClock.LocalDate(payment.PaymentDate).ToString("dd.MM.yyyy")</td><td>@payment.Amount.ToString("N2") @if(payment.IsCancelled){<span class="text-danger">(Anuluar)</span>}</td><td>@BillingService.MethodLabel(payment.PaymentMethod)</td><td>@if(payment.SeasonalStartMonth.HasValue){<strong class="d-block">@payment.SeasonalLabel</strong><small class="balance-caption">Tarifa: @payment.SeasonalRate?.ToString("N2") / muaj</small>}@payment.Notes @if(payment.IsCancelled){<small class="balance-caption">Arsyeja: @payment.CancellationReason</small>}</td><td>@(payment.CreatedByUser?.UserName ?? "Sistemi")</td><td><a asp-action="Receipt" asp-route-returnUrl="@(Context.Request.PathBase + Context.Request.Path + Context.Request.QueryString)" asp-route-id="@payment.Id" class="text-link me-3">Printo arkëtimin</a>@if(User.IsInRole(Roles.Admin) && !payment.IsCancelled){<a asp-action="CancelPayment" asp-route-id="@payment.Id" class="text-danger">Anulo me arsye</a>}</td></tr>}
@if(Model.Payments.Count == 0){<tr><td colspan="6" class="text-secondary p-4">Ende nuk ka pagesa.</td></tr>}
</tbody></table></div></section>



@if(Model.PersonalTrainings.Count>0){<section class="panel p-4 mt-4"><div class="d-flex justify-content-between"><h2 class="h5">Trajnimet personale · Borxh @Model.PersonalDue.ToString("N2")</h2></div>@foreach(var t in Model.PersonalTrainings){<p><a asp-controller="PersonalTraining" asp-action="Details" asp-route-id="@t.Id">@t.Name</a> · @t.Schedule @(t.IsCancelled?"· Anuluar":"")</p>}<partial name="~/Views/PersonalTraining/_Charges.cshtml" model="Model.PersonalTrainings.SelectMany(x=>x.Charges).OrderByDescending(x=>x.Period)"/></section>}
@if(Model.FirstMonthChanges.Count>0){<details class="account-history panel"><summary>Ndryshimet e tarifës së muajit të parë</summary><div class="table-responsive"><table class="table"><thead><tr><th>Data / operatori</th><th>Shuma para</th><th>Shuma pas</th><th>Arsyeja</th></tr></thead><tbody>@foreach(var change in Model.FirstMonthChanges){<tr><td>@TimeZoneInfo.ConvertTimeFromUtc(change.CreatedAt,BillingClock.Zone).ToString("dd.MM.yyyy HH:mm")<small class="d-block">@change.Actor?.UserName</small></td><td>@change.PreviousAmount.ToString("N2")</td><td>@change.Amount.ToString("N2")</td><td>@change.Reason</td></tr>}</tbody></table></div></details>}
<details class="account-history panel"><summary>Historiku i kategorisë</summary><div class="table-responsive"><table class="table"><thead><tr><th>Nga muaji</th><th>Kategoria</th><th>Arsyeja / shënimi</th><th>Autori / data</th></tr></thead><tbody>@foreach(var entry in Model.FeeAssignments){var replaced=Model.FeeAssignments.Any(a=>a.EffectiveMonth==entry.EffectiveMonth && a.Id>entry.Id);<tr><td>@entry.EffectiveMonth.ToString("MM.yyyy")<small class="balance-caption">@(replaced?"Zëvendësuar":entry.EffectiveMonth>TariffService.CurrentMonth?"Planifikuar":"Historik / në fuqi")</small></td><td>@entry.FeePlan!.Name @if(entry.FamilyId.HasValue){<a class="d-block" asp-controller="Families" asp-action="Details" asp-route-id="@entry.FamilyId" asp-route-month="@entry.EffectiveMonth.ToString("yyyy-MM")">Familja · renditja @entry.FamilyOrder →</a>}</td><td>@entry.Reason<small class="balance-caption">@entry.Notes</small></td><td>@(entry.CreatedByUser?.UserName??"Sistemi")<small class="balance-caption">@TimeZoneInfo.ConvertTimeFromUtc(entry.CreatedAt,BillingClock.Zone).ToString("dd.MM.yyyy HH:mm")</small></td></tr>}@if(Model.FeeAssignments.Count==0){<tr><td colspan="4">Tarifa ekzistuese ruhet deri në caktimin e një kategorie.</td></tr>}</tbody></table></div></details>
<details class="account-history panel"><summary>Lirimet nga pagesa</summary><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Muaji</th><th>Lloji / arsyeja</th><th>Shuma</th><th>Miratuar nga / data</th><th></th></tr></thead><tbody>
@foreach(var exemption in Model.Exemptions){var reversed = Model.IsExemptionReversed(exemption.Id);<tr><td>@exemption.Month.ToString("00")/@exemption.Year</td><td><strong>@BillingService.TypeLabel(exemption.ExemptionType)</strong> · @exemption.Reason<small class="balance-caption">@exemption.Notes</small></td><td>@exemption.Amount.ToString("N2")</td><td>@(exemption.CreatedByUser?.UserName ?? "Sistemi")<small class="balance-caption">@TimeZoneInfo.ConvertTimeFromUtc(exemption.CreatedAt, BillingClock.Zone).ToString("dd.MM.yyyy HH:mm")</small></td><td>@if(reversed){<span class="text-secondary">I kthyer · shih historikun</span>}else if(User.IsInRole(Roles.Admin)){<a asp-action="ReverseExemption" asp-route-id="@exemption.Id" class="text-danger">Kthe lirimin</a>}</td></tr>}
@if(Model.Exemptions.Count == 0){<tr><td colspan="5" class="text-secondary p-4">Nuk ka lirime të regjistruara.</td></tr>}
</tbody></table></div></details>
<details class="account-history panel"><summary>Historiku financiar</summary><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Regjistruar më</th><th>Përshkrimi</th><th>Detyrim (+)</th><th>Kredit (−)</th><th>Bilanci</th><th>Autori</th></tr></thead><tbody>
@{decimal running = 0;}
@foreach(var item in Model.History){if(!item.IsCancelled){running += item.Debit-item.Credit;}<tr><td class="text-nowrap">@TimeZoneInfo.ConvertTimeFromUtc(item.CreatedAt, BillingClock.Zone).ToString("dd.MM.yyyy HH:mm")</td><td>@item.Description @if(item.IsCancelled){<span class="text-danger">(Anuluar)</span>}</td><td>@item.Debit.ToString("N2")</td><td>@item.Credit.ToString("N2")</td><td class="amount-cell">@running.ToString("N2")</td><td>@(item.CreatedByUser?.UserName ?? "Sistemi")</td></tr>}
</tbody></table></div></details>
</div>
@section PageNavigation {
    <a class="btn btn-outline-secondary app-back-button" asp-action="Index"><span aria-hidden="true">←</span><span>Mbrapa</span></a>
}
