@model SeasonalPaymentModel
@using _2Korriku.Services
@{ ViewData["Title"] = "Pagesë sezonale"; }
<link rel="stylesheet" href="~/css/seasonal-payment.css" asp-append-version="true"/><div class="seasonal-payment">

<div class="page-heading mt-3"><div><p class="eyebrow">PAGESA SEZONALE</p><h1>Pagesë sezonale</h1><p>@Model.StudentName</p></div></div>

@if(!ViewData.ModelState.IsValid){<div class="alert alert-danger seasonal-error" role="alert"><strong>Pagesa sezonale nuk mund të realizohet</strong><div asp-validation-summary="All"></div><a asp-action="Account" asp-route-id="@Model.StudentId">Kontrollo kartelën e lojtarit →</a></div>}
<form asp-action="Seasonal" method="get" class="card p-4 mb-4"><input type="hidden" name="returnUrl" value="@(ViewData["PaymentReturnUrl"] ?? Context.Request.Query["returnUrl"].ToString())"/>
    <input type="hidden" name="studentId" value="@Model.StudentId" />
    <div class="row g-3 align-items-end">
        <div class="col-md-5"><label for="season-start" class="form-label">Fillimi i sezonit</label><input id="season-start" name="startMonth" value="@Model.StartMonth" type="month" min="@TariffService.CurrentMonth.ToString("yyyy-MM")" max="@TariffService.CurrentMonth.AddMonths(24).ToString("yyyy-MM")" class="form-control" required /></div>
        <div class="col-md-4"><label for="season-months" class="form-label">Paketa</label><select id="season-months" name="months" class="form-select"><option value="6" selected="@(Model.Months == 6)">6 muaj · 1 muaj zbritje</option><option value="12" selected="@(Model.Months == 12)">12 muaj · 2 muaj zbritje</option></select></div>
        <div class="col-md-3"><button type="submit" class="btn btn-dark w-100">Llogarit sezonin</button></div>
    </div>
</form>
@if(Model.Quote is SeasonalQuote quote){
<section class="panel p-4 mb-4" aria-label="Përllogaritja e sezonit">
    <div class="seasonal-period"><h2>@quote.Start.ToString("MM.yyyy") – @quote.End.ToString("MM.yyyy")</h2><span>@quote.Months muaj mbulim · paguan @quote.PaidMonths</span></div>
    <div class="table-responsive"><table class="table"><tbody>
        <tr><th>Tarifa për një muaj</th><td class="text-end">@quote.Rate.ToString("N2")</td></tr>
        <tr><th>@quote.Months × @quote.Rate.ToString("N2")</th><td class="text-end">@quote.Gross.ToString("N2")</td></tr>
        <tr><th>Zbritja · @quote.FreeMonths muaj</th><td class="text-end text-success">− @quote.Discount.ToString("N2")</td></tr>
        <tr class="fw-bold"><th>Për t’u arkëtuar</th><td class="text-end fs-4">@quote.Total.ToString("N2")</td></tr>
    </tbody></table></div>
    <div class="seasonal-months">@for(var i=0;i<quote.Months;i++){<span class="@(i>=quote.PaidMonths?"seasonal-free":"")">@quote.Start.AddMonths(i).ToString("MM.yyyy")<small>@(i>=quote.PaidMonths?"Zbritje":"Me pagesë")</small></span>}</div><small class="text-secondary d-block mt-2">Borxhet jashtë kësaj periudhe paguhen veçmas. Mungesat nuk e zgjasin sezonin.</small>
</section>
<form asp-action="Seasonal" method="post" data-financial-confirm class="card p-4"><input type="hidden" name="returnUrl" value="@(ViewData["PaymentReturnUrl"] ?? Context.Request.Query["returnUrl"].ToString())"/>
    <p class="text-secondary bank-pending-hint" hidden>Bankë: pagesa dhe sezoni mbeten në pritje. Borxhi ulet vetëm pasi administratori konfirmon hyrjen në bankë.</p>
    <input asp-for="StudentId" type="hidden" /><input asp-for="RequestId" type="hidden" /><input asp-for="StartMonth" type="hidden" /><input asp-for="Months" type="hidden" /><input asp-for="ExpectedRate" type="hidden" />
    <div class="row g-3">
        <div class="col-md-6"><label asp-for="PaymentDate" class="form-label">Data e pagesës</label><input asp-for="PaymentDate" type="date" max="@BillingClock.Today.ToString("yyyy-MM-dd")" class="form-control" required /></div>
        <div class="col-md-6"><label asp-for="PaymentMethod" class="form-label">Mënyra e pagesës</label><select asp-for="PaymentMethod" class="form-select"><option value="Cash">Para në dorë</option><option value="Bank">Bankë</option></select></div>
        <div class="col-12"><label asp-for="Notes" class="form-label">Shënim / referencë bankare</label><textarea asp-for="Notes" class="form-control" rows="2" maxlength="250"></textarea></div>
    </div>
    <div class="d-flex justify-content-end gap-2 mt-4"><button type="submit" class="btn btn-primary">Arkëto @quote.Total.ToString("N2") dhe ruaj sezonin</button></div>
</form>
}
</div>

@section PageNavigation {
    <a class="btn btn-outline-secondary app-back-button" asp-action="Account" asp-route-id="@Model.StudentId"><span aria-hidden="true">←</span><span>Mbrapa</span></a>
}
@section Scripts {<script src="~/js/bank-pending-hint.js" asp-append-version="true"></script>}
