@model PlayerBillingModel
@using _2Korriku.Services
@{Layout="_PrintLayout";ViewData["Title"]="Kartela e lojtarit · "+Model.Student.FullName;decimal running=0;}
<link rel="stylesheet" href="~/css/player-print.css" asp-append-version="true" />
<div class="print-toolbar"><a asp-action="Account" asp-route-id="@Model.Student.Id">← Kartela e lojtarit</a><button type="button" onclick="window.print()">Printo A4 / Ruaj PDF</button></div>
<main class="stock-sheet player-print">
<header class="document-header"><div class="document-brand"><img src="~/images/fc-2-korriku.svg" alt="FC 2 Korriku" /><div><strong>FC 2 KORRIKU</strong><span>KARTELA E LOJTARIT</span></div></div><div class="document-heading"><span class="copy-label">KARTELA FINANCIARE</span><h1>@Model.Student.FullName</h1><strong>@(Model.Student.IsActive?"Aktiv":"Joaktiv") · #@Model.Student.Id</strong></div></header><div class="document-rule"></div>
<div class="document-metadata"><div><label>Datëlindja</label><strong>@Model.Student.DateOfBirth.ToString("dd.MM.yyyy")</strong></div><div><label>Regjistruar më</label><strong>@BillingClock.LocalDate(Model.Student.RegistrationDate).ToString("dd.MM.yyyy")</strong></div><div><label>Prindi / kontakti</label><strong>@Model.Student.ParentName · @Model.Student.ParentPhone</strong></div><div><label>Ekipi / tarifa aktuale</label><strong>@(Model.Student.TrainingTeam?.Name ?? "Pa ekip") · @Model.CurrentFeeName · @Model.Student.MonthlyFee.ToString("N2") € / muaj</strong></div></div>
@if(Model.Student.TrainingTeam is TrainingTeam team){<p class="document-notes">@team.Location · @string.Join(" · ",team.Sessions.OrderBy(s=>s.Day).ThenBy(s=>s.StartsAt).Select(s=>$"{TeamService.DayName(s.Day)} {s.StartsAt:HH:mm}–{s.EndsAt:HH:mm}"))</p>}
<div class="player-print-summary"><span>@(Model.AvailableBalance>0?"Borxh":Model.AvailableBalance<0?"Parapagim":"Bilanci") <strong>@Math.Abs(Model.AvailableBalance).ToString("N2") €</strong></span><span>Borxh mujor <strong>@Model.MonthlyDue.ToString("N2") €</strong></span><span>Fonde sezonale <strong>@Model.SeasonalReserve.ToString("N2") €</strong></span><span>Trajnime personale <strong>@Model.PersonalDue.ToString("N2") €</strong></span></div>
<p class="document-notes">Fondet sezonale janë të rezervuara për muajt e sezonit. Shumat e ndara më sipër shpjegojnë gjendjen dhe nuk mblidhen sërish me bilancin.</p>
@if(Model.CurrentFamilyId.HasValue){<p class="document-notes">Lojtari është në paketë familjare. Kjo kartelë paraqet vetëm pjesën e këtij lojtari; pagesat familjare kryhen bashkë.</p>}
<h2>Faturat mujore</h2>
<table class="document-table"><thead><tr><th>Muaji / fatura</th><th>Tarifa (€)</th><th>Lirim (€)</th><th>Mbuluar (€)</th><th>Borxh (€)</th></tr></thead><tbody>@foreach(var invoice in Model.Invoices.OrderBy(i=>i.Period.Year).ThenBy(i=>i.Period.Month)){<tr><td>@invoice.MonthLabel<small>@invoice.Number · @invoice.Period.FeePlanName</small></td><td>@invoice.Amount.ToString("N2")</td><td>@invoice.Exempted.ToString("N2")</td><td>@invoice.Paid.ToString("N2")</td><td>@invoice.Due.ToString("N2")</td></tr>}@if(Model.Invoices.Count==0){<tr><td colspan="5">Pa fatura mujore.</td></tr>}</tbody><tfoot><tr><th>Gjithsej</th><td>@Model.Invoices.Sum(i=>i.Amount).ToString("N2")</td><td>@Model.Invoices.Sum(i=>i.Exempted).ToString("N2")</td><td>@Model.Invoices.Sum(i=>i.Paid).ToString("N2")</td><td>@Model.MonthlyDue.ToString("N2")</td></tr></tfoot></table>
<h2>Pagesat e regjistruara</h2>
<table class="document-table"><thead><tr><th>Data / nr.</th><th>Mënyra</th><th>Shënimi / statusi</th><th>Shuma (€)</th></tr></thead><tbody>@foreach(var p in Model.Payments.OrderBy(p=>p.PaymentDate).ThenBy(p=>p.Id)){<tr><td>@BillingClock.LocalDate(p.PaymentDate).ToString("dd.MM.yyyy") · #@p.Id</td><td>@BillingService.MethodLabel(p.PaymentMethod)</td><td>@p.Notes @if(p.SeasonalStartMonth.HasValue){<small>@p.SeasonalLabel</small>}@if(p.IsCancelled){<small>ANULUAR · @p.CancellationReason</small>}</td><td>@p.Amount.ToString("N2")</td></tr>}@if(Model.Payments.Count==0){<tr><td colspan="4">Pa pagesa.</td></tr>}</tbody><tfoot><tr><th colspan="3">Gjithsej pagesa aktive</th><td>@Model.Payments.Where(p=>!p.IsCancelled).Sum(p=>p.Amount).ToString("N2")</td></tr></tfoot></table>
@if(Model.Sales.Count>0){<h2>Rekuizitat e dorëzuara</h2><table class="document-table"><thead><tr><th>Dokumenti</th><th>Vlera (€)</th><th>Paguar (€)</th><th>Borxh (€)</th></tr></thead><tbody>@foreach(var sale in Model.Sales){<tr><td>@sale.InvoiceNumber<small>@sale.WaiverReason</small></td><td>@sale.GrandTotal.ToString("N2")</td><td>@sale.AmountPaid.ToString("N2")</td><td>@sale.Due.ToString("N2")</td></tr>}</tbody></table>}
@if(Model.PersonalTrainings.Count>0){<h2>Trajnimet personale</h2><table class="document-table"><thead><tr><th>Trajnimi / periudha</th><th>Tarifa (€)</th><th>Paguar (€)</th><th>Lirim (€)</th><th>Borxh (€)</th></tr></thead><tbody>@foreach(var training in Model.PersonalTrainings){@foreach(var charge in training.Charges.OrderBy(c=>c.Period)){<tr><td>@training.Name · @charge.Period.ToString("MM.yyyy") @if(charge.IsCancelled){<small>Anuluar</small>}</td><td>@charge.Amount.ToString("N2")</td><td>@charge.Paid.ToString("N2")</td><td>@charge.Waived.ToString("N2")</td><td>@charge.Due.ToString("N2")</td></tr>}}</tbody></table>}
@if(Model.Exemptions.Count>0){<h2>Lirimet nga pagesa</h2><table class="document-table"><thead><tr><th>Muaji</th><th>Lloji / arsyeja</th><th>Shuma (€)</th></tr></thead><tbody>@foreach(var item in Model.Exemptions){<tr><td>@item.Month.ToString("00")/@item.Year</td><td>@BillingService.TypeLabel(item.ExemptionType) · @item.Reason @if(Model.IsExemptionReversed(item.Id)){<small>I kthyer</small>}</td><td>@item.Amount.ToString("N2")</td></tr>}</tbody></table>}
<h2>Historiku financiar</h2>
<table class="document-table"><thead><tr><th>Regjistruar më</th><th>Përshkrimi</th><th>Detyrim (€)</th><th>Kredit (€)</th><th>Bilanci (€)</th></tr></thead><tbody>@foreach(var item in Model.History){if(!item.IsCancelled){running+=item.Debit-item.Credit;}<tr><td>@TimeZoneInfo.ConvertTimeFromUtc(item.CreatedAt,BillingClock.Zone).ToString("dd.MM.yyyy HH:mm")</td><td>@item.Description @if(item.IsCancelled){<small>Anuluar</small>}</td><td>@item.Debit.ToString("N2")</td><td>@item.Credit.ToString("N2")</td><td>@running.ToString("N2")</td></tr>}@if(Model.History.Count==0){<tr><td colspan="5">Pa lëvizje financiare.</td></tr>}</tbody></table>
<p class="document-notes">Bilanci i historikut: vlerë pozitive = detyrim; vlerë negative = kredit. Fondet sezonale dhe detyrimet e trajnimeve shpjegohen në përmbledhjen e kartelës.</p>
<footer class="document-footer"><span>FC 2 Korriku · @Model.Student.FullName</span><span>Gjeneruar @TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow,BillingClock.Zone).ToString("dd.MM.yyyy HH:mm")</span></footer></main>
