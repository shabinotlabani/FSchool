@model RegisterPaymentModel
@{ ViewData["Title"] = "Regjistro pagesë mujore"; }
<div class="player-registration mx-auto"><div class="page-heading mt-3"><div><h1>Regjistro pagesë mujore</h1><p>@Model.StudentName</p></div></div>
<div class="billing-note">@(Model.Balance >= 0 ? "Bilanci mujor" : "Parapagim aktual"): <strong>@Math.Abs(Model.Balance).ToString("N2") €</strong></div>
<p class="mb-3"><a asp-action="Seasonal" asp-route-studentId="@Model.StudentId" class="btn btn-outline-primary">Pagesë sezonale · 6 ose 12 muaj</a></p>
<form asp-action="Register" method="post" class="card p-4 billing-form">
<div asp-validation-summary="All" class="text-danger" role="alert"></div><input asp-for="StudentId" type="hidden"/><input asp-for="RequestId" type="hidden"/>
<div class="row g-3"><div class="col-md-6"><label asp-for="Amount" class="form-label">Shuma (€) *</label><input asp-for="Amount" type="number" min="0.01" step="0.01" class="form-control" required/></div><div class="col-md-6"><label asp-for="PaymentDate" class="form-label">Data e pagesës *</label><input asp-for="PaymentDate" type="date" max="@_2Korriku.Services.BillingClock.Today.ToString("yyyy-MM-dd")" class="form-control" required/></div><div class="col-12"><label asp-for="PaymentMethod" class="form-label">Mënyra e pagesës</label><select asp-for="PaymentMethod" class="form-select"><option value="Cash">Para në dorë</option><option value="Bank">Bankë</option><option value="Other">Tjetër</option></select></div><div class="col-12"><label asp-for="Notes" class="form-label">Shënim / referencë bankare</label><textarea asp-for="Notes" rows="3" maxlength="250" class="form-control"></textarea></div></div>
<div class="d-flex justify-content-end gap-2 mt-4"><button type="submit" class="btn btn-primary">Ruaj pagesën</button></div></form></div>

@section PageNavigation {
    <a class="btn btn-outline-secondary app-back-button" asp-action="Account" asp-route-id="@Model.StudentId"><span aria-hidden="true">←</span><span>Mbrapa</span></a>
}
