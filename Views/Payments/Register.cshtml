@model RegisterPaymentModel
@{ ViewData["Title"] = "Pagesë mujore"; }
<link rel="stylesheet" href="~/css/payment-register.css" asp-append-version="true"/>
<div class="payment-register">
<div class="payment-heading"><div><h1>Pagesë mujore</h1><a asp-action="Account" asp-route-id="@Model.StudentId">@Model.StudentName</a></div><a asp-action="Seasonal" asp-route-returnUrl="@(Context.Request.PathBase + Context.Request.Path + Context.Request.QueryString)" asp-route-studentId="@Model.StudentId" class="payment-seasonal">Pagesë sezonale →</a></div>
<form asp-action="Register" method="post" data-financial-confirm data-automatic-bank="@(Model.AutomaticBankAmount>0?"true":"false")" class="panel payment-form"><input type="hidden" name="returnUrl" value="@(ViewData["PaymentReturnUrl"] ?? Context.Request.Query["returnUrl"].ToString())"/>
<div class="payment-balance"><span>@(Model.Balance > 0 ? "Borxh mujor" : Model.Balance < 0 ? "Parapagim aktual" : "Bilanci mujor")</span><strong class="@(Model.Balance>0?"text-danger":"text-success")">@Math.Abs(Model.Balance).ToString("N2")</strong></div>
<div class="payment-fields">
<div asp-validation-summary="All" class="text-danger" role="alert"></div><input asp-for="StudentId" type="hidden"/><input asp-for="RequestId" type="hidden"/>
<div class="row g-3">
<div class="col-sm-6"><label asp-for="Amount" class="form-label">Shuma *</label><input asp-for="Amount" type="number" min="0.01" step="0.01" inputmode="decimal" class="form-control payment-amount" required/></div>
<div class="col-sm-6"><label asp-for="PaymentDate" class="form-label">Data *</label><input asp-for="PaymentDate" type="date" max="@_2Korriku.Services.BillingClock.Today.ToString("yyyy-MM-dd")" class="form-control" required/></div>
<div class="col-12"><fieldset class="payment-methods"><legend>Mënyra e pagesës</legend><div class="payment-method-options">
<input asp-for="PaymentMethod" type="radio" value="Cash" id="method-cash" required/><label for="method-cash">Cash</label>
<input asp-for="PaymentMethod" type="radio" value="Bank" id="method-bank" required/><label for="method-bank">Bankë</label>
</div></fieldset>@if(Model.AutomaticBankAmount>0){<p class="text-secondary small">Në pritje automatikisht: <strong>@Model.AutomaticBankAmount.ToString("N2")</strong>. Për pagesë Cash, ndryshoni mënyrën.</p>}<small class="text-secondary bank-pending-hint" hidden>Bankë: ruhet në pritje. Borxhi mbetet deri në konfirmimin nga administratori.</small></div>
<div class="col-12"><label asp-for="Notes" class="form-label">Shënim / referencë <span class="text-secondary fw-normal">(opsionale)</span></label><input asp-for="Notes" maxlength="250" class="form-control"/></div>
</div>
<div class="payment-submit"><button type="submit" class="btn btn-primary">Ruaj pagesën</button></div>
</div></form></div>
@section Scripts {<script src="~/js/bank-pending-hint.js" asp-append-version="true"></script>}
@section PageNavigation {
<a class="btn btn-outline-secondary app-back-button" asp-action="Account" asp-route-id="@Model.StudentId"><span aria-hidden="true">←</span><span>Mbrapa</span></a>
}
