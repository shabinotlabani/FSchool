@model List<OtherDebt>
@if(Model.Count>0){
<section class="panel mt-3" id="other-debts"><div class="panel-heading"><div><h2>Borxhe të tjera</h2><small class="text-secondary">Gjendja aktuale · të gjithë muajt</small></div><strong class="text-danger">@Model.Sum(x=>x.Due).ToString("N2")</strong></div>
<div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Lojtari</th><th>Lloji / dokumenti</th><th>Borxhi</th><th></th></tr></thead><tbody>
@foreach(var debt in Model){<tr><td><a asp-controller="Payments" asp-action="Account" asp-route-id="@debt.StudentId">@debt.StudentName</a></td><td>@debt.Category<small class="balance-caption">@debt.Document</small></td><td class="text-danger fw-semibold">@debt.Due.ToString("N2")</td><td>@if(User.IsInRole(Roles.Admin)||User.IsInRole(Roles.Operator)){<a class="btn btn-sm btn-outline-primary" asp-controller="@debt.Controller" asp-action="@debt.Action" asp-route-id="@debt.Id">@(debt.Action=="Pay"?"Paguaj":"Shiko dokumentin")</a>}else{<a asp-controller="Payments" asp-action="Account" asp-route-id="@debt.StudentId">Kartela</a>}</td></tr>}
</tbody></table></div></section>
}
