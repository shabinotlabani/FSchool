@model TeamEditModel
@using _2Korriku.Services
@{ViewData["Title"]=Model.Id==0?"Ekip i ri":"Ndrysho ekipin";}
<div class="page-heading mt-3"><div><p class="eyebrow">ADMINISTRIMI I EKIPEVE</p><h1>@ViewData["Title"]</h1></div></div>
<form asp-action="Save" method="post" class="panel p-4"><input asp-for="Id" type="hidden"/><input asp-for="Revision" type="hidden"/><div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div><div class="row g-3"><div class="col-md-6"><label asp-for="Name" class="form-label">Emri i ekipit</label><input asp-for="Name" class="form-control" maxlength="100" placeholder="p.sh. Ekipi 6–8" required/></div><div class="col-md-6"><label asp-for="FootballFieldId" class="form-label">Fusha e stërvitjes</label><select asp-for="FootballFieldId" class="form-select"><option value="">Pa fushë të caktuar</option>@foreach(var field in Model.Fields){<option value="@field.Id">@field.Name @(field.IsActive ? "" : "(Joaktive)")</option>}</select><small class="text-secondary">Vlen për të gjitha seancat javore. Disa ekipe mund të ndajnë të njëjtën fushë dhe orar.</small></div><div class="col-md-6"><label asp-for="Location" class="form-label">Vendndodhje shtesë (opsionale)</label><input asp-for="Location" class="form-control" maxlength="200"/></div><div class="col-md-4"><label asp-for="MinAge" class="form-label">Nga mosha (vjeç)</label><input asp-for="MinAge" type="number" min="0" max="100" class="form-control" required/></div><div class="col-md-4"><label asp-for="MaxAge" class="form-label">Deri në moshën (përfshihet)</label><input asp-for="MaxAge" type="number" min="0" max="100" class="form-control" required/></div><div class="col-md-4"><label asp-for="Capacity" class="form-label">Maksimumi i lojtarëve</label><input asp-for="Capacity" type="number" min="1" max="1000" class="form-control" required/></div><div class="col-12"><label class="d-flex gap-2 align-items-center"><input asp-for="IsActive"/> Ekip aktiv për regjistrime</label></div></div>
<div class="row g-3 mt-2"><div class="col-md-6"><label asp-for="CoachId" class="form-label">Trajneri kryesor *</label><select asp-for="CoachId" class="form-select" required><option value="">Zgjidhni trajnerin</option>@foreach(var coach in Model.Coaches){<option value="@coach.Id">@coach.FirstName @coach.LastName · @coach.Email</option>}</select><span asp-validation-for="CoachId" class="text-danger"></span></div><div class="col-md-6"><label asp-for="AssistantCoachId" class="form-label">Ndihmëstrajneri *</label><select asp-for="AssistantCoachId" class="form-select" required><option value="">Zgjidhni ndihmëstrajnerin</option>@foreach(var coach in Model.Coaches){<option value="@coach.Id">@coach.FirstName @coach.LastName · @coach.Email</option>}</select><span asp-validation-for="AssistantCoachId" class="text-danger"></span></div></div>
@if(Model.Coaches.Count<2){<p class="text-danger mt-3">Duhen të paktën dy trajnerë aktivë. <a asp-controller="Users" asp-action="Create" asp-route-role="@Roles.Coach">Regjistro trajner</a></p>}
<div class="d-flex justify-content-between align-items-center border-top pt-4 mt-4 mb-3"><h2 class="h5 mb-0">Ditët dhe oraret e stërvitjeve</h2><button id="add-session" type="button" class="btn btn-outline-primary">+ Shto seancë</button></div><div class="table-responsive"><table class="table"><thead><tr><th>Dita</th><th>Fillimi</th><th>Përfundimi</th><th></th></tr></thead><tbody id="sessions">@for(var i=0;i<Model.Sessions.Count;i++){<tr><td><select asp-for="Sessions[i].Day" data-session-field="Day" class="form-select" required>@for(var day=1;day<=7;day++){<option value="@day">@TeamService.DayName(day)</option>}</select></td><td><input asp-for="Sessions[i].StartsAt" data-session-field="StartsAt" type="time" asp-format="{0:HH:mm}" class="form-control" step="60" required/></td><td><input asp-for="Sessions[i].EndsAt" data-session-field="EndsAt" type="time" asp-format="{0:HH:mm}" class="form-control" step="60" required/></td><td><button type="button" class="btn btn-outline-danger remove-session" aria-label="Hiq seancën">×</button></td></tr>}</tbody></table></div>
<label asp-for="Notes" class="form-label">Shënime (opsionale)</label><textarea asp-for="Notes" class="form-control mb-3" maxlength="500" rows="2"></textarea>@if(Model.Id!=0){<label asp-for="Reason" class="form-label">Arsyeja e ndryshimit</label><input asp-for="Reason" class="form-control mb-3" maxlength="200" required/>}<div class="d-flex gap-2 mt-4"><button class="btn btn-primary">Ruaj ekipin dhe orarin</button></div></form>
@section Scripts{<script src="~/js/team-editor.js" asp-append-version="true"></script>}

@section PageNavigation {
    <a class="btn btn-outline-secondary app-back-button" asp-action="Index"><span aria-hidden="true">←</span><span>Mbrapa</span></a>
}
