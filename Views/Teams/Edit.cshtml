@model TeamEditModel
@using _2Korriku.Services
@{ViewData["Title"]=Model.Id==0?"Ekip i ri":"Ndrysho ekipin";}
<div class="page-heading mt-3"><div><p class="eyebrow">ADMINISTRIMI I EKIPEVE</p><h1>@ViewData["Title"]</h1></div></div>
<form asp-action="Save" method="post" class="panel p-4"><input asp-for="Id" type="hidden"/><input asp-for="Revision" type="hidden"/><div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div><div class="row g-3"><div class="col-md-6"><label asp-for="Name" class="form-label">Emri i ekipit</label><input asp-for="Name" class="form-control" maxlength="100" placeholder="p.sh. Ekipi 6–8" required/></div><div class="col-md-6"><label asp-for="FootballFieldId" class="form-label">Fusha e stërvitjes</label><select asp-for="FootballFieldId" class="form-select"><option value="">Pa fushë të caktuar</option>@foreach(var field in Model.Fields){<option value="@field.Id">@field.Name @(field.IsActive ? "" : "(Joaktive)")</option>}</select><small class="text-secondary">Vlen për të gjitha seancat javore. Disa ekipe mund të ndajnë të njëjtën fushë dhe orar.</small></div><div class="col-md-6"><label asp-for="Location" class="form-label">Vendndodhje shtesë (opsionale)</label><input asp-for="Location" class="form-control" maxlength="200"/></div><div class="col-md-4"><label asp-for="Capacity" class="form-label">Maksimumi i lojtarëve</label><input asp-for="Capacity" type="number" min="1" max="1000" class="form-control" required/></div><div class="col-12"><label class="d-flex gap-2 align-items-center"><input asp-for="IsActive"/> Ekip aktiv për regjistrime</label></div></div>
<div class="row g-3 mt-2"><div class="col-md-6"><label asp-for="Gender" class="form-label">Gjinia e ekipit</label><select asp-for="Gender" class="form-select"><option value="Male">Meshkuj</option><option value="Female">Femra</option><option value="Mixed">Përzier</option></select></div></div>
<div class="row g-3 mt-2">
<div class="col-md-6"><label asp-for="CoachId" class="form-label">Trajneri kryesor *</label><select asp-for="CoachId" class="form-select" required><option value="">Zgjidhni trajnerin</option>@foreach(var coach in Model.Coaches){<option value="@coach.Id">@coach.FirstName @coach.LastName · @coach.Email</option>}</select><span asp-validation-for="CoachId" class="text-danger"></span></div>
<div class="col-md-6 team-assistants">
<div class="d-flex align-items-center justify-content-between gap-2 mb-2"><label class="form-label mb-0">Ndihmëstrajnerët</label><button id="add-assistant" type="button" class="btn btn-sm btn-outline-primary">+ Shto trajner</button></div>
<div id="assistant-list">@for(var i=0;i<Model.AssistantCoachIds.Count;i++){<div class="assistant-row"><select name="AssistantCoachIds" class="form-select" aria-label="Ndihmëstrajneri"><option value="">Zgjidhni trajnerin</option>@foreach(var coach in Model.Coaches){<option value="@coach.Id" selected="@(coach.Id==Model.AssistantCoachIds[i])">@coach.FirstName @coach.LastName</option>}</select><button type="button" class="assistant-remove" aria-label="Hiq trajnerin">−</button></div>}</div>
<template id="assistant-template"><div class="assistant-row"><select name="AssistantCoachIds" class="form-select" aria-label="Ndihmëstrajneri"><option value="">Zgjidhni trajnerin</option>@foreach(var coach in Model.Coaches){<option value="@coach.Id">@coach.FirstName @coach.LastName</option>}</select><button type="button" class="assistant-remove" aria-label="Hiq trajnerin">−</button></div></template>
<small class="text-secondary">Opsionale. Mund të shtoni disa.</small>
</div>
<div class="col-md-6"><label asp-for="DoctorId" class="form-label">Mjeku</label><select asp-for="DoctorId" class="form-select"><option value="">Pa mjek të caktuar</option>@foreach(var user in Model.Doctors){<option value="@user.Id">@user.FirstName @user.LastName</option>}</select></div>
<div class="col-md-6"><label asp-for="PsychologistId" class="form-label">Psikologu</label><select asp-for="PsychologistId" class="form-select"><option value="">Pa psikolog të caktuar</option>@foreach(var user in Model.Psychologists){<option value="@user.Id">@user.FirstName @user.LastName</option>}</select></div>
</div>
@if(Model.Coaches.Count<1){<p class="text-danger mt-3">Duhet të paktën një trajner aktiv. <a asp-controller="Users" asp-action="Create" asp-route-role="@Roles.Coach">Regjistro trajner</a></p>}
<div class="d-flex justify-content-between align-items-center border-top pt-4 mt-4 mb-3"><h2 class="h5 mb-0">Ditët dhe oraret e stërvitjeve</h2><button id="add-session" type="button" class="btn btn-outline-primary">+ Shto seancë</button></div><div class="table-responsive"><table class="table"><thead><tr><th>Dita</th><th>Fillimi</th><th>Përfundimi</th><th></th></tr></thead><tbody id="sessions">@for(var i=0;i<Model.Sessions.Count;i++){<tr><td><select asp-for="Sessions[i].Day" data-session-field="Day" class="form-select" required>@for(var day=1;day<=7;day++){<option value="@day">@TeamService.DayName(day)</option>}</select></td><td><input asp-for="Sessions[i].StartsAt" data-session-field="StartsAt" type="time" asp-format="{0:HH:mm}" class="form-control" step="60" required/></td><td><input asp-for="Sessions[i].EndsAt" data-session-field="EndsAt" type="time" asp-format="{0:HH:mm}" class="form-control" step="60" required/></td><td><button type="button" class="btn btn-outline-danger remove-session" aria-label="Hiq seancën">×</button></td></tr>}</tbody></table></div>
<label asp-for="Notes" class="form-label">Shënime (opsionale)</label><textarea asp-for="Notes" class="form-control mb-3" maxlength="500" rows="2"></textarea>@if(Model.Id!=0){<label asp-for="Reason" class="form-label">Arsyeja e ndryshimit</label><input asp-for="Reason" class="form-control mb-3" maxlength="200" required/>}<div class="d-flex gap-2 mt-4"><button class="btn btn-primary">Ruaj ekipin dhe orarin</button></div></form>
@section Scripts{<script src="~/js/team-editor.js" asp-append-version="true"></script>}

@section PageNavigation {
    <a class="btn btn-outline-secondary app-back-button" asp-action="Index"><span aria-hidden="true">←</span><span>Mbrapa</span></a>
}
