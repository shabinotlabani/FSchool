@model TeamDetailsModel
@using _2Korriku.Services
@{ViewData["Title"]=Model.Team.Name;var active=Model.Team.Students.Count(s=>s.IsActive);}
<link rel="stylesheet" href="~/css/teams.css" asp-append-version="true"/>
@if(User.IsInRole(Roles.Admin)){<a class="btn btn-outline-primary mb-3" asp-controller="Attendance" asp-action="Index" asp-route-teamId="@Model.Team.Id">Prezenca e lojtarëve</a>}
<div class="page-heading mt-3"><div><p class="eyebrow">@Model.Team.MinAge–@Model.Team.MaxAge VJEÇ · @(Model.Team.IsActive?"AKTIV":"JOAKTIV")</p><h1>@Model.Team.Name</h1><p>@active / @Model.Team.Capacity lojtarë aktivë · @Math.Max(0,Model.Team.Capacity-active) vende të lira</p></div>@if(User.IsInRole(Roles.Admin)){<a asp-action="Edit" asp-route-id="@Model.Team.Id" class="btn btn-primary">Ndrysho ekipin / orarin</a>}</div>
@if(TempData["Success"] is string message){<div class="alert alert-success">@message</div>}
<section class="panel p-4 mb-4"><partial name="_Coaches" model="Model.Team"/><h2 class="h5">Orari javor i stërvitjeve</h2><p>@if(Model.Team.FootballField != null){<a asp-controller="Fields" asp-action="Index" asp-route-fieldId="@Model.Team.FootballFieldId">@Model.Team.FootballField.Name</a>}else{<span>Pa fushë të caktuar</span>} · @Model.Team.Location</p><ul class="team-schedule">@foreach(var s in Model.Team.Sessions.OrderBy(s=>s.Day).ThenBy(s=>s.StartsAt)){<li><span>@TeamService.DayName(s.Day)</span><strong>@s.StartsAt.ToString("HH:mm") – @s.EndsAt.ToString("HH:mm")</strong></li>}</ul><p class="text-secondary mb-0">@Model.Team.Notes</p></section>
<section class="panel mb-4"><div class="panel-heading"><h2>Lojtarët e ekipit</h2></div><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Lojtari</th><th>Datëlindja / mosha</th><th>Prindi / telefoni</th><th>Statusi</th><th></th></tr></thead><tbody>@foreach(var s in Model.Team.Students.OrderBy(s=>s.LastName).ThenBy(s=>s.FirstName)){var age=TeamService.Age(s.DateOfBirth);<tr><td><a asp-controller="Payments" asp-action="Account" asp-route-id="@s.Id">@s.FullName</a></td><td>@s.DateOfBirth.ToString("dd.MM.yyyy") · @age vjeç @if(age<Model.Team.MinAge||age>Model.Team.MaxAge){<small class="balance-caption text-warning">Jashtë grupmoshës aktuale · kontrolloni ekipin</small>}</td><td>@s.ParentName<small class="balance-caption">@s.ParentPhone</small></td><td>@(s.IsActive?"Aktiv":"Joaktiv")</td><td>@if(User.IsInRole(Roles.Admin)||User.IsInRole(Roles.Operator)){<a asp-action="Assign" asp-route-id="@s.Id">Ndrysho ekipin</a>}</td></tr>}@if(Model.Team.Students.Count==0){<tr><td colspan="5" class="p-4 text-secondary">Ende nuk ka lojtarë. Ekipi propozohet gjatë regjistrimit sipas datëlindjes.</td></tr>}</tbody></table></div></section>
<section class="panel p-4 mb-4"><h2 class="h5">Historiku i caktimeve</h2><div class="table-responsive"><table class="table"><thead><tr><th>Data / autori</th><th>Lojtari</th><th>Nga → Në</th><th>Arsyeja</th></tr></thead><tbody>@foreach(var c in Model.MembershipHistory){<tr><td>@TimeZoneInfo.ConvertTimeFromUtc(c.CreatedAt,BillingClock.Zone).ToString("dd.MM.yyyy HH:mm")<small class="balance-caption">@(c.Actor?.UserName??"Sistemi")</small></td><td>@c.Student?.FullName</td><td>@(c.FromTeamName??"Pa ekip") → @(c.ToTeamName??"Pa ekip")</td><td>@c.Reason</td></tr>}</tbody></table></div></section>
<section class="panel p-4"><h2 class="h5">Historiku i ekipit dhe orarit</h2>@foreach(var c in Model.History){<div class="border-bottom py-3"><strong>@c.Reason</strong><p class="my-2">@c.Snapshot</p><small class="text-secondary">@(c.Actor?.UserName??"Sistemi") · @TimeZoneInfo.ConvertTimeFromUtc(c.CreatedAt,BillingClock.Zone).ToString("dd.MM.yyyy HH:mm")</small></div>}</section>

@section PageNavigation {
    <a class="btn btn-outline-secondary app-back-button" asp-action="Index"><span aria-hidden="true">←</span><span>Mbrapa</span></a>
}
