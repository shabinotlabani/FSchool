@model List<TeamOption>
@using _2Korriku.Services
@{ViewData["Title"]="Ekipet dhe oraret";}
<link rel="stylesheet" href="~/css/teams.css" asp-append-version="true"/>
<div class="page-heading"><div><p class="eyebrow">SHKOLLA E FUTBOLLIT</p><h1>Ekipet dhe oraret</h1></div>@if(User.IsInRole(Roles.Admin)){<a asp-action="Create" class="btn btn-primary">+ Ekip i ri</a>}</div>
<form method="get" class="search-panel d-flex gap-3 flex-wrap align-items-center"><input name="search" type="search" value="@ViewData["Search"]" class="form-control" style="max-width:420px" placeholder="Kërko ekipin…" aria-label="Kërko ekip"/><label class="d-flex gap-2 align-items-center"><input type="checkbox" name="includeInactive" value="true" checked="@((bool?)ViewData["IncludeInactive"]==true)"/> Përfshi ekipet joaktive</label><button class="btn btn-dark">Kërko</button></form>
<div class="team-grid">@foreach(var row in Model){<article class="panel team-card"><div class="team-card-top"><span class="team-age">@row.Team.MinAge–@row.Team.MaxAge vjeç</span><span class="status-pill @(row.Team.IsActive&&row.FreePlaces>0?"status-active":"status-inactive")">@(!row.Team.IsActive?"Joaktiv":row.FreePlaces==0?"I mbushur":row.FreePlaces+" vende të lira")</span></div><h2><a asp-action="Details" asp-route-id="@row.Team.Id">@row.Team.Name</a></h2><p class="text-secondary">@(row.Team.FootballField?.Name ?? (string.IsNullOrWhiteSpace(row.Team.Location)?"Pa fushë të caktuar":row.Team.Location))</p><ul class="team-schedule">@foreach(var s in row.Team.Sessions.OrderBy(s=>s.Day).ThenBy(s=>s.StartsAt)){<li><span>@TeamService.DayName(s.Day)</span><strong>@s.StartsAt.ToString("HH:mm") – @s.EndsAt.ToString("HH:mm")</strong></li>}</ul><div class="team-capacity"><span>@row.Enrolled / @row.Team.Capacity lojtarë aktivë</span><progress value="@row.Enrolled" max="@row.Team.Capacity" aria-label="Vendet e zëna"></progress></div><a asp-action="Details" asp-route-id="@row.Team.Id" class="btn btn-outline-primary w-100">Hap ekipin →</a></article>}</div>
@if(Model.Count==0){<div class="panel empty-panel"><strong>Nuk ka ekipe për këtë kërkim.</strong></div>}
