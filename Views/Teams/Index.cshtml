@model List<TeamOption>
@using _2Korriku.Services
@{ViewData["Title"]="Ekipet dhe oraret";}
<link rel="stylesheet" href="~/css/teams.css" asp-append-version="true"/>
<div class="team-workspace"><div class="page-heading"><h1>Ekipet dhe oraret</h1>@if(User.IsInRole(Roles.Admin)){<div class="d-flex gap-2"><a asp-controller="Leagues" asp-action="Index" class="btn btn-outline-primary">Menaxho garat</a><a asp-action="Create" class="btn btn-primary">+ Ekip i ri</a></div>}</div>
<form method="get" class="search-panel d-flex gap-3 flex-wrap align-items-center"><input name="search" type="search" value="@ViewData["Search"]" class="form-control" style="max-width:420px" placeholder="Kërko ekipin…" aria-label="Kërko ekip"/><label class="d-flex gap-2 align-items-center"><input type="checkbox" name="includeInactive" value="true" checked="@((bool?)ViewData["IncludeInactive"]==true)"/> Përfshi ekipet joaktive</label><button class="btn btn-dark">Kërko</button></form>
<div class="panel table-responsive" tabindex="0" role="region" aria-label="Ekipet dhe oraret">
<table class="table team-list"><thead><tr><th>Ekipi</th><th>Trajnerët</th><th>Fusha</th><th>Orari</th><th>Lojtarë</th><th>Statusi</th><th></th></tr></thead><tbody>
@foreach(var row in Model){
<tr><td><a asp-action="Details" asp-route-id="@row.Team.Id"><strong>@row.Team.Name</strong></a>@foreach(var league in ((List<LeagueTeam>)ViewData["Leagues"]!).Where(l=>l.TrainingTeamId==row.Team.Id)){<small class="d-block text-secondary">@league.League.Name</small>}</td>
<td><span class="d-block">@(row.Team.Coach==null?"Pa trajner":row.Team.Coach.FirstName+" "+row.Team.Coach.LastName)</span>@if(row.Team.AssistantCoach!=null){<small class="d-block text-secondary">@row.Team.AssistantCoach.FirstName @row.Team.AssistantCoach.LastName · Ndihmëstrajner</small>}</td>
<td>@(row.Team.FootballField?.Name ?? (string.IsNullOrWhiteSpace(row.Team.Location)?"Pa fushë të caktuar":row.Team.Location))</td>
<td><ul class="team-schedule">@foreach(var s in row.Team.Sessions.OrderBy(s=>s.Day).ThenBy(s=>s.StartsAt)){<li><span>@TeamService.DayName(s.Day)</span><strong>@s.StartsAt.ToString("HH:mm") – @s.EndsAt.ToString("HH:mm")</strong></li>}</ul></td>
<td><div class="team-capacity"><span>@row.Enrolled / @row.Team.Capacity</span><progress value="@row.Enrolled" max="@row.Team.Capacity" aria-label="Vendet e zëna"></progress></div></td>
<td><span class="status-pill @(row.Team.IsActive&&row.FreePlaces>0?"status-active":"status-inactive")">@(!row.Team.IsActive?"Joaktiv":row.FreePlaces==0?"I mbushur":row.FreePlaces+" vende të lira")</span></td><td><div class="team-row-actions"><a asp-action="Details" asp-route-id="@row.Team.Id">Hap ekipin</a>@if(User.IsInRole(Roles.Admin)){<a asp-action="Minutes" asp-route-id="@row.Team.Id">Minutazhi</a>}</div></td></tr>
}
@if(Model.Count==0){<tr><td colspan="7" class="text-center py-4">Nuk ka ekipe për këtë kërkim.</td></tr>}
</tbody></table></div>
</div>
