@model List<PlayerContract>
@using _2Korriku.Services
@{ViewData["Title"]="Kontratat";var today=BillingClock.Today;}
<link rel="stylesheet" href="~/css/contracts.css" asp-append-version="true"/>
<div class="contracts-page"><div class="page-heading"><div><h1>Kontratat</h1><p>Pagat bruto dhe afatet</p></div><div class="d-flex gap-2"><a asp-action="Staff" class="btn btn-outline-secondary">Personat</a><a asp-controller="Sponsorships" asp-action="Salaries" class="btn btn-outline-secondary">Sponsorizimet</a><a asp-action="Create" class="btn btn-primary">+ Kontratë</a></div></div>
<form class="contract-filter" method="get"><select name="status" class="form-select" aria-label="Statusi"><option value="">Të gjitha</option><option value="Active" selected="@((string?)ViewData["Status"]=="Active")">Aktive</option><option value="Expiring" selected="@((string?)ViewData["Status"]=="Expiring")">Skadojnë brenda 30 ditësh</option></select><button class="btn btn-outline-secondary">Shfaq</button></form>
<div class="table-responsive"><table class="table align-middle"><thead><tr><th>Personi</th><th>Paga bruto</th><th>Fillimi</th><th>Skadimi</th><th>Statusi</th><th></th></tr></thead><tbody>
@foreach(var c in Model){var end=c.EffectiveEnd;var days=end.DayNumber-today.DayNumber;<tr><td><strong>@c.PersonName</strong><small class="d-block text-secondary">@c.CategoryName</small></td><td>@c.SalaryOn(today).ToString("N2")</td><td>@c.StartsOn.ToString("dd/MM/yyyy")</td><td><strong>@end.ToString("dd/MM/yyyy")</strong>@if(days>=0&&days<=30){<small class="d-block text-danger">@days ditë</small>}</td><td>@(c.Status=="Draft"?"Draft":end<today?"Skaduar":c.StartsOn>today?"E planifikuar":days<=30?"Afër skadimit":"Aktive")</td><td><a asp-action="Details" asp-route-id="@c.Id" class="btn btn-sm btn-outline-secondary">Hap</a></td></tr>}@if(Model.Count==0){<tr><td colspan="6">Nuk ka kontrata.</td></tr>}
</tbody></table></div></div>
