@model PlayerContract
@using _2Korriku.Services
@{ViewData["Title"]="Kontrata · "+Model.PersonName;var today=BillingClock.Today;var days=Model.EffectiveEnd.DayNumber-today.DayNumber;var currentSalary=Model.SalaryOn(today);}
<link rel="stylesheet" href="~/css/contracts.css" asp-append-version="true"/>
<div class="contracts-page contract-simple-detail">
@if(TempData["Success"] is string success){<div class="alert alert-success">@success</div>}@if(TempData["Error"] is string error){<div class="alert alert-danger">@error</div>}
<div class="page-heading"><div><h1>@Model.PersonName</h1><p>@Model.CategoryName · @(Model.Status=="Draft"?"Draft":Model.EffectiveEnd<today?"E skaduar":days<=30?"Afër skadimit":"Aktive")</p></div><div class="d-flex flex-wrap gap-2">@if(Model.Status=="Draft"){<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Ndrysho draftin</a>}<a asp-action="Print" asp-route-id="@Model.Id" class="btn btn-outline-primary">Kontrata A4</a>@if(Model.Status!="Draft"&&Model.EffectiveEnd>=today){<a asp-action="Annex" asp-route-id="@Model.Id" class="btn btn-primary">+ Aneks</a>}</div></div>
<div class="contract-summary-grid"><div><span>Paga bruto aktuale</span><strong>@currentSalary.ToString("N2")</strong></div><div><span>Fillimi</span><strong>@Model.StartsOn.ToString("dd.MM.yyyy")</strong></div><div><span>Skadimi</span><strong>@Model.EffectiveEnd.ToString("dd.MM.yyyy")</strong>@if(days>=0&&days<=30){<small>@days ditë të mbetura</small>}</div></div>
<details class="contract-number-editor"><summary>Numri i kontratës · <strong>@Model.Number</strong></summary><form asp-action="ChangeNumber" method="post" class="contract-number-form"><input type="hidden" name="id" value="@Model.Id"/><input type="hidden" name="revision" value="@Model.Revision"/><label>Numri manual<input name="number" value="@Model.Number" maxlength="80" class="form-control"/></label><div><button class="btn btn-outline-secondary" name="automatic" value="false">Ruaj numrin</button><button class="btn btn-outline-primary" name="automatic" value="true">Gjenero automatik</button></div></form></details>
<section class="contract-annexes"><div class="contract-section-title"><h2>Anekset</h2><span>@Model.Annexes.Count</span></div>
<div class="table-responsive"><table class="table align-middle"><thead><tr><th>Numri</th><th>Në fuqi nga</th><th>Paga e mëparshme</th><th>Paga e re</th><th>Statusi</th><th></th></tr></thead><tbody>@foreach(var a in Model.Annexes.OrderByDescending(x=>x.EffectiveOn)){<tr><td><strong>@a.Number</strong><small class="d-block text-secondary">@a.Reason</small></td><td>@a.EffectiveOn.ToString("dd.MM.yyyy")</td><td>@a.PreviousGrossSalary.ToString("N2")</td><td><strong>@a.NewGrossSalary.ToString("N2")</strong></td><td>@(a.Status=="Draft"?"Draft":"Aktiv")</td><td class="text-nowrap"><a asp-action="PrintAnnex" asp-route-id="@a.Id" class="btn btn-sm btn-outline-secondary">A4</a>@if(a.Status=="Draft"){<a asp-action="EditAnnex" asp-route-id="@a.Id" class="btn btn-sm btn-outline-primary ms-1">Ndrysho</a>}</td></tr>}@if(Model.Annexes.Count==0){<tr><td colspan="6">Nuk ka anekse.</td></tr>}</tbody></table></div></section>
<a class="btn btn-outline-secondary mt-3" asp-controller="Sponsorships" asp-action="Salaries">Shiko te Sponsorizimet</a>
</div>
@section PageNavigation {<a class="btn btn-outline-secondary" asp-action="Index">← Kontratat</a>}
