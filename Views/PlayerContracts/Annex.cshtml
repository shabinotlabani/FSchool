@model PlayerContractAnnexInput
@{ViewData["Title"]=Model.Id==0?"Aneks i ri":"Ndrysho aneksin";}
<link rel="stylesheet" href="~/css/contracts.css" asp-append-version="true"/>
<div class="contracts-page contract-simple"><div class="page-heading"><div><h1>@ViewData["Title"]</h1><p>Ndryshimi i pagës ruhet me datën kur hyn në fuqi</p></div></div>
<form asp-action="Annex" method="post" data-financial-confirm><div asp-validation-summary="All" class="text-danger" role="alert"></div><input asp-for="Id" type="hidden"/><input asp-for="PlayerContractId" type="hidden"/><input asp-for="Revision" type="hidden"/>
<div class="contract-simple-fields"><label>Numri i aneksit<input asp-for="Number" class="form-control" placeholder="Gjenerohet automatikisht"/></label><label>Hyn në fuqi më<input asp-for="EffectiveOn" type="date" class="form-control" required/></label><label>Paga e re bruto<input asp-for="NewGrossSalary" type="number" min="0.01" max="99999999.99" step="0.01" inputmode="decimal" class="form-control" required/></label><label class="contract-wide">Arsyeja<textarea asp-for="Reason" class="form-control" rows="3" required></textarea></label></div>
<div class="d-flex flex-wrap gap-2 mt-4"><button class="btn btn-outline-secondary" name="command" value="Draft">Ruaj draftin</button><button class="btn btn-primary" name="command" value="Activate">Aktivizo aneksin</button></div></form></div>
@section PageNavigation {<a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.PlayerContractId">← Kontrata</a>}
