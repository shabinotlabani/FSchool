@model List<PlayerContract>
@using _2Korriku.Services
@if(Model.Count>0){<link rel="stylesheet" href="~/css/contracts.css" asp-append-version="true"/><section class="contract-notice" aria-label="Kontratat afër skadimit"><strong>Kontratat · skadimi brenda 30 ditësh</strong><ul>@foreach(var c in Model){<li><a asp-controller="PlayerContracts" asp-action="Details" asp-route-id="@c.Id">@c.PersonName</a> · @c.EffectiveEnd.ToString("dd.MM.yyyy") · @(c.EffectiveEnd.DayNumber-BillingClock.Today.DayNumber) ditë</li>}</ul></section>}
