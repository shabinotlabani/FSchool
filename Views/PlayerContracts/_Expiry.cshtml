@model List<PlayerContract>
@using _2Korriku.Services
@if(Model.Count>0){<link rel="stylesheet" href="~/css/contracts.css" asp-append-version="true"/><section class="contract-notice" aria-label="Kontratat afër skadimit"><header><span>AFATI I KONTRATAVE</span><strong>Skadojnë brenda një muaji</strong><b>@Model.Count</b></header><div>@foreach(var c in Model){var days=c.EffectiveEnd.DayNumber-BillingClock.Today.DayNumber;<a asp-controller="PlayerContracts" asp-action="Details" asp-route-id="@c.Id"><span class="contract-notice-avatar">@(string.IsNullOrWhiteSpace(c.PersonName)?"L":c.PersonName[..1].ToUpperInvariant())</span><span><strong>@c.PersonName</strong><small>Kontrata @c.Number · @c.EffectiveEnd.ToString("dd/MM/yyyy")</small></span><b>@days<small>ditë</small></b></a>}</div></section>}
