@model List<PlayerFamily>
@{ViewData["Title"]="Familjet dhe paketat";}
<div class="page-heading"><div><p class="eyebrow">PAKETA FAMILJARE</p><h1>Familjet dhe fëmijët</h1></div>@if(User.IsInRole(Roles.Admin)){<div class="d-flex gap-2"><a asp-controller="Tariffs" asp-action="Index" class="btn btn-outline-primary">Tarifat mujore</a><a asp-action="Edit" class="btn btn-primary">+ Familje e re</a></div>}</div>
<form method="get" class="panel p-3 mb-3 d-flex gap-2"><input name="search" value="@ViewData["Search"]" type="search" class="form-control" placeholder="Kërko familjen ose telefonin"/><button class="btn btn-primary">Kërko</button></form>
<section class="panel"><table class="table mb-0"><thead><tr><th>Familja</th><th>Telefoni</th><th></th></tr></thead><tbody>@foreach(var family in Model){<tr><td><strong>@family.Name</strong><small class="d-block text-secondary">Familja #@family.Id</small></td><td>@family.Phone</td><td><a asp-action="Details" asp-route-id="@family.Id" class="btn btn-outline-primary">Hap paketën</a></td></tr>}@if(Model.Count==0){<tr><td colspan="3" class="p-4">Nuk ka familje. Administratori krijon familjen dhe zgjedh fëmijët; mbiemri ose telefoni nuk i bashkon automatikisht.</td></tr>}</tbody></table></section>
