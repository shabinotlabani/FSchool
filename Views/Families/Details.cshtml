@model FamilyDetailsModel
@using _2Korriku.Services
@{ViewData["Title"]=Model.Family.Name;}
<div class="page-heading mt-3"><div><p class="eyebrow">PAKETA FAMILJARE · #@Model.Family.Id</p><h1>@Model.Family.Name</h1><p>@Model.Family.Phone</p></div>@if(User.IsInRole(Roles.Admin)){<a asp-action="Edit" asp-route-id="@Model.Family.Id" asp-route-month="@(Model.Month>=TariffService.NextMonth?Model.Month.ToString("yyyy-MM"):TariffService.NextMonth.ToString("yyyy-MM"))" class="btn btn-primary">Menaxho fëmijët dhe paketën</a>}</div>
@if(TempData["Success"] is string message){<div class="alert alert-success">@message</div>}
<form method="get" class="panel p-3 mb-3 d-flex gap-3 align-items-end"><div><label for="month" class="form-label">Paketa për muajin</label><input type="month" id="month" name="month" value="@Model.Month.ToString("yyyy-MM")" class="form-control" required/></div><button class="btn btn-outline-primary">Shfaq</button><a asp-action="Details" asp-route-id="@Model.Family.Id" asp-route-month="@TariffService.NextMonth.ToString("yyyy-MM")">Muaji i ardhshëm</a></form>
<a asp-controller="Payments" asp-action="Family" asp-route-id="@Model.Family.Id" class="btn btn-primary mb-3">Pagesat familjare</a>
<section class="panel p-4 mb-4"><div class="d-flex justify-content-between mb-3"><h2 class="h5">@Model.Members.Count fëmijë · @Model.Month.ToString("MM.yyyy")</h2><strong>Paketa: @Model.Members.Sum(m=>m.Fee.Amount).ToString("N2") € / muaj</strong></div><div class="table-responsive"><table class="table"><thead><tr><th>Renditja</th><th>Lojtari</th><th>Tarifa mujore</th><th></th></tr></thead><tbody>@foreach(var member in Model.Members){<tr><td>@member.Position</td><td>@member.Student.FullName @if(!member.Student.IsActive){<span class="badge text-bg-warning">Joaktiv — rishikoni përfshirjen</span>}</td><td>@member.Fee.Amount.ToString("N2") €</td><td><a asp-controller="Payments" asp-action="Account" asp-route-id="@member.Student.Id">Kartela dhe pagesat →</a></td></tr>}@if(Model.Members.Count==0){<tr><td colspan="4">Familja nuk ka fëmijë në paketë për këtë muaj. Kontrolloni muajin e ardhshëm ose menaxhoni përbërjen.</td></tr>}</tbody></table></div></section>
<section class="panel p-4"><h2 class="h5">Historiku i familjes</h2><table class="table"><thead><tr><th>Vlen nga</th><th>Ndryshimi</th><th>Arsyeja / autori</th></tr></thead><tbody>@foreach(var change in Model.History){<tr><td>@change.EffectiveMonth.ToString("MM.yyyy")</td><td style="white-space:pre-wrap">@change.Snapshot</td><td>@change.Reason<small class="d-block text-secondary">@(change.Actor?.UserName??"Sistemi") · @TimeZoneInfo.ConvertTimeFromUtc(change.CreatedAt,BillingClock.Zone).ToString("dd.MM.yyyy HH:mm")</small></td></tr>}</tbody></table></section>

@section PageNavigation {
    <a class="btn btn-outline-secondary app-back-button" asp-action="Index"><span aria-hidden="true">←</span><span>Mbrapa</span></a>
}
