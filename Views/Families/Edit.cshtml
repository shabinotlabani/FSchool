@model FamilyEditModel
@using _2Korriku.Services
@using System.Globalization
@{ViewData["Title"]=Model.Id==0?"Familje e re":"Menaxho familjen";var price=Model.FamilyPrice??new FeePlanOption(0,"",0,false);}
<div class="page-heading mt-3"><div><p class="eyebrow">PAKETA DHE RENDITJA</p><h1>@ViewData["Title"]</h1></div></div>
<form asp-action="Save" method="post" class="panel p-4" id="family-form" data-pricing-url="@Url.Action("Prices","Families")"><input asp-for="Id" type="hidden"/><input asp-for="Revision" type="hidden"/><div asp-validation-summary="All" class="text-danger"></div><div class="mb-3"><label asp-for="PreferredPaymentMethod" class="form-label">Pagesa mujore zakonisht</label><select asp-for="PreferredPaymentMethod" class="form-select"><option value="Cash">Cash</option><option value="Bank">Bankë</option></select><small class="text-secondary">Mund të ndryshohet për çdo pagesë.</small><span asp-validation-for="PreferredPaymentMethod" class="text-danger"></span></div><div class="row g-3 mb-4"><div class="col-md-6"><label asp-for="Name" class="form-label">Emri i familjes *</label><input asp-for="Name" class="form-control" required maxlength="150" placeholder="p.sh. Familja Shabani – Labinot"/></div><div class="col-md-6"><label asp-for="Phone" class="form-label">Telefoni i prindit</label><input asp-for="Phone" class="form-control" maxlength="100"/></div><div class="col-md-6"><label asp-for="EffectiveMonth" class="form-label">Përbërja vlen nga muaji *</label><input asp-for="EffectiveMonth" type="month" min="@TariffService.NextMonth.ToString("yyyy-MM")" class="form-control" required/></div></div>
<partial name="_TariffChoice" model="Model"/>
<link rel="stylesheet" href="~/css/family-editor.css" asp-append-version="true"/>
<h2 class="h5">Fëmijët në paketë</h2>
<label for="family-search" class="form-label">Kërko lojtarin</label><input id="family-search" type="search" class="form-control" placeholder="Emri, mbiemri ose prindi" autocomplete="off" aria-controls="family-results"/>
<button type="button" id="family-new-player" class="btn btn-outline-primary mt-2">+ Lojtar i ri</button>
<div id="family-results" class="family-results" hidden>
@foreach(var student in Model.Students){
<div class="family-result" data-blocked="@Model.JoinBlocks.ContainsKey(student.Id).ToString().ToLowerInvariant()" data-student-id="@student.Id" data-name="@student.FullName" data-search="@student.FullName @student.ParentName @student.ParentPhone @student.Id">
<div><strong>@student.FullName</strong><small>@student.ParentName · #@student.Id @(student.IsActive?"":"· Joaktiv")</small></div>
@if(Model.JoinBlocks.TryGetValue(student.Id,out var block)){<small class="text-danger">@block</small>}
<button type="button" class="btn btn-sm btn-outline-primary" data-add="@student.Id" disabled="@Model.JoinBlocks.ContainsKey(student.Id)" aria-label="Shto @student.FullName">+ Shto</button>
</div>}
</div><p id="family-search-status" class="text-secondary small mt-2 mb-3" role="status" aria-live="polite"></p>
<div class="table-responsive"><table class="table"><thead><tr><th>Renditja</th><th>Fëmija</th><th>Tarifa</th><th></th></tr></thead><tbody id="family-members">@foreach(var id in Model.StudentIds){var student=Model.Students.SingleOrDefault(s=>s.Id==id);<tr><td class="position"></td><td><input type="hidden" name="StudentIds" value="@id"/><span>@(student?.FullName??"Lojtar i panjohur") · #@id</span></td><td class="price"></td><td class="text-nowrap"><button type="button" class="btn btn-sm btn-outline-secondary" data-move="up" aria-label="Lëviz lart">↑</button> <button type="button" class="btn btn-sm btn-outline-secondary" data-move="down" aria-label="Lëviz poshtë">↓</button> <button type="button" class="btn btn-sm btn-outline-danger" data-move="remove">Hiq</button></td></tr>}</tbody></table></div>
<div class="alert alert-light border"><span id="family-rule"></span><strong class="d-block mt-2">Totali i paketës: <output id="family-total" aria-live="polite">0.00</output> / muaj</strong></div>
<label class="d-flex gap-2 align-items-start mb-3"><input asp-for="ConfirmIndividualTransfer" class="form-check-input"/><span>Konfirmoj kalimin e lojtarëve që po shtoj nga tarifa individuale në paketën familjare, nga muaji i zgjedhur.</span></label>
<label asp-for="Reason" class="form-label">Arsyeja *</label><input asp-for="Reason" class="form-control mb-4" required maxlength="200"/><button class="btn btn-primary">Ruaj familjen dhe paketën</button></form>
<script type="application/json" id="family-pricing">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new{first=price.Amount,additional=price.FamilyAdditionalAmount,limit=price.FamilyFirstCount,singleStandard=price.SingleUsesStandard,standard=Model.StandardPrice}))</script>
@section Scripts{<script src="~/js/family-editor.js" asp-append-version="true"></script>}

@section PageNavigation {
    <a class="btn btn-outline-secondary app-back-button" asp-action="Index"><span aria-hidden="true">←</span><span>Mbrapa</span></a>
}
<dialog id="family-player-dialog" class="family-player-dialog" aria-labelledby="family-player-title">
<div class="family-player-toolbar"><strong id="family-player-title">Lojtar i ri</strong><button type="button" id="family-player-close" class="btn btn-outline-secondary">Mbyll</button></div>
<iframe id="family-player-frame" title="Regjistro lojtar të ri" data-url="@Url.Action("Create","Students",new{familyPicker=true})"></iframe>
</dialog>
