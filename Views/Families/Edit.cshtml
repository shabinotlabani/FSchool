@model FamilyEditModel
@using _2Korriku.Services
@using System.Globalization
@{ViewData["Title"]=Model.Id==0?"Familje e re":"Menaxho familjen";var price=Model.FamilyPrice??new FeePlanOption(0,"",0,false);}
<div class="page-heading mt-3"><div><p class="eyebrow">PAKETA DHE RENDITJA</p><h1>@ViewData["Title"]</h1></div></div>
<form asp-action="Save" method="post" class="panel p-4" id="family-form" data-pricing-url="@Url.Action("Prices","Families")"><input asp-for="Id" type="hidden"/><input asp-for="Revision" type="hidden"/><div asp-validation-summary="All" class="text-danger"></div><div class="row g-3 mb-4"><div class="col-md-6"><label asp-for="Name" class="form-label">Emri i familjes *</label><input asp-for="Name" class="form-control" required maxlength="150" placeholder="p.sh. Familja Shabani – Labinot"/></div><div class="col-md-6"><label asp-for="Phone" class="form-label">Telefoni i prindit</label><input asp-for="Phone" class="form-control" maxlength="100"/></div><div class="col-md-6"><label asp-for="EffectiveMonth" class="form-label">Përbërja vlen nga muaji *</label><input asp-for="EffectiveMonth" type="month" min="@TariffService.NextMonth.ToString("yyyy-MM")" class="form-control" required/></div></div>
<partial name="_TariffChoice" model="Model"/>
<h2 class="h5">Fëmijët në paketë</h2><label for="family-search" class="form-label">Kërko lojtarin</label><input id="family-search" type="search" class="form-control mb-2" placeholder="Emri, mbiemri ose prindi"/><div class="d-flex gap-2 mb-3"><select id="family-student" class="form-select"><option value="">Zgjidhni lojtarin</option>@foreach(var student in Model.Students){<option value="@student.Id">@student.FullName · @student.ParentName · #@student.Id @(student.IsActive?"":"· Joaktiv")</option>}</select><button type="button" id="family-add" class="btn btn-outline-primary">+ Shto</button></div>
<div class="table-responsive"><table class="table"><thead><tr><th>Renditja</th><th>Fëmija</th><th>Tarifa</th><th></th></tr></thead><tbody id="family-members">@foreach(var id in Model.StudentIds){var student=Model.Students.SingleOrDefault(s=>s.Id==id);<tr><td class="position"></td><td><input type="hidden" name="StudentIds" value="@id"/><span>@(student?.FullName??"Lojtar i panjohur") · #@id</span></td><td class="price"></td><td class="text-nowrap"><button type="button" class="btn btn-sm btn-outline-secondary" data-move="up" aria-label="Lëviz lart">↑</button> <button type="button" class="btn btn-sm btn-outline-secondary" data-move="down" aria-label="Lëviz poshtë">↓</button> <button type="button" class="btn btn-sm btn-outline-danger" data-move="remove">Hiq</button></td></tr>}</tbody></table></div>
<div class="alert alert-light border"><span id="family-rule"></span><strong class="d-block mt-2">Totali i paketës: <output id="family-total" aria-live="polite">0.00</output> € / muaj</strong></div>
<label asp-for="Reason" class="form-label">Arsyeja *</label><input asp-for="Reason" class="form-control mb-4" required maxlength="200"/><button class="btn btn-primary">Ruaj familjen dhe paketën</button></form>
<script type="application/json" id="family-pricing">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new{first=price.Amount,additional=price.FamilyAdditionalAmount,limit=price.FamilyFirstCount,singleStandard=price.SingleUsesStandard,standard=Model.StandardPrice}))</script>
@section Scripts{<script src="~/js/family-editor.js" asp-append-version="true"></script>}

@section PageNavigation {
    <a class="btn btn-outline-secondary app-back-button" asp-action="Index"><span aria-hidden="true">←</span><span>Mbrapa</span></a>
}
