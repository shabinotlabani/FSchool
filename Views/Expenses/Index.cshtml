@model ExpenseIndexModel
@using _2Korriku.Services
@{ViewData["Title"]="Shpenzimet";}
<div class="page-heading"><div><p class="eyebrow">EVIDENCA E PAGESAVE TË SHKOLLËS</p><h1>Shpenzimet</h1></div><div class="d-flex gap-2 flex-wrap">@if(User.IsInRole(Roles.Admin)){<a asp-action="Categories" class="btn btn-outline-primary">Kategoritë</a>}@if(User.IsInRole(Roles.Admin)||User.IsInRole(Roles.Operator)){<a asp-action="Create" class="btn btn-primary">+ Regjistro shpenzim</a>}</div></div>
<partial name="~/Views/Payments/_BillingNotice.cshtml"/>
<form method="get" class="panel p-3 mb-4"><div asp-validation-summary="All" class="text-danger"></div><div class="row g-3 align-items-end"><div class="col-md-2"><label for="From" class="form-label">Nga data</label><input id="From" name="From" value="@Model.Filter.From?.ToString("yyyy-MM-dd")" type="date" class="form-control" required/></div><div class="col-md-2"><label for="To" class="form-label">Deri në datë</label><input id="To" name="To" value="@Model.Filter.To?.ToString("yyyy-MM-dd")" type="date" max="@BillingClock.Today.ToString("yyyy-MM-dd")" class="form-control" required/></div><div class="col-md-3"><label asp-for="CategoryId" class="form-label">Kategoria</label><select asp-for="CategoryId" class="form-select"><option value="">Të gjitha</option>@foreach(var c in Model.Categories){<option value="@c.Id">@c.Name</option>}</select></div><div class="col-md-3"><label asp-for="Search" class="form-label">Kërko shpenzim</label><input asp-for="Search" type="search" class="form-control"/></div><div class="col-md-2"><button class="btn btn-primary w-100">Filtro</button></div></div><div class="d-flex gap-4 mt-3 flex-wrap"><label><input asp-for="IncludeCancelled"/> Përfshi të anuluarat</label><a asp-action="Index">Pastro filtrat</a><a asp-controller="Reports" asp-action="Index" asp-route-from="@Model.Filter.From?.ToString("yyyy-MM-dd")" asp-route-to="@Model.Filter.To?.ToString("yyyy-MM-dd")">Raporti i hyrjeve dhe shpenzimeve →</a></div></form>
<section class="panel p-3"><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Dokumenti / data</th><th>Kategoria</th><th>Përshkrimi / përfituesi</th><th>Shuma</th><th></th></tr></thead><tbody>
@foreach(var e in Model.Expenses){<tr><td><a asp-action="Details" asp-route-id="@e.Id">@e.Number</a><small class="d-block">@e.Date.ToString("dd.MM.yyyy")</small></td><td>@e.CategoryName<small class="d-block">@e.SubcategoryName</small></td><td>@e.Description<small class="d-block">@e.Recipient</small></td><td>@e.Amount.ToString("N2") € @if(e.CancelledAt.HasValue){<small class="d-block text-danger">Anuluar</small>}</td><td><a asp-action="Print" asp-route-id="@e.Id">Printo</a></td></tr>}
@if(Model.Expenses.Count==0){<tr><td colspan="5" class="p-4 text-secondary">Nuk ka shpenzime për filtrat e zgjedhur.</td></tr>}
</tbody><tfoot><tr><th colspan="3">Gjithsej shpenzime aktive në listë</th><th>@Model.Expenses.Where(x=>x.CancelledAt==null).Sum(x=>x.Amount).ToString("N2") €</th><th></th></tr></tfoot></table></div></section>