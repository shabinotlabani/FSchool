@model StockCardModel
@using _2Korriku.Services
@{Layout="_PrintLayout";ViewData["Title"]="Kartela e rekuizitës";}
<div class="print-toolbar"><a asp-action="Card" asp-route-variantId="@Model.Filter.VariantId" asp-route-id="@Model.Product.Id" asp-route-from="@Model.Filter.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.Filter.To.ToString("yyyy-MM-dd")">← Kthehu te kartela</a><button onclick="window.print()">Printo A4</button></div>
<main class="stock-sheet"><header class="document-header"><div class="document-brand"><img src="~/images/fc-2-korriku.svg" alt="FC 2 Korriku"/><div><strong>FC 2 KORRIKU</strong><span>MAGAZINA · EVIDENCA E STOKUT</span></div></div><div class="document-heading"><span class="copy-label">KARTELA E REKUIZITËS</span><h1>@Model.Product.Name</h1><strong>@Model.Filter.From.ToString("dd.MM.yyyy") — @Model.Filter.To.ToString("dd.MM.yyyy")</strong></div></header><div class="document-rule"></div>
<p>@Model.Product.CategoryId · Madhësia: @Model.SelectedSize · Kodi: @Model.Product.Code</p><p>Gjendja në fillim: <strong>@Model.Opening.ToString("0.##")</strong> · Hyrje: <strong>@Model.Incoming.ToString("0.##")</strong> · Dalje: <strong>@Model.Outgoing.ToString("0.##")</strong> · Në fund: <strong>@Model.Closing.ToString("0.##")</strong></p>
@if(Model.UndatedStock!=0){<p class="document-notes">Gjendja përfshin një diferencë bazë pa datë prej @Model.UndatedStock.ToString("0.##"). Historiku duhet verifikuar.</p>}
<table class="document-table"><thead><tr><th>Data</th><th>Dokumenti / pala</th><th>Hyrje</th><th>Dalje</th><th>Gjendja</th></tr></thead><tbody><tr><td colspan="4">Gjendja para periudhës</td><td>@Model.Opening.ToString("0.##")</td></tr>@foreach(var r in Model.Rows){<tr><td>@BillingClock.LocalDate(r.Movement.Date).ToString("dd.MM.yyyy")</td><td><strong>@r.Document</strong><br/>@r.Party<br/><small>Madhësia: @(r.Movement.ProductSize??"—") · @r.Movement.UnitName · @r.Movement.Notes · @(r.Movement.User?.UserName??"Sistemi")</small></td><td>@r.Incoming.ToString("0.##")</td><td>@r.Outgoing.ToString("0.##")</td><td>@r.Balance.ToString("0.##")</td></tr>}@if(Model.Rows.Count==0){<tr><td colspan="5">Pa lëvizje në periudhën e zgjedhur.</td></tr>}</tbody><tfoot><tr><th colspan="2">GJITHSEJ</th><td>@Model.Incoming.ToString("0.##")</td><td>@Model.Outgoing.ToString("0.##")</td><td>@Model.Closing.ToString("0.##")</td></tr></tfoot></table><footer class="document-footer"><span>FC 2 Korriku · Kartela e stokut</span><span>Gjeneruar @TimeZoneInfo.ConvertTimeFromUtc(Model.GeneratedAt,BillingClock.Zone).ToString("dd.MM.yyyy HH:mm")</span></footer></main>
