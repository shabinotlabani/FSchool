@model StockEntry
@using _2Korriku.Services
@{ Layout = "_PrintLayout"; ViewData["Title"] = "Fletëhyrje në magazinë"; }
<div class="print-toolbar"><a asp-action="Entry" asp-route-id="@Model.Id">← Dokumenti i hyrjes</a><div><span>A4 · dokument furnizimi</span><button type="button" onclick="window.print()">Printo hyrjen</button></div></div>
<main class="stock-sheet"><header class="document-header"><div class="document-brand"><img src="~/images/fc-2-korriku.svg" alt="Logo e FC 2 Korriku" width="44" height="63"/><div><strong>FC 2 KORRIKU</strong><span>SHKOLLA E FUTBOLLIT</span><small>Prishtinë · 1957</small></div></div><div class="document-heading"><span class="copy-label">MAGAZINA</span><h1>Fletëhyrje në magazinë</h1><strong>@Model.DocumentNumber</strong></div></header><div class="document-rule"></div>
<div class="document-metadata"><div><label>Furnitori</label><strong>@(Model.SupplierName ?? "—")</strong></div><div><label>Data e hyrjes</label><strong>@BillingClock.LocalDate(Model.Date).ToString("dd.MM.yyyy")</strong></div><div><label>Dokumenti i furnitorit</label><span>@(Model.SupplierInvoiceNo ?? "—")</span></div><div><label>Regjistruar nga</label><span>@(Model.CreatedByUser?.UserName ?? "Administrata")</span></div></div>
<table class="document-table"><thead><tr><th>Nr.</th><th>Rekuizita / madhësia</th><th>Sasia</th><th>Çmimi (€)</th><th>Vlera (€)</th></tr></thead><tbody>@{var row = 0;}@foreach(var detail in Model.Details.OrderBy(d => d.Id)){row++;<tr><td>@row</td><td>@(detail.DisplayName) @(detail.DisplaySize)</td><td>@detail.Quantity.ToString("0.##") @detail.UnitName</td><td>@detail.UnitPrice.ToString("N2")</td><td>@detail.Total.ToString("N2")</td></tr>}</tbody></table><div class="stock-totals">GJITHSEJ: @Model.TotalAmount.ToString("N2") €</div>
@if(!string.IsNullOrWhiteSpace(Model.Notes)){<p class="document-notes"><strong>Shënime:</strong> @Model.Notes</p>}
<div class="document-signatures"><div><span>Dorëzoi</span><strong>@(Model.SupplierName ?? " ")</strong><i></i><small>Nënshkrimi</small></div><div><span>Pranoi në magazinë</span><strong>@(Model.CreatedByUser?.UserName ?? " ")</strong><i></i><small>Nënshkrimi / vula</small></div></div><footer class="document-footer"><span>FC 2 Korriku · Evidenca e magazinës</span><span>@Model.DocumentNumber</span></footer></main>
