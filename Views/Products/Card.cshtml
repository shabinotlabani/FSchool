@model StockCardModel
@using _2Korriku.Services
@{ViewData["Title"]="Kartela e rekuizitës";var valid=ViewData.ModelState.IsValid;var from=Model.Filter.From.ToString("yyyy-MM-dd");var to=Model.Filter.To.ToString("yyyy-MM-dd");}
<link rel="stylesheet" href="~/css/inventory.css" asp-append-version="true"/>

<div class="page-heading mt-3"><div><p class="eyebrow">MAGAZINA / KARTELA E REKUIZITËS</p><h1>@Model.Product.Name</h1><p>@Model.Product.CategoryId · Madhësia: @Model.SelectedSize · @(Model.Product.IsActive?"Aktive":"Joaktive")</p></div><div class="stock-actions">@if(User.IsInRole(Roles.Admin)||User.IsInRole(Roles.Operator)){<a asp-action="Edit" asp-route-id="@Model.Product.Id" class="btn btn-primary">Ndrysho rekuizitën</a>}@if(valid){<a asp-action="PrintCard" asp-route-variantId="@Model.Filter.VariantId" asp-route-id="@Model.Product.Id" asp-route-from="@from" asp-route-to="@to" class="btn btn-outline-primary">Printo kartelën</a>}@if(Model.Product.IsActive&&(User.IsInRole(Roles.Admin)||User.IsInRole(Roles.Operator))){<a asp-action="Receive" asp-route-productId="@Model.Product.Id" class="btn btn-primary">+ Hyrje</a><a asp-controller="Sales" asp-action="Create" asp-route-productId="@Model.Product.Id" class="btn btn-outline-primary">− Dalje për lojtarin</a>}</div></div>
@if(TempData["Success"] is string message){<div class="alert alert-success">@message</div>}
<section class="panel p-4 mb-3"><div class="d-flex justify-content-between mb-3"><h2 class="h5">Stoku sipas madhësisë · @Model.Product.UnitName</h2>@if(User.IsInRole(Roles.Admin)||User.IsInRole(Roles.Operator)){<a asp-action="Sizes" asp-route-id="@Model.Product.Id" class="btn btn-outline-primary">Menaxho madhësitë</a>}</div><div class="table-responsive"><table class="table"><thead><tr><th>Madhësia</th><th>Në fillim</th><th>Hyrje</th><th>Dalje</th><th>Në fund</th><th>Stoku sot</th></tr></thead><tbody>@foreach(var size in Model.Sizes){<tr><td><a asp-action="Card" asp-route-id="@Model.Product.Id" asp-route-variantId="@size.Variant.Id" asp-route-from="@from" asp-route-to="@to">@size.Variant.Size</a> @if(!size.Variant.IsActive){}</td><td>@size.Opening.ToString("0.##")</td><td>@size.Incoming.ToString("0.##")</td><td>@size.Outgoing.ToString("0.##")</td><td><strong>@size.Closing.ToString("0.##")</strong></td><td>@size.Variant.CurrentStock.ToString("0.##")</td></tr>}</tbody></table></div><small class="text-secondary">Periudha: @Model.Filter.From.ToString("dd.MM.yyyy") — @Model.Filter.To.ToString("dd.MM.yyyy")</small></section>
<section class="stock-identity"><div><span>Stoku aktual</span><strong>@Model.Product.CurrentStock.ToString("0.##")</strong></div><div><span>Stoku minimal</span><strong>@Model.Product.MinimumStock.ToString("0.##")</strong></div><div><span>Çmimi aktual i shitjes</span><strong>@Model.Product.SalePrice.ToString("N2") €</strong></div><div><span>Kodi / barkodi</span><strong class="stock-code">@Model.Product.Code</strong><small>@Model.Product.Barcode</small></div></section>
<form asp-action="Card" asp-route-id="@Model.Product.Id" method="get" class="stock-filter panel"><div asp-validation-summary="All" class="text-danger"></div><div class="stock-date-form"><div><label for="VariantId">Madhësia</label><select id="VariantId" name="VariantId"><option value="">Të gjitha madhësitë</option>@foreach(var v in Model.Product.Variants.OrderBy(v=>v.Id)){<option value="@v.Id" selected="@(Model.Filter.VariantId==v.Id)">@v.Size</option>}</select></div><div><label for="From">Nga data</label><input id="From" name="From" type="date" value="@from" min="1900-01-01" max="@BillingClock.Today.ToString("yyyy-MM-dd")" required/></div><div><label for="To">Deri në datë (përfshihet)</label><input id="To" name="To" type="date" value="@to" min="1900-01-01" max="@BillingClock.Today.ToString("yyyy-MM-dd")" required/></div><button class="btn btn-primary">Shfaq lëvizjet</button><a asp-action="Card" asp-route-id="@Model.Product.Id" class="btn btn-outline-secondary">Ky muaj</a><a asp-action="Card" asp-route-id="@Model.Product.Id" asp-route-from="1900-01-01" asp-route-to="@BillingClock.Today.ToString("yyyy-MM-dd")" class="btn btn-outline-secondary">Gjithë historiku</a></div></form>
@if(valid){
@if(Model.UndatedStock!=0){<div class="alert alert-warning">Ka @Model.UndatedStock.ToString("0.##") sasi diferencë midis stokut aktual dhe lëvizjeve të dokumentuara. Kjo përfshihet si gjendje bazë pa datë; gjendja historike është e përllogaritur dhe duhet verifikuar.</div>}
<section class="panel"><div class="panel-heading"><div><h2>Lëvizjet · @Model.SelectedSize</h2><p>@Model.Filter.From.ToString("dd.MM.yyyy") — @Model.Filter.To.ToString("dd.MM.yyyy") · @Model.Rows.Count lëvizje</p></div><span class="stock-period-pill">Sipas datës së dokumentit</span></div><div class="table-responsive"><table class="table stock-table align-middle mb-0"><thead><tr><th>Data / dokumenti</th><th>Furnitori / lojtari</th><th class="stock-number">Hyrje</th><th class="stock-number">Dalje</th><th class="stock-number">Gjendja</th><th>Regjistruar nga</th></tr></thead><tbody><tr class="stock-opening"><td colspan="4">Gjendja para periudhës</td><td class="stock-number">@Model.Opening.ToString("0.##")</td><td></td></tr>
@foreach(var row in Model.Rows){<tr><td><small>@BillingClock.LocalDate(row.Movement.Date).ToString("dd.MM.yyyy")</small>@if(row.DocumentId.HasValue){<a class="stock-doc-link" asp-controller="@row.Controller" asp-action="@row.Action" asp-route-id="@row.DocumentId">@row.Document</a>}else{<strong class="stock-doc-link">@row.Document</strong>}</td><td>@row.Party<small class="balance-caption stock-notes">Madhësia: @(row.Movement.ProductSize??"—") · @row.Movement.UnitName · @row.Movement.Notes</small></td><td class="stock-number stock-in">@(row.Incoming==0?"—":row.Incoming.ToString("0.##"))</td><td class="stock-number stock-out">@(row.Outgoing==0?"—":row.Outgoing.ToString("0.##"))</td><td class="stock-number fw-bold">@row.Balance.ToString("0.##")</td><td><span>@(row.Movement.User?.UserName??"Sistemi")</span><small class="balance-caption">@TimeZoneInfo.ConvertTimeFromUtc(row.Movement.CreatedAt,BillingClock.Zone).ToString("dd.MM.yyyy HH:mm")</small></td></tr>}
@if(Model.Rows.Count==0){<tr><td colspan="6" class="p-5 text-center text-secondary">Nuk ka lëvizje në këtë periudhë. Gjendja e fillimit mbartet në fund.</td></tr>}
</tbody><tfoot><tr><th colspan="2">Gjithsej për periudhën</th><td class="stock-number">@Model.Incoming.ToString("0.##")</td><td class="stock-number">@Model.Outgoing.ToString("0.##")</td><td class="stock-number">@Model.Closing.ToString("0.##")</td><td></td></tr></tfoot></table></div></section>
}

@section PageNavigation {
    <a class="btn btn-outline-secondary app-back-button" asp-action="Index" asp-route-from="@from" asp-route-to="@to"><span aria-hidden="true">←</span><span>Mbrapa</span></a>
}
