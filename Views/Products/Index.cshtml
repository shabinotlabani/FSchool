@model StockOverviewModel
@{
    ViewData["Title"] = "Rekuizitat";
    var f = Model.Filter;
    var writer = User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Operator);
    var inactive = f.Status == "inactive";
}
<link rel="stylesheet" href="~/css/product-shop.css" asp-append-version="true" />
<div class="product-shop">
    <header class="shop-heading">
        <div><p class="eyebrow">FC 2 KORRIKU</p><h1>Rekuizitat</h1><p>Gjithçka për lojën.</p></div>
        <details class="shop-management">
            <summary>Menaxhimi <span aria-hidden="true">⌄</span></summary>
            <nav aria-label="Menaxhimi i rekuizitave">
                @if(writer){<a asp-action="Create">Shto rekuizitë</a><a asp-action="Receive">Furnizo stokun</a>}
                <a asp-action="Entries">Historiku i furnizimeve</a>
                <a asp-controller="Sales" asp-action="Index">Dorëzimet për lojtarët</a>
                <a asp-action="Stock">Raporti i stokut / printimi</a>
                <a asp-action="Index" asp-route-inactive="@(!inactive)">@(inactive ? "Rekuizitat aktive" : "Rekuizitat joaktive")</a>
                @if(User.IsInRole(Roles.Admin)){<a asp-controller="SizeGroups" asp-action="Index">Menaxho madhësitë</a>}
            </nav>
        </details>
    </header>
    @if(TempData["Success"] is string message){<div class="alert alert-success">@message</div>}
    <form method="get" asp-action="Index" class="shop-search" role="search">
        <input type="hidden" name="category" value="@f.Category" />
        @if(inactive){<input type="hidden" name="inactive" value="true" />}
        <label for="shop-search" class="visually-hidden">Kërko rekuizitë</label>
        <input id="shop-search" name="search" type="search" value="@f.Search" maxlength="200" placeholder="Kërko rekuizitën…" />
        <button type="submit" class="btn btn-primary">Kërko</button>
    </form>
    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
    <nav class="shop-categories" aria-label="Kategoritë e rekuizitave">
        <a asp-action="Index" asp-route-search="@f.Search" asp-route-inactive="@inactive" class="@(string.IsNullOrEmpty(f.Category) ? "selected" : "")" aria-current="@(string.IsNullOrEmpty(f.Category) ? "page" : null)">Të gjitha</a>
        @foreach(var category in Model.Categories){
            var selected = string.Equals(f.Category, category, StringComparison.OrdinalIgnoreCase);
            <a asp-action="Index" asp-route-category="@category" asp-route-search="@f.Search" asp-route-inactive="@inactive" class="@(selected ? "selected" : "")" aria-current="@(selected ? "page" : null)">@category</a>
        }
    </nav>
    @if(ViewData.ModelState.IsValid){
        <div class="shop-results"><span>@Model.Rows.Count rekuizita @(inactive ? "joaktive" : "")</span>@if(!string.IsNullOrEmpty(f.Search)||!string.IsNullOrEmpty(f.Category)){<a asp-action="Index" asp-route-inactive="@inactive">Pastro kërkimin</a>}</div>
        @if(Model.Rows.Count == 0){<div class="shop-empty"><h2>Nuk u gjetën rekuizita</h2><p>Provo një emër tjetër ose zgjidh të gjitha kategoritë.</p></div>}
        <div class="shop-grid">
        @foreach(var row in Model.Rows){
            var p = row.Product;
            var available = p.IsActive && p.CurrentStock > 0 && (p.Variants.Count == 0 || p.Variants.Any(v => v.IsActive && v.CurrentStock > 0));
            var sizes = p.Variants.Where(v => v.IsActive).OrderBy(v => v.Id).ToList();
            <article class="shop-product">
                <a asp-action="Card" asp-route-id="@p.Id" class="shop-product-visual" aria-label="Shiko @p.Name">
                    <span class="shop-availability @(!available ? "unavailable" : "")">@(!p.IsActive ? "Joaktive" : available ? "Në stok" : "Pa stok")</span>
                    <svg viewBox="0 0 100 100" fill="none" aria-hidden="true"><path d="M50 16 83 33v35L50 86 17 68V33Z" fill="currentColor" opacity=".08"/><path d="m17 33 33 18 33-18M50 51v35M17 33l33-17 33 17v35L50 86 17 68V33Zm16-9 34 18v14" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
                    <span class="shop-product-code">@p.Code</span>
                </a>
                <div class="shop-product-body">
                    <p class="shop-category">@p.CategoryId</p>
                    <h2><a asp-action="Card" asp-route-id="@p.Id">@p.Name</a></h2>
                    <div class="shop-price">@p.SalePrice.ToString("N2")</div>
                    <div class="shop-sizes" aria-label="Madhësitë">
                        @foreach(var size in sizes.Take(6)){<span class="@(size.CurrentStock <= 0 ? "sold-out" : "")" title="@size.CurrentStock.ToString("0.##") në stok">@size.Size</span>}
                        @if(sizes.Count > 6){<a asp-action="Card" asp-route-id="@p.Id">+@(sizes.Count - 6)</a>}
                        @if(sizes.Count == 0 && !string.IsNullOrEmpty(p.Size)){<span>@p.Size</span>}
                    </div>
                    <div class="shop-product-bottom">
                        <span>@p.CurrentStock.ToString("0.##") @p.UnitName.ToLowerInvariant() në stok</span>
                        @if(writer && available){<a asp-controller="Sales" asp-action="Create" asp-route-productId="@p.Id" class="btn btn-primary" aria-label="Jep lojtarit: @p.Name">Jep lojtarit</a>}
                        else{<a asp-action="Card" asp-route-id="@p.Id" class="shop-detail-link">Shiko →</a>}
                    </div>
                </div>
            </article>
        }
        </div>
    }
</div>
