@model StockEntryListModel
@using _2Korriku.Services
@{ ViewData["Title"] = "Historiku i hyrjeve"; }
<div class="page-heading"><div><p class="eyebrow">MAGAZINA</p><h1>Historiku i hyrjeve</h1><p>@(Model.ProductName == null ? "Çdo furnizim ruhet si dokument më vete." : "Hyrjet për rekuizitën: " + Model.ProductName)</p></div><div class="d-flex gap-2"><a asp-action="Index" class="btn btn-outline-primary">Rekuizitat</a>@if(User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Operator)){<a asp-action="Receive" class="btn btn-primary">+ Hyrje e re</a>}</div></div>
<form method="get" class="search-panel billing-filter"><input asp-for="ProductId" type="hidden"/><div class="billing-search"><label for="entry-search" class="form-label">Kërko dokument ose furnitor</label><input id="entry-search" name="search" value="@Model.Search" class="form-control" type="search"/></div><div><label asp-for="From" class="form-label">Nga data</label><input asp-for="From" type="date" class="form-control"/></div><div><label asp-for="To" class="form-label">Deri më</label><input asp-for="To" type="date" class="form-control"/></div><button class="btn btn-dark">Kërko</button><a asp-action="Entries" class="btn btn-outline-secondary">Pastro</a></form>
<section class="panel"><div class="panel-heading"><h2>@Model.Entries.Count dokumente</h2><strong>@Model.Entries.Sum(e => e.TotalAmount).ToString("N2") €</strong></div><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Dokumenti</th><th>Data</th><th>Furnitori</th><th>Rekuizita</th><th>Vlera</th><th>Regjistruar nga</th><th></th></tr></thead><tbody>
@foreach(var entry in Model.Entries){<tr><td><a asp-action="Entry" asp-route-id="@entry.Id" class="fw-semibold">@entry.DocumentNumber</a><small class="balance-caption">@entry.SupplierInvoiceNo</small></td><td>@BillingClock.LocalDate(entry.Date).ToString("dd.MM.yyyy")</td><td>@(entry.SupplierName ?? "—")</td><td>@entry.Details.Count</td><td>@entry.TotalAmount.ToString("N2") €</td><td>@(entry.CreatedByUser?.UserName ?? "Administrata")</td><td><a asp-action="PrintEntry" asp-route-id="@entry.Id" class="text-link">Printo</a></td></tr>}
@if(Model.Entries.Count == 0){<tr><td colspan="7" class="text-center text-secondary p-5">Nuk ka hyrje për këtë kërkim. Hyrja e re regjistrohet nga butoni sipër.</td></tr>}
</tbody></table></div></section>
