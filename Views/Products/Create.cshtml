@model CreateProductModel
@{ ViewData["Title"] = "Rekuizitë e re"; }
<div class="player-registration mx-auto"><div class="page-heading mt-3"><div><h1>Rekuizitë e re</h1></div></div>
<form asp-action="Create" method="post" class="card p-4 billing-form"><div asp-validation-summary="All" class="text-danger" role="alert"></div><div class="row g-3"><div class="col-12"><label asp-for="Name" class="form-label">Emri i rekuizitës *</label><input asp-for="Name" maxlength="200" class="form-control" required placeholder="p.sh. Fanellë stërvitjeje"/></div><div class="col-md-6"><label asp-for="Category" class="form-label">Kategoria *</label><input asp-for="Category" maxlength="50" class="form-control" required/></div><div class="col-md-6"><label asp-for="SizeGroupId" class="form-label">Grupi i madhësive *</label><select asp-for="SizeGroupId" class="form-select" required><option value="">Zgjidhni grupin</option>@foreach(var g in Model.SizeGroups){<option value="@g.Id">@g.Name — @g.Sizes</option>}</select></div><div class="col-md-6"><label asp-for="UnitName" class="form-label">Njësia matëse *</label><select asp-for="UnitName" class="form-select"><option>Copë</option><option>Palë</option></select></div><div class="col-md-6"><label asp-for="SalePrice" class="form-label">Çmimi i shitjes (€)</label><input asp-for="SalePrice" type="number" min="0" step="0.01" class="form-control" required/></div><div class="col-md-6"><label asp-for="MinimumStock" class="form-label">Stoku minimal për madhësi</label><input asp-for="MinimumStock" type="number" min="0" step="0.01" class="form-control" required/></div><div class="col-12"><label asp-for="Barcode" class="form-label">Barkodi (opsional)</label><input asp-for="Barcode" maxlength="50" class="form-control"/></div></div><div class="d-flex gap-2 justify-content-end"><button class="btn btn-primary">Krijo dhe vazhdo te hyrja</button></div></form></div>

@section PageNavigation {
    <a class="btn btn-outline-secondary app-back-button" asp-action="Index"><span aria-hidden="true">←</span><span>Mbrapa</span></a>
}
