@model CreateStockEntryModel
@{ ViewData["Title"] = "Hyrje në stok"; }
<div class="page-heading mt-3"><div><p class="eyebrow">FURNIZIM I RI</p><h1>Hyrje në stok</h1></div><a asp-action="Entries" class="btn btn-outline-primary">Hyrjet ekzistuese</a></div>
@if(TempData["Success"] is string message){<div class="alert alert-success" role="status">@message</div>}
@if(Model.Products.Count == 0){<div class="billing-note">Nuk ka rekuizita aktive. @if(User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Operator)){<a asp-action="Create">Krijoni rekuizitën e parë</a>} për të vazhduar.</div>}
<form asp-action="Receive" method="post" class="card p-3 p-md-4 billing-form" id="stock-entry-form"><div asp-validation-summary="All" class="text-danger" role="alert"></div><input asp-for="RequestId" type="hidden"/>
<div class="row g-3 mb-4"><div class="col-md-3"><label asp-for="Date" class="form-label">Data e hyrjes *</label><input asp-for="Date" type="date" max="@_2Korriku.Services.BillingClock.Today.ToString("yyyy-MM-dd")" class="form-control" required/></div><div class="col-md-5"><label asp-for="SupplierName" class="form-label">Furnitori</label><input asp-for="SupplierName" maxlength="200" class="form-control"/></div><div class="col-md-4"><label asp-for="SupplierInvoiceNo" class="form-label">Nr. dokumentit të furnitorit</label><input asp-for="SupplierInvoiceNo" maxlength="100" class="form-control"/></div></div>
<div class="table-responsive"><table class="table stock-entry-table"><thead><tr><th>Rekuizita *</th><th>Madhësia *</th><th>Sasia *</th><th>Çmimi i blerjes (€) *</th><th>Vlera (€)</th><th></th></tr></thead><tbody id="stock-lines">
@for(var i = 0; i < Model.Lines.Count; i++){<tr class="stock-line"><td><select asp-for="Lines[i].ProductId" data-line-field="ProductId" class="form-select line-product" required aria-label="Rekuizita"><option value="">Zgjidhni rekuizitën</option>@foreach(var product in Model.Products){<option value="@product.Id" data-price="@product.PurchasePrice.ToString(System.Globalization.CultureInfo.InvariantCulture)">@product.Name · @product.UnitName</option>}</select></td><td><select asp-for="Lines[i].ProductVariantId" data-line-field="ProductVariantId" class="form-select line-variant" required aria-label="Madhësia"><option value="">Zgjidhni madhësinë</option>@foreach(var variant in Model.Products.Where(p=>p.Id==Model.Lines[i].ProductId).SelectMany(p=>p.Variants).Where(v=>v.IsActive).OrderBy(v=>v.Id)){<option value="@variant.Id">@variant.Size · stok @variant.CurrentStock.ToString("0.##")</option>}</select></td><td><input asp-for="Lines[i].Quantity" data-line-field="Quantity" type="number" min="0.01" max="1000000" step="0.01" class="form-control line-quantity" required aria-label="Sasia"/></td><td><input asp-for="Lines[i].UnitPrice" data-line-field="UnitPrice" type="number" min="0" max="999999.99" step="0.01" class="form-control line-price" required aria-label="Çmimi i blerjes"/></td><td class="line-total amount-cell">0.00</td><td><button type="button" class="btn btn-outline-danger remove-line" aria-label="Hiq rreshtin">×</button></td></tr>}
</tbody></table></div><div class="d-flex justify-content-between align-items-center gap-3 flex-wrap"><button type="button" class="btn btn-outline-primary" id="add-stock-line">+ Shto rekuizitë</button><strong>Gjithsej: <output id="stock-total" aria-live="polite">0.00</output> €</strong></div><div class="mt-4"><label asp-for="Notes" class="form-label">Shënime</label><textarea asp-for="Notes" maxlength="1000" rows="3" class="form-control"></textarea></div><div class="d-flex gap-2 justify-content-end mt-4"><button type="submit" class="btn btn-primary" disabled="@(Model.Products.Count == 0)">Ruaj hyrjen</button></div>
</form>
<script id="variant-catalog" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Products.SelectMany(p=>p.Variants.Where(v=>v.IsActive).OrderBy(v=>v.Id).Select(v=>new { id=v.Id, productId=p.Id, size=v.Size, stock=v.CurrentStock, price=v.PurchasePrice, unit=p.UnitName }))))</script>
@section Scripts{<script src="~/js/inventory-lines.js" asp-append-version="true"></script>}

@section PageNavigation {
    <a class="btn btn-outline-secondary app-back-button" asp-action="Index"><span aria-hidden="true">←</span><span>Mbrapa</span></a>
}
