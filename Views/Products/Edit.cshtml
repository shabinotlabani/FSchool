@model EditProductModel
@{ViewData["Title"]="Ndrysho rekuizitën";}

<div class="page-heading mt-3"><div><p class="eyebrow">REKUIZITAT / TË DHËNAT</p><h1>Ndrysho rekuizitën</h1><p>@Model.Product?.Code</p></div></div>
<form asp-action="Edit" method="post" class="panel p-4"><input asp-for="Id" type="hidden" /><input asp-for="ExpectedState" type="hidden" /><div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>
<div class="row g-3">
<div class="col-md-6"><label asp-for="Name" class="form-label">Emri</label><input asp-for="Name" class="form-control" maxlength="200" required /></div>
<div class="col-md-6"><label asp-for="Category" class="form-label">Kategoria</label><input asp-for="Category" class="form-control" maxlength="50" required /></div>
<div class="col-md-6"><label asp-for="UnitName" class="form-label">Njësia</label><select asp-for="UnitName" class="form-select"><option>Copë</option><option>Palë</option></select></div>
<div class="col-md-6"><label asp-for="Barcode" class="form-label">Barkodi</label><input asp-for="Barcode" class="form-control" maxlength="50" /></div>
<div class="col-md-6"><label asp-for="SalePrice" class="form-label">Çmimi i shitjes (€)</label><input asp-for="SalePrice" type="number" min="0" max="999999.99" step="0.01" class="form-control" required /></div>
<div class="col-md-6"><label asp-for="MinimumStock" class="form-label">Stoku minimal për madhësi</label><input asp-for="MinimumStock" type="number" min="0" max="1000000" step="0.01" class="form-control" required /><small class="text-secondary">P.sh. minimumi 2: çdo madhësi me 2, 1 ose 0 shfaqet në raportin e stokut të ulët.</small></div>
<div class="col-12"><label class="d-flex gap-2"><input asp-for="IsActive" /> Rekuizitë aktive</label></div>
</div><div class="d-flex gap-2 mt-4"><button class="btn btn-primary">Ruaj ndryshimet</button></div></form>
<section class="panel p-4 mt-4"><div class="d-flex gap-3 justify-content-between flex-wrap"><h2 class="h5">Madhësitë dhe stoku aktual</h2><a asp-action="Sizes" asp-route-id="@Model.Id">Menaxho madhësitë →</a></div><p>Gjithsej: <strong>@Model.Product!.CurrentStock.ToString("0.##") @Model.Product.UnitName</strong></p>
<div class="table-responsive"><table class="table"><thead><tr><th>Madhësia</th><th>Sasia aktuale</th><th>Statusi</th></tr></thead><tbody>@foreach(var size in Model.Product.Variants.OrderBy(v=>v.Id)){<tr><td>@size.Size</td><td>@size.CurrentStock.ToString("0.##")</td><td>@(size.IsActive?"Aktive":"Joaktive")</td></tr>}</tbody></table></div>
@if(Model.Product.IsActive){<a asp-action="Receive" asp-route-productId="@Model.Id" class="btn btn-outline-primary">Regjistro hyrje në stok</a>}
</section>

@section PageNavigation {
    <a class="btn btn-outline-secondary app-back-button" asp-action="Card" asp-route-id="@Model.Id"><span aria-hidden="true">←</span><span>Mbrapa</span></a>
}
