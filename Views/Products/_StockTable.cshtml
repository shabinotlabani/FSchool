@model StockOverviewModel
<div class="table-responsive"><table class="table stock-table align-middle mb-0"><thead><tr><th>Rekuizita</th><th class="stock-number">Në fillim</th><th class="stock-number">Hyrje</th><th class="stock-number">Dalje</th><th class="stock-number">Në fund</th><th class="stock-number">Stoku sot</th><th></th></tr></thead><tbody>
@foreach(var row in Model.Rows){var p=row.Product;<tr><td><div class="stock-product"><span class="stock-product-icon"><svg class="icon" aria-hidden="true"><use href="#i-box"/></svg></span><div><a asp-action="Card" asp-route-id="@p.Id" asp-route-from="@Model.Filter.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.Filter.To.ToString("yyyy-MM-dd")">@p.Name</a><small>@p.CategoryId · @(p.Variants.Count>0?string.Join(", ",p.Variants.Select(v=>v.Size)):p.Size??"Pa madhësi") @if(!p.IsActive){<span>· Joaktiv</span>}</small></div></div></td><td class="stock-number">@row.Opening.ToString("0.##")</td><td class="stock-number stock-in">@row.Incoming.ToString("0.##")</td><td class="stock-number stock-out">@row.Outgoing.ToString("0.##")</td><td class="stock-number"><strong>@row.Closing.ToString("0.##")</strong><small class="stock-badge @row.StatusClass">@row.Status</small></td><td class="stock-number text-secondary">@p.CurrentStock.ToString("0.##")</td><td><a asp-action="Card" asp-route-id="@p.Id" asp-route-from="@Model.Filter.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.Filter.To.ToString("yyyy-MM-dd")" class="btn btn-sm btn-outline-primary">Kartela →</a>@if(User.IsInRole(Roles.Admin)||User.IsInRole(Roles.Operator)){<a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary ms-2">Ndrysho</a>}</td></tr>}
</tbody><tfoot><tr><th>Gjithsej · @Model.Rows.Count rekuizita</th><td class="stock-number">@Model.Rows.Sum(r=>r.Opening).ToString("0.##")</td><td class="stock-number">@Model.Rows.Sum(r=>r.Incoming).ToString("0.##")</td><td class="stock-number">@Model.Rows.Sum(r=>r.Outgoing).ToString("0.##")</td><td class="stock-number">@Model.Rows.Sum(r=>r.Closing).ToString("0.##")</td><td class="stock-number">@Model.Rows.Sum(r=>r.Product.CurrentStock).ToString("0.##")</td><td></td></tr></tfoot></table></div>
