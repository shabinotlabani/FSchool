@model DevelopmentHistory
@{
    ViewData["Title"]="Profili i lojtarit";
    (string? Value, DateOnly? Date) Latest(string kind,string key){
        var configured=Model.Catalog.Find(kind)?.Fields.FirstOrDefault(x=>x.Key==key);
        if(configured==null)return(null,null);
        foreach(var row in Model.Records.Where(x=>x.Sport==Model.Catalog.Sport&&x.Kind==kind).OrderByDescending(x=>x.Date).ThenByDescending(x=>x.Id)){
            if(!row.Schema.Fields.Any(f=>f.Key==key&&f.Label==configured.Label&&f.Min==configured.Min&&f.Max==configured.Max))continue;
            if(row.Values.TryGetValue(key,out var value))return (value,row.Date);
        }
        return (null,null);
    }
    var height=Latest("Measurements","Height");var weight=Latest("Measurements","Weight");var sprint=Latest("Testing","Sprint20");
    var skillKind=Model.IsGoalkeeper?"Goalkeeping":"Skills";
    var skills=(Model.Catalog.Find(skillKind)?.Fields??[]).Where(f=>f.Slider&&f.Max==5).Take(Model.IsGoalkeeper?6:4).Select(f=>new{Label=f.Label.Replace(" / 5",""),Entry=Latest(skillKind,f.Key)}).ToList();
    var scored=skills.Where(x=>x.Entry.Value!=null).ToList();
    var latestDate=Model.Records.Select(x=>(DateOnly?)x.Date).Concat(Model.Evaluations.Select(x=>(DateOnly?)x.Date)).Max();
}
<link rel="stylesheet" href="~/css/player-development.css" asp-append-version="true"/>
<section class="development-ui player-overview">
<header class="profile-heading"><span class="profile-person" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="7" r="3"/><path d="M5 21v-2a7 7 0 0 1 14 0v2"/></svg></span><div><h1>@Model.Player.FullName <partial name="_WhatsAppContact" model="@(new _2Korriku.Services.WhatsAppContact(Model.Player.ParentPhone,Model.Player.ParentName))"/></h1><p>@(latestDate.HasValue?"Përditësuar më "+latestDate.Value.ToString("dd.MM.yyyy"):"Ende pa vlerësime")</p></div><span class="profile-team">@Model.Player.TrainingTeam?.Name</span></header>
@{var positionError=TempData["PositionError"] as string;}
<details class="development-extra position-editor" open="@(Model.PlayerRole==null||positionError!=null)"><summary><span>@(Model.PlayerRole??"Cakto rolin")@if(!Model.IsGoalkeeper&&Model.Positions.Contains(Model.PrimaryPosition)){<small> · @Model.PrimaryPosition</small>}@if(!Model.IsGoalkeeper&&Model.Positions.Contains(Model.SecondaryPosition)){<small> / @Model.SecondaryPosition</small>}</span><small class="text-secondary">Ndrysho</small></summary>
@if(positionError!=null){<p class="text-danger" role="alert">@positionError</p>}
<form asp-action="Position" method="post" class="position-form"><input type="hidden" name="studentId" value="@Model.Player.Id"/>
<div><label for="player-role">Roli</label><select id="player-role" name="playerRole" required class="form-select"><option value="" disabled selected="@(Model.PlayerRole==null)">Zgjidh</option>@foreach(var role in Model.Catalog.Roles){<option selected="@(Model.PlayerRole==role)">@role</option>}</select></div>
<div data-outfield-position><label for="primary-position">Pozita kryesore</label><select id="primary-position" name="primaryPosition" class="form-select"><option value="">Zgjidh pozitën</option>@foreach(var position in Model.Positions){<option selected="@(position==Model.PrimaryPosition)">@position</option>}</select></div>
<div data-outfield-position><label for="secondary-position">Pozita e dytë <small>· opsionale</small></label><select id="secondary-position" name="secondaryPosition" class="form-select"><option value="Asnjë">Pa pozitë të dytë</option>@foreach(var position in Model.Positions){<option selected="@(position==Model.SecondaryPosition)">@position</option>}</select></div>
<div class="position-save"><button class="btn btn-outline-secondary">Ruaj</button></div></form>
</details>
<div class="profile-measurements">
@foreach(var metric in Model.Sections.Where(s=>s.Key is "Measurements" or "Testing").SelectMany(s=>s.Fields.Where(f=>f.Min.HasValue).Select(f=>new{Label=f.Label,Entry=Latest(s.Key,f.Key),Unit=""})).Take(3)){
<div><span>@metric.Label</span><strong>@(metric.Entry.Value==null?"—":metric.Entry.Value+" "+metric.Unit)</strong>@if(metric.Entry.Date.HasValue){<small>@metric.Entry.Date.Value.ToString("dd.MM.yyyy")</small>}</div>}
</div>
<div class="profile-skills"><h2>@(Model.IsGoalkeeper?"Aftësitë e portierit":"Aftësitë teknike")</h2>
@foreach(var skill in skills){var rating=int.TryParse(skill.Entry.Value,out var n)?n:0;
<div class="profile-skill"><div><span>@skill.Label</span><strong>@(rating==0?"Pa vlerësim":rating+"/5")</strong></div><div class="skill-segments" role="img" aria-label="@(skill.Label+": "+(rating==0?"pa vlerësim":rating+" nga 5"))">@for(var i=1;i<=5;i++){<i class="@(i<=rating?"filled":"")"></i>}</div></div>}
</div>
@if(scored.Count>0){var min=scored.Min(x=>int.Parse(x.Entry.Value!));var weakest=scored.Where(x=>int.Parse(x.Entry.Value!)==min).ToList();
<div class="profile-insight"><h2>Vëzhgim nga vlerësimet</h2><p>@if(weakest.Count==scored.Count){<text>Aftësitë e vlerësuara kanë të njëjtin rezultat: @min/5.</text>}else{<text>@string.Join(", ",weakest.Select(x=>x.Label)) ka rezultatin më të ulët mes aftësive të vlerësuara (@min/5) dhe mund të jetë fokus i stërvitjes së ardhshme.</text>}</p></div>}
<a asp-controller="CareReferrals" asp-action="Create" asp-route-studentId="@Model.Player.Id" class="btn btn-sm btn-outline-secondary mt-2">Refero te mjeku / nutricisti</a>
<a asp-controller="CoachMenus" asp-action="Index" asp-route-studentId="@Model.Player.Id" class="btn btn-sm btn-outline-primary mt-2">@(ViewData["IndividualMenu"] is true?"Menu individuale · AI":"Propozo menu me AI")</a>
<div class="player-care-links">@foreach(var part in new[]{("injuries","Lëndimet"),("doctor","Mjeku"),("psychologist","Psikologu")}){<a asp-action="Player" asp-route-id="@Model.Player.Id" asp-route-section="Progress" asp-fragment="@part.Item1">@part.Item2</a>}</div>
<nav class="profile-actions" aria-label="Plotëso të dhënat e lojtarit">
@foreach(var action in new[]{(skillKind,"Aftësitë"),("Measurements","Matjet"),("Testing","Testimet"),("Profile","Profili"),(Model.IsGoalkeeper?"KeeperTraining":"Talent",Model.IsGoalkeeper?"Ushtrimet":"Talenti")}.Where(a=>Model.Catalog.Find(a.Item1)!=null)){<a asp-action="Record" asp-route-studentId="@Model.Player.Id" asp-route-kind="@action.Item1"><span aria-hidden="true">+</span> @action.Item2</a>}
<a asp-action="Player" asp-route-id="@Model.Player.Id" asp-route-section="Progress">Ecuria <span aria-hidden="true">↗</span></a>
</nav>
@if(Model.IsGoalkeeper && Model.Catalog.Find("KeeperTraining")!=null && Model.Records.Any(x=>x.Kind=="KeeperTraining")){
<details class="development-extra"><summary>Ushtrimet e regjistruara</summary><partial name="_Records" model="@(new DevelopmentRecordGrid(Model.Catalog.Find("KeeperTraining")!,Model.Records,Model.CoachId))"/></details>
}
<details class="development-extra"><summary>Vlerësime të tjera</summary>
<form asp-action="Record" method="get" class="d-flex gap-2 pb-3"><input type="hidden" name="studentId" value="@Model.Player.Id"/><label for="extra-kind" class="visually-hidden">Lloji i vlerësimit</label><select id="extra-kind" name="kind" class="form-select">@foreach(var part in Model.Sections.Where(x=>x.Key is "Skills" or "Tactics" or "Talent" or "Match" or "Load")){<option value="@part.Key">@part.Label</option>}</select><button class="btn btn-outline-secondary">Hap</button></form>
</details>
</section>

<div class="d-flex gap-3 flex-wrap mt-3">
<a class="btn btn-outline-secondary" asp-controller="CoachInbox" asp-action="Thread" asp-route-studentId="@Model.Player.Id" asp-route-returnUrl="@Url.Action("Player","PlayerDevelopment",new{id=Model.Player.Id})">Mesazh prindit</a>
<a class="btn btn-outline-secondary" asp-controller="CoachInbox" asp-action="Deactivate" asp-route-studentId="@Model.Player.Id" asp-route-returnUrl="@Url.Action("Players","Coaches")">Pasivizo</a>
</div>
@section PageNavigation {
@{var origin=Context.Request.Query["returnUrl"].ToString();var fromPlayers=Url.IsLocalUrl(origin)&&origin.Split('?')[0].Equals("/Coaches/Players",StringComparison.OrdinalIgnoreCase);}
@if(fromPlayers){<a href="@origin" class="btn btn-outline-secondary app-back-button" id="back-to-attendance" data-student="@Model.Player.Id">← Lojtarët e mi</a>}
else{<a asp-controller="Attendance" asp-action="Index" asp-route-teamId="@Model.Player.TrainingTeamId" asp-route-coachRole="@(Model.Player.TrainingTeam?.CoachId==User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ? "head" : "assistant")" class="btn btn-outline-secondary app-back-button" id="back-to-attendance" data-student="@Model.Player.Id">← Prezenca</a>}
}
@section Scripts {<script src="~/js/development-navigation.js" asp-append-version="true"></script>}
