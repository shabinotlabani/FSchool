@model DevelopmentHistory
@{ViewData["Title"]="Zhvillimi i lojtarit";}
<link rel="stylesheet" href="~/css/player-development.css" asp-append-version="true"/>
<section class="development-ui">
<div class="page-heading"><div><h1>@Model.Player.FullName</h1><span class="text-secondary">@Model.Player.TrainingTeam?.Name · @Model.Player.DateOfBirth.ToString("dd/MM/yyyy")</span></div>
@if(Model.Section=="Assessment"){<a asp-action="Edit" asp-route-studentId="@Model.Player.Id" class="btn btn-primary">Vlerësim i ri</a>}
else if(Model.Section!="Progress"){<a asp-action="Record" asp-route-studentId="@Model.Player.Id" asp-route-kind="@Model.Section" class="btn btn-primary">Regjistrim i ri</a>}</div>

<nav class="development-tabs" aria-label="Zhvillimi i lojtarit">
@foreach(var tab in new[]{("Skills","Aftësitë"),("Assessment","Vlerësimi"),("Profile","Profili"),("Testing","Testimet"),("Progress","Progresi ndër vite"),("Talent","Talenti"),("Measurements","Matjet fizike")}){<a asp-action="Player" asp-route-id="@Model.Player.Id" asp-route-section="@tab.Item1" class="btn btn-sm @(Model.Section==tab.Item1?"btn-primary":"btn-outline-secondary")" aria-current="@(Model.Section==tab.Item1?"page":null)">@tab.Item2</a>}
</nav>
<form method="get" class="d-flex gap-2 mb-3"><input type="hidden" name="id" value="@Model.Player.Id"/><input type="hidden" name="section" value="@Model.Section"/><label for="development-year" class="align-self-center">Viti</label><select name="year" id="development-year" class="form-select" style="max-width:170px"><option value="">Të gjitha vitet</option>@foreach(var year in Model.Years){<option value="@year" selected="@(Model.Year==year)">@year</option>}</select><button class="btn btn-outline-secondary">Shfaq</button></form>
@if(Model.Section=="Progress"){
<h2 class="h5">Vlerësimet sipas vitit</h2><div class="table-responsive"><table class="table"><thead><tr><th>Viti</th><th>Vlerësime</th><th>Teknika / 5</th><th>Taktika / 5</th><th>Fizike / 5</th><th>Disiplina / 5</th><th>Bashkëpunimi / 5</th><th>Mesatarja / 5</th></tr></thead><tbody>
@foreach(var group in Model.Evaluations.GroupBy(x=>x.Date.Year).OrderByDescending(x=>x.Key)){<tr><td>@group.Key</td><td>@group.Count()</td><td>@group.Average(x=>x.Technique).ToString("0.0")</td><td>@group.Average(x=>x.Tactics).ToString("0.0")</td><td>@group.Average(x=>x.Fitness).ToString("0.0")</td><td>@group.Average(x=>x.Discipline).ToString("0.0")</td><td>@group.Average(x=>x.Teamwork).ToString("0.0")</td><td>@group.Average(x=>x.Average).ToString("0.0")</td></tr>}
@if(Model.Evaluations.Count==0){<tr><td colspan="8">Ende pa vlerësime.</td></tr>}
</tbody></table></div>
@foreach(var section in Model.Sections){<details class="development-extra"><summary>@(section.Label)</summary><partial name="_Records" model="@(new DevelopmentRecordGrid(section,Model.Records,Model.CoachId))"/></details>}
}else if(Model.Section!="Assessment"){
<partial name="_Records" model="@(new DevelopmentRecordGrid(Model.Catalog.Find(Model.Section)??DevelopmentSections.Find(Model.Section)!,Model.Records,Model.CoachId))"/>
}else{
<div class="table-responsive"><table class="table align-middle"><thead><tr><th>Data</th><th>Trajneri</th><th>Teknika</th><th>Taktika</th><th>Fizike</th><th>Disiplina</th><th>Bashkëpunimi</th><th>Mesatarja / 5</th><th></th></tr></thead><tbody>
@for(var i=0;i<Model.Evaluations.Count;i++){var e=Model.Evaluations[i];var previous=i+1<Model.Evaluations.Count?Model.Evaluations[i+1]:null;
<tr><td>@e.Date.ToString("dd/MM/yyyy")</td><td>@e.Coach.FirstName @e.Coach.LastName</td><td>@e.Technique</td><td>@e.Tactics</td><td>@e.Fitness</td><td>@e.Discipline</td><td>@e.Teamwork</td><td><strong>@e.Average.ToString("0.0")</strong>@if(previous!=null){<small class="text-secondary ms-2">@((e.Average-previous.Average).ToString("+0.0;-0.0;0.0"))</small>}</td><td>@if(e.CoachId==Model.CoachId){<a asp-action="Edit" asp-route-id="@e.Id" asp-route-studentId="@e.StudentId">Ndrysho</a>}</td></tr>
<tr><td colspan="9"><details><summary>Plani i zhvillimit · Rishikimi @(e.ReviewDate?.ToString("dd/MM/yyyy")??"—")</summary><dl class="row mt-3"><dt class="col-md-3">Pikat e forta</dt><dd class="col-md-9" style="white-space:pre-wrap">@(e.Strengths??"—")</dd><dt class="col-md-3">Për t’u përmirësuar</dt><dd class="col-md-9" style="white-space:pre-wrap">@(e.Improvements??"—")</dd><dt class="col-md-3">Objektivat</dt><dd class="col-md-9" style="white-space:pre-wrap">@e.Goals</dd></dl></details></td></tr>}
@if(Model.Evaluations.Count==0){<tr><td colspan="9">Ende pa vlerësime.</td></tr>}
</tbody></table></div>
}
</section>

@section PageNavigation {<a asp-action="Player" asp-route-id="@Model.Player.Id" class="btn btn-outline-secondary app-back-button">← Profili i lojtarit</a>}
