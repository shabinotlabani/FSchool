@model DevelopmentChart
@using System.Globalization
@{
    string Number(decimal n)=>n.ToString("0.##",CultureInfo.InvariantCulture);
    var stars=Model.Rating&&ViewData["StarRatings"] is true;
    string Value(decimal n){var count=Math.Clamp((int)Math.Round(n),0,5);return stars?new string('★',count)+new string('☆',5-count):Number(n)+" "+Model.Unit;}
    var points=Model.Points;
    var minimum=Model.Rating?(Model.Unit=="/100"?0:1):points.Count==0?0:Math.Max(0,points.Min(x=>x.Value)-Math.Max(1,(points.Max(x=>x.Value)-points.Min(x=>x.Value))*0.15m));
    var maximum=Model.Rating?(Model.Unit=="/100"?100:5):points.Count==0?1:points.Max(x=>x.Value)+Math.Max(1,(points.Max(x=>x.Value)-points.Min(x=>x.Value))*0.15m);
    decimal X(DevelopmentPoint p)=>points.Count<2?222:48+348m*(p.Date.DayNumber-points[0].Date.DayNumber)/Math.Max(1,points[^1].Date.DayNumber-points[0].Date.DayNumber);
    decimal Y(DevelopmentPoint p)=>146-118m*(p.Value-minimum)/(maximum-minimum);
    var line=string.Join(" ",points.Select(p=>Number(X(p))+","+Number(Y(p))));
    var last=points.LastOrDefault();
    var delta=points.Count>1?points[^1].Value-points[0].Value:0;
}
<section class="progress-chart @(stars?"star-rating-chart":"")">
<header><h3>@Model.Title</h3></header>
@if(points.Count==0){<p class="progress-empty">Ende pa regjistrime për @Model.Title.ToLower().</p>}
else{
<div class="progress-comparison">
<div><span>Në fillim</span><strong aria-label="@(stars?Number(points[0].Value)+" nga 5 yje":null)">@Value(points[0].Value)</strong><small>@points[0].Date.ToString("dd/MM/yyyy")</small></div>
<div><span>E fundit</span><strong aria-label="@(stars?Number(last!.Value)+" nga 5 yje":null)">@Value(last!.Value)</strong><small>@last.Date.ToString("dd/MM/yyyy")</small></div>
<div><span>Ndryshimi</span><strong>@(points.Count<2?"—":delta.ToString("+0.##;-0.##;0")+" "+(stars?"★":Model.Rating?"pikë":Model.Unit))</strong><small>@(points.Count<2?"Vetëm një regjistrim":Model.Title.StartsWith("Sprint")?(delta<0?"Më shpejt":delta>0?"Më ngadalë":"Pa ndryshim"):Model.Rating?(delta>0?"Përmirësim":delta<0?"Rënie":"Pa ndryshim"):"Nga matja e parë")</small></div>
</div>
@if(points.Count==1){<p class="progress-caption">Ecuria shfaqet pas regjistrimit të dytë.</p>}
<svg viewBox="0 0 420 184" role="group" aria-label="Ecuria: @Model.Title" class="progress-plot">
<g class="plot-grid"><path d="M48 28H396 M48 87H396 M48 146H396"/></g>
<g class="plot-labels"><text x="40" y="32" text-anchor="end">@Number(maximum)</text><text x="40" y="91" text-anchor="end">@Number((maximum+minimum)/2)</text><text x="40" y="150" text-anchor="end">@Number(minimum)</text><text x="48" y="175">@points[0].Date.ToString("dd/MM/yyyy")</text>@if(points.Count>1){<g><text x="396" y="175" text-anchor="end">@points[^1].Date.ToString("dd/MM/yyyy")</text></g>}</g>
@if(points.Count>1){<polyline points="@line" class="plot-line"/>}
@foreach(var p in points){var label=p.Date.ToString("dd/MM/yyyy")+" · "+Value(p.Value);
<g><circle cx="@Number(X(p))" cy="@Number(Y(p))" r="4" class="plot-dot"/><circle cx="@Number(X(p))" cy="@Number(Y(p))" r="13" class="plot-hit" tabindex="0" role="button" aria-label="@label" data-value="@label"><title>@label</title></circle></g>}
</svg>
<p class="plot-readout" aria-live="polite">@last!.Date.ToString("dd/MM/yyyy") · @Value(last.Value)</p>
}
</section>
