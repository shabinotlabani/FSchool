@model DevelopmentHistory
@{
    ViewData["Title"]="Ecuria";
    var charts=_2Korriku.Services.DevelopmentCharts.Build(Model.Records);
    foreach(var sport in Model.Evaluations.GroupBy(x=>x.Sport)){
        charts.Add(new DevelopmentChart(_2Korriku.Services.SportDevelopmentService.Label(sport.Key)+" · Vlerësimi i përgjithshëm","/5",sport.GroupBy(x=>x.Date).OrderBy(x=>x.Key).Select(g=>new DevelopmentPoint(g.Key,g.OrderByDescending(x=>x.Id).First().Average)).ToList(),true));
    }
    var selected=charts.FindIndex(x=>x.Points.Count>0);
    if(selected<0)selected=0;
}
<link rel="stylesheet" href="~/css/player-development.css" asp-append-version="true"/>
<section class="development-ui progress-page">

<header class="progress-heading"><h1>Ecuria</h1><p>@Model.Player.FullName <span>· @Model.Player.TrainingTeam?.Name</span></p></header>
@if(ViewData["MatchMinutes"] is PlayerMatchMinutes minutes){
<section class="progress-mini-card player-match-summary" aria-label="Minutazhi në ndeshje">
<header class="d-flex justify-content-between align-items-center gap-2"><h2 class="h6 mb-0">Minutazhi</h2><small>@(Model.Year.HasValue?Model.Year.Value.ToString():"Gjithë periudha")</small></header>
@if(minutes.Appearances>0){<div class="progress-comparison">
<div><span>Mesatarja / ndeshje</span><strong data-match-average>@minutes.Average.ToString("0.#") min</strong></div>
<div><span>Gjithsej</span><strong>@minutes.TotalMinutes min</strong></div>
<div><span>Ndeshje të luajtura</span><strong>@minutes.Appearances</strong></div>
</div><p class="progress-caption mb-0">@(ViewData["IncludesCurrentMatch"] is true?"Përfshirë minutat e regjistruara në këtë ndeshje, nëse nuk është anuluar.":"Vetëm ndeshjet e përfunduara ku ka luajtur.")</p>}
else{<p class="progress-empty mb-0">Ende pa minuta në ndeshje të përfunduara.</p>}
</section>
}
<partial name="~/Views/PlayerDevelopment/_CareProgress.cshtml" model="Model"/>
<h2 class="h6 mt-4">Zhvillimi dhe matjet</h2>
<div class="progress-card-grid">
@foreach(var chart in charts.Where(x=>x.Points.Count>0)){<div class="progress-mini-card"><partial name="~/Views/PlayerDevelopment/_Chart.cshtml" model="chart"/></div>}
</div>
@if(!charts.Any(x=>x.Points.Count>0)){<p class="progress-empty">Ende pa regjistrime.</p>}
</section>
@section Scripts {<script src="~/js/player-progress.js" asp-append-version="true"></script>}

@section PageNavigation {
@if(ViewData["AdminMatchId"] is int matchId){<a asp-controller="Home" asp-action="MatchReport" asp-route-id="@matchId" class="btn btn-outline-secondary app-back-button">← Ndeshja</a>}else{<a asp-action="Player" asp-route-id="@Model.Player.Id" class="btn btn-outline-secondary app-back-button">← Profili i lojtarit</a>}}
