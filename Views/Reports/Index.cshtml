@model CashReportModel
@using _2Korriku.Services
@{ViewData["Title"]="Raporti i hyrjeve dhe shpenzimeve";}
<link rel="stylesheet" href="~/css/cash-report.css" asp-append-version="true" />
<div class="financial-report">
<div class="page-heading"><div><p class="eyebrow">RAPORTI FINANCIAR</p><h1>Hyrjet dhe shpenzimet</h1></div><div class="d-flex gap-2 flex-wrap">@if(User.IsInRole(Roles.Admin)){<a asp-action="CoachActivity" class="btn btn-outline-primary">Aktiviteti i trajnerëve</a>}<a asp-controller="Treasury" asp-action="Index" class="btn btn-outline-primary">Arkat</a><a asp-action="Reasons" asp-route-from="@Model.Filter.From?.ToString("yyyy-MM-dd")" asp-route-to="@Model.Filter.To?.ToString("yyyy-MM-dd")" class="btn btn-outline-primary">Veprimet me arsye</a><a asp-action="Operations" class="btn btn-outline-primary">Borxhet dhe stoku</a></div></div>
<form method="get" class="panel p-3 mb-4 financial-report-filter"><div asp-validation-summary="All" class="text-danger" role="alert"></div><div class="d-flex gap-3 flex-wrap align-items-end"><div><label for="From" class="form-label">Nga data</label><input id="From" name="From" value="@Model.Filter.From?.ToString("yyyy-MM-dd")" type="date" min="1900-01-01" max="@BillingClock.Today.ToString("yyyy-MM-dd")" class="form-control" required/></div><div><label for="To" class="form-label">Deri në datë</label><input id="To" name="To" value="@Model.Filter.To?.ToString("yyyy-MM-dd")" type="date" min="1900-01-01" max="@BillingClock.Today.ToString("yyyy-MM-dd")" class="form-control" required/></div><button class="btn btn-primary">Shfaq raportin</button><a asp-action="Index" class="btn btn-outline-secondary">Ky muaj</a>@if(ViewData.ModelState.IsValid){<a asp-action="Print" asp-route-from="@Model.Filter.From?.ToString("yyyy-MM-dd")" asp-route-to="@Model.Filter.To?.ToString("yyyy-MM-dd")" class="btn btn-outline-primary">Printo raportin A4</a>}<a asp-controller="Expenses" asp-action="Index" class="btn btn-outline-secondary">Shpenzimet</a></div></form>
@if(ViewData.ModelState.IsValid){

<section class="panel p-4"><partial name="_CashSummary" model="Model"/></section>
<details class="panel p-4 mt-4"><summary class="fw-semibold">Shiko lëvizjet e periudhës (@Model.Movements.Count)</summary><div class="table-responsive mt-3"><table class="table align-middle cash-movements"><thead><tr><th>Data</th><th>Dokumenti</th><th>Burimi / kategoria</th><th>Përshkrimi</th><th>Mënyra</th><th>Hyrje</th><th>Dalje</th></tr></thead><tbody>
@foreach(var m in Model.Movements){<tr><td data-label="Data">@m.Date.ToString("dd/MM/yyyy")</td><td data-label="Dokumenti"><a asp-controller="@m.Controller" asp-action="@m.Action" asp-route-id="@m.Id">@m.Reference</a></td><td data-label="Burimi / kategoria">@(m.Group=="Shpenzime"?m.Category:m.Group)<small class="d-block">@m.Subcategory</small></td><td data-label="Përshkrimi">@m.Description</td><td data-label="Mënyra">@(m.Method == "Cash" ? "Cash" : m.Method == "Bank" ? "Bankë" : "Tjetër / e papërcaktuar")</td><td data-label="Hyrje">@m.Income.ToString("N2")</td><td data-label="Dalje">@m.Outgoing.ToString("N2")</td></tr>}
@if(Model.Movements.Count==0){<tr><td colspan="7">Nuk ka lëvizje në këtë periudhë.</td></tr>}
</tbody></table></div></details>}

</div>
