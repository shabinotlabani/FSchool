@model CashReportModel
@{var columns=Model.HasOtherMethod?7:6; var receipts=Model.Movements.Where(x=>x.Group!=TreasuryEntry.OpeningGroup).ToList(); var expenses=Model.Movements.Where(x=>x.Group=="Shpenzime").ToList();}
<link rel="stylesheet" href="~/css/cash-report.css" asp-append-version="true" />
<h2 class="h5 stock-print-category">Hyrjet nga arkëtimet</h2>
<div class="table-responsive"><table class="table document-table cash-report-table cash-breakdown"><thead><tr><th>Burimi</th><th>Arkëtime bruto</th><th>Anulime</th><th>Cash neto</th><th>Bankë neto</th>@if(Model.HasOtherMethod){<th>Tjetër neto</th>}<th>Gjithsej neto</th></tr></thead><tbody>
@{var incomeIndex=0;}
@foreach(var r in Model.IncomeRows){var rows=Model.Movements.Where(x=>x.Group==r.Name).ToList();var incomeKey=$"cash-income-{incomeIndex++}";<tr class="cash-income-group"><td data-label="Burimi"><button type="button" class="cash-expand" data-cash-toggle="@incomeKey" aria-expanded="false"><span>+</span><strong>@r.Name</strong></button></td><td data-label="Arkëtime bruto">@r.Gross.ToString("N2")</td><td class="cash-reversed" data-label="Anulime">@r.Reversed.ToString("N2")</td><td data-label="Cash neto">@rows.Where(x=>x.Method=="Cash").Sum(x=>x.Income).ToString("N2")</td><td data-label="Bankë neto">@rows.Where(x=>x.Method=="Bank").Sum(x=>x.Income).ToString("N2")</td>@if(Model.HasOtherMethod){<td data-label="Tjetër neto">@rows.Where(x=>x.Method=="Other").Sum(x=>x.Income).ToString("N2")</td>}<td data-label="Gjithsej neto">@r.Net.ToString("N2")</td></tr>
@foreach(var entry in rows.OrderByDescending(x=>x.Date).ThenBy(x=>x.Reference)){<tr class="cash-income-detail" data-cash-parent="@incomeKey" hidden><td data-label="Dokumenti"><a class="cash-entry-link" asp-controller="@entry.Controller" asp-action="@entry.Action" asp-route-id="@entry.Id" asp-route-embedded="true" asp-route-returnUrl="@(Context.Request.PathBase + Context.Request.Path + Context.Request.QueryString)"><strong>@entry.Date.ToString("dd/MM/yyyy") · @entry.Description</strong><small>@entry.Reference</small></a></td><td data-label="Arkëtime bruto">@(entry.Income>0?entry.Income.ToString("N2"):"—")</td><td class="cash-reversed" data-label="Anulime">@(entry.Income<0?(-entry.Income).ToString("N2"):"—")</td><td data-label="Cash neto">@(entry.Method=="Cash"?entry.Income.ToString("N2"):"—")</td><td data-label="Bankë neto">@(entry.Method=="Bank"?entry.Income.ToString("N2"):"—")</td>@if(Model.HasOtherMethod){<td data-label="Tjetër neto">@(entry.Method=="Other"?entry.Income.ToString("N2"):"—")</td>}<td data-label="Gjithsej neto">@entry.Income.ToString("N2")</td></tr>}}
</tbody><tfoot><tr><th data-label="Burimi">GJITHSEJ HYRJE</th><td data-label="Arkëtime bruto">@Model.IncomeRows.Sum(x=>x.Gross).ToString("N2")</td><td class="cash-reversed" data-label="Anulime">@Model.IncomeRows.Sum(x=>x.Reversed).ToString("N2")</td><td data-label="Cash neto">@receipts.Where(x=>x.Method=="Cash").Sum(x=>x.Income).ToString("N2")</td><td data-label="Bankë neto">@receipts.Where(x=>x.Method=="Bank").Sum(x=>x.Income).ToString("N2")</td>@if(Model.HasOtherMethod){<td data-label="Tjetër neto">@receipts.Where(x=>x.Method=="Other").Sum(x=>x.Income).ToString("N2")</td>}<td data-label="Gjithsej neto"><strong>@Model.Income.ToString("N2")</strong></td></tr></tfoot></table></div>
<h2 class="h5 stock-print-category mt-4">Daljet sipas kategorive dhe nënkategorive</h2>
<div class="table-responsive"><table class="table document-table cash-report-table cash-breakdown"><thead><tr><th>Kategoria / nënkategoria</th><th>Shpenzuar bruto</th><th>Anulime</th><th>Cash neto</th><th>Bankë neto</th>@if(Model.HasOtherMethod){<th>Tjetër neto</th>}<th>Gjithsej neto</th></tr></thead><tbody>
@{var categoryIndex=0;}
@foreach(var group in Model.Movements.Where(x=>x.Group=="Shpenzime").GroupBy(x=>x.Category).OrderBy(x=>x.Key)){var categoryKey=$"cash-category-{categoryIndex++}";
<tr class="cash-category"><th data-label="Kategoria / nënkategoria"><button type="button" class="cash-expand" data-cash-toggle="@categoryKey" aria-expanded="false"><span>+</span><strong>@group.Key</strong></button></th><td data-label="Shpenzuar bruto">@group.Where(x=>x.Outgoing>0).Sum(x=>x.Outgoing).ToString("N2")</td><td class="cash-reversed" data-label="Anulime">@((-group.Where(x=>x.Outgoing<0).Sum(x=>x.Outgoing)).ToString("N2"))</td><td data-label="Cash neto">@group.Where(x=>x.Method=="Cash").Sum(x=>x.Outgoing).ToString("N2")</td><td data-label="Bankë neto">@group.Where(x=>x.Method=="Bank").Sum(x=>x.Outgoing).ToString("N2")</td>@if(Model.HasOtherMethod){<td data-label="Tjetër neto">@group.Where(x=>x.Method=="Other").Sum(x=>x.Outgoing).ToString("N2")</td>}<td data-label="Gjithsej neto">@group.Sum(x=>x.Outgoing).ToString("N2")</td></tr>
var subIndex=0;
@foreach(var sub in group.GroupBy(x=>x.Subcategory).OrderBy(x=>x.Key)){var subKey=$"{categoryKey}-sub-{subIndex++}";<tr class="cash-subcategory" data-cash-parent="@categoryKey" hidden><td data-label="Kategoria / nënkategoria"><button type="button" class="cash-expand is-sub" data-cash-toggle="@subKey" aria-expanded="false"><span>+</span><strong>@(sub.Key??"Pa nënkategori")</strong></button></td><td data-label="Shpenzuar bruto">@sub.Where(x=>x.Outgoing>0).Sum(x=>x.Outgoing).ToString("N2")</td><td class="cash-reversed" data-label="Anulime">@((-sub.Where(x=>x.Outgoing<0).Sum(x=>x.Outgoing)).ToString("N2"))</td><td data-label="Cash neto">@sub.Where(x=>x.Method=="Cash").Sum(x=>x.Outgoing).ToString("N2")</td><td data-label="Bankë neto">@sub.Where(x=>x.Method=="Bank").Sum(x=>x.Outgoing).ToString("N2")</td>@if(Model.HasOtherMethod){<td data-label="Tjetër neto">@sub.Where(x=>x.Method=="Other").Sum(x=>x.Outgoing).ToString("N2")</td>}<td data-label="Gjithsej neto">@sub.Sum(x=>x.Outgoing).ToString("N2")</td></tr>
@foreach(var entry in sub.OrderByDescending(x=>x.Date).ThenBy(x=>x.Reference)){<tr class="cash-expense-detail" data-cash-parent="@subKey" data-cash-ancestor="@categoryKey" hidden><td data-label="Dokumenti"><a class="cash-entry-link" asp-controller="@entry.Controller" asp-action="@entry.Action" asp-route-id="@entry.Id" asp-route-embedded="true" asp-route-returnUrl="@(Context.Request.PathBase + Context.Request.Path + Context.Request.QueryString)"><strong>@entry.Date.ToString("dd/MM/yyyy") · @entry.Description</strong><small>@entry.Reference</small></a></td><td data-label="Shpenzuar bruto">@(entry.Outgoing>0?entry.Outgoing.ToString("N2"):"—")</td><td class="cash-reversed" data-label="Anulime">@(entry.Outgoing<0?(-entry.Outgoing).ToString("N2"):"—")</td><td data-label="Cash neto">@(entry.Method=="Cash"?entry.Outgoing.ToString("N2"):"—")</td><td data-label="Bankë neto">@(entry.Method=="Bank"?entry.Outgoing.ToString("N2"):"—")</td>@if(Model.HasOtherMethod){<td data-label="Tjetër neto">@(entry.Method=="Other"?entry.Outgoing.ToString("N2"):"—")</td>}<td data-label="Gjithsej neto">@entry.Outgoing.ToString("N2")</td></tr>}}}
@if(!Model.Movements.Any(x=>x.Group=="Shpenzime")){<tr><td colspan="@columns">Nuk ka shpenzime në këtë periudhë.</td></tr>}
</tbody><tfoot><tr><th data-label="Kategoria / nënkategoria">GJITHSEJ SHPENZIME</th><td data-label="Shpenzuar bruto">@expenses.Where(x=>x.Outgoing>0).Sum(x=>x.Outgoing).ToString("N2")</td><td class="cash-reversed" data-label="Anulime">@((-expenses.Where(x=>x.Outgoing<0).Sum(x=>x.Outgoing)).ToString("N2"))</td><td data-label="Cash neto">@expenses.Where(x=>x.Method=="Cash").Sum(x=>x.Outgoing).ToString("N2")</td><td data-label="Bankë neto">@expenses.Where(x=>x.Method=="Bank").Sum(x=>x.Outgoing).ToString("N2")</td>@if(Model.HasOtherMethod){<td data-label="Tjetër neto">@expenses.Where(x=>x.Method=="Other").Sum(x=>x.Outgoing).ToString("N2")</td>}<td data-label="Gjithsej neto"><strong>@expenses.Sum(x=>x.Outgoing).ToString("N2")</strong></td></tr></tfoot></table></div>
<script>document.addEventListener('click',event=>{const button=event.target.closest('[data-cash-toggle]');if(!button)return;const key=button.dataset.cashToggle,opening=button.getAttribute('aria-expanded')!=='true';button.setAttribute('aria-expanded',String(opening));button.querySelector('span').textContent=opening?'−':'+';document.querySelectorAll(`[data-cash-parent="${key}"]`).forEach(row=>row.hidden=!opening);if(!opening){document.querySelectorAll(`[data-cash-ancestor="${key}"]`).forEach(row=>row.hidden=true);document.querySelectorAll(`[data-cash-parent="${key}"] [data-cash-toggle]`).forEach(child=>{child.setAttribute('aria-expanded','false');child.querySelector('span').textContent='+';});}});</script>
@if(Model.Movements.Any(x=>x.Group==TreasuryEntry.OpeningGroup || x.Group==TreasuryEntry.WithdrawalGroup)){
<div class="table-responsive mt-4"><table class="table document-table cash-report-table cash-breakdown"><thead><tr><th>Veprimi</th><th>Bruto</th><th>Anulime</th><th>Cash neto</th><th>Bankë neto</th>@if(Model.HasOtherMethod){<th>Tjetër neto</th>}<th>Gjithsej neto</th></tr></thead><tbody>
@{var treasuryIndex=0;}
@foreach(var name in new[]{TreasuryEntry.OpeningGroup,TreasuryEntry.WithdrawalGroup}){
    var entries=Model.Movements.Where(x=>x.Group==name).ToList();
    if(entries.Count==0){continue;}
    var treasuryKey=$"cash-treasury-{treasuryIndex++}";
    <tr><td data-label="Veprimi"><button type="button" class="cash-expand" data-cash-toggle="@treasuryKey" aria-expanded="false"><span>+</span><strong>@name</strong></button></td><td data-label="Bruto">@entries.Where(x=>x.Income+x.Outgoing>0).Sum(x=>x.Income+x.Outgoing).ToString("N2")</td><td class="cash-reversed" data-label="Anulime">@((-entries.Where(x=>x.Income+x.Outgoing<0).Sum(x=>x.Income+x.Outgoing)).ToString("N2"))</td><td data-label="Cash neto">@entries.Where(x=>x.Method=="Cash").Sum(x=>x.Income+x.Outgoing).ToString("N2")</td><td data-label="Bankë neto">@entries.Where(x=>x.Method=="Bank").Sum(x=>x.Income+x.Outgoing).ToString("N2")</td>@if(Model.HasOtherMethod){<td data-label="Tjetër neto">0.00</td>}<td data-label="Gjithsej neto">@entries.Sum(x=>x.Income+x.Outgoing).ToString("N2")</td></tr>
    @foreach(var entry in entries.OrderByDescending(x=>x.Date).ThenBy(x=>x.Reference)){var value=entry.Income+entry.Outgoing;<tr class="cash-income-detail" data-cash-parent="@treasuryKey" hidden><td data-label="Dokumenti"><a class="cash-entry-link" asp-controller="@entry.Controller" asp-action="@entry.Action" asp-route-id="@entry.Id" asp-route-embedded="true" asp-route-returnUrl="@(Context.Request.PathBase + Context.Request.Path + Context.Request.QueryString)"><strong>@entry.Date.ToString("dd/MM/yyyy") · @entry.Description</strong><small>@entry.Reference</small></a></td><td data-label="Bruto">@(value>0?value.ToString("N2"):"—")</td><td class="cash-reversed" data-label="Anulime">@(value<0?(-value).ToString("N2"):"—")</td><td data-label="Cash neto">@(entry.Method=="Cash"?value.ToString("N2"):"—")</td><td data-label="Bankë neto">@(entry.Method=="Bank"?value.ToString("N2"):"—")</td>@if(Model.HasOtherMethod){<td data-label="Tjetër neto">@(entry.Method=="Other"?value.ToString("N2"):"—")</td>}<td data-label="Gjithsej neto">@value.ToString("N2")</td></tr>}
}
</tbody></table></div>
}
<div class="table-responsive mt-4"><table class="table document-table cash-report-table cash-balances"><thead><tr><th>Përmbledhja</th>@foreach(var m in Model.MethodBalances){<th>@m.Name</th>}<th>Gjithsej</th></tr></thead><tbody>
<tr><th>Gjendja në fillim</th>@foreach(var m in Model.MethodBalances){<td data-label="@m.Name">@m.Opening.ToString("N2")</td>}<td data-label="Gjithsej">@Model.Opening.ToString("N2")</td></tr>
@if(Model.Movements.Any(x=>x.Group==TreasuryEntry.OpeningGroup)){
<tr><th>Gjendje fillestare e regjistruar (neto)</th>@foreach(var m in Model.MethodBalances){<td data-label="@m.Name">@m.InitialFunds.ToString("N2")</td>}<td data-label="Gjithsej">@Model.InitialFunds.ToString("N2")</td></tr>
}
<tr><th>Hyrjet neto</th>@foreach(var m in Model.MethodBalances){<td data-label="@m.Name">@m.Income.ToString("N2")</td>}<td data-label="Gjithsej">@Model.Income.ToString("N2")</td></tr>
<tr><th>Daljet neto</th>@foreach(var m in Model.MethodBalances){<td data-label="@m.Name">@m.Outgoing.ToString("N2")</td>}<td data-label="Gjithsej">@Model.Outgoing.ToString("N2")</td></tr>
<tr><th>Diferenca e periudhës</th>@foreach(var m in Model.MethodBalances){<td data-label="@m.Name">@m.Net.ToString("N2")</td>}<td data-label="Gjithsej">@Model.Net.ToString("N2")</td></tr>
</tbody><tfoot><tr><th>GJENDJA NË FUND</th>@foreach(var m in Model.MethodBalances){<td data-label="@m.Name"><strong>@m.Closing.ToString("N2")</strong></td>}<td data-label="Gjithsej"><strong>@Model.Closing.ToString("N2")</strong></td></tr></tfoot></table></div>
<dialog class="cash-document-dialog" data-cash-document-dialog aria-label="Dokumenti i kalimit"><button type="button" class="cash-document-close" data-cash-document-close aria-label="Mbyll dokumentin">×</button><iframe title="Dokumenti i kalimit" data-cash-document-frame></iframe></dialog>
<script>document.addEventListener('click',event=>{const link=event.target.closest('.cash-entry-link');if(!link)return;const dialog=document.querySelector('[data-cash-document-dialog]'),frame=dialog?.querySelector('[data-cash-document-frame]');if(!dialog||!frame||typeof dialog.showModal!=='function')return;event.preventDefault();frame.src=link.href;dialog.showModal();});document.addEventListener('click',event=>{if(!event.target.closest('[data-cash-document-close]'))return;const dialog=document.querySelector('[data-cash-document-dialog]');dialog?.close();});document.addEventListener('close',event=>{if(!event.target.matches?.('[data-cash-document-dialog]'))return;const frame=event.target.querySelector('[data-cash-document-frame]');if(frame)frame.src='about:blank';},true);window.addEventListener('message',event=>{if(event.origin!==location.origin||event.data!=='close-report-document')return;document.querySelector('[data-cash-document-dialog]')?.close();});</script>
