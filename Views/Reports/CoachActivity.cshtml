@model CoachActivityReport
@using _2Korriku.Services
@{ ViewData["Title"] = "Aktiviteti i trajnerëve"; var maximum = Math.Max(1, Model.Rows.Select(x => x.Points).DefaultIfEmpty().Max()); }
<link rel="stylesheet" href="~/css/coach-activity.css" asp-append-version="true"/>
<div class="coach-activity-report">
<div class="page-heading"><h1>Aktiviteti i trajnerëve</h1><span class="text-secondary">@Model.From.ToString("dd.MM.yyyy") – @Model.To.ToString("dd.MM.yyyy")</span></div>
<form method="get" class="panel activity-filter">
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<div><label for="from">Nga data</label><input id="from" name="from" type="date" value="@Model.From.ToString("yyyy-MM-dd")" max="@BillingClock.Today.ToString("yyyy-MM-dd")" class="form-control" required/></div>
<div><label for="to">Deri më</label><input id="to" name="to" type="date" value="@Model.To.ToString("yyyy-MM-dd")" max="@BillingClock.Today.ToString("yyyy-MM-dd")" class="form-control" required/></div>
<button class="btn btn-primary">Shfaq</button><a asp-action="CoachActivity" class="btn btn-outline-secondary">Ky muaj</a>
</form>
@if(ViewData.ModelState.IsValid){
<div class="activity-totals"><span><strong>@Model.Rows.Count(x=>x.Points>0)<small> / @Model.Rows.Count</small></strong>Trajnerë aktivë</span><span><strong>@Model.Rows.Sum(x=>x.Points)</strong>Pikë gjithsej</span><span><strong>@Model.Rows.Count(x=>x.Points==0)</strong>Pa regjistrime</span></div>
<section class="panel table-responsive"><table class="table align-middle mb-0 activity-grid"><thead><tr><th>Trajneri</th><th>Pikët</th><th>Ditë aktive</th><th>Prezenca</th><th>Vlerësime / matje</th><th>Raste / kërkesa</th><th>Regjistrimi i fundit</th></tr></thead><tbody>
@foreach(var row in Model.Rows){<tr><td><strong>@row.Name</strong>@if(row.Points==0){<small class="d-block text-secondary">Pa aktivitet në periudhë</small>}</td><td><div class="activity-score"><strong>@row.Points</strong><span aria-hidden="true"><i style="width:@((int)(100.0*row.Points/maximum))%"></i></span></div></td><td>@row.Days</td><td>@row.Attendance</td><td>@row.Development</td><td>@row.Referrals</td><td class="text-nowrap">@(row.Last.HasValue ? TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(row.Last.Value,DateTimeKind.Utc),BillingClock.Zone).ToString("dd.MM.yyyy HH:mm") : "—")</td></tr>}
@if(Model.Rows.Count==0){<tr><td colspan="7" class="text-center py-4 text-secondary">Nuk ka trajnerë të regjistruar.</td></tr>}
</tbody></table></section>
<details class="activity-method"><summary>Si llogariten pikët?</summary><p>1 regjistrim unik = 1 pikë. Numërohen sipas datës kur u futën në sistem.</p><ul><li>Prezenca: ruajtja e parë e trajnerit për çdo seancë.</li><li>Vlerësime / matje: një regjistrim për lojtar, kategori dhe datë vlerësimi.</li><li>Raste / kërkesa: një rast për lojtar, specialist dhe ditë, përfshirë kërkesat për menu.</li></ul><p>Korrigjimet nuk shtojnë pikë. Përfshihen trajnerët me rolin aktual dhe të dhënat që ruhen në sistem. Pikët matin përdorimin, jo cilësinë e punës; numri i ekipeve dhe lojtarëve ndikon në total.</p></details>
}
</div>
@section PageNavigation {<a asp-action="Index" class="btn btn-outline-secondary app-back-button">← Raportet</a>}
