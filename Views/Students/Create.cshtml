@{ var club = await Club.Get(); }
@model StudentRegistrationModel
<link rel="stylesheet" href="~/css/first-month-help.css" asp-append-version="true"/>
@using _2Korriku.Services
@{ ViewData["Title"] = "Regjistro lojtar të ri"; }
<link rel="stylesheet" href="~/css/teams.css" asp-append-version="true"/>
<div class="player-registration mx-auto">
    
    <div class="mb-4">
        <div class="text-uppercase text-secondary small fw-semibold mb-2">@club.Name · Shkolla e futbollit</div>
        <h1 class="h2 mb-2">Regjistro lojtar të ri</h1>
        
    </div>
    <div id="registration-family-link" class="mb-3"><a asp-action="CreateFamily" class="btn btn-outline-primary">Regjistro familjen së bashku</a></div>
    <form asp-action="Create" method="post" data-financial-confirm class="card shadow-sm p-3 p-md-4">
        @if(ViewData["FamilyPicker"] is true){<input type="hidden" name="familyPicker" value="true"/>}
        <div asp-validation-summary="All" class="text-danger" role="alert"></div>
        <label class="contract-player-choice mb-3"><input asp-for="IsContractPlayer" type="checkbox"/><span><strong>Lojtar me kontratë</strong><small>Regjistrohet pa obligim mujor. Kontrata plotësohet më vonë.</small></span></label>
        <div class="mb-3" id="registration-payment-method"><label asp-for="PreferredPaymentMethod" class="form-label">Pagesa mujore zakonisht</label><select asp-for="PreferredPaymentMethod" class="form-select"><option value="Cash">Cash</option><option value="Bank">Bankë</option></select><small class="text-secondary">Mund të ndryshohet për çdo pagesë.</small><span asp-validation-for="PreferredPaymentMethod" class="text-danger"></span></div>
        <fieldset class="mb-4">
            <legend class="h5 mb-3">Të dhënat e lojtarit</legend>
            <div class="row g-3">
                <div class="col-md-6"><label asp-for="FirstName" class="form-label"></label> *<input asp-for="FirstName" class="form-control" autocomplete="given-name" maxlength="100" required aria-describedby="first-error" /><span asp-validation-for="FirstName" id="first-error" class="text-danger small"></span></div>
                <div class="col-md-6"><label asp-for="LastName" class="form-label"></label> *<input asp-for="LastName" class="form-control" autocomplete="family-name" maxlength="100" required aria-describedby="last-error" /><span asp-validation-for="LastName" id="last-error" class="text-danger small"></span></div>
                <div class="col-md-6"><label asp-for="DateOfBirth" class="form-label"></label> *<input asp-for="DateOfBirth" type="date" class="form-control" max="@DateTime.Today.ToString("yyyy-MM-dd")" required aria-describedby="birth-error" /><span asp-validation-for="DateOfBirth" id="birth-error" class="text-danger small"></span></div>
                <div class="col-md-6"><label asp-for="Gender" class="form-label">Gjinia *</label><select asp-for="Gender" class="form-select" required><option value="Male">Mashkull</option><option value="Female">Femër</option></select><span asp-validation-for="Gender" class="text-danger small"></span></div>
                <div class="col-md-6"><label asp-for="Phone" class="form-label">Telefoni i lojtarit (opsional)</label><input asp-for="Phone" type="tel" class="form-control" maxlength="50" placeholder="+383 …"/><span asp-validation-for="Phone" class="text-danger small"></span></div><div class="col-md-6" id="registration-fee-plan"><label asp-for="FeePlanId" class="form-label">Kategoria e pagesës *</label><select asp-for="FeePlanId" class="form-select" required>@foreach(var plan in Model.FeePlans){<option value="@plan.Id" data-waiver="@plan.IsWaiver.ToString().ToLowerInvariant()" data-family="@plan.IsFamily.ToString().ToLowerInvariant()">@plan.Name · @plan.PriceLabel</option>}</select></div>
                <div class="col-12" id="fee-family"><label asp-for="FamilyId" class="form-label">Familja *</label><select asp-for="FamilyId" class="form-select"><option value="">Zgjidhni familjen</option>@foreach(var family in Model.Families){<option value="@family.Id" data-plan="@Model.FamilyPlanIds.GetValueOrDefault(family.Id)" data-payment-method="@family.PreferredPaymentMethod">@family.Name · @family.Phone · #@family.Id</option>}</select><small class="text-secondary">@if(User.IsInRole(Roles.Admin)){<a asp-controller="Families" asp-action="Edit" target="_blank">Krijo familje</a>}</small></div>
                <div class="col-12" id="fee-waiver"><label asp-for="FeeReason" class="form-label">Arsyeja e lirimit *</label><input asp-for="FeeReason" class="form-control mb-3" maxlength="200"/><label asp-for="FeeNotes" class="form-label">Shënimi i lirimit *</label><textarea asp-for="FeeNotes" class="form-control" maxlength="400"></textarea></div>
            </div>
        </fieldset>
        <fieldset class="border-top pt-4 mb-4" id="registration-payment" data-family-picker="@((ViewData["FamilyPicker"] is true).ToString().ToLowerInvariant())">
            <legend class="h5">Pagesa në regjistrim</legend>
            <div class="row g-3">
                <div class="col-sm-6"><label asp-for="RegistrationPayment" class="form-label">Lloji i pagesës</label><select asp-for="RegistrationPayment" class="form-select"><option value="Monthly">Mujore</option><option value="Seasonal">Sezonale</option></select></div>
                <div class="col-sm-6" id="registration-season-length"><label asp-for="SeasonalMonths" class="form-label">Kohëzgjatja</label><select asp-for="SeasonalMonths" class="form-select"><option value="6">6 muaj · paguan 5</option><option value="12">12 muaj · paguan 10</option></select></div>
            </div>
            <div id="registration-seasonal" class="mt-3" hidden>
                <input asp-for="SeasonalRequestId" type="hidden"/>
                <input asp-for="SeasonalExpectedRate" type="hidden"/>
                <div class="row g-3 align-items-end">
                    <div class="col-sm-6"><label asp-for="SeasonalPaymentMethod" class="form-label">Mënyra e pagesës sezonale</label><select asp-for="SeasonalPaymentMethod" class="form-select"><option value="Cash">Cash</option><option value="Bank">Bankë</option></select></div>
                    <div class="col-sm-6"><div class="bg-light border rounded p-3" aria-live="polite"><small id="registration-season-period" class="text-secondary d-block" data-start="@TariffService.CurrentMonth.ToString("yyyy-MM")"></small><strong id="registration-season-total" class="fs-5"></strong><small id="registration-season-calculation" class="d-block text-secondary"></small></div></div>
                </div>
                <p id="registration-season-bank" class="small text-secondary mt-2 mb-0" hidden>Sezoni aktivizohet pas konfirmimit bankar.</p>
            </div>
        </fieldset>
        <fieldset class="border-top pt-4 mb-4" id="registration-monthly">
            <legend class="h5">Tarifa e muajit të parë</legend>
            <p id="first-month-proposal" role="status" aria-live="polite"></p>
            <label class="d-flex gap-2 mb-3"><input type="checkbox" id="manual-first-month" checked="@Model.FirstMonthAmount.HasValue"/> Cakto vetë shumën për muajin e parë</label>
            <div class="first-month-label"><label asp-for="FirstMonthAmount" class="form-label">Shuma e muajit të parë</label><details class="first-month-help"><summary aria-label="Si llogaritet shuma e muajit të parë?">i</summary><div class="first-month-help-content"><strong>Si llogaritet?</strong><p>Numërohen ditët nga regjistrimi deri në fund të muajit, përfshirë ditën e regjistrimit. Çdo 7 ditë llogariten si një javë; java e paplotë llogaritet e plotë, deri në 4 javë.</p><p><strong>Tarifa mujore × javët ÷ 4</strong></p><p>Rezultati rrumbullakohet përpjetë në numër të plotë, pa kaluar tarifën mujore.</p><p id="first-month-calculation" class="first-month-example" aria-live="polite"></p><small>Nëse e caktoni shumën vetë, përdoret ajo shumë dhe kërkohet arsyeja.</small></div></details></div><input asp-for="FirstMonthAmount" class="form-control mb-3" type="number" min="0" max="999999999.99" step="0.01" disabled="@(!Model.FirstMonthAmount.HasValue)"/>
            <div id="first-month-reason"><label asp-for="FirstMonthReason" class="form-label">Arsyeja e shumës së caktuar *</label><input asp-for="FirstMonthReason" class="form-control" maxlength="200" disabled="@(!Model.FirstMonthAmount.HasValue)"/></div>
        </fieldset>
        <fieldset class="border-top pt-4 mb-4" id="team-selection" data-endpoint="@Url.Action("Suggestions","Teams")" data-selected="@Model.TrainingTeamId">
            <legend class="h5 mb-2">Ekipi dhe orari i stërvitjeve</legend>
            <p id="team-status" class="team-selection-note" role="status" aria-live="polite">Vendosni datëlindjen për të parë ekipet, oraret dhe vendet e lira.</p>
            <div id="team-proposals" class="team-proposals">
            @foreach(var option in Model.SuggestedTeams){<label class="team-choice"><input type="radio" name="TrainingTeamId" required value="@option.Team.Id" checked="@(Model.TrainingTeamId==option.Team.Id)" disabled="@(option.FreePlaces==0)"/><span><strong>@option.Team.Name</strong><small>@(option.FreePlaces==0?"Ekipi është i mbushur":option.FreePlaces+" vende të lira")</small><span class="team-choice-times">@string.Join("\n",option.Team.Sessions.OrderBy(s=>s.Day).ThenBy(s=>s.StartsAt).Select(s=>$"{_2Korriku.Services.TeamService.DayName(s.Day)} {s.StartsAt:HH:mm}–{s.EndsAt:HH:mm}"))</span><small>@option.Team.Location</small></span></label>}
            </div>
            <span asp-validation-for="TrainingTeamId" class="text-danger"></span>
            
        </fieldset>
        <fieldset class="border-top pt-4 mb-4">
            <legend class="h5 mb-1">Prindi ose kujdestari</legend>
            
            <div class="row g-3">
                <div class="col-12"><label asp-for="ParentName" class="form-label"></label><input asp-for="ParentName" class="form-control" maxlength="150" /><span asp-validation-for="ParentName" class="text-danger small"></span></div>
                <div class="col-md-6"><label asp-for="ParentPhone" class="form-label"></label><input asp-for="ParentPhone" type="tel" class="form-control" placeholder="+383 …" /><span asp-validation-for="ParentPhone" class="text-danger small"></span></div>
                <div class="col-md-6"><label asp-for="ParentEmail" class="form-label">Emaili i prindit (opsional)</label><input asp-for="ParentEmail" type="email" class="form-control" placeholder="emri@shembull.com" /><span asp-validation-for="ParentEmail" class="text-danger small"></span></div>
            </div>
        </fieldset>
        <div class="border-top pt-4 mb-4"><label asp-for="Notes" class="form-label"></label><textarea asp-for="Notes" class="form-control" rows="3" maxlength="2000" placeholder="Informacione shtesë (opsionale)"></textarea><span asp-validation-for="Notes" class="text-danger small"></span></div>
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 border-top pt-4">

            <div class="d-flex gap-2"><button type="submit" class="btn btn-primary px-4">Regjistro lojtarin</button></div>
        </div>
    </form>
</div>
<script type="application/json" id="first-month-pricing">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new{standard=Model.StandardPrice,weeks=FirstMonthPricing.Weeks(BillingClock.Today),counts=Model.FamilyCounts,plans=Model.FeePlans.Select(p=>new{id=p.Id,isFamily=p.IsFamily,amount=p.Amount,additional=p.FamilyAdditionalAmount,limit=p.FamilyFirstCount,singleStandard=p.SingleUsesStandard})}))</script>
@section Scripts{<script src="~/js/registration-seasonal.js" asp-append-version="true" defer></script><script src="~/js/first-month-registration.js" asp-append-version="true"></script><script>const plan=document.querySelector('#FeePlanId'),contract=document.querySelector('#IsContractPlayer');function waiver(){const pending=contract.checked;document.querySelector('#registration-family-link').hidden=pending;document.querySelector('#registration-payment-method').hidden=pending;document.querySelector('#registration-fee-plan').hidden=pending;document.querySelector('#registration-payment').hidden=pending;document.querySelector('#registration-monthly').hidden=pending;plan.required=!pending;plan.disabled=pending;const family=!pending&&plan.selectedOptions[0]?.dataset.family==='true';document.querySelector('#fee-family').hidden=!family;document.querySelector('#FamilyId').required=family;const method=document.querySelector('#PreferredPaymentMethod');method.disabled=pending||family;if(family)method.value=document.querySelector('#FamilyId').selectedOptions[0]?.dataset.paymentMethod||'Cash';const free=!pending&&plan.selectedOptions[0]?.dataset.waiver==='true';document.querySelector('#fee-waiver').hidden=!free;document.querySelector('#FeeReason').required=free;document.querySelector('#FeeNotes').required=free;}document.querySelector('#FamilyId').addEventListener('change',waiver);plan.addEventListener('change',waiver);contract.addEventListener('change',waiver);waiver();</script><script src="~/js/team-suggestions.js" asp-append-version="true"></script>}

@section PageNavigation {
    <a class="btn btn-outline-secondary app-back-button" asp-action="Index"><span aria-hidden="true">←</span><span>Mbrapa</span></a>
}
