@model StudentEditModel
@using _2Korriku.Services
@{ViewData["Title"]="Edito lojtarin";}
<div class="page-heading mt-3"><div><p class="eyebrow">LOJTARI #@Model.Id</p><h1>Edito të dhënat</h1></div></div>
<form method="post" class="panel p-4 mb-4" id="student-edit" data-teams-url="@Url.Action("Suggestions","Teams")"><input asp-for="Id" type="hidden"/><input asp-for="Revision" type="hidden"/><div asp-validation-summary="All" class="text-danger mb-3"></div><div class="row g-3"><div class="col-md-4"><label asp-for="FirstName" class="form-label">Emri *</label><input asp-for="FirstName" class="form-control" maxlength="100" required/></div><div class="col-md-4"><label asp-for="LastName" class="form-label">Mbiemri *</label><input asp-for="LastName" class="form-control" maxlength="100" required/></div><div class="col-md-4"><label asp-for="DateOfBirth" class="form-label">Datëlindja *</label><input asp-for="DateOfBirth" type="date" max="@BillingClock.Today.ToString("yyyy-MM-dd")" class="form-control" required/></div><div class="col-md-4"><label asp-for="ParentName" class="form-label">Prindi / kujdestari</label><input asp-for="ParentName" class="form-control" maxlength="150"/></div><div class="col-md-4"><label asp-for="ParentPhone" class="form-label">Telefoni i prindit</label><input asp-for="ParentPhone" type="tel" class="form-control" maxlength="50"/></div><div class="col-md-4"><label asp-for="ParentEmail" class="form-label">Emaili i prindit</label><input asp-for="ParentEmail" type="email" class="form-control" maxlength="254"/></div><div class="col-12"><label asp-for="TrainingTeamId" class="form-label">Ekipi / orari</label><select asp-for="TrainingTeamId" class="form-select"><option value="">Pa ekip</option>@if(Model.TrainingTeamId.HasValue&&!Model.Teams.Any(t=>t.Team.Id==Model.TrainingTeamId)){<option value="@Model.TrainingTeamId">@Model.CurrentTeamName · Ekipi aktual (kontrolloni moshën / aktivizimin)</option>}@foreach(var option in Model.Teams){<option value="@option.Team.Id" disabled="@(option.FreePlaces==0&&Model.TrainingTeamId!=option.Team.Id)">@option.Team.Name · @option.FreePlaces vende · @string.Join("; ",option.Team.Sessions.OrderBy(s=>s.Day).Select(s=>$"{TeamService.DayName(s.Day)} {s.StartsAt:HH:mm}–{s.EndsAt:HH:mm}"))</option>}</select><small id="edit-team-status" class="text-secondary">Nëse ndryshoni datëlindjen, kontrollohet përputhja me ekipin.</small></div><div class="col-12"><label asp-for="Notes" class="form-label">Shënime</label><textarea asp-for="Notes" class="form-control" maxlength="2000" rows="3"></textarea></div><div class="col-12"><label class="d-flex gap-2"><input asp-for="IsActive"/> Lojtar aktiv</label></div><div class="col-12"><label asp-for="Reason" class="form-label">Arsyeja e ndryshimit *</label><input asp-for="Reason" class="form-control" maxlength="200" required/></div></div><div class="d-flex gap-2 mt-4"><button class="btn btn-primary">Ruaj ndryshimet</button><a asp-controller="Families" asp-action="Index" class="btn btn-outline-secondary">Menaxho paketën familjare</a>@if(User.IsInRole(Roles.Admin)){<a asp-controller="Tariffs" asp-action="Assign" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Ndrysho kategorinë e pagesës</a>}</div></form>
<section class="panel p-4"><h2 class="h5">Historiku i editimit</h2><table class="table"><thead><tr><th>Data</th><th>Ndryshimet</th><th>Arsyeja</th><th>Autori</th></tr></thead><tbody>@foreach(var change in Model.History){<tr><td>@TimeZoneInfo.ConvertTimeFromUtc(change.CreatedAt,BillingClock.Zone).ToString("dd.MM.yyyy HH:mm")</td><td>@change.Summary</td><td>@change.Reason</td><td>@change.Actor?.UserName</td></tr>}@if(Model.History.Count==0){<tr><td colspan="4">Ende nuk ka ndryshime të regjistruara.</td></tr>}</tbody></table></section>
@section Scripts{<script src="~/js/student-edit.js" asp-append-version="true"></script>}

@section PageNavigation {
    <a class="btn btn-outline-secondary app-back-button" asp-controller="Payments" asp-action="Account" asp-route-id="@Model.Id"><span aria-hidden="true">←</span><span>Mbrapa</span></a>
}
