@model Student
@{Layout=null;}
<!DOCTYPE html><html lang="sq"><head><meta charset="utf-8"/><title>Lojtari u regjistrua</title></head><body>
<p>Lojtari u regjistrua. Mund ta mbyllni këtë dritare.</p>
