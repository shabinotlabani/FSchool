@model FamilyRegistrationModel
@using _2Korriku.Services
@{ViewData["Title"]="Regjistro fëmijët në paketë";}
<div class="page-heading mt-3"><div><p class="eyebrow">REGJISTRIM FAMILJAR</p><h1>Fëmijët së bashku, një paketë</h1></div></div>

<form method="post" class="panel p-4" id="family-registration" data-teams-url="@Url.Action("Suggestions","Teams")"><input asp-for="RequestId" type="hidden"/><div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>
<div class="row g-3 mb-4"><div class="col-md-6"><label asp-for="FamilyId" class="form-label">Familja</label><select asp-for="FamilyId" class="form-select"><option value="">Krijo familje të re</option>@foreach(var family in Model.Families){<option value="@family.Id">@family.Name · @Model.FamilyCounts.GetValueOrDefault(family.Id) fëmijë ekzistues</option>}</select></div><div class="col-md-6" id="family-name-field"><label asp-for="FamilyName" class="form-label">Emri i familjes së re *</label><input asp-for="FamilyName" class="form-control" maxlength="150" placeholder="p.sh. Familja Shabani – Labinot"/></div></div>
<partial name="_FamilyTariffChoice" model="Model"/>
<fieldset class="border-top pt-3 mb-4"><legend class="h5">Prindi / kujdestari</legend><div class="row g-3"><div class="col-md-4"><label asp-for="ParentName" class="form-label">Emri i prindit</label><input asp-for="ParentName" class="form-control" maxlength="150"/></div><div class="col-md-4"><label asp-for="ParentPhone" class="form-label">Telefoni</label><input asp-for="ParentPhone" class="form-control" type="tel" maxlength="50"/></div><div class="col-md-4"><label asp-for="ParentEmail" class="form-label">Emaili</label><input asp-for="ParentEmail" class="form-control" type="email" maxlength="254"/></div></div></fieldset>
<div id="registration-children">@for(var i=0;i<Model.Children.Count;i++){<fieldset class="border rounded p-3 mb-3 registration-child"><legend class="h5 w-auto px-2">Fëmija <span class="child-number">@(i+1)</span></legend><div class="row g-3"><div class="col-md-4"><label asp-for="Children[i].FirstName" data-child-label="FirstName" class="form-label">Emri *</label><input asp-for="Children[i].FirstName" data-child-field="FirstName" class="form-control" maxlength="100" required/></div><div class="col-md-4"><label asp-for="Children[i].LastName" data-child-label="LastName" class="form-label">Mbiemri *</label><input asp-for="Children[i].LastName" data-child-field="LastName" class="form-control" maxlength="100" required/></div><div class="col-md-4"><label asp-for="Children[i].DateOfBirth" data-child-label="DateOfBirth" class="form-label">Datëlindja *</label><input asp-for="Children[i].DateOfBirth" data-child-field="DateOfBirth" type="date" max="@BillingClock.Today.ToString("yyyy-MM-dd")" class="form-control" required/></div><div class="col-md-8"><label asp-for="Children[i].TrainingTeamId" data-child-label="TrainingTeamId" class="form-label">Ekipi dhe orari</label><select asp-for="Children[i].TrainingTeamId" data-child-field="TrainingTeamId" class="form-select"><option value="">Pa ekip — caktoje më vonë</option>@foreach(var option in Model.Children[i].Teams){<option value="@option.Team.Id" disabled="@(option.FreePlaces==0)">@option.Team.Name · @option.FreePlaces vende · @string.Join("; ",option.Team.Sessions.OrderBy(s=>s.Day).Select(s=>$"{TeamService.DayName(s.Day)} {s.StartsAt:HH:mm}–{s.EndsAt:HH:mm}"))</option>}</select><small class="team-message text-secondary">Ekipet propozohen sipas datëlindjes. Vendet kontrollohen gjatë ruajtjes.</small></div><div class="col-md-4"><label class="form-label">Propozimi për muajin e parë</label><strong class="child-fee d-block"></strong></div>
<div class="col-12"><label class="d-flex gap-2"><input type="checkbox" class="child-manual" checked="@Model.Children[i].FirstMonthAmount.HasValue"/> Cakto shumën e muajit të parë për këtë fëmijë</label></div>
<div class="col-md-4"><label asp-for="Children[i].FirstMonthAmount" data-child-label="FirstMonthAmount" class="form-label">Shuma (€)</label><input asp-for="Children[i].FirstMonthAmount" data-child-field="FirstMonthAmount" type="number" min="0" max="999999999.99" step="0.01" class="form-control" disabled="@(!Model.Children[i].FirstMonthAmount.HasValue)"/></div>
<div class="col-md-8 child-fee-reason"><label asp-for="Children[i].FirstMonthReason" data-child-label="FirstMonthReason" class="form-label">Arsyeja *</label><input asp-for="Children[i].FirstMonthReason" data-child-field="FirstMonthReason" class="form-control" maxlength="200" disabled="@(!Model.Children[i].FirstMonthAmount.HasValue)"/></div><div class="col-12"><label asp-for="Children[i].Notes" data-child-label="Notes" class="form-label">Shënime për fëmijën</label><textarea asp-for="Children[i].Notes" data-child-field="Notes" class="form-control" maxlength="2000" rows="2"></textarea></div></div><button type="button" class="btn btn-sm btn-outline-danger mt-3 remove-child">Hiq fëmijën</button></fieldset>}</div>
<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4"><button type="button" id="add-child" class="btn btn-outline-primary">+ Shto fëmijë tjetër</button><strong>Faturat e para për fëmijët e rinj: <output id="registration-total" aria-live="polite">0.00</output> €</strong></div><button class="btn btn-primary" type="submit">Regjistro fëmijët dhe krijo faturat</button></form>
<script type="application/json" id="registration-pricing">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new{plans=Model.Plans.Select(p=>new{id=p.Id,first=FirstMonthPricing.Calculate(p.Amount,BillingClock.Today),additional=FirstMonthPricing.Calculate(p.FamilyAdditionalAmount??0,BillingClock.Today),limit=p.FamilyFirstCount}),familyPlans=Model.FamilyPlanIds,counts=Model.FamilyCounts}))</script>
@section Scripts{<script src="~/js/family-registration.js" asp-append-version="true"></script>}

@section PageNavigation {
    <a class="btn btn-outline-secondary app-back-button" asp-action="Create"><span aria-hidden="true">←</span><span>Mbrapa</span></a>
}
