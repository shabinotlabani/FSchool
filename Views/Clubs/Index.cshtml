@model List<ClubTenant>
@{ Layout = "_ClubLayout"; ViewData["Title"] = "Klubet"; }
<header class="club-heading"><div><h1>Te cili klub do të futesh?</h1></div><a class="club-button primary" asp-action="Edit">+ Shto klub</a></header>
@if(TempData["Success"] is string success){<div class="club-notice">@success</div>}
@if(TempData["Error"] is string error){<div class="club-notice error">@error</div>}
<div class="club-table-wrap"><table class="club-table"><thead><tr><th>Klubi</th><th>Skadenca</th><th>Statusi</th><th></th></tr></thead><tbody>
@foreach(var club in Model){
    var active = club.IsActive && (club.ExpiresOn == null || club.ExpiresOn >= _2Korriku.Services.BillingClock.Today);
    <tr><td><strong>@club.Name</strong><small>@_2Korriku.Services.SportDevelopmentService.Label(club.Sport) · ID @club.Id</small></td><td>@(club.ExpiresOn?.ToString("dd.MM.yyyy") ?? "Pa afat")</td><td><span class="club-status @(active ? "active" : "inactive")">@(active ? "Aktiv" : !club.IsActive ? "Joaktiv" : "I skaduar")</span></td><td><div class="club-actions"><a class="club-button" asp-action="Edit" asp-route-id="@club.Id">Ndrysho</a><form asp-action="Select" method="post"><input type="hidden" name="id" value="@club.Id"/><button class="club-button primary" disabled="@(!active)">Hyr në klub →</button></form></div></td></tr>
}
</tbody></table></div>
