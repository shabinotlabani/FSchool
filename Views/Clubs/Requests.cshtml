@model List<ClubRegistration>
@{ Layout = "_ClubLayout"; ViewData["Title"] = "Kërkesat për regjistrim"; }
<a class="club-back" asp-action="Index">← Klubet</a>
<header class="club-heading"><div><p>@Model.Count(x => x.ReviewedAt == null) në pritje</p><h1>Kërkesat për regjistrim</h1></div></header>
<p class="registration-note">Shqyrtoni kërkesën dhe kontaktoni klubin. Shënimi si e shqyrtuar nuk krijon klub ose llogari dhe nuk dërgon email.</p>
@if(TempData["Success"] is string success){<div class="club-notice" role="status">@success</div>}
<div class="club-table-wrap"><table class="club-table registration-table">
<thead><tr><th>Klubi / aktiviteti</th><th>Kontakti</th><th>Pranuar (UTC)</th><th>Statusi</th><th>Veprimi</th></tr></thead>
<tbody>
@if(Model.Count == 0){<tr><td colspan="5">Ende nuk ka kërkesa për regjistrim.</td></tr>}
@foreach(var request in Model){
    <tr><td><strong>@request.Name</strong><small>@request.Activity</small></td>
    <td><a href="mailto:@request.Email">@request.Email</a><small>@request.Phone</small></td>
    <td>@request.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
    <td><span class="club-status @(request.ReviewedAt == null ? "inactive" : "active")">@(request.ReviewedAt == null ? "Në pritje" : "E shqyrtuar")</span></td>
    <td>@if(request.ReviewedAt == null){<form asp-action="ReviewRequest" method="post"><input type="hidden" name="id" value="@request.Id"/><button class="club-button">Shëno si të shqyrtuar</button></form>}else{<small>@request.ReviewedAt.Value.ToString("dd/MM/yyyy HH:mm") UTC</small>}</td></tr>
}
</tbody></table></div>
