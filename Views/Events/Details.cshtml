@model EventDetails
@using _2Korriku.Services
@{var e=Model.Event;ViewData["Title"]=e.Name;var admin=User.IsInRole(Roles.Admin);var write=admin||User.IsInRole(Roles.Operator);}
<partial name="_Intro"/>
<div class="page-heading"><div><p class="eyebrow">@e.Category.Name · @e.StatusLabel · Versioni @e.Version</p><h1>@e.Name</h1></div><a asp-action="Print" asp-route-id="@e.Id" class="btn btn-outline-primary">Printo listën e autorizuar</a></div>
@if(e.Photo!=null){<img class="event-detail-photo" src="@Url.Action("Photo",new{id=e.Id})" alt="@e.Name"/>}
<p>@ClubEventService.Local(e.StartsAt).ToString("dd/MM/yyyy HH:mm") – @ClubEventService.Local(e.EndsAt).ToString("dd/MM/yyyy HH:mm") · @e.Location</p>
<p>Afati: <strong>@ClubEventService.Local(e.Deadline).ToString("dd/MM/yyyy HH:mm")</strong> · Çmimi: <strong>@(e.Price==0?"Falas":e.Price.ToString("N2"))</strong> · Kapaciteti: @e.Capacity</p>
<p class="event-description">@e.Description</p><p><strong>Organizatori:</strong> @e.Organizer · @e.Contact</p>
<details><summary>Kushtet, transporti dhe udhëzimet</summary><p class="event-description">@e.Terms</p><p class="event-description">@e.Transport</p><p class="event-description">@e.Instructions</p><p>Politika e anulimit: @(e.CancellationPolicy=="Refund"?"Lirohet detyrimi. Pagesat mund të rimbursohen ose kreditohen.":"Tarifa e autorizuar ruhet pas anulimit.")</p></details>
@if(admin){<div class="event-actions">@if(e.Status is "Draft" or "Published"){<a asp-action="Edit" asp-route-id="@e.Id" class="btn btn-outline-primary">Ndrysho</a>}
@foreach(var action in e.Status=="Draft"?new[]{("Publish","Publiko"),("Cancel","Anulo")}:e.Status=="Published"?new[]{("Cancel","Anulo"),("Complete","Përfundo")}:Array.Empty<(string,string)>()){
<form asp-action="State" method="post"><input type="hidden" name="id" value="@e.Id"/><input type="hidden" name="revision" value="@e.Revision"/><button name="command" value="@action.Item1" class="btn btn-outline-primary">@action.Item2</button></form>}
</div>}
<h2 class="event-section-title">Përmbledhja financiare</h2><div class="event-scroll"><table class="event-summary"><thead><tr><th>Të ardhura të autorizuara</th><th>Pagesa neto</th><th>Borxhe</th><th>Sponsorizime të pranuara</th><th>Shpenzime</th><th>Rezultati financiar</th></tr></thead><tbody><tr><td>@Model.Revenue.ToString("N2")</td><td>@Model.Collected.ToString("N2")</td><td>@Model.Debt.ToString("N2")</td><td>@Model.Sponsorship.ToString("N2")</td><td>@Model.Costs.ToString("N2")</td><td>@Model.Result.ToString("N2")</td></tr></tbody></table></div>
<p class="text-secondary">Pagesat neto përjashtojnë rimbursimet dhe kreditimet. Rezultati = pagesat neto + sponsorizimet − shpenzimet. Sponsorizimet janë arkëtime të lidhura nga moduli ekzistues.</p>
<h2 class="event-section-title">Pjesëmarrësit</h2><p>@e.Invitations.Count(x=>x.Status=="Accepted") konfirmuar · @e.Invitations.Count(x=>x.Status=="Declined") refuzuar · @e.Invitations.Count(x=>x.Status=="Pending") në pritje · @e.Invitations.Count(x=>x.Attended==true) prezentë</p>
<div class="event-scroll"><table class="table event-table"><thead><tr><th>Lojtari / prindi</th><th>Përgjigjja / autorizimi</th><th>Detyrimi</th><th>Paguar neto</th><th>Borxh</th><th>Prezenca</th><th>Veprimet</th></tr></thead><tbody>
@foreach(var i in e.Invitations.OrderBy(x=>x.Student.FullName)){
var last=i.Consents.OrderByDescending(x=>x.Id).FirstOrDefault();
<tr><td><a asp-controller="Payments" asp-action="Account" asp-route-id="@i.StudentId">@i.Student.FullName</a><small>@i.Student.ParentName</small></td><td><strong>@i.StatusLabel</strong>@if(last!=null){<small>@last.Guardian · @ClubEventService.Local(last.CreatedAt).ToString("dd/MM/yyyy HH:mm")</small><small>Versioni @last.Version · Kushtet: @(last.TermsAccepted?"Pranuar":"Pa pranim")</small>}@if(i.WithdrawalRequested){<small class="text-danger">Kërkesë për tërheqje në pritje</small>}</td><td>@((i.Amount-i.Waived).ToString("N2"))</td><td>@i.Paid.ToString("N2")@if(i.Refundable>0){<small>Për kthim: @i.Refundable.ToString("N2")</small>}</td><td><strong>@i.Due.ToString("N2")</strong></td><td>@(i.Attended.HasValue?(i.Attended.Value?"Prezent":"Mungon"):"Pa regjistruar")
@if(write&&i.Status=="Accepted"&&e.Status is "Published" or "Completed"){
<form asp-action="Attendance" method="post"><input type="hidden" name="id" value="@e.Id"/><input type="hidden" name="invitationId" value="@i.Id"/><button name="attended" value="true" class="btn btn-sm btn-outline-primary">Prezent</button><button name="attended" value="false" class="btn btn-sm btn-outline-secondary">Mungon</button></form>}
</td><td>
@if(write&&i.Due>0){<details><summary>Regjistro pagesë</summary><form asp-action="Pay" method="post"><input type="hidden" name="id" value="@e.Id"/><input type="hidden" name="invitationId" value="@i.Id"/><input type="hidden" name="request" value="@Guid.NewGuid()"/><input name="amount" type="number" step="0.01" min="0.01" max="@i.Due.ToString("0.00",System.Globalization.CultureInfo.InvariantCulture)" required aria-label="Shuma" class="form-control"/><select name="method" aria-label="Mënyra" class="form-select"><option>Cash</option><option>Bank</option></select><button class="btn btn-sm btn-primary">Paguaj</button></form></details>}
@if(admin&&i.WithdrawalRequested){<details><summary>Shqyrto tërheqjen</summary><form asp-action="Withdrawal" method="post"><input type="hidden" name="id" value="@e.Id"/><input type="hidden" name="invitationId" value="@i.Id"/><input name="reason" maxlength="200" placeholder="Arsyeja" required class="form-control"/><button name="approve" value="true" class="btn btn-sm btn-outline-primary">Prano</button><button name="approve" value="false" class="btn btn-sm btn-outline-danger">Refuzo</button></form></details>}
@if(admin&&e.Status=="Published"&&i.Status!="Cancelled"){<details><summary>Anulo pjesëmarrjen</summary><form asp-action="CancelParticipation" method="post"><input type="hidden" name="id" value="@e.Id"/><input type="hidden" name="invitationId" value="@i.Id"/><input name="reason" maxlength="200" placeholder="Arsyeja" required class="form-control"/><button class="btn btn-sm btn-outline-danger">Anulo sipas politikës së eventit</button></form></details>}
@if(admin&&i.Refundable>0){<details><summary>Rimburso / kredito</summary><form asp-action="Settle" method="post"><input type="hidden" name="id" value="@e.Id"/><input type="hidden" name="invitationId" value="@i.Id"/><input type="hidden" name="request" value="@Guid.NewGuid()"/><input name="amount" type="number" min="0.01" max="@i.Refundable.ToString("0.00",System.Globalization.CultureInfo.InvariantCulture)" step="0.01" required class="form-control" aria-label="Shuma e kthimit"/><select name="kind" class="form-select" aria-label="Lloji i kthimit"><option value="Refund">Rimbursim</option><option value="Credit">Kreditim në mujore</option></select><select name="method" class="form-select" aria-label="Mënyra e rimbursimit"><option>Cash</option><option>Bank</option></select><input name="reason" maxlength="200" placeholder="Arsyeja" required class="form-control"/><button class="btn btn-sm btn-primary">Ruaj kthimin</button></form></details>}
</td></tr>}
</tbody><tfoot><tr><th colspan="2">Gjithsej</th><td>@Model.Revenue.ToString("N2")</td><td>@Model.Collected.ToString("N2")</td><td>@Model.Debt.ToString("N2")</td><td colspan="2"></td></tr></tfoot></table></div>
<h2 class="event-section-title">Pagesat dhe kthimet</h2><div class="event-scroll"><table class="table event-table"><thead><tr><th>Data</th><th>Lojtari</th><th>Veprimi</th><th>Shuma</th><th>Statusi</th></tr></thead><tbody>
@foreach(var p in Model.Payments){<tr><td>@ClubEventService.Local(p.CreatedAt).ToString("dd/MM/yyyy HH:mm")</td><td>@e.Invitations.First(x=>x.Id==p.EventInvitationId).Student.FullName</td><td><a asp-controller="Payments" asp-action="Receipt" asp-route-id="@p.Id">Arkëtim #@p.Id · @p.PaymentMethod</a></td><td>@p.Amount.ToString("N2")</td><td>@(p.IsCancelled?"Anuluar":"Aktiv")</td></tr>}
@foreach(var s in Model.Settlements){<tr><td>@ClubEventService.Local(s.CreatedAt).ToString("dd/MM/yyyy HH:mm")</td><td>@e.Invitations.First(x=>x.Id==s.EventInvitationId).Student.FullName</td><td>@(s.Kind=="Credit"?"Kreditim në mujore":"Rimbursim") · @s.Reason</td><td>@s.Amount.ToString("N2")</td><td>Ruajtur</td></tr>}
</tbody><tfoot><tr><th colspan="3">Gjithsej arkëtime neto</th><td>@Model.Collected.ToString("N2")</td><td></td></tr></tfoot></table></div>
<h2 class="event-section-title">Shpenzimet</h2><div class="event-scroll"><table class="table event-table"><thead><tr><th>Data</th><th>Dokumenti</th><th>Përshkrimi</th><th>Shuma</th><th>Statusi</th></tr></thead><tbody>@foreach(var link in Model.Expenses){var x=link.Expense;<tr><td>@x.Date.ToString("dd/MM/yyyy")</td><td><a asp-controller="Expenses" asp-action="Details" asp-route-id="@x.Id">@x.Number</a></td><td>@x.Description</td><td>@x.Amount.ToString("N2")</td><td>@(x.CancelledAt==null?"Aktiv":"Anuluar")</td></tr>}</tbody><tfoot><tr><th colspan="3">Gjithsej shpenzime aktive</th><td>@Model.Costs.ToString("N2")</td><td></td></tr></tfoot></table></div>
@if(admin){
<details class="event-no-print"><summary>Regjistro shpenzim të eventit</summary><form asp-action="Expense" method="post" class="event-inline"><input type="hidden" name="id" value="@e.Id"/><input type="hidden" name="input.RequestId" value="@Guid.NewGuid()"/><label>Kategoria<select name="input.CategoryId" class="form-select" required>@foreach(var c in Model.ExpenseCategories){<option value="@c.Id">@c.Name</option>}</select></label><label>Përshkrimi<input name="input.Description" maxlength="200" required class="form-control"/></label><label>Data<input name="input.Date" type="date" value="@BillingClock.Today.ToString("yyyy-MM-dd")" max="@BillingClock.Today.ToString("yyyy-MM-dd")" required class="form-control"/></label><label>Shuma<input name="input.Amount" type="number" min="0.01" step="0.01" required class="form-control"/></label><label>Mënyra<select name="input.Method" class="form-select"><option>Cash</option><option>Bank</option></select></label><button class="btn btn-primary">Regjistro</button></form></details>
<form asp-action="Link" method="post" class="event-inline"><input type="hidden" name="id" value="@e.Id"/><label>Shpenzim ekzistues<select name="sourceId" class="form-select" required><option value="">Zgjidhni</option>@foreach(var x in Model.AvailableExpenses){<option value="@x.Id">@x.Number · @x.Description · @x.Amount.ToString("N2")</option>}</select></label><button class="btn btn-outline-primary">Lidh me eventin</button></form>
}
<h2 class="event-section-title">Sponsorizimet</h2><div class="event-scroll"><table class="table event-table"><thead><tr><th>Sponsori</th><th>Referenca bankare</th><th>Data</th><th>Shuma</th><th>Statusi</th></tr></thead><tbody>@foreach(var x in Model.Sponsors){<tr><td>@x.Receipt.Contract.Sponsor</td><td>@x.Receipt.BankReference</td><td>@x.Receipt.Date.ToString("dd/MM/yyyy")</td><td>@x.Receipt.Amount.ToString("N2")</td><td>@(x.Receipt.CancelledAt==null?"Aktiv":"Anuluar")</td></tr>}</tbody><tfoot><tr><th colspan="3">Gjithsej sponsorizime aktive</th><td>@Model.Sponsorship.ToString("N2")</td><td></td></tr></tfoot></table></div>
@if(admin){<form asp-action="Link" method="post" class="event-inline"><input type="hidden" name="id" value="@e.Id"/><input type="hidden" name="sponsor" value="true"/><label>Arkëtim sponsori<select name="sourceId" class="form-select" required><option value="">Zgjidhni</option>@foreach(var x in Model.AvailableSponsors){<option value="@x.Id">@x.Contract.Sponsor · @x.BankReference · @x.Amount.ToString("N2")</option>}</select></label><button class="btn btn-outline-primary">Lidh sponsorin</button></form>}
<details><summary>Historiku i autorizimeve dhe ndryshimeve</summary><div class="event-scroll"><table class="table event-table"><thead><tr><th>Data</th><th>Lojtari / vepruesi</th><th>Veprimi</th><th>Versioni / kushtet</th></tr></thead><tbody>@foreach(var i in e.Invitations){@foreach(var c in i.Consents.OrderByDescending(x=>x.Id)){<tr><td>@ClubEventService.Local(c.CreatedAt).ToString("dd/MM/yyyy HH:mm")</td><td>@i.Student.FullName · @c.Guardian</td><td>@c.Decision</td><td>Versioni @c.Version<details><summary>Kushtet e ruajtura</summary><pre>@c.Snapshot</pre></details></td></tr>}}@foreach(var a in Model.Audits){<tr><td>@ClubEventService.Local(a.CreatedAt).ToString("dd/MM/yyyy HH:mm")</td><td>@a.Actor</td><td>@a.Action</td><td><details><summary>Regjistrimi</summary><pre>@a.Snapshot</pre></details></td></tr>}</tbody></table></div></details>
