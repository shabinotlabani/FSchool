@model EventEdit
@{ViewData["Title"]=Model.Id==0?"Event i ri":"Ndrysho eventin";}
<partial name="_Intro"/><h1>@ViewData["Title"]</h1>
@if(Model.Id!=0){<p class="alert alert-info">Ndryshimi i datës, vendit, përshkrimit, çmimit ose kushteve kërkon konfirmim të ri. Pagesat e kryera ruhen; detyrimi i vjetër lirohet deri në konfirmimin e ri.</p>}
<form asp-action="Edit" method="post" enctype="multipart/form-data" class="event-edit" id="event-edit">
<input asp-for="Id" type="hidden"/><input asp-for="Revision" type="hidden"/><div asp-validation-summary="All" class="text-danger"></div>
<div class="event-fields"><label>Emri<input asp-for="Name" class="form-control" required/></label><label>Kategoria<select asp-for="CategoryId" class="form-select" required><option value="">Zgjidhni</option>@foreach(var c in Model.Categories){<option value="@c.Id">@c.Name</option>}</select></label><label>Fillon<input asp-for="StartsAt" type="datetime-local" class="form-control" required/></label><label>Përfundon<input asp-for="EndsAt" type="datetime-local" class="form-control" required/></label><label>Afati i konfirmimit<input asp-for="Deadline" type="datetime-local" class="form-control" required/></label><label>Lokacioni<input asp-for="Location" class="form-control" required/></label><label>Numri maksimal<input asp-for="Capacity" class="form-control" min="1" max="10000"/></label><label>Çmimi për pjesëmarrës<input asp-for="Price" class="form-control" type="number" min="0" max="999999.99" step="0.01"/></label><label class="event-check"><input asp-for="IsPaid"/> Event me pagesë</label><label class="event-check"><input asp-for="RequiresConsent"/> Kërkon leje prindërore</label><label>Organizatori<input asp-for="Organizer" class="form-control"/></label><label>Kontakti<input asp-for="Contact" class="form-control"/></label><label>Politika e anulimit<select asp-for="CancellationPolicy" class="form-select"><option value="Refund">Lirohet detyrimi; pagesat rimbursohen ose kreditohen</option><option value="Retain">Ruhet tarifa e autorizuar pas anulimit</option></select></label><label>Fotografia<input name="photo" type="file" accept="image/jpeg,image/png,image/webp" class="form-control" data-event-photo/></label><label class="event-check"><input asp-for="RemovePhoto"/> Hiq fotografinë ekzistuese</label></div>
<label>Përshkrimi<textarea asp-for="Description" class="form-control" rows="4" required></textarea></label><label>Kushtet e autorizimit<textarea asp-for="Terms" class="form-control" rows="4"></textarea></label><label>Transporti<textarea asp-for="Transport" class="form-control" rows="2"></textarea></label><label>Udhëzime të tjera<textarea asp-for="Instructions" class="form-control" rows="2"></textarea></label>
<h2>@(Model.Id==0?"Lojtarët e ftuar":"Shto lojtarë të tjerë të ftuar")</h2><p>Përzgjedhjet e ekipeve dhe lojtarëve bashkohen. Grupmosha filtron përzgjedhjen. Ftesat ekzistuese ruhen.</p>
<div class="event-fields"><label class="event-check"><input asp-for="AllPlayers"/> Të gjithë lojtarët aktivë</label><label>Mosha nga<input asp-for="MinAge" class="form-control"/></label><label>Mosha deri<input asp-for="MaxAge" class="form-control"/></label></div>
<div class="event-selection"><div class="event-scroll"><table class="table event-table"><thead><tr><th>Zgjidh</th><th>Ekipi</th></tr></thead><tbody>@foreach(var t in Model.Teams){<tr><td><input name="TeamIds" value="@t.Id" type="checkbox" checked="@Model.TeamIds.Contains(t.Id)" aria-label="Fto @t.Name"/></td><td>@t.Name</td></tr>}</tbody></table></div><div class="event-scroll event-player-selection"><table class="table event-table"><thead><tr><th>Zgjidh</th><th>Lojtari</th><th>Datëlindja</th></tr></thead><tbody>@foreach(var s in Model.Students){<tr><td><input name="StudentIds" value="@s.Id" type="checkbox" checked="@Model.StudentIds.Contains(s.Id)" aria-label="Fto @s.FullName"/></td><td>@s.FullName</td><td>@s.DateOfBirth.ToString("dd/MM/yyyy")</td></tr>}</tbody></table></div></div>
<p class="photo-status" role="status"></p><button class="btn btn-primary" type="submit">Ruaj eventin</button></form>
<script src="~/js/event-photo.js" asp-append-version="true"></script>
