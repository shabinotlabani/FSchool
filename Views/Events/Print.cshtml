@model ClubEvent
@using _2Korriku.Services
@{Layout="_PrintLayout";ViewData["Title"]="Pjesëmarrësit e autorizuar · "+Model.Name;var rows=Model.Invitations.Where(x=>x.Status=="Accepted"&&x.AcceptedVersion==Model.Version&&Model.Status!="Cancelled").OrderBy(x=>x.Student.FullName).ToList();}
<link rel="stylesheet" href="~/css/events.css" asp-append-version="true"/>
<div class="print-toolbar"><a asp-action="Details" asp-route-id="@Model.Id">Mbrapa</a><button type="button" onclick="window.print()">Printo</button></div><main class="stock-sheet"><h1>@Model.Name</h1><p>@ClubEventService.Local(Model.StartsAt).ToString("dd/MM/yyyy HH:mm") · @Model.Location</p><p>Pjesëmarrësit e konfirmuar · Versioni @Model.Version</p><table class="event-print-list"><thead><tr><th>Nr.</th><th>Lojtari</th><th>Datëlindja</th><th>Prindi</th><th>Telefoni</th><th>Prezenca</th></tr></thead><tbody>@for(var n=0;n<rows.Count;n++){var i=rows[n];<tr><td>@(n+1)</td><td>@i.Student.FullName</td><td>@i.Student.DateOfBirth.ToString("dd/MM/yyyy")</td><td>@(i.Consents.Where(x=>x.Decision=="Accepted"&&x.Version==Model.Version).OrderByDescending(x=>x.Id).FirstOrDefault()?.Guardian??i.Student.ParentName)</td><td>@i.Student.ParentPhone</td><td>@(i.Attended==true?"Prezent":i.Attended==false?"Mungon":"")</td></tr>}</tbody><tfoot><tr><th colspan="5">Gjithsej lojtarë të konfirmuar</th><td>@rows.Count</td></tr></tfoot></table><p>Transporti: @Model.Transport</p><p>Kontakti: @Model.Contact</p></main>
