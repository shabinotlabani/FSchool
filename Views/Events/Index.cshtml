@model List<ClubEvent>
@using _2Korriku.Services
@{ViewData["Title"]="Eventet";var mode=ViewData["Mode"]?.ToString();}
<partial name="_Intro"/>
<div class="page-heading"><div><p class="eyebrow">AKTIVITETET E KLUBIT</p><h1>Eventet &amp; Lejet Prindërore</h1></div>@if(User.IsInRole(Roles.Admin)){<a asp-action="Edit" class="btn btn-primary">+ Event i ri</a>}</div>
<form method="get" class="event-filter"><label>Kërko<input name="search" value="@ViewData["Search"]" class="form-control"/></label><label>Statusi<select name="status" class="form-select"><option value="">Të gjitha</option>@foreach(var item in new[]{("Draft","Draft"),("Published","Publikuar"),("Cancelled","Anuluar"),("Completed","Përfunduar")}){<option value="@item.Item1" selected="@(ViewData["Status"]?.ToString()==item.Item1)">@item.Item2</option>}</select></label><label>Pamja<select name="view" class="form-select"><option value="table" selected="@(mode=="table")">Tabela</option><option value="calendar" selected="@(mode=="calendar")">Kalendari</option><option value="cards" selected="@(mode=="cards")">Kartat</option></select></label><button class="btn btn-primary">Shfaq</button></form>
@if(mode=="cards"){
<div class="event-cards">@foreach(var e in Model){<article class="event-card">@if(e.Photo!=null){<img src="@Url.Action("Photo",new{id=e.Id})" alt="@e.Name" loading="lazy"/>}<div><span class="event-status">@e.StatusLabel · @e.Category.Name</span><h2><a asp-action="Details" asp-route-id="@e.Id">@e.Name</a></h2><p>@ClubEventService.Local(e.StartsAt).ToString("dd/MM/yyyy HH:mm") · @e.Location</p><p>@(e.Price==0?"Falas":e.Price.ToString("N2")) · @e.Invitations.Count(x=>x.Status=="Accepted") / @e.Capacity pjesëmarrës</p></div></article>}</div>
}else if(mode=="calendar"){
@foreach(var month in Model.GroupBy(x=>ClubEventService.Local(x.StartsAt).ToString("yyyy-MM")).OrderBy(x=>x.Key)){
var date=DateTime.Parse(month.Key+"-01");var offset=((int)date.DayOfWeek+6)%7;var days=DateTime.DaysInMonth(date.Year,date.Month);
<h2 class="event-month">@date.ToString("MMMM yyyy",System.Globalization.CultureInfo.GetCultureInfo("sq-AL"))</h2><div class="event-scroll"><table class="event-calendar"><thead><tr>@foreach(var day in new[]{"Hënë","Martë","Mërkurë","Enjte","Premte","Shtunë","Diel"}){<th>@day</th>}</tr></thead><tbody>@for(var week=0;week<(offset+days+6)/7;week++){<tr>@for(var weekday=0;weekday<7;weekday++){var n=week*7+weekday-offset+1;<td>@if(n>0&&n<=days){<strong>@n</strong>@foreach(var e in month.Where(x=>ClubEventService.Local(x.StartsAt).Day==n)){<a asp-action="Details" asp-route-id="@e.Id">@ClubEventService.Local(e.StartsAt).ToString("HH:mm") · @e.Name<small>@e.StatusLabel</small></a>}}</td>}</tr>}</tbody></table></div>}
}else{
<div class="event-scroll"><table class="table event-table"><thead><tr><th>Eventi</th><th>Kategoria</th><th>Data / vendi</th><th>Afati</th><th>Konfirmuar</th><th>Çmimi</th><th>Statusi</th></tr></thead><tbody>@foreach(var e in Model){<tr><td><a asp-action="Details" asp-route-id="@e.Id">@e.Name</a></td><td>@e.Category.Name</td><td>@ClubEventService.Local(e.StartsAt).ToString("dd/MM/yyyy HH:mm")<small>@e.Location</small></td><td>@ClubEventService.Local(e.Deadline).ToString("dd/MM/yyyy HH:mm")</td><td>@e.Invitations.Count(x=>x.Status=="Accepted") / @e.Capacity</td><td>@(e.Price==0?"Falas":e.Price.ToString("N2"))</td><td>@e.StatusLabel</td></tr>}</tbody><tfoot><tr><th colspan="4">Gjithsej · @Model.Count evente</th><td>@Model.Sum(x=>x.Invitations.Count(i=>i.Status=="Accepted")) pjesëmarrës</td><td colspan="2"></td></tr></tfoot></table></div>
}
@if(Model.Count==0){<p class="text-secondary">Nuk ka evente për filtrat e zgjedhur.</p>}
