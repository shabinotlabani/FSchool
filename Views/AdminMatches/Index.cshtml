@model MatchList
@{ViewData["Title"]="Ndeshjet zyrtare";}
<link rel="stylesheet" href="~/css/admin-matches.css" asp-append-version="true"/>
<div class="official-matches">
<header class="official-heading"><div><span>GARA DHE KUPA</span><h1>Ndeshjet zyrtare</h1></div><div class="official-actions"><a asp-action="Propose" asp-route-teamId="@Model.TeamId" class="btn btn-outline-primary">Gjej ndeshjet zyrtare</a><a asp-action="Edit" asp-route-teamId="@Model.TeamId" class="btn btn-primary">+ Ndeshje</a></div></header>
<form method="get" class="official-filter"><label>Ekipi<select name="teamId" class="form-select"><option value="">Të gjitha ekipet</option>@foreach(var team in Model.Teams){<option value="@team.Id" selected="@(team.Id==Model.TeamId)">@team.Name</option>}</select></label><label>Viti<input name="year" value="@Model.Year" type="number" min="1900" max="2200" class="form-control"/></label><button class="btn btn-outline-primary">Shfaq</button></form>
<section class="official-grid">@foreach(var game in Model.Matches){var result=game.ScoreFor.HasValue?$"{game.ScoreFor} : {game.ScoreAgainst}":game.Kickoff?.ToString("HH:mm")??"—";<article class="official-row"><time>@game.Date.ToString("dd.MM")<small>@game.Date.Year</small></time><div class="official-main"><span>@(game.League?.Name??game.Competition??"Ndeshje zyrtare")</span><strong>@game.TrainingTeam.Name <b>@result</b> @game.Opponent</strong><small>@(game.Home?"Vendas":"Mysafir") · @MatchLabels.Status(game.Status)</small></div><a asp-action="Edit" asp-route-id="@game.Id">Korrigjo</a></article>}@if(Model.Matches.Count==0){<div class="official-empty">Nuk ka ndeshje zyrtare për këtë periudhë.</div>}</section>
</div>
