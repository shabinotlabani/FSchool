@model MatchReport
@{ViewData["Title"]="Minutazhi i lojtarëve";}
<link rel="stylesheet" href="~/css/matches.css" asp-append-version="true"/>
<div class="matches-page match-report"><div class="page-heading"><div><h1>Minutazhi i lojtarëve</h1><p>Vetëm ndeshjet e përfunduara</p></div></div>
<form method="get" class="match-filters"><input type="hidden" name="studentId" value="@Model.StudentId"/><label>Ekipi<select name="teamId" class="form-select"><option value="">Të gjitha ekipet</option>@foreach(var t in Model.Teams){<option value="@t.Id" selected="@(Model.TeamId==t.Id)">@t.Name</option>}</select></label><label>Viti<input name="year" value="@Model.Year" type="number" min="1900" max="2200" class="form-control"/></label><label>Liga<select name="leagueId" class="form-select"><option value="">Të gjitha ligat</option>@foreach(var league in Model.Leagues){<option value="@league.Id" selected="@(Model.LeagueId==league.Id)">@league.Name · @league.StartsOn.Year/@league.EndsOn.Year</option>}</select></label><button class="btn btn-outline-secondary">Shfaq</button></form>
<div class="table-responsive match-grid"><table class="table align-middle"><thead><tr><th>Lojtari</th><th>Ndeshje të luajtura</th><th>Titullar</th><th>Nga stoli</th><th>Rezervë pa hyrë</th><th>Minuta</th>@if(Model.Matches.Any(g=>g.Sport=="Football")){<th>Gola</th><th>Asiste</th><th>Të verdhë</th><th>Të kuq</th>}</tr></thead><tbody>
@foreach(var row in Model.Totals){<tr><td><a asp-action="Report" asp-route-studentId="@row.StudentId" asp-route-year="@Model.Year" asp-route-teamId="@Model.TeamId" asp-route-leagueId="@Model.LeagueId">@row.Name</a></td><td>@row.Games</td><td>@row.Starts</td><td>@row.Substitutions</td><td>@row.Unused</td><td><strong>@(row.OfficialMinutes+row.CupMinutes+row.FriendlyMinutes)</strong></td>@if(Model.Matches.Any(g=>g.Sport=="Football")){<td>@row.Goals</td><td>@row.Assists</td><td>@row.YellowCards</td><td>@row.RedCards</td>}</tr>}
@if(Model.Totals.Count==0){<tr><td colspan="9">Ende pa minuta të regjistruara për këtë periudhë.</td></tr>}
</tbody></table></div>
@if(Model.StudentId.HasValue){<h2 class="mt-4">Ndeshjet e lojtarit</h2><div class="table-responsive match-grid"><table class="table align-middle"><thead><tr><th>Data</th><th>Kundërshtari</th><th>Liga</th><th>Roli</th><th>Hyrja → dalja</th><th>Min</th></tr></thead><tbody>
@foreach(var game in Model.Matches){var p=game.Players.Single(x=>x.StudentId==Model.StudentId);<tr><td>@game.Date.ToString("dd/MM/yyyy")</td><td><a asp-action="Edit" asp-route-id="@game.Id">@game.Opponent</a></td><td>@(game.Competition??"Miqësore")</td><td>@MatchLabels.Role(p.Role)</td><td>@string.Join(" · ",p.Stints.Select(x=>$"{x.From}–{x.To}"))</td><td>@p.Minutes</td></tr>}
</tbody></table></div>}
</div>
@section PageNavigation { @if(Model.StudentId.HasValue){<a class="btn btn-outline-secondary app-back-button" asp-action="@(Model.TeamId.HasValue?"Matrix":"Report")" asp-route-teamId="@Model.TeamId" asp-route-leagueId="@Model.LeagueId" asp-route-year="@Model.Year">← Minutazhi</a>}else{<a class="btn btn-outline-secondary app-back-button" asp-action="Index" asp-route-year="@Model.Year">← Ndeshjet</a>} }
