@model MatchInput
<section class="formation-editor" aria-label="Formacioni i ekipit">
<div class="pitch-touch-nav" aria-label="Pamja e ekipit"><button type="button" data-pitch-tab="field" aria-pressed="true">Fusha</button><button type="button" data-pitch-tab="bench" aria-pressed="false">Rezervat</button><span id="pitch-save-state" role="status">E ruajtur</span></div>
<div class="formation-toolbar"><div><h2>Formacioni i ekipit</h2><small>Prek lojtarin për veprimet</small></div><button type="button" id="pitch-auto" class="btn btn-outline-primary">Auto</button><label>Vendosja<select asp-for="Formation" class="form-select"><option value="4-4-2">4–4–2</option><option value="4-3-3">4–3–3</option><option value="3-5-2">3–5–2</option><option value="4-2-3-1">4–2–3–1</option><option value="Auto">Sipas ekipit</option></select></label><button type="submit" name="command" value="@(Model.Status=="Draft"?"Confirm":"Save")" class="btn btn-primary pitch-top-save">@(Model.Status=="Draft"?"Konfirmo formacionin":"Ruaj ndeshjen")</button></div>
<div class="pitch-board"><div class="pitch-field-scroll"><div class="football-pitch"><svg class="pitch-markings" viewBox="0 0 500 680" preserveAspectRatio="none" aria-hidden="true"><rect x="14" y="14" width="472" height="652" rx="3"/><path d="M14 340H486 M115 14V125H385V14 M185 14V56H315V14 M115 666V555H385V666 M185 666V624H315V666"/><circle cx="250" cy="340" r="62"/><circle cx="250" cy="340" r="3"/><path d="M198 125Q250 174 302 125 M198 555Q250 506 302 555"/></svg><div id="pitch-players" class="pitch-players"></div></div>
</div><aside class="pitch-side"><section class="pitch-bench-sidebar"><h3 class="pitch-group-heading">Rezervat <span id="pitch-bench-count"></span></h3><div id="pitch-bench" class="pitch-card-list"></div>
</section><div id="pitch-panel-host"><p class="pitch-selection-empty">Prek një lojtar për veprimet</p></div><div class="pitch-legend"><strong>Statistikat e ndeshjes</strong><span>Minuta · Gola · Asiste</span><span><i class="pitch-yellow"></i> Të verdhë <i class="pitch-red"></i> Të kuq</span></div></aside></div><p id="pitch-auto-message" class="match-hint" role="status"></p>
<details class="pitch-available" open><summary>Lojtarët e tjerë <span id="pitch-available-count"></span></summary><div id="pitch-available" class="pitch-card-list"></div></details>
<p class="match-hint">Statistikat në karta i përkasin kësaj ndeshjeje.</p>
</section>
<dialog id="pitch-dialog" aria-labelledby="pitch-player-name"><header><span id="pitch-selected-avatar" class="pitch-avatar" aria-hidden="true"></span><div><h2 id="pitch-player-name"></h2><p id="pitch-player-status"></p></div><button type="button" id="pitch-close" aria-label="Mbyll">×</button></header>
<div id="pitch-player-stats" class="pitch-dialog-stats"></div><p id="pitch-care" class="match-care"></p>
<label id="pitch-pick-label">Zgjidh lojtarin<select id="pitch-pick" class="form-select"><option value="">Zgjidh</option>@for(var i=0;i<Model.Players.Count;i++){<option value="@i">@Model.Players[i].Name</option>}</select></label>
<div class="pitch-role-actions"><button type="button" data-pitch-role="Starter">Titullar</button><button type="button" data-pitch-role="Unused">Rezervë</button><button type="button" data-pitch-role="NotSelected">Jashtë listës</button></div>
<label>Minuta e veprimit<span class="pitch-minute-stepper"><button type="button" id="pitch-minute-down" aria-label="Një minutë më pak">−</button><input id="pitch-minute" type="number" min="1" max="300" class="form-control" inputmode="numeric" placeholder="Minuta"/><button type="button" id="pitch-minute-up" aria-label="Një minutë më shumë">+</button></span></label>
<div class="pitch-role-actions"><button type="button" id="pitch-enter">Hyr në lojë</button><button type="button" id="pitch-leave">Dil nga loja</button></div>
<details class="pitch-swap"><summary>Ndërrim</summary><label id="pitch-swap-label">Lojtari tjetër</label><select id="pitch-swap-player" class="form-select" aria-labelledby="pitch-swap-label"><option value="">Zgjidh lojtarin</option>@for(var i=0;i<Model.Players.Count;i++){<option value="@i">@Model.Players[i].Name</option>}</select><button type="button" id="pitch-swap-apply" class="btn btn-primary">Zbato ndërrimin</button></details>
<div class="pitch-event-actions"><button type="button" data-pitch-event="Goal">+ Gol</button><button type="button" data-pitch-event="Yellow">+ I verdhë</button><button type="button" data-pitch-event="Red">+ I kuq</button></div>
<details class="pitch-assessment"><summary>Vlerësimi i trajnerit</summary><div class="match-stars" role="group" aria-label="Vlerësimi i trajnerit">@for(var star=1;star<=5;star++){<button type="button" data-rating="@star" aria-label="@star yje" aria-pressed="false">★</button>}<button type="button" data-rating="" class="rating-clear" aria-label="Hiq vlerësimin">×</button></div><label for="pitch-note">Vërejtje <small>(opsionale)</small></label><textarea id="pitch-note" class="form-control" rows="2" maxlength="1000"></textarea></details>
<button type="submit" class="btn btn-primary pitch-action-save">Ruaj ndryshimet</button>
<p id="pitch-message" role="status"></p><button type="button" id="pitch-details" class="btn btn-outline-secondary">Rregullo minutat / asistet</button>
</dialog>
