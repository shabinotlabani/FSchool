@model DisciplineInput
@{ViewData["Title"]="Rregullat e kartonëve";}
<link rel="stylesheet" href="~/css/matches.css" asp-append-version="true"/>
<div class="matches-page"><h1>Rregullat e kartonëve</h1><p>@Model.TeamName · @MatchLabels.Kind(Model.Kind)</p>
<p class="match-hint">Plotësoni sipas rregullores së garës. Masa për një karton të kuq mund të ndryshohet te ndeshja sipas vendimit disiplinor.</p>
<form method="post"><input asp-for="Id" type="hidden"/><input asp-for="Revision" type="hidden"/><input asp-for="TeamId" type="hidden"/><input asp-for="Kind" type="hidden"/>
<div asp-validation-summary="All" class="text-danger"></div><div class="match-fields">
<label>Fillimi i sezonit<input asp-for="StartsOn" type="date" class="form-control" required/></label><label>Fundi i sezonit<input asp-for="EndsOn" type="date" class="form-control" required/></label>
<label>Pragu i të verdhëve<input asp-for="YellowThreshold" type="number" min="1" max="20" class="form-control" required/></label>
<label>Ndeshje pezullimi nga të verdhët<input asp-for="YellowBan" type="number" min="1" max="20" class="form-control" required/></label>
<div class="match-hint"><strong>I kuq direkt:</strong> masa vendoset nga komisioni te ndeshja.</div>
<label>Ndeshje për dy të verdhë<input asp-for="SecondYellowBan" type="number" min="0" max="20" class="form-control" required/></label>
</div><label class="my-3"><input asp-for="CountDismissalYellows"/> Numëro edhe të verdhët që sollën përjashtimin</label><div><button class="btn btn-primary">Konfirmo rregullin e garës</button></div></form></div>
@section PageNavigation {<a class="btn btn-outline-secondary" asp-action="Index" asp-route-teamId="@Model.TeamId">← Ndeshjet</a>}
