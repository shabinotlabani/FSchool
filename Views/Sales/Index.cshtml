@model List<Sale>
@using _2Korriku.Services
@{ ViewData["Title"] = "Daljet për lojtarët"; }
<div class="page-heading"><div><p class="eyebrow">REKUIZITAT · DORËZIMET</p><h1>Daljet për lojtarët</h1></div>@if(User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Operator)){<a asp-action="Create" class="btn btn-primary">+ Dalje e re</a>}</div>
<form method="get" class="search-panel d-flex gap-3 flex-wrap"><input type="hidden" name="studentId" value="@ViewData["StudentId"]"/><input class="form-control" style="max-width:420px" type="search" name="search" value="@ViewData["Search"]" placeholder="Emri i lojtarit ose numri i dokumentit" aria-label="Kërko dalje"/><label class="d-flex gap-2 align-items-center"><input type="checkbox" name="debtOnly" value="true" checked="@((bool?)ViewData["DebtOnly"] == true)"/> Vetëm me borxh</label><button class="btn btn-dark">Kërko</button><a asp-action="Index" class="btn btn-outline-secondary">Pastro</a></form>
<section class="panel"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Dokumenti / data</th><th>Lojtari</th><th>Vlera</th><th>Lirim</th><th>Arkëtuar</th><th>Borxh</th><th></th></tr></thead><tbody>
@foreach(var sale in Model){<tr><td><a asp-action="Details" asp-route-id="@sale.Id">@sale.InvoiceNumber</a><small class="balance-caption">@BillingClock.LocalDate(sale.Date).ToString("dd.MM.yyyy")</small></td><td>@(sale.PlayerName ?? sale.Student?.FullName ?? sale.CustomerName)</td><td>@sale.Total.ToString("N2") €</td><td>@sale.Discount.ToString("N2") € @if(sale.WaiverReason != null){<small class="balance-caption">E liruar</small>}</td><td>@sale.AmountPaid.ToString("N2") €</td><td><strong class="@(sale.Due > 0 ? "text-danger" : "text-success")">@sale.Due.ToString("N2") €</strong></td><td><a asp-action="Print" asp-route-id="@sale.Id" class="text-link">Printo</a></td></tr>}
@if(Model.Count == 0){<tr><td colspan="7" class="p-4 text-secondary">Nuk ka dalje për këtë kërkim.</td></tr>}
</tbody></table></div></section>
