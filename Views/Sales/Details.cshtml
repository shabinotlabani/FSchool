@model Sale
@using _2Korriku.Services
@{ ViewData["Title"] = Model.InvoiceNumber; }
<div class="page-heading mt-3"><div><p class="eyebrow">FLETËDALJE · @BillingClock.LocalDate(Model.Date).ToString("dd.MM.yyyy")</p><h1>@Model.InvoiceNumber</h1><p>@(Model.PlayerName ?? Model.Student?.FullName ?? Model.CustomerName)</p></div><div class="d-flex gap-2"><a asp-action="Print" asp-route-id="@Model.Id" class="btn btn-primary">Printo A4 · dy kopje</a>@if(Model.StudentId.HasValue){<a asp-controller="Payments" asp-action="Account" asp-route-id="@Model.StudentId" class="btn btn-outline-primary">Kartela e lojtarit</a>}</div></div>
<section class="panel p-4 mb-4"><table class="table"><thead><tr><th>Rekuizita</th><th>Sasia</th><th>Çmimi</th><th>Vlera</th></tr></thead><tbody>@foreach(var d in Model.Details){<tr><td>@(d.ProductName ?? d.Product?.Name) · @(d.ProductName != null ? d.ProductSize : d.Product?.Size)</td><td>@d.Quantity.ToString("0.##") @d.UnitName</td><td>@d.Price.ToString("N2") € @if(d.ListPrice.HasValue && d.ListPrice != d.Price){<small class="balance-caption">Çmimi i listës në dalje: @d.ListPrice.Value.ToString("N2") €</small>}</td><td>@d.Total.ToString("N2") €</td></tr>}</tbody></table><div class="d-flex justify-content-between flex-wrap gap-3"><span>Vlera: <strong>@Model.Total.ToString("N2") €</strong></span><span>Lirim: <strong>@Model.Discount.ToString("N2") €</strong></span><span>Arkëtuar: <strong>@Model.AmountPaid.ToString("N2") €</strong></span><span>Borxh: <strong>@Model.Due.ToString("N2") €</strong></span></div>
@if(Model.WaiverReason != null){<div class="alert alert-success mt-4"><strong>E liruar nga pagesa · 0 €</strong><p class="mb-0">Arsyeja: @Model.WaiverReason</p></div>}@if(Model.Notes != null){<p class="mt-3"><strong>Shënim:</strong> @Model.Notes</p>}<p class="text-secondary mt-3 mb-0">Regjistruar nga @(Model.User?.UserName ?? "Administrata") · @TimeZoneInfo.ConvertTimeFromUtc(Model.CreatedAt, BillingClock.Zone).ToString("dd.MM.yyyy HH:mm")</p></section>
@if(Model.Due > 0 && Model.RequestId != null){@if(User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Operator)){<a asp-action="Pay" asp-route-id="@Model.Id" class="btn btn-primary mb-4">Arkëto borxhin e kësaj daljeje</a>}}
<section class="panel p-4"><h2>Pagesat për këtë dalje</h2><table class="table"><thead><tr><th>Data</th><th>Shuma</th><th>Mënyra</th><th></th></tr></thead><tbody>@foreach(var p in Model.Payments.OrderBy(p=>p.Id)){<tr><td>@BillingClock.LocalDate(p.PaymentDate).ToString("dd.MM.yyyy")</td><td>@p.Amount.ToString("N2") € @if(p.IsCancelled){<span class="text-danger">Anuluar · @p.CancellationReason</span>}</td><td>@BillingService.MethodLabel(p.PaymentMethod)</td><td><a asp-controller="Payments" asp-action="Receipt" asp-route-id="@p.Id">Printo arkëtimin</a> @if(!p.IsCancelled && User.IsInRole(Roles.Admin)){<a asp-controller="Payments" asp-action="CancelPayment" asp-route-id="@p.Id" class="text-danger ms-3">Anulo me arsye</a>}</td></tr>}@if(Model.Payments.Count==0){<tr><td colspan="4">Nuk ka arkëtime të lidhura.</td></tr>}</tbody></table></section>

@section PageNavigation {
    <a class="btn btn-outline-secondary app-back-button" asp-action="Index"><span aria-hidden="true">←</span><span>Mbrapa</span></a>
}
