@model ParentEquipment
<div class="parent-equipment-content">
<p class="equipment-intro">Rekuizitat për <strong>@Model.Name</strong>. Porosia rezervon sasinë; vlera ngarkohet si borxh në kartelën financiare.</p>
<p class="equipment-hint">Rrëshqit tabelën anash për të zgjedhur sasinë dhe për të porositur →</p>
@if(TempData["Success"] is string success){<p class="equipment-success" role="status">@success</p>}
@if(TempData["Error"] is string error){<p class="equipment-error" role="alert">@error</p>}
<div class="equipment-scroll"><table class="equipment-table"><thead><tr><th>Rekuizita</th><th>Madhësia</th><th>Çmimi</th><th>E lirë</th><th>Porosit</th></tr></thead><tbody>
@foreach(var item in Model.Products){<tr><td>@if(item.HasPhoto){<img src="@Url.Action("Photo","ParentEquipment",new{token=Model.Token,id=item.ProductId})" alt="@item.Name" width="64" height="64" loading="lazy"/>}<strong>@item.Name</strong></td><td>@item.Size</td><td>@item.Price.ToString("N2")</td><td>@item.Available.ToString("0.##") @item.Unit</td><td>
@if(item.Available>=1){<form asp-controller="ParentEquipment" asp-action="Order" asp-route-token="@Model.Token" method="post" class="equipment-order-form">
<input type="hidden" name="panel" value="@((bool?)ViewData["EquipmentPanel"]==true?"true":"false")"/><input type="hidden" name="StudentId" value="@Model.StudentId"/><input type="hidden" name="VariantId" value="@item.Id"/><input type="hidden" name="RequestId" value="@Guid.NewGuid()"/><input type="hidden" name="ExpectedPrice" value="@item.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)"/>
<label>Sasia <input type="number" name="Quantity" value="1" min="1" max="@Math.Min(100,decimal.Floor(item.Available))" step="1" required/></label>
<label class="equipment-consent"><input type="checkbox" name="AcceptDebt" value="true" required/> Pranoj ngarkimin si borxh: @item.Price.ToString("N2") për @item.Unit.ToLower()</label><button type="submit">Porosit</button></form>}else{<span>Pa stok të lirë</span>}
</td></tr>}
@if(Model.Products.Count==0){<tr><td colspan="5">Ende pa rekuizita për porosi.</td></tr>}
</tbody></table></div>
<h3>Porositë e @Model.Name</h3><div class="equipment-scroll"><table class="equipment-table"><thead><tr><th>Porosia</th><th>Rekuizita</th><th>Statusi</th><th>Vlera</th><th>Borxhi</th></tr></thead><tbody>
@foreach(var order in Model.Orders){<tr><td>@order.InvoiceNumber<small>@_2Korriku.Services.BillingClock.LocalDate(order.Date).ToString("dd/MM/yyyy")</small></td><td>@foreach(var line in order.Details){<div>@line.ProductName · @line.ProductSize · @line.Quantity.ToString("0.##") @line.UnitName</div>}</td><td>@(order.Status=="Reserved"?"E rezervuar · në pritje të dorëzimit":order.Status=="Cancelled"?"E anuluar":"E dorëzuar")</td><td>@order.GrandTotal.ToString("N2")</td><td>@order.Due.ToString("N2")</td></tr>}
@if(Model.Orders.Count==0){<tr><td colspan="5">Nuk keni porosi ende.</td></tr>}
</tbody></table></div></div>
