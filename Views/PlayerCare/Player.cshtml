@model CarePage
@{ViewData["Title"]=Model.Player.FullName;}
<div class="page-heading"><div><h1>@Model.Player.FullName</h1><span>@Model.Player.DateOfBirth.ToString("dd/MM/yyyy") · @Model.Player.TrainingTeam?.Name</span></div><a asp-action="Visit" asp-route-studentId="@Model.Player.Id" class="btn btn-primary">Vizitë e re</a></div>
<partial name="_WhatsAppContact" model="@(new _2Korriku.Services.WhatsAppContact(Model.Player.ParentPhone,Model.Player.ParentName))"/>
@if(Model.Kind==Roles.Nutritionist){<a asp-controller="NutritionMenus" asp-action="Edit" asp-route-studentId="@Model.Player.Id" class="btn btn-sm btn-outline-primary my-3">Menuja javore</a>}
<h2 class="h5 mt-3">Vizitat e mia</h2><div class="table-responsive"><table class="table"><thead><tr><th>Data</th><th>Vizita</th><th>Rikontrolli</th><th>Detajet</th></tr></thead><tbody>@foreach(var entry in Model.Entries){<tr><td>@entry.Date.ToString("dd/MM/yyyy")</td><td>@entry.Subject</td><td>@entry.ReviewDate?.ToString("dd/MM/yyyy")</td><td><details><summary>Shfaq</summary><p style="white-space:pre-wrap">@entry.PrivateNotes</p>@if(Model.Kind==Roles.Doctor){<strong>@CareLabels.Status(entry.TrainingStatus)</strong><p style="white-space:pre-wrap">@entry.CoachInstructions</p>}@if(entry.ShareWithParent){<p><strong>Udhëzimi për prindin</strong></p><p style="white-space:pre-wrap">@entry.ParentInstructions</p>}</details></td></tr>}@if(Model.Entries.Count==0){<tr><td colspan="4">Ende pa vizita.</td></tr>}</tbody></table></div>
<details class="mt-4"><summary>Matjet fizike</summary><div class="table-responsive"><table class="table"><thead><tr><th>Data</th><th>Pesha (kg)</th><th>Gjatësia (cm)</th></tr></thead><tbody>@foreach(var m in Model.Measurements){<tr><td>@m.Date.ToString("dd/MM/yyyy")</td><td>@m.Values.GetValueOrDefault("Weight")</td><td>@m.Values.GetValueOrDefault("Height")</td></tr>}</tbody></table></div></details>
@section PageNavigation{<a asp-action="Index" class="btn btn-outline-secondary">← Lojtarët e mi</a>}
