@model List<CareRosterRow>
@{ViewData["Title"]=ViewData["Kind"]?.ToString()==Roles.Doctor?"Hapësira e mjekut":"Hapësira e nutricistit";}
<div class="page-heading"><h1>@ViewData["Title"]</h1></div>
<div class="table-responsive"><table class="table align-middle"><thead><tr><th>Lojtari</th><th>Ekipi</th><th>Vizita e fundit</th><th>Kontrolli i radhës</th><th></th></tr></thead><tbody>@foreach(var row in Model){<tr><td><a asp-action="Player" asp-route-id="@row.Player.Id">@row.Player.FullName</a></td><td>@row.Player.TrainingTeam?.Name</td><td>@row.Latest?.Date.ToString("dd/MM/yyyy")</td><td>@row.Latest?.ReviewDate?.ToString("dd/MM/yyyy")</td><td><a asp-action="Visit" asp-route-studentId="@row.Player.Id" class="btn btn-sm btn-outline-primary">Vizitë e re</a></td></tr>}@if(Model.Count==0){<tr><td colspan="5">Administratori ende nuk ju ka caktuar lojtarë.</td></tr>}</tbody></table></div>

<div class="d-flex gap-2 my-3"><a asp-controller="CareReferrals" asp-action="Index" class="btn btn-sm btn-outline-primary">Rastet nga trajnerët</a>@if(ViewData["Kind"]?.ToString()==Roles.Nutritionist){<a asp-controller="NutritionMenus" asp-action="Edit" class="btn btn-sm btn-outline-primary">Menuja e përbashkët</a>}</div>
