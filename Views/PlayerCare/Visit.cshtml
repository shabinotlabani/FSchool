@model CareInput
@{var player=(Student)ViewData["Player"]!;var medical=ViewData["Kind"]?.ToString()==Roles.Doctor;ViewData["Title"]=medical?"Vizitë mjekësore":"Konsultë ushqimore";}
<link rel="stylesheet" href="~/css/player-development.css" asp-append-version="true"/>
<section class="development-ui"><h1 class="h4">@player.FullName</h1><form method="post" class="development-form"><div asp-validation-summary="All" class="text-danger"></div><input asp-for="StudentId" type="hidden"/><input asp-for="RequestId" type="hidden"/>
<div class="row g-3"><div class="col-md-6"><label asp-for="Date" class="form-label">Data</label><input asp-for="Date" type="date" class="form-control" required/></div><div class="col-md-6"><label asp-for="ReviewDate" class="form-label">Kontrolli i radhës</label><input asp-for="ReviewDate" type="date" class="form-control"/></div>
<div class="col-12"><label asp-for="Subject" class="form-label">@(medical?"Vizita / lëndimi":"Qëllimi i konsultës") · privat</label><input asp-for="Subject" class="form-control" required maxlength="150"/></div>
<div class="col-12"><label asp-for="PrivateNotes" class="form-label">@(medical?"Shënimet klinike / trajtimi":"Plani ushqimor / hidratimi / shënimet") · private</label><textarea asp-for="PrivateNotes" rows="5" class="form-control" maxlength="8000"></textarea></div>
@if(medical){<div class="col-md-6"><label asp-for="TrainingStatus" class="form-label">Statusi për trajnerin</label><select asp-for="TrainingStatus" class="form-select" required><option value="">Zgjidh</option><option value="Ready">I gatshëm</option><option value="Limited">Me kufizime</option><option value="Unavailable">Nuk stërvitet</option></select></div><div class="col-12"><label asp-for="CoachInstructions" class="form-label">Udhëzimi për trajnerin</label><textarea asp-for="CoachInstructions" rows="2" class="form-control" maxlength="2000"></textarea></div>}
else{<div class="col-md-6"><label asp-for="Weight" class="form-label">Pesha (kg) · ndahet me trajnerin</label><input asp-for="Weight" type="number" step="0.1" class="form-control"/></div><div class="col-md-6"><label asp-for="Height" class="form-label">Gjatësia (cm) · ndahet me trajnerin</label><input asp-for="Height" type="number" step="0.1" class="form-control"/></div>}
<div class="col-12"><label class="form-label"><input asp-for="ShareWithParent"/> Shfaq udhëzimin më poshtë te prindi</label><textarea asp-for="ParentInstructions" aria-label="Udhëzimi për prindin" rows="3" class="form-control" maxlength="4000"></textarea></div></div><div class="development-save"><button class="btn btn-primary">Ruaj vizitën</button></div></form></section>
@section PageNavigation{<a asp-action="Player" asp-route-id="@Model.StudentId" class="btn btn-outline-secondary">← Lojtari</a>}
