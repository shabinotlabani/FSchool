@model Student
@{ViewData["Title"]="Fotoja e lojtarit";var hasPhoto=ViewData["HasPhoto"] is true;}
<link rel="stylesheet" href="~/css/student-photo.css" asp-append-version="true"/>
<section class="student-photo-editor">
<p class="eyebrow">FOTOJA E LOJTARIT</p><h1>@Model.FullName</h1><p class="text-secondary">Bëni një foto me telefon ose zgjidheni nga galeria. Fotoja përditësohet edhe në portalin e prindit.</p>
@if(hasPhoto){<img class="student-photo-current" src="@Url.Action("Image",new{id=Model.Id})" alt="@Model.FullName" width="240" height="300"/>}
<form asp-action="Save" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="player-photo-form mt-3">
<label class="form-label">Zgjidh nga galeria<input name="photo" type="file" accept="image/jpeg,image/png,image/webp" class="form-control" required/></label>
<label class="btn btn-outline-primary student-photo-camera">Bëj foto me kamerë<input type="file" accept="image/jpeg,image/png,image/webp" capture="environment" data-photo-camera class="visually-hidden" aria-label="Bëj foto me kamerë"/></label>
<div class="photo-preview" hidden><img alt="Parapamja e fotos"/><span>Parapamja e fotos së re</span></div>
<p class="text-secondary small">JPG, PNG ose WebP deri në 10 MB. Fotoja zvogëlohet automatikisht.</p>
<div class="student-photo-actions"><button type="submit" class="btn btn-primary" disabled>Ruaj foton</button>@if(hasPhoto){<button type="button" class="btn btn-outline-secondary" data-remove-photo>Hiq foton</button>}</div><p role="status" aria-live="polite" class="photo-status"></p></form></section>
@section Scripts {<script src="~/js/player-photo.js" asp-append-version="true"></script>}
@section PageNavigation {<a class="btn btn-outline-secondary app-back-button" asp-controller="@(User.IsInRole(Roles.Coach)?"PlayerDevelopment":"Students")" asp-action="@(User.IsInRole(Roles.Coach)?"Player":"Edit")" asp-route-id="@Model.Id">← Mbrapa</a>}
