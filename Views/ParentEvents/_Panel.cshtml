@model ParentEvents
@using _2Korriku.Services
@using System.Text.Json
@{var members=(List<Student>)ViewData["Members"]!;var payments=(List<Payment>)ViewData["Payments"]!;var settlements=(List<EventSettlement>)ViewData["Settlements"]!;var upcoming=Model.Invitations.Where(x=>x.Event.EndsAt>=DateTime.UtcNow&&x.Event.Status=="Published").ToList();var past=Model.Invitations.Except(upcoming).ToList();var pending=upcoming.Count(x=>x.Status=="Pending"&&x.Event.Deadline>DateTime.UtcNow);}
<div class="parent-event-content" data-event-pending="@pending"><p class="parent-event-child">@Model.Name</p>
@if(members.Count>1){<div class="event-scroll"><table class="event-table"><thead><tr><th>Fëmija</th><th>Eventet dhe autorizimet</th></tr></thead><tbody>@foreach(var child in members){<tr><td>@child.FullName</td><td><a asp-action="Index" asp-route-token="@Model.Token" asp-route-studentId="@child.Id">@(child.Id==Model.StudentId?"Fëmija i zgjedhur":"Shfaq eventet")</a></td></tr>}</tbody></table></div>}
@if(TempData["Success"] is string success){<p class="event-notice" role="status">@success</p>}@if(TempData["Error"] is string error){<p class="event-error" role="alert">@error</p>}
@if(pending>0){<p class="event-notice">Keni @pending @(pending==1?"leje prindërore në pritje.":"leje prindërore në pritje.")</p>}
@foreach(var group in new[]{("Eventet e ardhshme",upcoming),("Eventet e kaluara dhe të anuluara",past)}){
<h2>@group.Item1</h2>
@if(group.Item2.Count==0){<p>Nuk ka evente në këtë listë.</p>}
@foreach(var i in group.Item2){var e=i.Event;
<details class="parent-event-item" id="event-@e.Id">
<summary><span class="parent-event-date"><strong>@ClubEventService.Local(e.StartsAt).ToString("dd")</strong><small>@ClubEventService.Local(e.StartsAt).ToString("MMM",System.Globalization.CultureInfo.GetCultureInfo("sq-AL"))</small></span><span class="parent-event-title"><strong>@e.Name</strong><small>@i.StatusLabel · @ClubEventService.Local(e.StartsAt).ToString("HH:mm")</small></span><span class="parent-event-chevron" aria-hidden="true">›</span></summary><div class="parent-event-body">
@if(e.Photo!=null){<img src="@Url.Action("Photo",new{token=Model.Token,id=e.Id})" alt="@e.Name" loading="lazy"/>}
<p class="event-badge">@e.StatusLabel · @i.StatusLabel</p><p><strong>Fëmija:</strong> @Model.Name</p>
<p><strong>Data dhe ora:</strong> @ClubEventService.Local(e.StartsAt).ToString("dd/MM/yyyy HH:mm") – @ClubEventService.Local(e.EndsAt).ToString("dd/MM/yyyy HH:mm")</p><p><strong>Lokacioni:</strong> @e.Location</p><p class="event-description">@e.Description</p><p><strong>Çmimi:</strong> @(e.Price==0?"Falas":e.Price.ToString("N2"))</p><p><strong>Afati:</strong> @ClubEventService.Local(e.Deadline).ToString("dd/MM/yyyy HH:mm")</p>
@if(!string.IsNullOrWhiteSpace(e.Transport)){<p class="event-description"><strong>Transporti:</strong> @e.Transport</p>}
@if(!string.IsNullOrWhiteSpace(e.Instructions)){<p class="event-description"><strong>Udhëzime:</strong> @e.Instructions</p>}
@if(!string.IsNullOrWhiteSpace(e.Organizer)||!string.IsNullOrWhiteSpace(e.Contact)){<p><strong>Organizatori / kontakti:</strong> @string.Join(" · ",new[]{e.Organizer,e.Contact}.Where(x=>!string.IsNullOrWhiteSpace(x)))</p>}
<div class="event-terms"><strong>Kushtet e @(e.RequiresConsent?"autorizimit":"pjesëmarrjes")</strong><p>@e.Terms</p><p>Politika e anulimit: @(e.CancellationPolicy=="Refund"?"Detyrimi lirohet. Pagesat e kryera mund të rimbursohen ose kreditohen nga klubi.":"Tarifa e autorizuar ruhet edhe pas anulimit të pjesëmarrjes ose eventit.")</p></div>
@if(e.Status=="Published"&&i.Status is "Pending" or "Declined"&&e.Deadline>DateTime.UtcNow){
<p>Përgjigjja vlen vetëm për @Model.Name. Shkruani emrin tuaj si prind ose kujdestar që përdor këtë link privat.</p>
<form asp-action="Respond" asp-route-token="@Model.Token" method="post"><input type="hidden" name="invitationId" value="@i.Id"/><input type="hidden" name="version" value="@e.Version"/><label>Emri dhe mbiemri i prindit / kujdestarit<input name="guardian" type="text" maxlength="150" required autocomplete="name"/></label><label><input name="terms" value="true" type="checkbox"/> I lexova dhe i pranoj kushtet e mësipërme. Konfirmoj se jam prindi ose kujdestari i fëmijës.</label><div class="event-actions"><button name="decision" value="Accepted">@(e.RequiresConsent?"E autorizoj pjesëmarrjen":"E konfirmoj pjesëmarrjen")</button><button name="decision" value="Declined" class="decline">@(e.RequiresConsent?"Nuk e autorizoj pjesëmarrjen":"Nuk marrim pjesë")</button></div></form>
}else if(i.Status=="Accepted"&&e.Status=="Published"){
<p class="event-notice">Pjesëmarrja e @Model.Name është konfirmuar.</p>
@if(i.WithdrawalRequested){<p>Kërkesa juaj për tërheqje është në shqyrtim nga klubi.</p>}else{
<details><summary>Kërko tërheqjen e pëlqimit</summary><p>Klubi do ta shqyrtojë kërkesën dhe do ta trajtojë detyrimin sipas politikës së anulimit.</p><form asp-action="Respond" asp-route-token="@Model.Token" method="post"><input name="invitationId" value="@i.Id" type="hidden"/><input name="version" value="@e.Version" type="hidden"/><input name="decision" value="Withdraw" type="hidden"/><label>Emri i prindit / kujdestarit<input name="guardian" type="text" maxlength="150" required/></label><button>Kërko tërheqjen</button></form></details>}
}else if(e.Status=="Published"&&e.Deadline<=DateTime.UtcNow){<p>Afati për konfirmim ka përfunduar.</p>}
<details><summary>Historiku i autorizimeve</summary>@if(i.Consents.Count==0){<p>Ende pa përgjigje.</p>}@foreach(var c in i.Consents.OrderByDescending(x=>x.Id)){var snapshot=JsonDocument.Parse(c.Snapshot);<div class="event-block"><p><strong>@c.Guardian</strong> · @ClubEventService.Local(c.CreatedAt).ToString("dd/MM/yyyy HH:mm")</p><p>@(c.Decision=="Accepted"?"Autorizuar / konfirmuar":c.Decision=="Declined"?"Refuzuar":"Kërkuar tërheqje") · Versioni @c.Version · @(c.TermsAccepted?"Kushtet u pranuan":"Kushtet nuk u pranuan")</p><p class="event-description">Kushtet e ruajtura: @snapshot.RootElement.GetProperty("Terms").GetString()</p><p>Data: @ClubEventService.Local(snapshot.RootElement.GetProperty("StartsAt").GetDateTime()).ToString("dd/MM/yyyy HH:mm") · Vendi: @snapshot.RootElement.GetProperty("Location").GetString() · Çmimi: @snapshot.RootElement.GetProperty("Price").GetDecimal().ToString("N2")</p><p class="event-description">Transporti: @snapshot.RootElement.GetProperty("Transport").GetString()</p></div>snapshot.Dispose();}</details>
</div></details>}}
<details class="parent-event-finance"><summary><span>Financat e eventeve</span><strong>@Model.Invitations.Sum(x=>x.Due).ToString("N2")</strong></summary><p>Këto detyrime janë të ndara nga tarifa mujore e shkollës.</p>
<div class="event-scroll"><table class="event-table"><thead><tr><th>Eventi</th><th>Fëmija</th><th>Shuma</th><th>Paguar neto</th><th>Borxhi</th><th>Statusi</th></tr></thead><tbody>@foreach(var i in Model.Invitations.Where(x=>x.Amount>0||x.Paid>0)){<tr><td>@i.Event.Name</td><td>@Model.Name</td><td>@((i.Amount-i.Waived).ToString("N2"))</td><td>@i.Paid.ToString("N2")</td><td>@i.Due.ToString("N2")</td><td>@(i.Refundable>0?"Në dispozicion për kthim":i.Due==0?"E shlyer":i.Paid>0?"Pjesërisht e paguar":"E papaguar")@if(i.Refundable>0){<small>@i.Refundable.ToString("N2") · Kontaktoni klubin për rimbursim ose kreditim.</small>}</td></tr>}</tbody><tfoot><tr><th colspan="2">Gjithsej</th><td>@Model.Invitations.Sum(x=>x.Amount-x.Waived).ToString("N2")</td><td>@Model.Invitations.Sum(x=>x.Paid).ToString("N2")</td><td>@Model.Invitations.Sum(x=>x.Due).ToString("N2")</td><td></td></tr></tfoot></table></div>
</details><details class="parent-event-finance"><summary>Pagesat dhe kthimet</summary><div class="event-scroll"><table class="event-table"><thead><tr><th>Data</th><th>Eventi</th><th>Veprimi</th><th>Shuma</th><th>Statusi</th></tr></thead><tbody>@foreach(var p in payments){<tr><td>@ClubEventService.Local(p.CreatedAt).ToString("dd/MM/yyyy")</td><td>@Model.Invitations.First(x=>x.Id==p.EventInvitationId).Event.Name</td><td>Pagesë · @p.PaymentMethod</td><td>@p.Amount.ToString("N2")</td><td>@(p.IsCancelled?"Anuluar":"Pranuar")</td></tr>}@foreach(var s in settlements){<tr><td>@ClubEventService.Local(s.CreatedAt).ToString("dd/MM/yyyy")</td><td>@Model.Invitations.First(x=>x.Id==s.EventInvitationId).Event.Name</td><td>@(s.Kind=="Credit"?"Kreditim në mujore":"Rimbursim")</td><td>@s.Amount.ToString("N2")</td><td>@s.Reason</td></tr>}</tbody><tfoot><tr><th colspan="3">Gjithsej pagesa neto</th><td>@Model.Invitations.Sum(x=>x.Paid).ToString("N2")</td><td></td></tr></tfoot></table></div>
</details>
</div>
