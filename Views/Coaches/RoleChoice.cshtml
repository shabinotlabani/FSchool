@{ViewData["Title"]="Prezenca";}
<link rel="stylesheet" href="~/css/attendance.css" asp-append-version="true"/>
<link rel="stylesheet" href="~/css/coach-light.css" asp-append-version="true"/>
<div class="attendance-page coach-light coach-role-page">
<div class="page-heading"><h1>Paneli i trajnerit</h1><a class="coach-inbox-link" asp-controller="CoachInbox" asp-action="Index">Mesazhet <span>@ViewData["UnreadMessages"]</span></a></div>
<div class="coach-choices">
<a class="panel coach-choice choice-players" asp-action="Players"><span class="coach-choice-icon" aria-hidden="true"><svg class="icon"><use href="#i-players"/></svg></span><span class="coach-choice-copy"><strong>Lojtarët e mi</strong><span>Profili dhe prezenca</span></span><span class="coach-choice-arrow" aria-hidden="true">›</span></a>
<a class="panel coach-choice choice-head" asp-action="Index" asp-route-coachRole="head"><span class="coach-choice-icon" aria-hidden="true"><svg class="icon"><use href="#i-players"/></svg></span><span class="coach-choice-copy"><strong>Trajner</strong></span><span class="coach-choice-arrow" aria-hidden="true">›</span></a>
<a class="panel coach-choice choice-assistant" asp-action="Index" asp-route-coachRole="assistant"><span class="coach-choice-icon is-teal" aria-hidden="true"><svg class="icon"><use href="#i-players"/></svg></span><span class="coach-choice-copy"><strong>Ndihmëstrajner</strong></span><span class="coach-choice-arrow" aria-hidden="true">›</span></a>
<a class="panel coach-choice choice-personal" asp-action="Personal"><span class="coach-choice-icon is-purple" aria-hidden="true"><svg class="icon"><use href="#i-calendar"/></svg></span><span class="coach-choice-copy"><strong>Trajnime personale</strong></span><span class="coach-choice-arrow" aria-hidden="true">›</span></a>
</div></div>
