@{ViewData["Title"]="Prezenca";}
<link rel="stylesheet" href="~/css/attendance.css" asp-append-version="true"/>
<link rel="stylesheet" href="~/css/coach-light.css" asp-append-version="true"/>
<div class="attendance-page coach-light coach-role-page">
<div class="page-heading"><div><span class="coach-kicker">PANELI I TRAJNERIT</span><h1>Mirë se erdhe.</h1><p>Prezenca, ekipet dhe trajnimet e tua.</p></div></div>
<div class="coach-choices">
<a class="panel coach-choice" asp-action="Index" asp-route-coachRole="head"><span class="coach-choice-icon" aria-hidden="true"><svg class="icon"><use href="#i-players"/></svg></span><span class="coach-choice-copy"><strong>Jam trajner</strong><span>Ekipet dhe prezenca</span></span><span class="coach-choice-arrow" aria-hidden="true">›</span></a>
<a class="panel coach-choice" asp-action="Index" asp-route-coachRole="assistant"><span class="coach-choice-icon is-teal" aria-hidden="true"><svg class="icon"><use href="#i-players"/></svg></span><span class="coach-choice-copy"><strong>Jam ndihmëstrajner</strong><span>Ekipet dhe prezenca</span></span><span class="coach-choice-arrow" aria-hidden="true">›</span></a>
<a class="panel coach-choice" asp-action="Personal"><span class="coach-choice-icon is-purple" aria-hidden="true"><svg class="icon"><use href="#i-calendar"/></svg></span><span class="coach-choice-copy"><strong>Trajnime personale</strong><span>Lojtarët dhe oraret</span></span><span class="coach-choice-arrow" aria-hidden="true">›</span></a>
</div></div>
