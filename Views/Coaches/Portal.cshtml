@model List<CoachTeamCard>
@using _2Korriku.Services
@{ViewData["Title"]="Ekipet e mia";var role=ViewData["CoachRole"] as string;}
<link rel="stylesheet" href="~/css/attendance.css" asp-append-version="true"/>
<link rel="stylesheet" href="~/css/coach-light.css" asp-append-version="true"/>
<div class="attendance-page coach-team-page coach-light">
<div class="page-heading"><div><p class="eyebrow">@(role=="head"?"TRAJNER":"NDIHMËSTRAJNER") · @Model.Count ekipe</p><h1>Ekipet e mia</h1></div><a class="coach-inbox-link" asp-controller="CoachInbox" asp-action="Index">Mesazhet <span>@ViewData["UnreadMessages"]</span></a></div>
@if(Model.Count==0){<div class="panel p-4">Nuk keni ekipe aktive të caktuara në këtë rol.</div>}
<a class="coach-roster-link" asp-action="Players"><svg class="icon" aria-hidden="true"><use href="#i-players"/></svg><strong>Lojtarët e mi</strong><span aria-hidden="true">→</span></a>
@foreach(var card in Model){var team=card.Team;
<section class="panel coach-team-card @(card.InProgress?"is-current":"")">
<div class="coach-team-top"><h2>@team.Name</h2><span class="coach-team-age">@team.MinAge–@team.MaxAge vjeç</span></div>
@if(!string.IsNullOrWhiteSpace(team.FootballField?.Name??team.Location)){<p class="coach-team-field">@(team.FootballField?.Name??team.Location)</p>}
<div class="coach-next-session"><span class="coach-session-day">@card.When</span>@if(card.StartsAt.HasValue){<strong>@card.StartsAt.Value.ToString("HH:mm")<span> – @card.EndsAt!.Value.ToString("HH:mm")</span></strong>}</div>
<a asp-controller="Attendance" asp-action="Index" asp-route-teamId="@team.Id" asp-route-coachRole="@role" class="btn btn-primary coach-attendance-link">Shëno prezencën <span aria-hidden="true">→</span></a>
<div class="coach-team-footer">
<details class="coach-weekly-schedule"><summary>Orari javor</summary><ul>@foreach(var session in team.Sessions.OrderBy(s=>s.Day).ThenBy(s=>s.StartsAt)){<li><span>@TeamService.DayName(session.Day)</span><strong>@session.StartsAt.ToString("HH:mm")–@session.EndsAt.ToString("HH:mm")</strong></li>}@if(team.Sessions.Count==0){<li>Pa orar të caktuar.</li>}</ul></details>
<a asp-action="Team" asp-route-id="@team.Id">Lojtarët dhe ekipi</a>
</div>
</section>}
</div>
@section PageNavigation {<a class="btn btn-outline-secondary app-back-button" asp-action="Index"><span aria-hidden="true">←</span><span>Mbrapa</span></a>}
