@model CoachPlayers
@{ ViewData["Title"] = "Lojtarët e mi"; }
<link rel="stylesheet" href="~/css/coach-light.css" asp-append-version="true" />
<div class="coach-light coach-players-page">
    <div class="page-heading"><div><h1>Lojtarët e mi</h1><p>@Model.Players.Count lojtarë · 30 ditët e fundit</p></div></div>
    @if (TempData["Success"] is string success) { <div class="alert alert-success" role="status">@success</div> }
    <form method="get" class="coach-player-search">
        <input type="search" name="search" value="@Model.Search" class="form-control" placeholder="Kërko lojtarin" aria-label="Kërko lojtarin" />
        <button class="btn btn-primary">Kërko</button>
        @if (!string.IsNullOrWhiteSpace(Model.Search)) { <a asp-action="Players" class="btn btn-outline-secondary">Pastro</a> }
    </form>
    <div class="coach-player-grid table-responsive">
        <table class="table align-middle">
            <thead><tr><th>Lojtari</th><th>Ekipi</th><th>Prezenca <small>@Model.From.ToString("dd.MM")–@Model.To.ToString("dd/MM/yyyy")</small></th><th>Vlerësimi</th><th class="coach-actions-cell">Veprimet</th></tr></thead>
            <tbody>
            @foreach (var player in Model.Players)
            {
                <tr>
                    <td class="coach-player-identity"><a class="coach-player-name" asp-controller="PlayerDevelopment" asp-action="Player" asp-route-id="@player.Id" asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)">@player.Name</a><small>@player.Age vjeç · @player.Team</small></td>
                    <td class="coach-player-team">@player.Team</td>
                    <td class="coach-player-presence">
                        @if (player.Percent is int percent) { <div class="coach-presence-label"><strong>@percent%</strong><span>@player.Present / @player.Total ditë</span></div><div class="coach-presence-track" role="progressbar" aria-label="Prezenca e @player.Name" aria-valuenow="@percent" aria-valuemin="0" aria-valuemax="100"><span style="width:@(percent)%"></span></div> }
                        else { <span class="text-secondary">Pa prezencë</span> }
                    </td>
                    <td class="coach-rating-cell">
                        @if (player.Rating is decimal rating) { <div class="coach-rating" role="img" aria-label="@rating.ToString("0.0") nga 5 yje"><span class="coach-rating-stars" aria-hidden="true">★★★★★<span style="width:@((rating * 20).ToString(System.Globalization.CultureInfo.InvariantCulture))%">★★★★★</span></span><strong>@rating.ToString("0.0")</strong></div><small>@player.RatingDate?.ToString("dd/MM/yyyy")</small> }
                        else { <span class="text-secondary">Pa vlerësim</span> }
                    </td>
                    <td class="coach-actions-cell"><details class="coach-row-actions"><summary>Veprime <span aria-hidden="true">⌄</span></summary><div><a class="coach-player-open" asp-controller="PlayerDevelopment" asp-action="Player" asp-route-id="@player.Id" asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)">Profili</a><a class="coach-player-open" asp-controller="CoachInbox" asp-action="Thread" asp-route-studentId="@player.Id" asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)">Mesazh</a><a class="coach-player-open" asp-controller="CoachInbox" asp-action="Deactivate" asp-route-studentId="@player.Id" asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)">Pasivizo</a></div></details></td>
                </tr>
            }
            @if (Model.Players.Count == 0) { <tr class="coach-player-empty"><td colspan="5">Nuk u gjet asnjë lojtar aktiv në ekipet tuaja.</td></tr> }
            </tbody>
        </table>
    </div>
</div>
<partial name="_MobileNav" />
@section PageNavigation { <a class="btn btn-outline-secondary app-back-button" asp-action="Index">← Mbrapa</a> }
