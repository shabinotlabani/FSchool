@model List<CareReferral>
@{ViewData["Title"]="Rastet nga trajnerët";}
<h1 class="h4">Rastet nga trajnerët</h1>
<div class="table-responsive"><table class="table"><thead><tr><th>Lojtari</th><th>Data</th><th>Arsyeja</th><th>Statusi</th><th></th></tr></thead><tbody>@foreach(var r in Model){<tr><td><a asp-controller="PlayerCare" asp-action="Player" asp-route-id="@r.StudentId">@r.Student.FullName</a></td><td>@r.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</td><td style="white-space:pre-wrap">@r.Reason</td><td>@(r.ClosedAt==null?"Në pritje":"Përfunduar") @if(r.MenuStatus!=null){<small class="d-block">@CareMenuStatus.Label(r.MenuStatus)</small>}</td><td>@if(r.Kind==Roles.Nutritionist&&r.ClosedAt==null){<a asp-controller="NutritionMenus" asp-action="Edit" asp-route-studentId="@r.StudentId" asp-route-referralId="@r.Id">Menuja javore</a>} @if(r.ClosedAt==null){<a asp-controller="PlayerCare" asp-action="Visit" asp-route-studentId="@r.StudentId">Vizitë</a><form asp-action="Close" method="post"><input type="hidden" name="id" value="@r.Id"/><button class="btn btn-sm btn-outline-secondary">Përfundo rastin</button></form>}</td></tr>}@if(Model.Count==0){<tr><td colspan="5">Nuk ka raste.</td></tr>}</tbody></table></div>
@section PageNavigation{<a asp-controller="PlayerCare" asp-action="Index" class="btn btn-outline-secondary">← Lojtarët</a>}
