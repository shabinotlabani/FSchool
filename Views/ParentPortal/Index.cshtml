@{ var club = await Club.Get(); }
@model ParentPortalModel
@using _2Korriku.Services
@{Layout=null;var token=Context.Request.RouteValues["token"]?.ToString();ViewData["PwaManifest"]=Url.Action("Manifest","ParentPortal",new{token});}
<!doctype html><html lang="sq"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><meta name="referrer" content="no-referrer"/><title>Prindi · @club.Name · @_2Korriku.Services.ClubBranding.PlatformName</title><link rel="stylesheet" href="~/css/parent-portal.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/parent-refresh.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/player-passport.css" asp-append-version="true"/><meta name="theme-color" content="#163c65"/><partial name="_PwaHead" /></head>
<body data-parent-reopen-url="@(Model.NeedsAcknowledgement ? null : Url.Action("Index",new{token,studentId=Model.StudentId}))">
@if(Model.NeedsAcknowledgement){
<main class="blocked warning"><div><span class="notice-label">NJOFTIM PËR PAGESËN</span><h1>Shuma për t’u paguar: @Model.Debt.ToString("N2")</h1><p>Ju lutem kryeni pagesën e mbetur. Shtypni “Po e lexova” për të vazhduar në portal.</p><form asp-action="Acknowledge" asp-route-token="@token" method="post"><input type="hidden" name="studentId" value="@Context.Request.Query["studentId"]"/><input type="hidden" name="month" value="@Model.Month.ToString("yyyy-MM")"/><input type="hidden" name="finance" value="@Model.Finance.ToString().ToLowerInvariant()"/><button class="button" type="submit">Po e lexova</button></form></div></main>
}else{
<main class="portal">
<header class="parent-header"><div class="parent-brand"><img src="@Club.LogoUrl" alt="" width="34" height="40"/><span>@club.Name <small>Portali i prindit</small></span></div><h1>@(Model.FamilyName??Model.Name)</h1></header>
@if(Model.Members.Count>0){
<div class="parent-family-summary"><span>Për t’u paguar · Familja</span><strong>@Model.Debt.ToString("N2")</strong></div>
<div class="parent-family-scroll" tabindex="0" role="region" aria-label="Fëmijët e familjes"><table class="parent-family-table"><thead><tr><th>Fëmija</th><th>Për t’u paguar</th><th>Parapagim</th></tr></thead><tbody>
@foreach(var member in Model.Members){<tr class="@(member.Id==Model.StudentId?"selected":"")"><th scope="row"><a asp-action="Index" asp-route-token="@token" asp-route-studentId="@member.Id" asp-route-continueVisit="true" asp-route-finance="@Model.Finance" asp-route-month="@Model.Month.ToString("yyyy-MM")" aria-current="@(member.Id==Model.StudentId?"page":null)">@member.Name</a></th><td>@member.Debt.ToString("N2")</td><td>@member.Advance.ToString("N2")</td></tr>}
</tbody></table></div><h2 class="parent-selected-child">@Model.Name</h2>
}
<partial name="_PlayerCard" model="Model"/>
<partial name="_PortalPanels" model="Model"/>
<div class="parent-push" id="parent-push" data-status="@Url.Action("Notifications",new{token,actionName="status"})" data-enable="@Url.Action("Notifications",new{token,actionName="enable"})" data-disable="@Url.Action("Notifications",new{token,actionName="disable"})" data-worker="@Url.Content("~/sw.js")">
@Html.AntiForgeryToken()
<button class="parking-link" id="push-toggle" type="button" disabled><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4"/></svg><span>Aktivizo njoftimet</span></button><p id="push-status" class="empty" role="status" aria-live="polite"></p>
</div>
@if(Model.ParkingTicketId != null){
<footer class="parent-parking-footer"><form asp-action="GenerateParking" asp-route-token="@token" asp-route-studentId="@Model.StudentId" method="post"><button class="parking-link" type="submit"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="4" y="3" width="16" height="18" rx="3"/><path d="M10 17V7h3a3 3 0 0 1 0 6h-3"/></svg><span>Bileta e parkingut</span></button></form></footer>
}
</main>
}
<script src="~/js/parent-portal-visit.js" asp-append-version="true"></script>
<script src="~/js/player-progress.js" asp-append-version="true"></script>
<script src="~/js/parent-panels.js" asp-append-version="true"></script>
<script src="~/js/player-photo.js" asp-append-version="true"></script>
<script src="~/js/parent-push.js" asp-append-version="true"></script>
<partial name="_PwaInstall" /></body></html>
