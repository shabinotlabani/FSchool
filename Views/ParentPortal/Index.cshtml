@model ParentPortalModel
@using _2Korriku.Services
@{Layout=null;var token=Context.Request.RouteValues["token"]?.ToString();}
<!doctype html><html lang="sq"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><meta name="referrer" content="no-referrer"/><title>Prindi · 2 Korriku</title><link rel="stylesheet" href="~/css/parent-portal.css" asp-append-version="true"/></head>
<body>
@if(Model.Debt>0){
<main class="blocked"><div><h1>Borxhi i mbetur: @Model.Debt.ToString("N2")</h1><p>Ju lutem paguani pjesën e mbetur.</p></div></main>
}else{
<main class="portal">
<header><span>2 Korriku</span><h1>@Model.Name</h1></header>
@if(Model.Finance){
    <a class="button secondary" asp-action="Index" asp-route-token="@token" asp-route-month="@Model.Month.ToString("yyyy-MM")">← Mbrapa</a>
    <h2>Kartela financiare</h2><div class="balance">Borxhi <strong>0.00</strong>@if(Model.Advance>0){<span>Parapagim <strong>@Model.Advance.ToString("N2")</strong></span>}</div>
}else{
    <a class="button" asp-action="Index" asp-route-token="@token" asp-route-finance="true" asp-route-month="@Model.Month.ToString("yyyy-MM")">Kartela financiare</a>
    <section><h2>Orari</h2>@foreach(var session in Model.Schedule){<div class="row"><span>@TeamService.DayName(session.Day)</span><strong>@session.Start.ToString("HH:mm")–@session.End.ToString("HH:mm")</strong></div>}@if(Model.Schedule.Count==0){<p class="empty">Pa orar.</p>}</section>
    <h2>Prezenca</h2>
}
<nav class="months" aria-label="Muaji">
@if(Model.Month.Year>2000||Model.Month.Month>1){<a asp-action="Index" asp-route-token="@token" asp-route-finance="@Model.Finance" asp-route-month="@Model.Month.AddMonths(-1).ToString("yyyy-MM")" aria-label="Muaji i kaluar">‹</a>}else{<span></span>}
<strong>@Model.Month.ToString("MMMM yyyy",System.Globalization.CultureInfo.GetCultureInfo("sq-AL"))</strong>
@if(Model.Month<TariffService.CurrentMonth){<a asp-action="Index" asp-route-token="@token" asp-route-finance="@Model.Finance" asp-route-month="@Model.Month.AddMonths(1).ToString("yyyy-MM")" aria-label="Muaji tjetër">›</a>}else{<span></span>}
</nav>
@if(Model.Finance){
<section class="statement"><div class="entry headings"><span>Data</span><span>Detyrim</span><span>Pagesë / kredit</span></div>
@foreach(var entry in Model.Movements){<div class="entry"><time>@BillingClock.LocalDate(entry.Date).ToString("dd.MM")</time><strong>@(entry.Debit>0?entry.Debit.ToString("N2"):"—")</strong><strong>@(entry.Credit>0?entry.Credit.ToString("N2"):"—")</strong></div>}
@if(Model.Movements.Count==0){<p class="empty">Pa veprime.</p>}
</section>
}else{
<section>
@if(Model.Attendance.Count>0){var present=Model.Attendance.Count(a=>a.Present);var percent=(int)new MonthlyAttendanceSummary(present,Model.Attendance.Count).Percent;
<div class="row"><strong>@percent%</strong><span>@present/@Model.Attendance.Count</span></div><progress value="@percent" max="100" aria-label="Prezenca mujore">@percent%</progress>
@foreach(var entry in Model.Attendance){<div class="row"><time>@entry.Date.ToString("dd.MM.yyyy")</time><span class="status @(entry.Present?"present":"absent")">@(entry.Present?"Prezent":"Mungon")</span></div>}
}else{<p class="empty">Pa prezencë të regjistruar.</p>}
</section>
}
</main>
}
</body></html>
