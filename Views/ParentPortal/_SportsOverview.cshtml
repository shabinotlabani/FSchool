@model ParentPortalModel
@{var token=Context.Request.RouteValues["token"]?.ToString();var present=Model.Attendance.Count(x=>x.Present);var total=Model.Attendance.Count;var percentage=total==0?(int?)null:(int)Math.Round(100m*present/total);}
@if(Model.Show("Attendance")){
<section class="sports-training-summary sports-training-compact" aria-label="Stërvitjet dhe prezenca">
<div class="sports-compact-heading"><h2>Stërvitjet</h2><a data-portal-target="attendance" asp-action="Index" asp-route-token="@token" asp-route-studentId="@Model.StudentId" asp-route-continueVisit="true" asp-fragment="attendance">Orari <span aria-hidden="true">↗</span></a></div>
<table class="sports-compact-table"><tbody>
<tr><th scope="row">Sot</th><td>@if(Model.TodaySessions.Count>0){<div class="sports-session-times">@foreach(var session in Model.TodaySessions){<time>@session.Start.ToString("HH:mm")<span>–</span>@session.End.ToString("HH:mm")</time>}</div>}else{<span class="sports-compact-muted">Pa stërvitje sot</span>}</td></tr>
<tr><th scope="row">Prezenca<small>@Model.Month.ToString("MMMM",System.Globalization.CultureInfo.GetCultureInfo("sq-AL"))</small></th><td>@if(percentage.HasValue){<div class="sports-compact-attendance"><span><strong>@present/@total</strong> stërvitje<small>@(total-present) mungesa</small></span><b aria-label="@percentage për qind pjesëmarrje">@percentage%</b></div>}else{<span class="sports-compact-muted">Ende pa regjistrime</span>}</td></tr>
</tbody></table>
</section>
}
