@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var navigation = new[] {
        (Controller: "Home", Label: "Përmbledhja", Icon: "home"),
        (Controller: "Students", Label: "Lojtarët", Icon: "players"),
        (Controller: "Families", Label: "Familjet", Icon: "players"),
        (Controller: "Coaches", Label: "Trajnerët", Icon: "players"),
        (Controller: "Teams", Label: "Ekipet", Icon: "calendar"),
        (Controller: "Fields", Label: "Fushat dhe terminet", Icon: "calendar"),
        (Controller: "PersonalTraining", Label: "Trajnimet personale", Icon: "calendar"),
        (Controller: "Payments", Label: "Pagesat", Icon: "wallet"),
        (Controller: "Products", Label: "Rekuizitat", Icon: "box"),
        (Controller: "Sales", Label: "Daljet", Icon: "bag"),
        (Controller: "Expenses", Label: "Shpenzimet", Icon: "wallet"),
        (Controller: "Treasury", Label: "Arkat", Icon: "wallet"),
        (Controller: "Reports", Label: "Raportet", Icon: "chart")
    };
    if (User.IsInRole(Roles.Coach)) navigation = new[] { (Controller: "Coaches", Label: "Ekipet dhe orari im", Icon: "calendar") };
    var accountName = User.Identity?.Name?.Split('@')[0] ?? "Llogaria";
}
<!DOCTYPE html>
<html lang="sq">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#2c3f93" />
    <title>@ViewData["Title"] · 2 Korriku</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/brand.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/sidebar.css" rel="stylesheet" asp-append-version="true" />
    <link rel="icon" type="image/svg+xml" href="~/images/fc-2-korriku.svg" asp-append-version="true" />
</head>
<body>
    <partial name="_Icons" />
    <a class="skip-link" href="#main-content">Kalo te përmbajtja</a>
    <aside class="app-sidebar">
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="sidebar-content"><svg class="icon" aria-hidden="true"><use href="#i-menu" /></svg><span>Menuja</span></button>
        <div class="sidebar-content" id="sidebar-content">
            <nav class="side-navigation" aria-label="Navigimi kryesor">
                @foreach (var item in navigation)
                {
                    var active = currentController == item.Controller;
                    <a asp-controller="@item.Controller" asp-action="Index" class="side-link @(active ? "is-active" : "")" aria-current="@(active ? "page" : null)"><svg class="icon" aria-hidden="true"><use href="#i-@item.Icon" /></svg>@item.Label @if(active){<span class="nav-dot" aria-hidden="true"></span>}</a>
                }
            </nav>
            @if(User.IsInRole(Roles.Admin)){<nav class="side-navigation" aria-label="Administrimi"><a asp-controller="Users" asp-action="Index" class="side-link @(currentController == "Users" ? "is-active" : "")"><svg class="icon" aria-hidden="true"><use href="#i-players"/></svg>Shfrytëzuesit</a><a asp-controller="Tariffs" asp-action="Index" class="side-link @(currentController == "Tariffs" ? "is-active" : "")"><svg class="icon" aria-hidden="true"><use href="#i-wallet"/></svg>Tarifat</a></nav>}
            <div class="sidebar-account"><div class="account-avatar" aria-hidden="true">@(accountName.Length > 0 ? accountName[..1].ToUpperInvariant() : "K")</div><div class="account-details"><strong>@accountName</strong><span>@(User.IsInRole(Roles.Admin) ? "Admin" : User.IsInRole(Roles.Operator) ? "Operator" : User.IsInRole(Roles.Coach) ? "Trajner" : "Shikues")</span></div></div>
            <partial name="_LoginPartial" />
        </div>
    </aside>
    <div class="app-workspace">
        <header class="app-topbar">
            <div class="topbar-navigation">
                <div class="breadcrumb-label">Portali i shkollës <span>/</span> <strong>@ViewData["Title"]</strong></div>
            @if (IsSectionDefined("PageNavigation"))
            {
                <nav class="page-back-navigation" aria-label="Kthimi">@await RenderSectionAsync("PageNavigation", required: false)</nav>
            }
            else if (!string.IsNullOrEmpty(currentController) && currentController != "Home")
            {
                var backController = ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "Home" : currentController;
                <nav class="page-back-navigation" aria-label="Kthimi"><a asp-area="" asp-controller="@backController" asp-action="Index" class="btn btn-outline-secondary app-back-button"><span aria-hidden="true">←</span><span>Mbrapa</span></a></nav>
            }
            </div>
            <span class="today-label"><svg class="icon" aria-hidden="true"><use href="#i-calendar" /></svg>@DateTime.Today.ToString("dd.MM.yyyy")</span>
        </header>
        <main class="app-content" id="main-content" tabindex="-1">
            @RenderBody()
        </main>
        <footer class="app-footer"><span>© @DateTime.Today.Year 2 Korriku</span><span>Talenti rritet. Ekipi fiton.</span></footer>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const menu = document.querySelector('.menu-toggle');
        menu.addEventListener('click', () => {
            const expanded = menu.getAttribute('aria-expanded') !== 'true';
            menu.setAttribute('aria-expanded', String(expanded));
            document.querySelector('.app-sidebar').classList.toggle('menu-open', expanded);
        });
        document.addEventListener('keydown', event => {
            if (event.key === 'Escape' && menu.getAttribute('aria-expanded') === 'true') {
                menu.setAttribute('aria-expanded', 'false');
                document.querySelector('.app-sidebar').classList.remove('menu-open');
                menu.focus();
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
