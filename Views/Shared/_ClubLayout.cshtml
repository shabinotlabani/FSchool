<!doctype html><html lang="sq"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>@ViewData["Title"] · UPNEXT</title><link rel="stylesheet" href="~/css/clubs.css" asp-append-version="true"/><link rel="icon" href="~/images/upnext/favicon.ico"/></head><body><main class="club-shell"><a class="club-brand" href="~/Clubs"><img src="~/images/upnext/symbol_only.svg" width="36" height="40" alt=""/><strong>UPNEXT <small>SPORTS MANAGEMENT SOFTWARE</small></strong></a>@RenderBody()
@if(User.Identity?.IsAuthenticated == true){<footer class="club-footer"><span>@User.Identity.Name</span><form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/Identity/Account/Login" method="post"><button class="club-link">Dil</button></form></footer>}
</main></body></html>
