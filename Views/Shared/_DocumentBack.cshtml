@{
    var destination=Context.Request.Query["returnUrl"].ToString();
    if(!Url.IsLocalUrl(destination)){
        destination=Url.Action("Index",User.IsInRole(Roles.FieldOperator) ? "Fields" : "Payments")!;
        if(Uri.TryCreate(Context.Request.Headers.Referer.ToString(),UriKind.Absolute,out var source)
            &&source.Scheme==Context.Request.Scheme&&source.Authority==Context.Request.Host.Value
            &&source.AbsolutePath!=Context.Request.Path.Value&&Url.IsLocalUrl(source.PathAndQuery))destination=source.PathAndQuery;
    }
}
@if(Context.Request.Query["embedded"]=="true"){
    <button type="button" class="app-back-button" onclick="window.parent.postMessage('close-report-document',location.origin)"><span aria-hidden="true">←</span> Mbyll</button>
}else{
    <a href="@destination" class="app-back-button"><span aria-hidden="true">←</span> Mbrapa</a>
}
