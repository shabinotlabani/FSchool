<dialog id="financial-confirm" aria-labelledby="financial-confirm-title" aria-describedby="financial-confirm-description" style="width:min(420px,calc(100vw - 32px));border:1px solid #dbe2ea;border-radius:14px;padding:24px;box-shadow:0 20px 60px #0f172a30">
    <h2 id="financial-confirm-title" class="h5">Konfirmo veprimin financiar</h2>
    <p id="financial-confirm-description">A jeni të sigurt që dëshironi ta kryeni këtë veprim?</p>
    <strong id="financial-confirm-action" class="d-block mb-2"></strong>
    <p id="financial-confirm-details" class="text-secondary"></p>
    <div class="d-flex gap-2 mt-4">
        <button type="button" id="financial-confirm-no" class="btn btn-outline-secondary flex-fill" autofocus>No</button>
        <button type="button" id="financial-confirm-yes" class="btn btn-primary flex-fill">Yes</button>
    </div>
</dialog>
