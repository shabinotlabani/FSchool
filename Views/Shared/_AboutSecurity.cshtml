@model bool
@{ string L(string sq, string en) => Model ? en : sq; }
<section class="public-trust" aria-label="@L("Kush jemi dhe siguria", "About us and security")">
    <div class="trust-about" id="about-us">
        <p class="product-kicker">VOLCANO PIXELS × UPNEXT</p>
        <h2>@L("Teknologji me njerëz pas saj.", "Technology with people behind it.")</h2>
        <h3>@L("Kush jemi ne", "Who we are")</h3>
        <p>@L("UPNEXT është zhvilluar nga Volcano Pixels. Ekipi ynë ndërton platforma softuerike, aplikacione biznesi dhe zgjidhje digjitale. Me UPNEXT, këtë punë e sjellim te organizimi i përditshëm i klubit sportiv.", "UPNEXT is developed by Volcano Pixels. Our team builds software platforms, business applications and digital solutions. With UPNEXT, we bring this work to the everyday organisation of sports clubs.")</p>
        <a class="trust-link" href="https://www.volcanopixels.com/team" target="_blank" rel="noopener noreferrer">@L("Njihuni me ekipin tonë", "Meet our team") ↗</a>
        <p class="trust-small">@L("Prezantimi i ekipit gjendet në faqen zyrtare të Volcano Pixels.", "Explore the team on the official Volcano Pixels website.")</p>
    </div>
    <div class="trust-security" id="security">
        <p class="product-kicker">@L("SIGURIA DHE TRANSPARENCA", "SECURITY AND TRANSPARENCY")</p>
        <h2>@L("Mbrojtje në disa nivele.", "Protection at multiple levels.")</h2>
        <p>@L("UPNEXT përdor infrastrukturën Railway. Më poshtë gjeni masat e programit dhe dokumentet e ofruesit të infrastrukturës.", "UPNEXT uses Railway infrastructure. Below are application controls and documentation from our infrastructure provider.")</p>
        <div class="trust-table-wrap" tabindex="0" role="region" aria-label="@L("Masat e sigurisë", "Security measures")"><table class="trust-table"><thead><tr><th>@L("Niveli", "Layer")</th><th>@L("Mbrojtja dhe dokumentacioni", "Protection and documentation")</th></tr></thead><tbody>
            <tr><th scope="row">UPNEXT</th><td><strong>@L("Qasje sipas rolit", "Role-based access")</strong><p>@L("Funksionet kufizohen sipas rolit dhe të dhënat e klubit ndahen nga ato të klubeve të tjera.", "Features are restricted by role and club records are separated from other clubs' records.")</p></td></tr>
            <tr><th scope="row">Railway</th><td><strong>SOC 2 Type II · SOC 3</strong><p>@L("Raporte auditimi të infrastrukturës Railway. SOC 3 është publik; SOC 2 kërkon qasje nga ofruesi.", "Audit reports for Railway infrastructure. SOC 3 is public; SOC 2 requires access from the provider.")</p><a href="https://trust.railway.com/" target="_blank" rel="noopener noreferrer">@L("Shih raportet zyrtare", "View official reports") ↗</a></td></tr>
            <tr><th scope="row">Railway</th><td><strong>@L("Enkriptimi i të dhënave", "Data encryption")</strong><p>@L("Railway dokumenton AES-256 për të dhënat e ruajtura dhe HTTPS/TLS për lidhjet publike të platformës.", "Railway documents AES-256 for stored data and HTTPS/TLS for the platform's public connections.")</p><a href="https://docs.railway.com/enterprise/security" target="_blank" rel="noopener noreferrer">@L("Dokumentacioni i sigurisë", "Security documentation") ↗</a></td></tr>
        </tbody></table></div>
        <details class="trust-terms"><summary>@L("Çfarë mbulojnë raportet dhe garancitë?", "What do reports and guarantees cover?")</summary>
            <p>@L("Raportet e Railway mbulojnë ofruesin e infrastrukturës; nuk janë certifikim i veçantë i UPNEXT. Garancitë kontraktuale të disponueshmërisë (SLA) varen nga marrëveshja Enterprise. Nuk deklarojmë përqindje disponueshmërie për UPNEXT pa marrëveshje të konfirmuar.", "Railway reports cover the infrastructure provider; they are not a separate UPNEXT certification. Contractual availability guarantees (SLAs) depend on the Enterprise agreement. We do not state a UPNEXT uptime percentage without a confirmed agreement.")</p>
            <a href="https://docs.railway.com/enterprise" target="_blank" rel="noopener noreferrer">Railway Enterprise ↗</a> · <a href="https://status.railway.com/" target="_blank" rel="noopener noreferrer">@L("Statusi i infrastrukturës", "Infrastructure status") ↗</a>
        </details>
        <p class="trust-small">@L("Burimet e ofruesit u kontrolluan më 04.11.2026.", "Provider sources checked on 4 November 2026.")</p>
    </div>
</section>
